msgstr "No menu da bandeja, escolha Abrir imagem ou Histórico de imagens para trabalhar com imagens existentes."


msgid "Shortcuts can be changed in Settings."
msgstr "Os atalhos podem ser alterados nas Configurações."


msgid "After successfully copying, saving or pinning a screenshot in this session, press R during the next selection to reuse its area."
msgstr "Após copiar, salvar ou fixar uma captura nesta sessão, pressione R na próxima seleção para reutilizar a última área."


msgid "Shortcut unavailable. Check Settings."
msgstr "Atalho indisponível. Verifique as Configurações."


msgid "Shortcut change failed. The previous shortcut is still active."
msgstr "Não foi possível alterar. O atalho anterior continua ativo."


msgid "OCR is disabled. Enable it in Settings."
msgstr "OCR desativado. Ative-o nas Configurações."

msgid "Press the screenshot shortcut to select an area directly. Use the annotation shortcut to open the toolbar. Add annotations, then copy, save or pin the image."
msgstr "Use o atalho de captura para selecionar uma área ou o de anotação para abrir a barra. Adicione anotações e copie, salve ou fixe a imagem."

msgid "Translation, annotation, OCR and screenshot shortcuts must differ"
msgstr "Os atalhos de tradução, anotação, OCR e captura devem ser diferentes"

msgid "Refresh screenshot"
msgstr "Atualizar captura"

msgid "Screenshot refresh failed"
msgstr "Falha ao atualizar a captura"

msgid "Display layout changed. Start a new screenshot."
msgstr "A disposição das telas mudou. Faça uma nova captura."

