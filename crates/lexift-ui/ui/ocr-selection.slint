import { ScreenshotPixelPicker } from "screenshot-pixel-picker.slint";
import { ScreenshotSizeLabel } from "screenshot-size-label.slint";
import { ScreenshotHelp } from "screenshot-help.slint";
import { Metrics } from "design/metrics.slint";
import { RegionPreview, ScreenInteractionHint } from "screen-interaction.slint";
export component OcrSelectionWindow inherits Window {
    in property <bool> screenshot-mode: false;
    in property <bool> picker-visible;
    in property <length> picker-left;
    in property <length> picker-top;
    in property <length> picker-width;
    in property <length> picker-height;
    in property <image> picker-grid;
    in property <string> picker-coordinates;
    in property <string> picker-hex;
    in property <string> picker-rgb;
    in property <int> picker-status;
    callback color-copy() -> bool;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.screenshot-mode && (event.text == "c" || event.text == "C") && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta {
                if root.color-copy() { return accept; }
            }
            return reject;
        }
    }

    in property <bool> help-visible;
    in property <length> help-left;
    in property <length> help-top;
    in property <length> help-width;
    in property <length> help-height;
    in property <string> size-text;
    in property <bool> size-visible;
    in property <length> size-left;
    in property <length> size-top;
    in property <length> size-width;
    in property <length> size-height;
    title: root.screenshot-mode ? @tr("Select screenshot region") : @tr("OCR translation");
    no-frame: true; always-on-top: true;
    background: #000;
    in property <image> frozen-image;
    in property <bool> selecting;
    in property <length> selection-left;
    in property <length> selection-top;
    in property <length> selection-width;
    in property <length> selection-height;
    Image { source: root.frozen-image; width: parent.width; height: parent.height; image-fit: fill; }
    RegionPreview {
        width: parent.width; height: parent.height;
        selecting: root.selecting; left: root.selection-left; top: root.selection-top;
        selection-width: root.selection-width; selection-height: root.selection-height;
    }
    if root.screenshot-mode && root.help-visible: ScreenshotHelp {
        x: root.help-left; y: root.help-top; width: root.help-width; height: root.help-height; stage: 0;
    }
    if root.screenshot-mode && root.picker-visible: ScreenshotPixelPicker {
        x:root.picker-left;y:root.picker-top;width:root.picker-width;height:root.picker-height;
        grid:root.picker-grid;coordinates:root.picker-coordinates;hex:root.picker-hex;rgb:root.picker-rgb;status:root.picker-status;
    }
    if root.screenshot-mode && root.size-visible: ScreenshotSizeLabel {
        x:root.size-left; y:root.size-top; width:root.size-width; height:root.size-height; text:root.size-text;
    }
    if !root.screenshot-mode: ScreenInteractionHint {
        width: min(parent.width - 32px, Metrics.ocr-hint-max-width);
        x: max(8px,(parent.width - self.width)/2); y: 24px;
        text: @tr("Drag to select. Release to translate. Escape or right-click to cancel.");
    }
    callback cancelled();
    TouchArea { mouse-cursor: crosshair; pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.cancelled(); } } }
}
