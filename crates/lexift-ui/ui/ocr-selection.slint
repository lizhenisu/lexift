import { ToolButton } from "annotation.slint";
export struct PolygonVertex { x: length, y: length }
import { Button } from "std-widgets.slint";
import { Colors } from "design/colors.slint";
export struct MultiRegionMark { left: length, top: length, width: length, height: length, label: string, current: bool }
import { ScreenshotPixelPicker } from "screenshot-pixel-picker.slint";
import { ScreenshotSizeLabel, SizeLabelStyle } from "screenshot-size-label.slint";
import { ScreenshotHelp } from "screenshot-help.slint";
import { Metrics } from "design/metrics.slint";
import { RegionPreview, ScreenInteractionHint } from "screen-interaction.slint";
export component OcrSelectionWindow inherits Window {
    in property <bool> mode-control;
    in property <bool> mode-windows-available;
    in property <bool> mode-busy;
    in property <bool> mode-confirm;
    in property <int> selection-mode;
    out property <float> mode-control-width: mode-strip.width / 1px;
    callback mode-action(int);
    in property <bool> multi-mode;
    in property <bool> mask-copy-mode;
    in property <bool> mask-copy-enabled;
    in property <bool> window-mode;
    in property <bool> combine-mode;
    in property <bool> combine-remove;
    in property <bool> combine-busy;
    in property <bool> freehand-mode;
    in property <bool> polygon-mode;
    in property <bool> polygon-closed;
    in property <string> polygon-path: "M0 0";
    in property <string> polygon-fill: "M0 0";
    in property <[PolygonVertex]> polygon-vertices;
    in property <bool> multi-controls;
    in property <bool> multi-retry;
    in property <bool> multi-finished;
    in property <bool> multi-can-save;
    in property <bool> multi-can-delete;
    in property <[MultiRegionMark]> multi-marks;
    in property <string> multi-feedback;
    callback multi-action(int);
    in property <bool> screenshot-mode: false;
    in property <bool> picker-visible;
    in property <length> picker-left;
    in property <length> picker-top;
    in property <length> picker-width;
    in property <length> picker-height;
    in property <image> picker-grid;
    in property <string> picker-coordinates;
    in property <string> picker-hex;
    in property <string> picker-rgb;
    in property <int> picker-status;
    in property <bool> reuse-available;
    callback reuse-region() -> bool;
    callback color-copy() -> bool;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.mode-confirm {
                if event.text == Key.Escape { root.mode-action(5); }
                if event.text == Key.Return { root.mode-action(6); }
                return accept;
            }
            if root.mode-control && !root.mode-busy && event.text == Key.F2 {
                mode-menu.show({x: 0px, y: 38px});
                return accept;
            }
            if root.multi-mode {
                if root.mask-copy-mode && event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "c" || event.text == "C") { root.multi-action(5); return accept; }
                if event.text == Key.Return { root.multi-action(1); return accept; }
                if root.combine-mode && event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "z" || event.text == "Z") { root.multi-action(0); return accept; }
                if root.polygon-mode && !root.freehand-mode && event.text == Key.Backspace { root.multi-action(0); return accept; }
                if !root.polygon-mode && !root.combine-mode && event.text == Key.Delete { root.multi-action(0); return accept; }
                if event.text == Key.Escape { root.multi-action(2); return accept; }
                return reject;
            }
            if root.screenshot-mode && event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if root.screenshot-mode && (event.text == "c" || event.text == "C") && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta {
                if root.color-copy() { return accept; }
            }
            if root.screenshot-mode && root.reuse-available && (event.text == "r" || event.text == "R") && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta {
                if root.reuse-region() { return accept; }
            }
            return reject;
        }
    }

    in property <bool> help-visible;
    in property <length> help-left;
    in property <length> help-top;
    in property <length> help-width;
    in property <length> help-height;
    in property <string> size-text;
    in property <bool> size-visible;
    in property <length> size-left;
    in property <length> size-top;
    in property <length> size-width;
    in property <length> size-height;
    title: root.screenshot-mode ? @tr("Select screenshot region") : @tr("OCR translation");
    no-frame: true; always-on-top: true;
    background: #000;
    in property <image> frozen-image;
    in property <bool> selecting;
    in property <length> selection-left;
    in property <length> selection-top;
    in property <length> selection-width;
    in property <length> selection-height;
    Image { source: root.frozen-image; width: parent.width; height: parent.height; image-fit: fill; }
    if !root.multi-mode: RegionPreview {
        width: parent.width; height: parent.height;
        selecting: root.selecting; left: root.selection-left; top: root.selection-top;
        selection-width: root.selection-width; selection-height: root.selection-height;
    }
    if root.screenshot-mode && !root.window-mode && !root.polygon-mode && !root.combine-mode && root.help-visible: ScreenshotHelp {
        x: root.help-left; y: root.help-top; width: root.help-width; height: root.help-height; stage: 0; reuse-available: root.reuse-available;
    }
    if root.screenshot-mode && !root.window-mode && !root.polygon-mode && !root.combine-mode && root.picker-visible: ScreenshotPixelPicker {
        x:root.picker-left;y:root.picker-top;width:root.picker-width;height:root.picker-height;
        grid:root.picker-grid;coordinates:root.picker-coordinates;hex:root.picker-hex;rgb:root.picker-rgb;status:root.picker-status;
    }
    if root.screenshot-mode && !root.window-mode && !root.polygon-mode && !root.combine-mode && root.size-visible: ScreenshotSizeLabel {
        x:root.size-left; y:root.size-top; width:root.size-width; height:root.size-height; text:root.size-text;
    }
    if !root.screenshot-mode: ScreenInteractionHint {
        width: min(parent.width - 32px, Metrics.ocr-hint-max-width);
        x: max(8px,(parent.width - self.width)/2); y: 24px;
        text: @tr("Drag to select. Release to translate. Escape or right-click to cancel.");
    }
    // Measure in the existing host; first selection needs no texture-preparation HWND.
    measure-size := Text { visible:false; text:root.size-text; font-size:SizeLabelStyle.font-size; }
    measure-help := ScreenshotHelp { visible:false; stage:0; reuse-available:root.reuse-available; width:min(400px,max(1px,parent.width - 16px)); }
    measure-picker := ScreenshotPixelPicker { visible:false; }
    out property <float> measured-size-width: (measure-size.preferred-width + 2 * SizeLabelStyle.inset) / 1px;
    out property <float> measured-size-height: SizeLabelStyle.label-height / 1px;
    out property <float> measured-help-width: measure-help.natural-width / 1px;
    out property <float> measured-help-height: measure-help.preferred-height / 1px;
    out property <float> measured-picker-width: measure-picker.content-width / 1px;
    out property <float> measured-picker-height: 184;
    callback cancelled();
    if root.polygon-mode: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        commands: root.polygon-fill; fill: Colors.primary.with-alpha(0.20);
    }
    if root.polygon-mode: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        commands: root.polygon-path; stroke: Colors.primary; stroke-width: 2px;
    }
    for vertex in (root.freehand-mode ? [] : root.polygon-vertices): Rectangle {
        x: vertex.x - 3px; y: vertex.y - 3px; width: 6px; height: 6px;
        border-radius: 3px; background: Colors.primary;
    }
    for mark in root.multi-marks: Rectangle {
        x: mark.left; y: mark.top; width: mark.width; height: mark.height;
        border-width: mark.current ? 3px : 1px;
        border-color: root.combine-mode && mark.current && root.combine-remove ? Colors.error : Colors.primary;
        background: root.window-mode || (root.combine-mode && !mark.current) ? Colors.primary.with-alpha(0.16) : transparent;
        if !root.window-mode && !root.combine-mode: Rectangle {
            x: 0px; y: 0px; height: 24px; width: label.preferred-width + 12px;
            background: Colors.screen-help-background;
            label := Text { x: 6px; height: parent.height; vertical-alignment: center; color: Colors.screen-help-foreground; text: mark.label; }
        }
    }
    if root.multi-mode && root.multi-controls: Rectangle {
        x: 0px; y: 0px; height: 76px; width: min(parent.width, 660px);
        background: Colors.surface;
        VerticalLayout {
            padding: 6px; spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                if root.combine-mode: Button { text: @tr("Add selection"); checkable: true; checked: !root.combine-remove; enabled: !root.combine-busy; clicked => { root.multi-action(3); } }
                if root.combine-mode: Button { text: @tr("Subtract selection"); checkable: true; checked: root.combine-remove; enabled: !root.combine-busy; clicked => { root.multi-action(4); } }
                if !root.window-mode: Button { text: root.freehand-mode ? @tr("Redraw contour") : root.combine-mode ? @tr("Undo") : root.polygon-mode ? (root.polygon-closed ? @tr("Continue editing polygon") : @tr("Remove last vertex")) : @tr("Delete current region"); enabled: root.multi-can-delete; clicked => { root.multi-action(0); } }
                Button { text: root.freehand-mode ? @tr("Save PNG") : root.polygon-mode ? (root.polygon-closed ? @tr("Save PNG") : @tr("Close polygon")) : (root.window-mode || root.combine-mode) ? @tr("Save PNG") : root.multi-retry ? @tr("Retry") : @tr("Save all PNG"); enabled: root.multi-can-save; clicked => { root.multi-action(1); } }
                if root.mask-copy-mode: Button { text: @tr("Copy image"); enabled: root.mask-copy-enabled; clicked => { root.multi-action(5); } }
                if root.mask-copy-mode: ToolButton { kind: 24; label: @tr("Pin screenshot"); enabled: root.mask-copy-enabled; clicked => { root.multi-action(6); } }
                Button { text: root.multi-finished ? @tr("Close") : @tr("Cancel"); clicked => { root.multi-action(2); } }
            }
            Text { text: root.multi-feedback; color: Colors.foreground; overflow: elide; }
        }
    }
    if !root.multi-mode: TouchArea { mouse-cursor: crosshair; pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.cancelled(); } } }
    mode-strip := Rectangle {
        visible: root.mode-control;
        width: min(parent.width, root.mode-confirm ? 660px : 38px); height: 38px;
        x: 0px; y: 76px; background: Colors.surface; border-radius: 6px;
        if !root.mode-confirm: ToolButton {
            kind: 35; label: @tr("Screenshot mode"); enabled: !root.mode-busy;
            clicked => { mode-menu.show({ x: 0px, y: 38px }); }
        }
        mode-menu := ContextMenuArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            enabled: false;
            Menu {
                MenuItem { title: @tr("Rectangle"); checkable: true; checked: root.selection-mode == 0; activated => { root.mode-action(0); } }
                MenuItem { title: root.mode-windows-available ? @tr("Multi-window screenshot") : @tr("Multi-window screenshot") + " — " + @tr("Start a new screenshot"); enabled: root.mode-windows-available; checkable: true; checked: root.selection-mode == 1; activated => { root.mode-action(1); } }
                MenuItem { title: @tr("Polygon screenshot"); checkable: true; checked: root.selection-mode == 2; activated => { root.mode-action(2); } }
                MenuItem { title: @tr("Combine screenshot regions"); checkable: true; checked: root.selection-mode == 3; activated => { root.mode-action(3); } }
                MenuItem { title: @tr("Freehand screenshot"); checkable: true; checked: root.selection-mode == 4; activated => { root.mode-action(4); } }
            }
        }
        if root.mode-confirm: HorizontalLayout {
            padding-left: 8px; padding-right: 6px; spacing: 6px;
            Text { text: @tr("Discard the current selection?"); color: Colors.foreground; vertical-alignment: center; wrap: word-wrap; }
            Button { text: @tr("Cancel"); clicked => { root.mode-action(5); } }
            Button { text: @tr("Discard"); clicked => { root.mode-action(6); } }
        }
    }
}
