import { ScrollView, LineEdit } from "std-widgets.slint";
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { SettingsButton } from "settings-controls.slint";

export struct PresetRow { label: string, available: bool }
export component ScreenshotPresetsWindow inherits Window {
    title: @tr("Screenshot presets");
    always-on-top: true;
    background: Colors.surface;
    preferred-width: 540px;
    preferred-height: 385px;
    min-width: 430px;
    min-height: 290px;
    in property <[PresetRow]> rows;
    in property <bool> saving-region;
    in property <bool> busy;
    in property <bool> callable;
    in property <string> feedback;
    private property <bool> can-capture: root.callable && root.selected >= 0 && root.selected < root.rows.length && root.rows[root.selected].available;
    in-out property <int> selected: -1;
    in-out property <string> name;
    in-out property <bool> confirming;
    callback action(int);
    forward-focus: keys;
    keys := FocusScope {
        forward-focus: preset-name;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirming { root.confirming = false; } else { root.action(5); }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                if root.rows.length > 0 && !root.busy && !root.confirming {
                    root.selected = max(0, min(root.rows.length - 1, root.selected + (event.text == Key.UpArrow ? -1 : 1)));
                }
                return accept;
            }
            if event.text == Key.Return && !root.busy && root.saving-region && !root.confirming {
                root.action(1); return accept;
            }
            if event.text == Key.Return && !root.busy && root.can-capture && !root.confirming {
                root.action(0); return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Spacing.medium;
            spacing: Spacing.small;
            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    for row[i] in root.rows: Rectangle {
                        height: 36px;
                        background: root.selected == i ? Colors.icon-button-hover : transparent;
                        accessible-role: button;
                        accessible-label: row.label;
                        Text { x: 8px; width: parent.width - 16px; height: parent.height;
                            text: row.label; color: row.available ? Colors.foreground : Colors.secondary-foreground;
                            vertical-alignment: center; overflow: elide; }
                        TouchArea {
                            enabled: !root.busy && !root.confirming;
                            clicked => { root.selected = i; }
                            double-clicked => { root.selected = i; root.action(0); }
                        }
                    }
                }
            }
            if root.confirming: Text { text: @tr("Delete this screenshot preset?"); color: Colors.foreground; }
            preset-name := LineEdit {
                visible: !root.confirming;
                text <=> root.name;
                placeholder-text: @tr("Preset name");
                enabled: !root.busy;
                accessible-label: @tr("Preset name");
            }
            if root.feedback != "": Text { text: root.feedback; color: Colors.secondary-foreground; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Spacing.small;
                if root.confirming: SettingsButton { label: @tr("Delete"); enabled: !root.busy; clicked => { root.action(4); } }
                if root.confirming: SettingsButton { label: @tr("Cancel"); clicked => { root.confirming = false; } }
                if !root.confirming && root.saving-region: SettingsButton { label: @tr("Save region as preset"); enabled: !root.busy; clicked => { root.action(1); } }
                if !root.confirming && root.saving-region: SettingsButton { label: @tr("Update existing preset"); enabled: !root.busy && root.selected >= 0; clicked => { root.action(2); } }
                if !root.confirming && !root.saving-region: SettingsButton { label: @tr("Screenshot"); enabled: root.can-capture && !root.busy; clicked => { root.action(0); } }
                if !root.confirming && !root.saving-region: SettingsButton { label: @tr("Rename"); enabled: !root.busy && root.selected >= 0; clicked => { root.action(3); } }
                if !root.confirming && !root.saving-region: SettingsButton { label: @tr("Delete"); enabled: !root.busy && root.selected >= 0; clicked => { root.confirming = true; } }
                SettingsButton { label: @tr("Close"); clicked => { root.action(5); } }
            }
        }
    }
}
