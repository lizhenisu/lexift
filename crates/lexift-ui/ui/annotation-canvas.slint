import { SettingsButton } from "settings-controls.slint";
import { AnnotationHistory } from "annotation-hint.slint";
import { AnnotationHintTarget } from "annotation-hint.slint";
import { Colors } from "design/colors.slint";
import { Metrics } from "design/metrics.slint";
export enum AnnotationCursor { idle, drawing, text, moving, horizontal, vertical, diagonal-down, diagonal-up, corner-radius, brush }

// A transparent, live-desktop overlay. Pixel content is produced from Core objects in Rust.
export component AnnotationCanvas inherits Window {
    title: root.image-view ? @tr("Long screenshot") : "Lexift Annotation Canvas";
    no-frame: true;
    always-on-top: true;
    min-width: root.image-view ? 640px : 0px;
    min-height: root.image-view ? 320px : 0px;
    // A one-step alpha keeps the layered HWND hittable while remaining visually transparent.
    background: #00000001;
    in property <image> frame;
    in property <image> controls;
    in property <bool> image-view: false;
    out property <length> image-header-height: Metrics.image-view-header-height;
    in-out property <float> image-zoom: 1;
    in property <float> image-pixel-scale: 1;
    out property <length> image-footer-height: root.image-cropping ? 40px : 24px;
    in property <length> image-pan-x;
    in property <length> image-pan-y;
    in property <bool> image-browsing: true;
    in property <bool> image-panning: false;
    in property <bool> image-cropping: false;
    in property <AnnotationCursor> crop-cursor: AnnotationCursor.drawing;
    in property <float> content-left: 0;
    in property <float> content-top: 0;
    in property <float> content-right: root.frame.width;
    in property <float> content-bottom: root.frame.height;
    in property <float> crop-left: 0;
    in property <float> crop-top: 0;
    in property <float> crop-right: root.frame.width;
    in property <float> crop-bottom: root.frame.height;
    callback crop-action(bool);
    callback header-drag-requested();
    callback image-resize-requested();
    callback image-close-requested();
    callback fit-image();
    callback image-pointer(int, float, float);
    callback viewport-pointer(int, float, float);
    callback viewport-scroll(float, float, float, float, bool);
    callback viewport-resized();
    changed width => { if root.image-view { root.viewport-resized(); } }
    changed height => { if root.image-view { root.viewport-resized(); } }
    in property <AnnotationCursor> cursor: AnnotationCursor.drawing;
    callback pointer(int, float, float);
    callback brush-size-scrolled(float);
    callback escape-requested();
    callback undo-requested();
    callback redo-requested();
    callback history-key(int);
    callback delete-requested();
    callback finish-path-requested();
    callback backspace-requested();
    callback region-key(string, bool, bool, bool) -> bool;
    forward-focus: keys;
    public function focus-input() { keys.focus(); }
    if !root.image-view: Image { source: root.frame; width: 100%; height: 100%; image-fit: fill; }
    if root.image-view: Rectangle { width: 100%; height: 100%; background: Colors.background; }
    if root.image-view: Rectangle {
        x: 0px; y: 0px; width: 100%; height: 32px; background: Colors.surface;
        accessible-role: window-title-bar; accessible-label: @tr("Long screenshot");
        Text { x: 12px; width: parent.width - 52px; height: 100%; text: @tr("Long screenshot"); color: Colors.foreground; vertical-alignment: center; }
        TouchArea { width: parent.width - 36px; height: 100%; mouse-cursor: move;
            pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.header-drag-requested(); } }
        }
        Rectangle { x: parent.width - 32px; width: 32px; height: 32px;
            accessible-role: button; accessible-label: @tr("Close");
            background: close-area.has-hover ? Colors.icon-button-hover : transparent;
            Image { x: 8px; y: 8px; width: 16px; height: 16px; source: @image-url("assets/icons/screenshot-close.svg"); colorize: Colors.foreground; }
            close-area := TouchArea { clicked => { root.image-close-requested(); } }
        }
    }
    if root.image-view: Rectangle {
        y: root.height - root.image-footer-height; width: 100%; height: root.image-footer-height; background: Colors.surface;
        Text { x: 12px; height: 100%; text: "\{round(root.image-zoom * root.image-pixel-scale * 100)}%    \{round(root.crop-right - root.crop-left)} × \{round(root.crop-bottom - root.crop-top)} px"; color: Colors.foreground; font-size: 11px; vertical-alignment: center; }
        if root.image-cropping: HorizontalLayout {
            x: parent.width - self.preferred-width - 24px; y: 6px; height: 28px; spacing: 8px;
            SettingsButton { label:@tr("Cancel"); compact:true; height:28px; clicked=>{root.crop-action(false);} }
            SettingsButton { label:@tr("Apply"); compact:true; primary:true; height:28px; clicked=>{root.crop-action(true);} }
        }
        if !root.image-cropping: AnnotationHintTarget { width: parent.width - 20px; height: 100%;
            text: @tr("Wheel: zoom · Drag: pan · Space: edit/pan · Ctrl+0: fit image");
            hovered: status-area.has-hover; pressed: status-area.pressed;
            status-area := TouchArea { }
        }
        TouchArea { x: parent.width - 16px; width: 16px; height: 100%; mouse-cursor: nwse-resize;
            pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.image-resize-requested(); } }
        }
    }
    if root.image-view: Rectangle {
        x: 0px; y: root.image-header-height; width: root.width;
        height: max(0px, root.height - root.image-header-height - root.image-footer-height);
        clip: true; background: Colors.image-workspace;
        for row in ceil(self.height / Metrics.image-grid-spacing): Rectangle {
            y: row * Metrics.image-grid-spacing; width: parent.width; height: 1px;
            for col in ceil(parent.width / Metrics.image-grid-spacing): Rectangle {
                x: col * Metrics.image-grid-spacing; y: 0px;
                width: 1px; height: 1px; background: Colors.image-workspace-dot;
            }
        }
        Rectangle {
            x: root.image-pan-x + root.content-left * root.image-zoom * 1px;
            y: root.image-pan-y + root.content-top * root.image-zoom * 1px;
            width: (root.content-right - root.content-left) * root.image-zoom * 1px;
            height: (root.content-bottom - root.content-top) * root.image-zoom * 1px;
            clip:true;
            Image { x:-root.content-left * root.image-zoom * 1px; y:-root.content-top * root.image-zoom * 1px; width:root.frame.width * root.image-zoom * 1px; height:root.frame.height * root.image-zoom * 1px; source:root.frame; image-fit:fill; }
            if !root.image-cropping: Image { x:-root.content-left * root.image-zoom * 1px; y:-root.content-top * root.image-zoom * 1px; width:root.frame.width * root.image-zoom * 1px; height:root.frame.height * root.image-zoom * 1px; source:root.controls; image-fit:fill; }
        }
        if root.image-cropping: Rectangle {
            x:root.image-pan-x; y:root.image-pan-y;
            width:root.frame.width * root.image-zoom * 1px; height:root.frame.height * root.image-zoom * 1px;
            private property <length> l: root.crop-left * root.image-zoom * 1px;
            private property <length> t: root.crop-top * root.image-zoom * 1px;
            private property <length> r: root.crop-right * root.image-zoom * 1px;
            private property <length> b: root.crop-bottom * root.image-zoom * 1px;
            Rectangle { x:0px; y:0px; width:parent.width; height:parent.t; background:Colors.capture-mask; }
            Rectangle { x:0px; y:parent.b; width:parent.width; height:max(0px,parent.height - parent.b); background:Colors.capture-mask; }
            Rectangle { x:0px; y:parent.t; width:parent.l; height:parent.b - parent.t; background:Colors.capture-mask; }
            Rectangle { x:parent.r; y:parent.t; width:max(0px,parent.width - parent.r); height:parent.b - parent.t; background:Colors.capture-mask; }
            Rectangle { x:parent.l; y:parent.t; width:parent.r - parent.l; height:parent.b - parent.t; border-width:1px; border-color:Colors.primary; }
            for handle in [0,1,2,3,4,5,6,7]: Rectangle {
                x: (handle == 0 || handle == 6 || handle == 7 ? parent.l : handle == 2 || handle == 3 || handle == 4 ? parent.r : (parent.l+parent.r)/2) - 3px;
                y: (handle <= 2 ? parent.t : handle >= 4 && handle <= 6 ? parent.b : (parent.t+parent.b)/2) - 3px;
                width:6px; height:6px; background:Colors.surface; border-width:1px; border-color:Colors.primary;
            }
        }
        image-input := TouchArea {
            mouse-cursor: root.image-cropping ? (root.crop-cursor == AnnotationCursor.moving ? move : root.crop-cursor == AnnotationCursor.horizontal ? ew-resize : root.crop-cursor == AnnotationCursor.vertical ? ns-resize : root.crop-cursor == AnnotationCursor.diagonal-down ? nwse-resize : root.crop-cursor == AnnotationCursor.diagonal-up ? nesw-resize : crosshair) : root.image-browsing ? (root.image-panning ? grabbing : grab)
                : root.cursor == AnnotationCursor.text ? text : root.cursor == AnnotationCursor.idle ? default : crosshair;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    keys.focus(); root.viewport-pointer(0, self.mouse-x / 1px, self.mouse-y / 1px);
                }
                if event.kind == PointerEventKind.move { root.viewport-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px); }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.viewport-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px); }
                if event.kind == PointerEventKind.cancel { root.viewport-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px); }
            }
            changed has-hover => { if !self.has-hover { root.viewport-pointer(4, self.mouse-x / 1px, self.mouse-y / 1px); } }
            scroll-event(event) => {
                root.viewport-scroll(self.mouse-x / 1px, self.mouse-y / 1px, event.delta-x / 1px, event.delta-y / 1px,
                    event.modifiers.control || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta);
                return accept;
            }
        }
    }
    TouchArea {
        visible: !root.image-view;
        width: 100%;
        height: 100%;
        mouse-cursor: root.cursor == AnnotationCursor.moving ? move
            : root.cursor == AnnotationCursor.text ? text
            : root.cursor == AnnotationCursor.horizontal ? ew-resize
            : root.cursor == AnnotationCursor.vertical ? ns-resize
            : root.cursor == AnnotationCursor.diagonal-down ? nwse-resize
            : root.cursor == AnnotationCursor.diagonal-up ? nesw-resize
            : root.cursor == AnnotationCursor.drawing ? crosshair : default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.pointer(0, self.mouse-x / 1px, self.mouse-y / 1px); }
            if event.kind == PointerEventKind.move { root.pointer(1, self.mouse-x / 1px, self.mouse-y / 1px); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.pointer(2, self.mouse-x / 1px, self.mouse-y / 1px); }
            if event.kind == PointerEventKind.cancel { root.pointer(3, self.mouse-x / 1px, self.mouse-y / 1px); }
        }
        changed has-hover => { if !self.has-hover { root.pointer(4, self.mouse-x / 1px, self.mouse-y / 1px); } }
        scroll-event(event) => {
            if root.cursor == AnnotationCursor.brush {
                root.brush-size-scrolled(event.delta-y / 1px);
                return accept;
            }
            return reject;
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.escape-requested(); return accept; }
            if event.text == Key.Delete { root.delete-requested(); return accept; }
            if event.text == Key.Return { root.finish-path-requested(); return accept; }
            if event.text == Key.Backspace { root.backspace-requested(); return accept; }
            if AnnotationHistory.action(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) == 2 { root.history-key(2); return accept; }
            if AnnotationHistory.action(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) == 1 { root.history-key(1); return accept; }
            if !event.modifiers.alt && !event.modifiers.meta && root.region-key(event.text, true, event.modifiers.control, event.modifiers.shift) { return accept; }
            return reject;
        }
        key-released(event) => {
            if root.region-key(event.text, false, event.modifiers.control, event.modifiers.shift) { return accept; }
            return reject;
        }

    }
}
