import { ResizeEdges } from "design/resize-edges.slint";
import { CopyFeedbackIcon } from "design/copy-feedback.slint";
import { ScrollView } from "std-widgets.slint";
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";
import { Metrics } from "design/metrics.slint";
import { WindowHeaderButton, WindowHeaderMark } from "design/window-header.slint";

export enum PopupCornerMode { native-dwm, opaque-square, slint-rounded }

component IconButton inherits Rectangle {
    in property <bool> copy-action: false;
    in property <bool> copied: false;
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: AccessibleRole.button; accessible-label: root.copy-action ? @tr("Copy") : ""; accessible-enabled: root.enabled;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: root.active ? Colors.primary-container
        : button.pressed ? Colors.icon-button-pressed
        : button.has-hover ? Colors.icon-button-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    if !root.copy-action: Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        colorize: root.active ? Colors.primary : Colors.secondary-foreground;
    }
    if root.copy-action: CopyFeedbackIcon { x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2; width: root.icon-size; height: root.icon-size; copied: root.copied; }
    button := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: !root.enabled ? Colors.outline
        : action.pressed ? Colors.primary.darker(12%)
        : action.has-hover ? Colors.primary.darker(6%) : Colors.primary;
    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        colorize: Colors.on-primary;
    }
    action := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component TranslationPopup inherits Window {
    title: @tr("Lexift Translation");
    icon: AppAssets.app-icon;
    no-frame: true;
    always-on-top: true;
    // Keep the native surface opaque so Windows can resize and present the
    // Popup consistently; the full-window card supplies the rounded visual edge.
    background: Colors.surface;
    preferred-width: root.popup-width;
    preferred-height: root.popup-height;
    min-width: 340px;
    min-height: root.resize-min-height;
    max-width: root.max-popup-width;
    max-height: root.max-popup-height;

    in property <int> session-id: 0;
    in-out property <string> mapped-source-text;
    in property <string> copy-source-value;
    in property <string> copy-result-value;
    in property <bool> copy-source-pending;
    in property <bool> copy-result-pending;
    in property <string> copy-source-completed;
    in property <string> copy-result-completed;
    callback copy-feedback-expired(bool, string);
    in-out property <length> popup-width: 420px;
    in-out property <length> popup-height: 390px;
    in-out property <PopupCornerMode> corner-mode: PopupCornerMode.slint-rounded;
    in-out property <length> source-card-height: 116px;
    in-out property <length> resize-min-height: 336px;
    in-out property <length> resize-min-source-height: 86px;
    in-out property <length> max-popup-width: 1920px;
    in-out property <length> max-popup-height: 1080px;
    out property <color> resize-fallback-color: Colors.surface;
    callback theme-background-changed();
    changed resize-fallback-color => { root.theme-background-changed(); }
    // Vertical budget the source card must leave for the language row and the
    // result card. Measured from the live layout, never from a frozen size.
    out property <length> resize-layout-reserve-height:
        root.height - content.height + language-bar.height + content.spacing + content.spacing + result-card.min-height;
    // Hard ceiling for the source card. Windows can shrink the window without the UI seeing an
    // event first (dragging the title row out of a top-edge snap, or a cross-DPI move), because its
    // modal move loop blocks the event loop; the bridge can only re-clamp the saved card height
    // once the mouse is released. Capping the rendered height here keeps the language row and the
    // result card on screen during that drag.
    out property <length> resize-max-source-height:
        max(root.height - root.resize-layout-reserve-height, root.resize-min-source-height);
    in-out property <bool> resize-active: false;
    in-out property <bool> resize-changes-height: false;
    in-out property <length> resize-fixed-remainder: 0px;
    in property <string> phase-text: @tr("Idle");
    in-out property <string> source-text: "";
    in property <string> translated-text: "";
    in property <string> error-text: "";
    in property <string> target-label: "简体中文";
    in property <int> target-index: 0;
    in property <string> source-label: @tr("Auto detect");
    in property <string> source-language: "";
    in property <int> source-index: 0;
    in property <string> detected-language: "";
    in property <bool> busy: false;
    // Measure against the requested width, including while the native window is hidden.
    out property <length> measured-source-height: source-measure.preferred-height;
    out property <length> measured-result-height: result-measure.preferred-height;
    out property <length> result-content-height: result-scroll.content-height;
    out property <length> result-viewport-height: result-scroll.visible-height;
    in-out property <length> result-scroll-y: 0px;
    in-out property <int> cached-surface-width: 0;
    in-out property <int> cached-surface-height: 0;
    in-out property <float> cached-surface-scale: 0;
    callback layout-requested();
    changed measured-source-height => { root.layout-requested(); }
    changed measured-result-height => { root.layout-requested(); }
    changed popup-width => { root.layout-requested(); }
    changed max-popup-height => { root.layout-requested(); }
    source-measure := Text {
        visible: false;
        width: max(1px, root.popup-width - 68px);
        text: root.source-text;
        font-size: Typography.body-size;
        wrap: word-wrap;
    }
    result-measure := Text {
        visible: false;
        width: max(1px, root.popup-width - 68px);
        text: root.error-text != "" ? root.error-text : root.translated-text == "" ? @tr("Translation will appear here") : root.translated-text;
        font-size: Typography.body-size;
        wrap: word-wrap;
    }
    in property <bool> pinned: false;
    in property <bool> speaking-source: false;
    in property <bool> speaking-translation: false;
    in property <string> feedback-text: "";
    in property <bool> feedback-error: false;
    in property <[string]> source-language-options: [@tr("Auto detect"), "English", "中文", "日本語", "한국어", "Deutsch", "Français", "Español", "Italiano", "Português"];
    in property <[string]> target-language-options: ["简体中文", "繁體中文", "English (US)", "English (UK)", "日本語", "한국어", "Deutsch", "Français", "Español", "Italiano", "Português (Portugal)", "Português (Brasil)"];
    in-out property <bool> source-menu-open: false;
    in-out property <bool> target-menu-open: false;
    out property <length> source-menu-anchor-x: card.x + content.x + language-bar.x + source-segment.x;
    out property <length> source-menu-anchor-y: card.y + content.y + language-bar.y;
    out property <length> source-menu-anchor-width: source-segment.width;
    out property <length> source-menu-anchor-height: language-bar.height;
    out property <length> target-menu-anchor-x: card.x + content.x + language-bar.x + target-segment.x;
    out property <length> target-menu-anchor-y: card.y + content.y + language-bar.y;
    out property <length> target-menu-anchor-width: target-segment.width;
    out property <length> target-menu-anchor-height: language-bar.height;

    callback interaction-requested();
    callback drag-requested();
    callback resize-requested(int);
    callback translate-requested(string, int, int);
    callback source-menu-requested();
    callback target-menu-requested();
    callback language-menu-dismiss-requested();
    callback pin-requested(bool);
    callback close-requested();
    callback copy-requested(bool);
    callback speech-requested(bool);
    callback feedback-dismiss-requested();

    feedback-timer := Timer {
        interval: 2500ms;
        running: root.feedback-text != "";
        triggered => { root.feedback-dismiss-requested(); }
    }

    card := Rectangle {
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: root.corner-mode == PopupCornerMode.slint-rounded
            ? Metrics.popup-shell-radius : 0px;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.popup-outline;
        clip: true;

        top := Rectangle {
            x: 20px; y: 0px; width: parent.width - 40px; height: Metrics.auxiliary-header-height;
            background: transparent;
            z: 30;
            WindowHeaderMark {
                x: 0px; y: (parent.height - self.height) / 2;
                icon: AppAssets.icon-translate;
            }
            Text {
                x: 40px; width: 140px; height: parent.height;
                text: "Lexift";
                color: Colors.foreground;
                font-size: Typography.compact-size;
                font-weight: 600;
                vertical-alignment: center;
            }
            drag := TouchArea {
                // Leave the top resize strip and the corner handles clear, but
                // make the remaining title row an easy, continuous drag target.
                x: 0px; y: 12px; width: parent.width - 80px; height: parent.height - 12px;
                z: 1;
                clicked => { root.interaction-requested(); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.target-menu-open = false;
                        root.source-menu-open = false;
                        root.interaction-requested();
                        root.drag-requested();
                    }
                }
            }
            WindowHeaderButton {
                x: parent.width - 72px; y: (parent.height - self.height) / 2;
                z: 2;
                icon: @image-url("assets/icons/header-pin.svg");
                label: root.pinned ? @tr("Unpin") : @tr("Pin");
                active: root.pinned;
                clicked => { root.interaction-requested(); root.pin-requested(!root.pinned); }
            }
            WindowHeaderButton {
                x: parent.width - 32px; y: (parent.height - self.height) / 2;
                z: 2;
                icon: @image-url("assets/icons/header-close.svg");
                label: @tr("Close");
                clicked => { root.source-menu-open = false; root.target-menu-open = false; root.close-requested(); }
            }
        }

        content := VerticalLayout {
            x: 20px; y: 52px; width: parent.width - 40px; height: parent.height - 72px;
            spacing: 10px;

            source-card := Rectangle {
                // While a native resize is in flight the card follows the window so the
                // exposed area stays filled; otherwise the saved card height wins. The card keeps
                // its own minimum during a shrink so it never collapses while the result card takes
                // the rest of the available space, and it never grows past the layout budget so a
                // window shrink the UI has not processed yet cannot push the rows below out of view.
                height: min(
                    root.resize-active && root.resize-changes-height
                        ? max(root.resize-min-source-height, root.height - root.resize-fixed-remainder)
                        : root.source-card-height,
                    root.resize-max-source-height
                );
                border-radius: 16px;
                background: Colors.popup-source;
                border-width: 1px;
                border-color: source-input.has-focus ? Colors.primary : transparent;
                source-scroll := ScrollView {
                    x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 58px;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, source-input.preferred-height);
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    mouse-drag-pan-enabled: false;

                    source-input := TextInput {
                        width: source-scroll.visible-width;
                        height: max(source-scroll.visible-height, self.preferred-height);
                        text <=> root.source-text;
                        color: Colors.foreground;
                        font-size: Typography.body-size;
                        single-line: false;
                        wrap: word-wrap;
                        vertical-alignment: TextVerticalAlignment.top;
                        selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground;
                        page-height: source-scroll.visible-height;
                        key-pressed(event) => {
                            root.interaction-requested();
                            if event.text == Key.Escape {
                                root.language-menu-dismiss-requested();
                                return accept;
                            }
                            if event.modifiers.control && event.text == Key.Return {
                                root.translate-requested(root.source-text, root.source-index, root.target-index);
                                return accept;
                            }
                            return reject;
                        }
                        cursor-position-changed(position) => {
                            if position.y + source-scroll.content-y < 0px {
                                source-scroll.content-y = min(0px, max(
                                    source-scroll.visible-height - self.height,
                                    -position.y
                                ));
                            } else if position.y + source-scroll.content-y > source-scroll.visible-height - 20px {
                                source-scroll.content-y = min(0px, max(
                                    source-scroll.visible-height - self.height,
                                    source-scroll.visible-height - position.y - 20px
                                ));
                            }
                        }
                        changed has-focus => { if self.has-focus { root.interaction-requested(); } }
                    }
                }
                AppVerticalScrollBar {
                    x: parent.width - 14px;
                    y: source-scroll.y;
                    height: source-scroll.height;
                    viewport-height: source-scroll.visible-height;
                    content-height: source-scroll.content-height;
                    content-y <=> source-scroll.content-y;
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 42px; width: parent.width - 16px; height: 36px;
                    spacing: 2px;
                    IconButton { copy-action: true; copied: root.copy-source-completed != "" && root.source-text == root.copy-source-value; enabled: !root.copy-source-pending; icon-size: 18px; clicked => { root.interaction-requested(); root.copy-requested(true); } }
                    IconButton { icon: AppAssets.icon-volume; icon-size: 18px; active: root.speaking-source; clicked => { root.interaction-requested(); root.speech-requested(true); } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        width: 38px;
                        height: 34px;
                        icon: AppAssets.icon-translate;
                        icon-size: 20px;
                        enabled: root.source-text != "" && !root.busy;
                        clicked => { root.interaction-requested(); root.translate-requested(root.source-text, root.source-index, root.target-index); }
                    }
                }
            }

            language-bar := Rectangle {
                height: 44px;
                border-radius: 12px;
                background: transparent;
                source-segment := Rectangle {
                    x: 0px; width: (parent.width - 44px) / 2; height: parent.height;
                    border-radius: 10px;
                    background: source-touch.pressed ? Colors.icon-button-pressed
                        : source-touch.has-hover || root.source-menu-open ? Colors.icon-button-hover : transparent;
                    source-touch := TouchArea {
                        clicked => { root.interaction-requested(); root.source-menu-requested(); }
                    }
                    Text {
                        x: 14px; width: parent.width - 46px; height: parent.height;
                        text: root.source-label;
                        color: Colors.foreground;
                        font-size: Typography.compact-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        x: parent.width - 28px; y: (parent.height - 16px) / 2;
                        width: 16px; height: 16px;
                        source: root.source-menu-open ? AppAssets.icon-expand-less : AppAssets.icon-expand-more;
                        image-fit: contain;
                        colorize: Colors.secondary-foreground;
                    }
                }
                Image {
                    x: source-segment.width + 11px;
                    y: (parent.height - 22px) / 2;
                    width: 22px;
                    height: 22px;
                    source: AppAssets.icon-swap-horizontal;
                    image-fit: contain;
                    colorize: Colors.secondary-foreground;
                }
                target-segment := Rectangle {
                    x: source-segment.width + 44px; width: source-segment.width; height: parent.height;
                    border-radius: 10px;
                    background: target-touch.pressed ? Colors.icon-button-pressed
                        : target-touch.has-hover || root.target-menu-open ? Colors.icon-button-hover : transparent;
                    target-touch := TouchArea {
                        clicked => { root.interaction-requested(); root.target-menu-requested(); }
                    }
                    Text {
                        x: 12px; width: parent.width - 46px; height: parent.height;
                        text: root.target-label;
                        color: Colors.foreground;
                        font-size: Typography.compact-size;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        x: parent.width - 28px; y: (parent.height - 16px) / 2;
                        width: 16px; height: 16px;
                        source: root.target-menu-open ? AppAssets.icon-expand-less : AppAssets.icon-expand-more;
                        image-fit: contain;
                        colorize: Colors.secondary-foreground;
                    }
                }
            }

            result-card := Rectangle {
                vertical-stretch: 1;
                min-height: 104px;
                border-radius: 16px;
                background: Colors.popup-result;
                border-width: 1px;
                border-color: Colors.popup-result-edge;
                Text {
                    x: 14px; y: 8px; width: parent.width - 28px; height: 24px;
                    text: root.busy ? root.phase-text : root.error-text != "" ? @tr("Translation failed") : @tr("Translation");
                    color: root.error-text != "" ? Colors.error : Colors.primary;
                    font-size: 13px;
                    font-weight: 600;
                }
                result-scroll := ScrollView {
                    x: 14px; y: 32px; width: parent.width - 28px; height: parent.height - 74px;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, result-text.preferred-height);
                    content-y <=> root.result-scroll-y;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    result-text := Text {
                        x: 0px; y: 0px;
                        width: result-scroll.visible-width;
                        height: max(result-scroll.visible-height, self.preferred-height);
                        vertical-alignment: TextVerticalAlignment.top;
                        text: root.error-text != "" ? root.error-text : root.translated-text == "" ? @tr("Translation will appear here") : root.translated-text;
                        color: root.error-text != "" ? Colors.error : root.translated-text == "" ? Colors.secondary-foreground : Colors.foreground;
                        font-size: Typography.body-size;
                        wrap: word-wrap;
                    }
                }
                AppVerticalScrollBar {
                    x: parent.width - 14px;
                    y: result-scroll.y;
                    height: result-scroll.height;
                    viewport-height: result-scroll.visible-height;
                    content-height: result-scroll.content-height;
                    content-y <=> result-scroll.content-y;
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 40px; width: parent.width - 16px; height: 34px;
                    spacing: 2px;
                    IconButton { copy-action: true; copied: root.copy-result-completed != "" && root.translated-text == root.copy-result-value; icon-size: 18px; enabled: root.translated-text != "" && !root.busy && root.error-text == "" && !root.copy-result-pending; clicked => { root.interaction-requested(); root.copy-requested(false); } }
                    IconButton { icon: AppAssets.icon-volume; icon-size: 18px; active: root.speaking-translation; enabled: root.translated-text != "" && !root.busy && root.error-text == ""; clicked => { root.interaction-requested(); root.speech-requested(false); } }
                    if root.error-text != "": IconButton { icon: AppAssets.icon-refresh; clicked => { root.translate-requested(root.source-text, root.source-index, root.target-index); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        ResizeEdges { width: parent.width; height: parent.height; z: 20; resize-requested(edge) => { root.resize-requested(edge); } }

        if root.feedback-text != "": Rectangle {
            x: (parent.width - min(280px, feedback-label.preferred-width + 28px)) / 2;
            y: parent.height - 60px;
            width: min(280px, feedback-label.preferred-width + 28px);
            height: 38px;
            z: 30;
            border-radius: 12px;
            background: root.feedback-error ? Colors.error-container : Colors.success-container;
            border-width: 1px;
            border-color: root.feedback-error ? Colors.error : Colors.success;
            feedback-label := Text {
                text: root.feedback-text;
                color: root.feedback-error ? Colors.error : Colors.success;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component PopupLanguageMenuWindow inherits Window {
    title: @tr("Lexift Languages");
    icon: AppAssets.app-icon;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.menu-width;
    height: root.menu-height;

    in property <int> selected-index: 0;
    in property <[string]> language-options: [];
    in-out property <length> menu-width: 196px;
    in-out property <length> menu-height: 400px;
    in-out property <length> menu-scroll-y: 0px;
    private property <length> content-inset: 6px;
    callback language-selected(int);
    callback dismiss-requested();

    changed selected-index => {
        root.menu-scroll-y = round(min(0px, max(
            root.menu-height - 2px - root.content-inset * 2 - root.language-options.length * 40px,
            (root.menu-height - 2px - root.content-inset * 2) / 2 - (root.selected-index + 0.5) * 40px
        )) / 4px) * 4px;
    }

    surface := Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Colors.outline;
        background: Colors.surface;
        clip: true;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000024;

        menu-scroll := ScrollView {
            // Slint's rectangular viewport clip does not mask rounded parent
            // corners. Keep every scrolled row inside the shell's curved edge.
            x: root.content-inset; y: root.content-inset;
            width: parent.width - root.content-inset - 12px;
            height: parent.height - root.content-inset * 2;
            content-height: root.language-options.length * 40px;
            content-y <=> root.menu-scroll-y;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            scrolled => { root.menu-scroll-y = round(root.menu-scroll-y / 4px) * 4px; }
            for option[index] in root.language-options: Rectangle {
                y: index * 40px;
                width: menu-scroll.visible-width;
                height: 40px;
                border-radius: 6px;
                background: index == root.selected-index ? Colors.primary-container
                    : row.pressed ? Colors.icon-button-pressed
                    : row.has-hover ? Colors.background : Colors.surface;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: option;
                    color: index == root.selected-index ? Colors.primary : Colors.foreground;
                    font-size: Typography.menu-size;
                    font-weight: Typography.menu-weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
                row := TouchArea { clicked => { root.language-selected(index); } }
            }
        }
        AppVerticalScrollBar {
            x: parent.width - 12px;
            y: root.content-inset;
            height: parent.height - root.content-inset * 2;
            viewport-height: menu-scroll.visible-height;
            content-height: menu-scroll.content-height;
            content-y <=> menu-scroll.content-y;
        }
    }
}
