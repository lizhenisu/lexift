import { ScrollView } from "std-widgets.slint";
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: root.active ? Colors.primary-container
        : button.pressed ? Colors.icon-button-pressed
        : button.has-hover ? Colors.icon-button-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    Image {
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        source: root.icon;
        image-fit: contain;
        colorize: root.active ? Colors.primary : Colors.foreground;
    }
    button := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: root.enabled ? Colors.primary : Colors.outline;
    Image {
        x: (parent.width - 22px) / 2;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        source: root.icon;
        image-fit: contain;
        colorize: Colors.surface;
    }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component TranslationPopup inherits Window {
    title: "Lexift Translation";
    icon: AppAssets.app-icon;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 420px;
    height: root.popup-height;

    in property <int> session-id: 0;
    in property <length> popup-height: 390px;
    in property <length> source-card-height: 116px;
    in property <string> phase-text: "Idle";
    in-out property <string> source-text: "";
    in property <string> translated-text: "";
    in property <string> error-text: "";
    in property <string> target-label: "简体中文";
    in property <int> target-index: 0;
    in property <string> detected-label: "Auto detect";
    in property <string> detected-language: "";
    in property <bool> busy: false;
    in property <bool> pinned: false;
    in property <bool> speaking-source: false;
    in property <bool> speaking-translation: false;
    in property <string> feedback-text: "";
    in property <bool> feedback-error: false;
    in property <[string]> language-options: ["简体中文", "繁體中文", "English (US)", "English (UK)", "日本語", "한국어", "Deutsch", "Français", "Español", "Italiano", "Português (Portugal)", "Português (Brasil)"];
    in-out property <bool> target-menu-open: false;
    in-out property <length> target-menu-scroll-y: 0px;
    private property <length> menu-anchor-top: 44px + language-bar.y;
    private property <length> menu-space-below: card.height - root.menu-anchor-top - language-bar.height - 4px;
    private property <length> menu-space-above: root.menu-anchor-top - 44px;
    private property <length> menu-height: min(250px, max(root.menu-space-below, root.menu-space-above));
    private property <bool> menu-opens-below: root.menu-space-below >= root.menu-space-above;

    callback interaction-requested();
    callback drag-requested();
    callback translate-requested(string, int);
    callback target-language-selected(int);
    callback pin-requested(bool);
    callback close-requested();
    callback copy-requested(bool);
    callback speech-requested(bool);
    callback feedback-dismiss-requested();

    changed target-menu-open => {
        if root.target-menu-open {
            root.target-menu-scroll-y = max(0px, min(
                root.target-index * 40px - root.menu-height / 2 + 20px,
                root.language-options.length * 40px - root.menu-height
            ));
        }
    }

    feedback-timer := Timer {
        interval: 2500ms;
        running: root.feedback-text != "";
        triggered => { root.feedback-dismiss-requested(); }
    }

    card := Rectangle {
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-radius: 16px;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.outline;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000029;
        clip: true;

        top := Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 44px;
            background: Colors.surface;
            Text {
                x: Spacing.medium; width: 180px; height: parent.height;
                text: "Lexift";
                color: Colors.foreground;
                font-size: Typography.body-size;
                font-weight: 700;
                vertical-alignment: center;
            }
            drag := TouchArea {
                x: 0px; y: 0px; width: parent.width - 88px; height: parent.height;
                clicked => { root.interaction-requested(); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.target-menu-open = false;
                        root.interaction-requested();
                        root.drag-requested();
                    }
                }
            }
            IconButton {
                x: parent.width - 82px; y: 5px;
                icon: AppAssets.icon-pin;
                active: root.pinned;
                clicked => { root.interaction-requested(); root.pin-requested(!root.pinned); }
            }
            IconButton {
                x: parent.width - 42px; y: 5px;
                icon: AppAssets.icon-close;
                clicked => { root.target-menu-open = false; root.close-requested(); }
            }
        }

        content := VerticalLayout {
            x: 12px; y: 44px; width: parent.width - 24px; height: parent.height - 56px;
            spacing: 10px;

            source-card := Rectangle {
                height: root.source-card-height;
                border-radius: 12px;
                background: Colors.background;
                border-width: source-input.has-focus ? 2px : 0px;
                border-color: Colors.primary;
                source-input := TextInput {
                    x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 58px;
                    text <=> root.source-text;
                    color: Colors.foreground;
                    font-size: Typography.body-size;
                    single-line: false;
                    wrap: word-wrap;
                    vertical-alignment: TextVerticalAlignment.top;
                    selection-background-color: Colors.primary-container;
                    key-pressed(event) => {
                        root.interaction-requested();
                        if event.text == Key.Escape {
                            root.target-menu-open = false;
                            return accept;
                        }
                        if event.modifiers.control && event.text == Key.Return {
                            root.translate-requested(root.source-text, root.target-index);
                            return accept;
                        }
                        return reject;
                    }
                    changed has-focus => { if self.has-focus { root.interaction-requested(); } }
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 42px; width: parent.width - 16px; height: 36px;
                    spacing: 2px;
                    IconButton { icon: AppAssets.icon-copy; clicked => { root.interaction-requested(); root.copy-requested(true); } }
                    IconButton { icon: AppAssets.icon-volume; active: root.speaking-source; clicked => { root.interaction-requested(); root.speech-requested(true); } }
                    Text {
                        text: root.detected-label;
                        color: Colors.success;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        width: 42px;
                        icon: AppAssets.icon-translate;
                        enabled: root.source-text != "" && !root.busy;
                        clicked => { root.interaction-requested(); root.translate-requested(root.source-text, root.target-index); }
                    }
                }
            }

            language-bar := Rectangle {
                height: 48px;
                border-radius: 12px;
                background: Colors.background;
                Text {
                    x: 14px; width: 126px; height: parent.height;
                    text: "Auto detect";
                    color: Colors.foreground;
                    font-size: Typography.body-size;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Image {
                    x: 148px; width: 30px; height: parent.height;
                    source: AppAssets.icon-swap-horizontal;
                    image-fit: contain;
                    colorize: Colors.secondary-foreground;
                }
                target-touch := TouchArea {
                    x: 184px; width: parent.width - 184px; height: parent.height;
                    clicked => { root.interaction-requested(); root.target-menu-open = !root.target-menu-open; }
                }
                Text {
                    x: 194px; width: parent.width - 226px; height: parent.height;
                    text: root.target-label;
                    color: Colors.foreground;
                    font-size: Typography.body-size;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Image {
                    x: parent.width - 26px; y: (parent.height - 18px) / 2;
                    width: 18px; height: 18px;
                    source: root.target-menu-open ? AppAssets.icon-expand-less : AppAssets.icon-expand-more;
                    image-fit: contain;
                    colorize: Colors.secondary-foreground;
                }
            }

            result-card := Rectangle {
                vertical-stretch: 1;
                min-height: 104px;
                border-radius: 12px;
                background: Colors.background;
                Text {
                    x: 14px; y: 8px; width: parent.width - 28px; height: 24px;
                    text: root.busy ? "Translating…" : root.error-text != "" ? "Translation failed" : "Translation";
                    color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
                    font-size: 13px;
                    font-weight: 600;
                }
                result-scroll := ScrollView {
                    x: 14px; y: 32px; width: parent.width - 28px; height: parent.height - 74px;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    Text {
                        width: result-scroll.visible-width;
                        text: root.error-text != "" ? root.error-text : root.translated-text == "" ? "Translation will appear here" : root.translated-text;
                        color: root.error-text != "" ? Colors.error : root.translated-text == "" ? Colors.secondary-foreground : Colors.foreground;
                        font-size: Typography.body-size;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 40px; width: parent.width - 16px; height: 34px;
                    spacing: 2px;
                    IconButton { icon: AppAssets.icon-copy; enabled: root.translated-text != ""; clicked => { root.interaction-requested(); root.copy-requested(false); } }
                    IconButton { icon: AppAssets.icon-volume; active: root.speaking-translation; enabled: root.translated-text != ""; clicked => { root.interaction-requested(); root.speech-requested(false); } }
                    if root.error-text != "": IconButton { icon: AppAssets.icon-refresh; clicked => { root.translate-requested(root.source-text, root.target-index); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        if root.target-menu-open: TouchArea {
            x: 0px; y: 44px; width: parent.width; height: parent.height - 44px;
            z: 19;
            clicked => { root.target-menu-open = false; }
        }

        if root.target-menu-open: Rectangle {
            x: 196px;
            y: root.menu-opens-below
                ? root.menu-anchor-top + language-bar.height + 4px
                : root.menu-anchor-top - root.menu-height;
            width: parent.width - 208px;
            height: min(root.menu-height, root.language-options.length * 40px);
            z: 20;
            border-radius: 10px;
            border-width: 1px;
            border-color: Colors.outline;
            background: Colors.surface;
            clip: true;
            menu-scroll := ScrollView {
                width: parent.width; height: parent.height;
                viewport-height: root.language-options.length * 40px;
                viewport-y <=> root.target-menu-scroll-y;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                for option[index] in root.language-options: Rectangle {
                    y: index * 40px; width: menu-scroll.visible-width; height: 40px;
                    background: index == root.target-index ? Colors.primary-container : row.pressed ? Colors.icon-button-pressed : row.has-hover ? Colors.background : Colors.surface;
                    Text { x: 12px; width: parent.width - 24px; text: option; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                    row := TouchArea { clicked => { root.target-menu-open = false; root.target-language-selected(index); } }
                }
            }
        }

        if root.feedback-text != "": Rectangle {
            x: (parent.width - min(280px, feedback-label.preferred-width + 28px)) / 2;
            y: parent.height - 52px;
            width: min(280px, feedback-label.preferred-width + 28px);
            height: 38px;
            z: 30;
            border-radius: 12px;
            background: root.feedback-error ? #fce8e6 : #e6f4ea;
            border-width: 1px;
            border-color: root.feedback-error ? Colors.error : Colors.success;
            feedback-label := Text {
                text: root.feedback-text;
                color: root.feedback-error ? Colors.error : Colors.success;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
