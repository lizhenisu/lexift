import { ScrollView } from "std-widgets.slint";
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: root.active ? Colors.primary-container
        : button.pressed ? Colors.icon-button-pressed
        : button.has-hover ? Colors.icon-button-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        colorize: root.active ? Colors.primary : Colors.foreground;
    }
    button := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: root.enabled ? Colors.primary : Colors.outline;
    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        image-fit: contain;
        colorize: Colors.surface;
    }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component TranslationPopup inherits Window {
    title: "Lexift Translation";
    icon: AppAssets.app-icon;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: root.popup-width;
    preferred-height: root.popup-height;
    min-width: 340px;
    min-height: root.resize-min-height;
    max-width: root.max-popup-width;
    max-height: root.max-popup-height;

    in property <int> session-id: 0;
    in-out property <length> popup-width: 420px;
    in-out property <length> popup-height: 390px;
    in-out property <length> source-card-height: 116px;
    in-out property <length> resize-min-height: 336px;
    in-out property <length> max-popup-width: 1920px;
    in-out property <length> max-popup-height: 1080px;
    // Exposed to the bridge only so a hidden/reused window cannot retain a
    // stale resize affordance from its previous session.
    in-out property <int> resize-hover: -1;
    in property <string> phase-text: "Idle";
    in-out property <string> source-text: "";
    in property <string> translated-text: "";
    in property <string> error-text: "";
    in property <string> target-label: "简体中文";
    in property <int> target-index: 0;
    in property <string> source-label: "Auto detect";
    in property <string> source-language: "";
    in property <int> source-index: 0;
    in property <string> detected-language: "";
    in property <bool> busy: false;
    in property <bool> pinned: false;
    in property <bool> speaking-source: false;
    in property <bool> speaking-translation: false;
    in property <string> feedback-text: "";
    in property <bool> feedback-error: false;
    in property <[string]> source-language-options: ["Auto detect", "English", "中文", "日本語", "한국어", "Deutsch", "Français", "Español", "Italiano", "Português"];
    in property <[string]> target-language-options: ["简体中文", "繁體中文", "English (US)", "English (UK)", "日本語", "한국어", "Deutsch", "Français", "Español", "Italiano", "Português (Portugal)", "Português (Brasil)"];
    in-out property <bool> source-menu-open: false;
    in-out property <bool> target-menu-open: false;
    out property <length> source-menu-anchor-x: card.x + content.x + language-bar.x + source-segment.x;
    out property <length> source-menu-anchor-y: card.y + content.y + language-bar.y;
    out property <length> source-menu-anchor-width: source-segment.width;
    out property <length> source-menu-anchor-height: language-bar.height;
    out property <length> target-menu-anchor-x: card.x + content.x + language-bar.x + target-segment.x;
    out property <length> target-menu-anchor-y: card.y + content.y + language-bar.y;
    out property <length> target-menu-anchor-width: target-segment.width;
    out property <length> target-menu-anchor-height: language-bar.height;

    callback interaction-requested();
    callback drag-requested();
    callback resize-requested(int);
    callback translate-requested(string, int, int);
    callback source-menu-requested();
    callback target-menu-requested();
    callback language-menu-dismiss-requested();
    callback pin-requested(bool);
    callback close-requested();
    callback copy-requested(bool);
    callback speech-requested(bool);
    callback feedback-dismiss-requested();

    feedback-timer := Timer {
        interval: 2500ms;
        running: root.feedback-text != "";
        triggered => { root.feedback-dismiss-requested(); }
    }

    card := Rectangle {
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-radius: 16px;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.outline;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000029;
        clip: true;

        top := Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 44px;
            background: Colors.surface;
            Text {
                x: Spacing.medium; width: 180px; height: parent.height;
                text: "Lexift";
                color: Colors.foreground;
                font-size: Typography.body-size;
                font-weight: 700;
                vertical-alignment: center;
            }
            drag := TouchArea {
                x: 0px; y: 0px; width: parent.width - 88px; height: parent.height;
                clicked => { root.interaction-requested(); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.target-menu-open = false;
                        root.source-menu-open = false;
                        root.interaction-requested();
                        root.drag-requested();
                    }
                }
            }
            IconButton {
                x: parent.width - 82px; y: 5px;
                icon: AppAssets.icon-pin;
                icon-size: 18px;
                active: root.pinned;
                clicked => { root.interaction-requested(); root.pin-requested(!root.pinned); }
            }
            IconButton {
                x: parent.width - 42px; y: 5px;
                icon: AppAssets.icon-close;
                clicked => { root.source-menu-open = false; root.target-menu-open = false; root.close-requested(); }
            }
        }

        content := VerticalLayout {
            x: 12px; y: 44px; width: parent.width - 24px; height: parent.height - 56px;
            spacing: 10px;

            source-card := Rectangle {
                height: root.source-card-height;
                border-radius: 12px;
                background: Colors.background;
                border-width: source-input.has-focus ? 2px : 0px;
                border-color: Colors.primary;
                source-scroll := ScrollView {
                    x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 58px;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, source-input.preferred-height);
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    mouse-drag-pan-enabled: false;

                    source-input := TextInput {
                        width: source-scroll.visible-width;
                        height: max(source-scroll.visible-height, self.preferred-height);
                        text <=> root.source-text;
                        color: Colors.foreground;
                        font-size: Typography.body-size;
                        single-line: false;
                        wrap: word-wrap;
                        vertical-alignment: TextVerticalAlignment.top;
                        selection-background-color: Colors.primary-container;
                        page-height: source-scroll.visible-height;
                        key-pressed(event) => {
                            root.interaction-requested();
                            if event.text == Key.Escape {
                                root.language-menu-dismiss-requested();
                                return accept;
                            }
                            if event.modifiers.control && event.text == Key.Return {
                                root.translate-requested(root.source-text, root.source-index, root.target-index);
                                return accept;
                            }
                            return reject;
                        }
                        cursor-position-changed(position) => {
                            if position.y + source-scroll.content-y < 0px {
                                source-scroll.content-y = min(0px, max(
                                    source-scroll.visible-height - self.height,
                                    -position.y
                                ));
                            } else if position.y + source-scroll.content-y > source-scroll.visible-height - 20px {
                                source-scroll.content-y = min(0px, max(
                                    source-scroll.visible-height - self.height,
                                    source-scroll.visible-height - position.y - 20px
                                ));
                            }
                        }
                        changed has-focus => { if self.has-focus { root.interaction-requested(); } }
                    }
                }
                AppVerticalScrollBar {
                    x: parent.width - 14px;
                    y: source-scroll.y;
                    height: source-scroll.height;
                    viewport-height: source-scroll.visible-height;
                    content-height: source-scroll.content-height;
                    content-y <=> source-scroll.content-y;
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 42px; width: parent.width - 16px; height: 36px;
                    spacing: 2px;
                    IconButton { icon: AppAssets.icon-copy; icon-size: 18px; clicked => { root.interaction-requested(); root.copy-requested(true); } }
                    IconButton { icon: AppAssets.icon-volume; icon-size: 18px; active: root.speaking-source; clicked => { root.interaction-requested(); root.speech-requested(true); } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        width: 38px;
                        height: 34px;
                        icon: AppAssets.icon-translate;
                        icon-size: 20px;
                        enabled: root.source-text != "" && !root.busy;
                        clicked => { root.interaction-requested(); root.translate-requested(root.source-text, root.source-index, root.target-index); }
                    }
                }

                // Eight resize handles sit on the source-card border. Corners are
                // declared last so they win hit testing where the regions overlap.
                left-resize := TouchArea {
                    x: -4px; y: 14px; width: 8px; height: parent.height - 28px;
                    mouse-cursor: ew-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 0; } else if root.resize-hover == 0 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(0); } }
                }
                right-resize := TouchArea {
                    x: parent.width - 4px; y: 14px; width: 8px; height: parent.height - 28px;
                    mouse-cursor: ew-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 1; } else if root.resize-hover == 1 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(1); } }
                }
                top-resize := TouchArea {
                    x: 14px; y: -4px; width: parent.width - 28px; height: 8px;
                    mouse-cursor: ns-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 2; } else if root.resize-hover == 2 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(2); } }
                }
                bottom-resize := TouchArea {
                    x: 14px; y: parent.height - 4px; width: parent.width - 28px; height: 8px;
                    mouse-cursor: ns-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 3; } else if root.resize-hover == 3 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(3); } }
                }
                top-left-resize := TouchArea {
                    x: -4px; y: -4px; width: 18px; height: 18px;
                    mouse-cursor: nwse-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 4; } else if root.resize-hover == 4 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(4); } }
                }
                top-right-resize := TouchArea {
                    x: parent.width - 14px; y: -4px; width: 18px; height: 18px;
                    mouse-cursor: nesw-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 5; } else if root.resize-hover == 5 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(5); } }
                }
                bottom-left-resize := TouchArea {
                    x: -4px; y: parent.height - 14px; width: 18px; height: 18px;
                    mouse-cursor: nesw-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 6; } else if root.resize-hover == 6 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(6); } }
                }
                bottom-right-resize := TouchArea {
                    x: parent.width - 14px; y: parent.height - 14px; width: 18px; height: 18px;
                    mouse-cursor: nwse-resize;
                    changed has-hover => { if self.has-hover { root.resize-hover = 7; } else if root.resize-hover == 7 { root.resize-hover = -1; } }
                    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize-requested(7); } }
                }

                Rectangle {
                    x: root.resize-hover == 4 || root.resize-hover == 6 ? 0px
                        : root.resize-hover == 5 || root.resize-hover == 7 ? parent.width - 24px
                        : (parent.width - 48px) / 2;
                    y: 0px;
                    width: root.resize-hover >= 4 ? 24px : 48px;
                    height: 2px;
                    border-radius: 1px;
                    background: Colors.primary;
                    opacity: root.resize-hover == 2 ? 1 : 0;
                    animate opacity, width { duration: 120ms; easing: ease-out; }
                }
                Rectangle {
                    x: root.resize-hover == 6 || root.resize-hover == 4 ? 0px
                        : root.resize-hover == 7 || root.resize-hover == 5 ? parent.width - 24px
                        : (parent.width - 48px) / 2;
                    y: parent.height - 2px;
                    width: root.resize-hover >= 4 ? 24px : 48px;
                    height: 2px;
                    border-radius: 1px;
                    background: Colors.primary;
                    opacity: root.resize-hover == 3 ? 1 : 0;
                    animate opacity, width { duration: 120ms; easing: ease-out; }
                }
                Rectangle {
                    x: 0px;
                    y: root.resize-hover == 4 ? 0px : root.resize-hover == 6 ? parent.height - 24px : (parent.height - 48px) / 2;
                    width: 2px;
                    height: root.resize-hover >= 4 ? 24px : 48px;
                    border-radius: 1px;
                    background: Colors.primary;
                    opacity: root.resize-hover == 0 ? 1 : 0;
                    animate opacity, height { duration: 120ms; easing: ease-out; }
                }
                Rectangle {
                    x: parent.width - 2px;
                    y: root.resize-hover == 5 ? 0px : root.resize-hover == 7 ? parent.height - 24px : (parent.height - 48px) / 2;
                    width: 2px;
                    height: root.resize-hover >= 4 ? 24px : 48px;
                    border-radius: 1px;
                    background: Colors.primary;
                    opacity: root.resize-hover == 1 ? 1 : 0;
                    animate opacity, height { duration: 120ms; easing: ease-out; }
                }
                // Curved corner affordances follow the source card's rounded
                // border instead of drawing a square L-shaped marker.
                Path {
                    x: 0px; y: 0px; width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M0 12 C0 5.37 5.37 0 12 0";
                    fill: transparent;
                    stroke: Colors.primary;
                    stroke-width: 2.5px;
                    opacity: root.resize-hover == 4 ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
                Path {
                    x: parent.width - 24px; y: 0px; width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M12 0 C18.63 0 24 5.37 24 12";
                    fill: transparent;
                    stroke: Colors.primary;
                    stroke-width: 2.5px;
                    opacity: root.resize-hover == 5 ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
                Path {
                    x: 0px; y: parent.height - 24px; width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M12 24 C5.37 24 0 18.63 0 12";
                    fill: transparent;
                    stroke: Colors.primary;
                    stroke-width: 2.5px;
                    opacity: root.resize-hover == 6 ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
                Path {
                    x: parent.width - 24px; y: parent.height - 24px; width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M24 12 C24 18.63 18.63 24 12 24";
                    fill: transparent;
                    stroke: Colors.primary;
                    stroke-width: 2.5px;
                    opacity: root.resize-hover == 7 ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
            }

            language-bar := Rectangle {
                height: 44px;
                border-radius: 12px;
                background: Colors.background;
                source-segment := Rectangle {
                    x: 0px; width: (parent.width - 44px) / 2; height: parent.height;
                    border-radius: 10px;
                    background: source-touch.pressed ? Colors.icon-button-pressed
                        : source-touch.has-hover ? Colors.icon-button-hover : Colors.background;
                    source-touch := TouchArea {
                        clicked => { root.interaction-requested(); root.source-menu-requested(); }
                    }
                    Text {
                        x: 14px; width: parent.width - 46px; height: parent.height;
                        text: root.source-label;
                        color: Colors.foreground;
                        font-size: Typography.compact-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        x: parent.width - 28px; y: (parent.height - 16px) / 2;
                        width: 16px; height: 16px;
                        source: root.source-menu-open ? AppAssets.icon-expand-less : AppAssets.icon-expand-more;
                        image-fit: contain;
                        colorize: Colors.secondary-foreground;
                    }
                }
                Image {
                    x: source-segment.width + 11px;
                    y: (parent.height - 22px) / 2;
                    width: 22px;
                    height: 22px;
                    source: AppAssets.icon-swap-horizontal;
                    image-fit: contain;
                    colorize: Colors.secondary-foreground;
                }
                target-segment := Rectangle {
                    x: source-segment.width + 44px; width: source-segment.width; height: parent.height;
                    border-radius: 10px;
                    background: target-touch.pressed ? Colors.icon-button-pressed
                        : target-touch.has-hover ? Colors.icon-button-hover : Colors.background;
                    target-touch := TouchArea {
                        clicked => { root.interaction-requested(); root.target-menu-requested(); }
                    }
                    Text {
                        x: 12px; width: parent.width - 46px; height: parent.height;
                        text: root.target-label;
                        color: Colors.foreground;
                        font-size: Typography.compact-size;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Image {
                        x: parent.width - 28px; y: (parent.height - 16px) / 2;
                        width: 16px; height: 16px;
                        source: root.target-menu-open ? AppAssets.icon-expand-less : AppAssets.icon-expand-more;
                        image-fit: contain;
                        colorize: Colors.secondary-foreground;
                    }
                }
            }

            result-card := Rectangle {
                vertical-stretch: 1;
                min-height: 104px;
                border-radius: 12px;
                background: Colors.background;
                Text {
                    x: 14px; y: 8px; width: parent.width - 28px; height: 24px;
                    text: root.busy ? "Translating…" : root.error-text != "" ? "Translation failed" : "Translation";
                    color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
                    font-size: 13px;
                    font-weight: 600;
                }
                result-scroll := ScrollView {
                    x: 14px; y: 32px; width: parent.width - 28px; height: parent.height - 74px;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    Text {
                        width: result-scroll.visible-width;
                        text: root.error-text != "" ? root.error-text : root.translated-text == "" ? "Translation will appear here" : root.translated-text;
                        color: root.error-text != "" ? Colors.error : root.translated-text == "" ? Colors.secondary-foreground : Colors.foreground;
                        font-size: Typography.body-size;
                        wrap: word-wrap;
                    }
                }
                AppVerticalScrollBar {
                    x: parent.width - 14px;
                    y: result-scroll.y;
                    height: result-scroll.height;
                    viewport-height: result-scroll.visible-height;
                    content-height: result-scroll.content-height;
                    content-y <=> result-scroll.content-y;
                }
                HorizontalLayout {
                    x: 8px; y: parent.height - 40px; width: parent.width - 16px; height: 34px;
                    spacing: 2px;
                    IconButton { icon: AppAssets.icon-copy; icon-size: 18px; enabled: root.translated-text != ""; clicked => { root.interaction-requested(); root.copy-requested(false); } }
                    IconButton { icon: AppAssets.icon-volume; icon-size: 18px; active: root.speaking-translation; enabled: root.translated-text != ""; clicked => { root.interaction-requested(); root.speech-requested(false); } }
                    if root.error-text != "": IconButton { icon: AppAssets.icon-refresh; clicked => { root.translate-requested(root.source-text, root.source-index, root.target-index); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        if root.feedback-text != "": Rectangle {
            x: (parent.width - min(280px, feedback-label.preferred-width + 28px)) / 2;
            y: parent.height - 52px;
            width: min(280px, feedback-label.preferred-width + 28px);
            height: 38px;
            z: 30;
            border-radius: 12px;
            background: root.feedback-error ? #fce8e6 : #e6f4ea;
            border-width: 1px;
            border-color: root.feedback-error ? Colors.error : Colors.success;
            feedback-label := Text {
                text: root.feedback-text;
                color: root.feedback-error ? Colors.error : Colors.success;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component PopupLanguageMenuWindow inherits Window {
    title: "Lexift Languages";
    icon: AppAssets.app-icon;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.menu-width;
    height: root.menu-height;

    in property <int> selected-index: 0;
    in property <[string]> language-options: [];
    in-out property <length> menu-width: 196px;
    in-out property <length> menu-height: 400px;
    in-out property <length> menu-scroll-y: 0px;
    callback language-selected(int);
    callback dismiss-requested();

    changed selected-index => {
        root.menu-scroll-y = round(min(0px, max(
            root.menu-height - root.language-options.length * 40px,
            root.menu-height / 2 - (root.selected-index + 0.5) * 40px
        )) / 4px) * 4px;
    }

    surface := Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Colors.outline;
        background: Colors.surface;
        clip: true;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000024;

        menu-scroll := ScrollView {
            x: 0px; y: 0px; width: parent.width - 10px; height: parent.height;
            content-height: root.language-options.length * 40px;
            content-y <=> root.menu-scroll-y;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            scrolled => { root.menu-scroll-y = round(root.menu-scroll-y / 4px) * 4px; }
            for option[index] in root.language-options: Rectangle {
                y: index * 40px;
                width: menu-scroll.visible-width;
                height: 40px;
                background: index == root.selected-index ? Colors.primary-container
                    : row.pressed ? Colors.icon-button-pressed
                    : row.has-hover ? Colors.background : Colors.surface;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: option;
                    color: index == root.selected-index ? Colors.primary : Colors.foreground;
                    font-size: Typography.menu-size;
                    font-weight: Typography.menu-weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
                row := TouchArea { clicked => { root.language-selected(index); } }
            }
        }
        AppVerticalScrollBar {
            x: parent.width - 12px;
            y: 2px;
            height: parent.height - 4px;
            viewport-height: menu-scroll.visible-height;
            content-height: menu-scroll.content-height;
            content-y <=> menu-scroll.content-y;
        }
    }
}
