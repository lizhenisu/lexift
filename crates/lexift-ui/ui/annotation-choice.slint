import { NumericRow, NumericAdjustmentRow, NumericPresentation } from "annotation-numeric.slint";
import { AnnotationPalette } from "annotation-palette.slint";
import { AnnotationColorPicker } from "annotation-color.slint";
import { Colors } from "design/colors.slint";
import { MenuMetrics } from "design/menu.slint";
import { AnnotationValues } from "annotation.slint";
import { AnnotationChoiceRequest, ConnectorStylePreview, LineStylePreview } from "annotation-fields.slint";
import { ScrollView } from "std-widgets.slint";

export component AnnotationChoiceWindow inherits Window {
    in property <int> disabled-index: -1;
    title: "Lexift"; no-frame: true; always-on-top: true; background: transparent;
    in property <[string]> options;
    in property <bool> lines;
    in property <bool> connectors;
    in property <bool> color-mode;
    in property <bool> font-mode;
    in property <bool> sequence-shapes;
    in property <int> text-style-mode: 0;
    in-out property <AnnotationValues> style-values;
    in property <int> active-choice: -1;
    in property <int> numeric-field: -9;
    in property <int> numeric-tool: 13;
    out property <float> numeric-content-width: max(300px, 226px + max(74px, numeric-metrics.preferred-width + 44px) + unit-metrics.preferred-width, wheel-metrics.preferred-width + 24px) / 1px;
    out property <float> style-content-width: max(420px, style-label-width + 300px) / 1px;
    private property <length> style-label-width: max(110px, outline-label.preferred-width, opacity-label.preferred-width, rounding-label.preferred-width, padding-label.preferred-width);
    outline-label := Text { visible:false; text:NumericPresentation.name(-104,root.numeric-tool); }
    opacity-label := Text { visible:false; text:NumericPresentation.name(-105,root.numeric-tool); }
    rounding-label := Text { visible:false; text:NumericPresentation.name(-106,root.numeric-tool); }
    padding-label := Text { visible:false; text:NumericPresentation.name(-107,root.numeric-tool); }
    numeric-metrics := Text { visible:false; text:NumericPresentation.display(root.numeric-field,root.numeric-value);font-size:13px; }
    unit-metrics := Text { visible:false;text:NumericPresentation.unit(root.numeric-field); }
    wheel-metrics := Text { visible:false;text:@tr("You can also adjust with the mouse wheel.");font-size:12px; }
    in-out property <int> numeric-value: 12;
    in property <int> numeric-minimum: 1;
    in property <int> numeric-maximum: 100;
    in-out property <int> numeric-slider-maximum: 100;
    callback numeric-edited(int);
    callback style-numeric-edited(int,int);
    callback numeric-scrolled(int,float);
    callback numeric-layout-changed();
    changed numeric-content-width => { if root.text-style-mode == 3 { root.numeric-layout-changed(); } }
    changed numeric-value => {
        if root.numeric-field == -102 && root.numeric-maximum > 144 { root.numeric-slider-maximum = max(root.numeric-slider-maximum, root.numeric-value); }
        root.numeric-edited(root.numeric-value);
    }

    callback custom-requested(float,float,float,float);
    callback text-style-edited(AnnotationValues);
    changed style-values => { root.text-style-edited(root.style-values); }
    private property <[color]> palette: [#d9472b, #e5bf55, #69ad61, #598fdf, #212121, #ffffff, #32ec66, #fff400];
    in-out property <float> hue;
    in-out property <float> saturation;
    in-out property <float> value;
    in property <color> preview;
    in property <color> bright;
    in-out property <string> hex-text;
    in property <bool> invalid;
    callback hsv-edited(float,float,float);
    callback hex-edited(string,bool);
    callback color-dragging(bool);
    in-out property <bool> parameter-input-active: false;
    in property <float> content-width: 320;
    callback parameter-input-finished();
    in-out property <int> selected;
    out property <length> menu-height: root.text-style-mode == 3 ? 104px : root.text-style-mode == 1 ? 90px : root.text-style-mode == 2 ? 176px : root.color-mode ? 300px : root.font-mode ? 320px : root.options.length * MenuMetrics.row-height + 8px;
    in-out property <length> font-scroll-y: 0px;
    callback center-selection();
    center-selection => { root.reveal-selection(true); }
    function reveal-selection(center: bool) {
        if root.font-mode {
            if center { root.font-scroll-y = -clamp(4px + root.selected * MenuMetrics.row-height - ((root.height - 2px) - MenuMetrics.row-height) / 2, 0px, max(0px, (root.options.length * MenuMetrics.row-height + 8px) - (root.height - 2px))); }
            else if 4px + root.selected * MenuMetrics.row-height < -root.font-scroll-y { root.font-scroll-y = -(4px + root.selected * MenuMetrics.row-height); }
            else if 4px + (root.selected + 1) * MenuMetrics.row-height > -root.font-scroll-y + (root.height - 2px) { root.font-scroll-y = -clamp(4px + (root.selected + 1) * MenuMetrics.row-height - (root.height - 2px), 0px, max(0px, (root.options.length * MenuMetrics.row-height + 8px) - (root.height - 2px))); }
        }
    }
    changed selected => { root.reveal-selection(false); }
    callback chosen(int);
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } if root.color-mode && event.text == Key.Return { root.hex-edited(root.hex-text,true); return accept; } return reject; }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); }
            else if root.color-mode || root.text-style-mode != 0 { return reject; }
            else if event.text == Key.DownArrow { root.selected = mod(root.selected + 1, root.options.length); }
            else if event.text == Key.UpArrow { root.selected = mod(root.selected + root.options.length - 1, root.options.length); }
            else if event.text == Key.Home { root.selected = 0; }
            else if event.text == Key.End { root.selected = root.options.length - 1; }
            else if event.text == Key.Return || event.text == " " { root.chosen(root.selected); }
            else { return reject; }
            accept
        }
    Rectangle {
        border-radius: MenuMetrics.row-radius; border-width: 1px;
        border-color: Colors.outline; background: Colors.surface;
        accessible-role: list;
        if root.color-mode: ScrollView {
            width: 100%; height: 100%;
            content-width: max(self.visible-width, root.content-width * 1px);
            content-height: root.menu-height;
            AnnotationColorPicker {
            width: parent.width; height: root.menu-height;
            hue <=> root.hue; saturation <=> root.saturation; value <=> root.value;
            preview: root.preview; bright: root.bright; hex-text <=> root.hex-text; invalid: root.invalid;
            hsv-edited(h,s,v) => { root.hsv-edited(h,s,v); }
            hex-edited(text,commit) => { root.hex-edited(text,commit); }
            input-active <=> root.parameter-input-active;
            input-finished => { root.parameter-input-finished(); }
            dragging(active) => { root.parameter-input-active = false; root.color-dragging(active); }
            }
        }
        if root.text-style-mode != 0: ScrollView {
            width: 100%; height: 100%; content-width: max(self.visible-width, root.content-width * 1px);
            content-height: root.menu-height;
            if root.text-style-mode == 3: Rectangle {
                width:100%; height:root.menu-height;
                Text { x:12px;y:9px;text:NumericPresentation.name(root.numeric-field,root.numeric-tool);color:Colors.foreground; }
                NumericAdjustmentRow { x:12px; y:24px; width:parent.width - 24px; height:38px;
                    track-width:190px; gap:10px; input-width:max(74px,numeric-metrics.preferred-width + 44px);
                    value:root.numeric-value; minimum:root.numeric-minimum; maximum:root.numeric-maximum; slider-maximum:root.numeric-slider-maximum;
                    display-divisor:root.numeric-field == -103 ? 100 : 1; caption-steps:root.numeric-field == -108; unit:NumericPresentation.unit(root.numeric-field);
                    edited(v)=>{root.numeric-value=v;} dragging(active)=>{root.color-dragging(active);}
                    input-editing(active)=>{root.parameter-input-active=active;} input-finished=>{root.parameter-input-finished();}
                }
                Text { x:12px;y:75px;text:@tr("You can also adjust with the mouse wheel.");font-size:12px;color:Colors.secondary-foreground; }
            }
            if root.text-style-mode == 1: Rectangle {
                width: 100%; height: root.menu-height;
                NumericRow { tool:root.numeric-tool; x:12px; y:4px; width:parent.width - 24px; label-width:root.style-label-width; field:-104; value:root.style-values.text-outline-width; minimum:1; maximum:20;
                    edited(f,v)=>{root.style-numeric-edited(f,v);} scrolled(f,d)=>{root.numeric-scrolled(f,d);}
                    dragging(active)=>{root.parameter-input-active=false;root.color-dragging(active);}
                    input-editing(active)=>{root.parameter-input-active=active;} input-finished=>{root.parameter-input-finished();} }
                AnnotationPalette {
                    x: (parent.width - self.width) / 2; y: 50px; button-size: 27px; inset: 3px; radius: 6px;
                    selected <=> root.style-values.text-outline-color-index;
                    preset-selected => { root.parameter-input-active = false; root.parameter-input-finished(); }
                    custom-requested(x,y,w,h) => { root.custom-requested(x,y,w,h); }
                }
            }
            if root.text-style-mode == 2: Rectangle {
                width: 100%; height: root.menu-height;
                NumericRow { tool:root.numeric-tool; x:12px; y:4px; width:parent.width - 24px; label-width:root.style-label-width; field:-105; value:root.style-values.text-bg-opacity; minimum:0; maximum:100;
                    edited(f,v)=>{root.style-numeric-edited(f,v);} scrolled(f,d)=>{root.numeric-scrolled(f,d);}
                    dragging(active)=>{root.parameter-input-active=false;root.color-dragging(active);}
                    input-editing(active)=>{root.parameter-input-active=active;} input-finished=>{root.parameter-input-finished();} }
                NumericRow { tool:root.numeric-tool; x:12px; y:48px; width:parent.width - 24px; label-width:root.style-label-width; field:-106; value:root.style-values.text-bg-rounding; minimum:0; maximum:100;
                    edited(f,v)=>{root.style-numeric-edited(f,v);} scrolled(f,d)=>{root.numeric-scrolled(f,d);}
                    dragging(active)=>{root.parameter-input-active=false;root.color-dragging(active);}
                    input-editing(active)=>{root.parameter-input-active=active;} input-finished=>{root.parameter-input-finished();} }
                NumericRow { tool:root.numeric-tool; x:12px; y:92px; width:parent.width - 24px; label-width:root.style-label-width; field:-107; value:root.style-values.text-bg-padding; minimum:0; maximum:100;
                    edited(f,v)=>{root.style-numeric-edited(f,v);} scrolled(f,d)=>{root.numeric-scrolled(f,d);}
                    dragging(active)=>{root.parameter-input-active=false;root.color-dragging(active);}
                    input-editing(active)=>{root.parameter-input-active=active;} input-finished=>{root.parameter-input-finished();} }
                AnnotationPalette {
                    x: (parent.width - self.width) / 2; y: 140px; button-size: 27px; inset: 3px; radius: 6px;
                    selected <=> root.style-values.text-bg-color-index;
                    preset-selected => { root.parameter-input-active = false; root.parameter-input-finished(); }
                    custom-requested(x,y,w,h) => { root.custom-requested(x,y,w,h); }
                }
            }
        }
        if !root.color-mode && root.text-style-mode == 0: ScrollView {
            content-y <=> root.font-scroll-y;
            width: 100%; height: 100%;
            content-width: self.visible-width;
            content-height: root.options.length * MenuMetrics.row-height + 8px;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            for label[i] in root.options: Rectangle {
            x: 4px; y: 4px + i * MenuMetrics.row-height;
            width: parent.width - 8px; height: MenuMetrics.row-height;
            border-radius: MenuMetrics.row-radius;
            background: root.selected == i ? Colors.primary : hit.has-hover ? Colors.menu-hover : transparent;
            opacity: i == root.disabled-index ? 0.45 : 1;
            accessible-role: list-item; accessible-label: label;
            accessible-item-selected: root.selected == i;
            accessible-action-default => { root.chosen(i); }
            if root.lines: LineStylePreview {
                x: 8px; y: (parent.height - 4px) / 2; width: parent.width - 16px; height: 4px;
                style: i; ink: root.selected == i ? Colors.on-primary : Colors.foreground;
            }
            if root.connectors: ConnectorStylePreview {
                x: 8px; y: (parent.height - 20px) / 2; width: parent.width - 16px; height: 20px;
                style: i; ink: root.selected == i ? Colors.on-primary : Colors.foreground;
            }
            if !root.lines && !root.connectors: Text {
                x: root.sequence-shapes ? 44px : 8px; width: parent.width - self.x - 8px; height: parent.height;
                text: label; font-size: 13px; vertical-alignment: center; overflow: elide;
                font-family: root.font-mode ? label : "";
                color: root.selected == i ? Colors.on-primary : Colors.foreground;
            }
            if root.sequence-shapes: Image { x:8px;y:6px;width:24px;height:24px;image-fit:contain;
                source:i==0 ? @image-url("icons/sequence-circle.svg") : i==1 ? @image-url("icons/sequence-circle-border.svg") : i==2 ? @image-url("icons/sequence-outline.svg") : i==3 ? @image-url("icons/sequence-plain.svg") : @image-url("icons/sequence-square.svg"); }
            if root.sequence-shapes: Text { x:8px;y:6px;width:24px;height:24px;text:"1";horizontal-alignment:center;vertical-alignment:center;color:i==2 ? #444444 : i==3 ? (root.selected==i ? Colors.on-primary : Colors.foreground) : #ffffff; }
            hit := TouchArea { enabled: i != root.disabled-index; clicked => { root.chosen(i); } }
        }
        }
    }
}

}
