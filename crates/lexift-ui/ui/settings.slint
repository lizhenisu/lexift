import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
import { Metrics } from "design/metrics.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";
import { ScrollView } from "std-widgets.slint";

component SettingsButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    width: max(104px, button-label.preferred-width + 2 * Spacing.medium);
    height: 40px;
    border-radius: 20px;
    border-width: primary ? 0px : 1px;
    border-color: Colors.outline;
    background: !enabled ? Colors.outline : primary ? Colors.primary : Colors.surface;

    button-label := Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        wrap: word-wrap;
        text: root.label;
        color: !root.enabled ? Colors.secondary-foreground : root.primary ? Colors.on-primary : Colors.primary;
        font-size: Typography.body-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SettingsSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: root.checked ? Colors.primary : Colors.outline;

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Colors.surface;
    }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }
}

component CredentialActionButton inherits Rectangle {
    in property <int> icon-kind;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    in property <bool> highlighted: false;
    in property <bool> pressed: false;
    callback clicked();

    width: Metrics.icon-button-size;
    height: Metrics.icon-button-size;
    border-radius: Metrics.icon-button-radius;
    opacity: root.enabled ? 1 : Metrics.disabled-opacity;
    background: root.pressed || (root.interactive && action-touch.pressed)
        ? Colors.icon-button-pressed
        : root.highlighted || (root.interactive && action-touch.has-hover)
            ? Colors.icon-button-hover : transparent;

    if root.icon-kind == 0: Path {
        x: (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 6.5c3.79 0 7.17 2.13 8.82 5.5-1.65 3.37-5.03 5.5-8.82 5.5S4.83 15.37 3.18 12C4.83 8.63 8.21 6.5 12 6.5M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zM12 9c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3m0-2c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5z";
        fill: Colors.secondary-foreground;
    }

    if root.icon-kind == 1: Path {
        x: (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z";
        fill: Colors.secondary-foreground;
    }

    if root.icon-kind == 2: Path {
        x: (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM6.92 19H5v-1.92l9.06-9.06 1.92 1.92L6.92 19zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
        fill: Colors.secondary-foreground;
    }

    if root.icon-kind == 3: Path {
        x: (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm2-10h8v10H8V9zm7.5-5-1-1h-5l-1 1H5v2h14V4z";
        fill: Colors.secondary-foreground;
    }

    if root.icon-kind == 4: Path {
        x: (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 6.5c3.79 0 7.17 2.13 8.82 5.5-.59 1.2-1.41 2.27-2.41 3.12l1.41 1.41C21.21 15.32 22.31 13.78 23 12c-1.73-4.39-6-7.5-11-7.5-1.27 0-2.49.2-3.64.57l1.65 1.65c.65-.14 1.31-.22 1.99-.22zM2.71 3.16a.996.996 0 0 0 0 1.41l1.97 1.97C3.06 7.83 1.77 9.7 1 12c1.73 4.39 6 7.5 11 7.5 1.52 0 2.97-.29 4.31-.81l2.72 2.72a.996.996 0 1 0 1.41-1.41L4.12 3.16a.996.996 0 0 0-1.41 0zM12 17.5c-3.79 0-7.17-2.13-8.82-5.5.72-1.47 1.76-2.71 3.03-3.64l2.35 2.35c-.04.21-.06.42-.06.64 0 1.93 1.57 3.5 3.5 3.5.22 0 .43-.02.64-.06l1.55 1.55c-.69.1-1.42.16-2.19.16zm3.46-4.89-4.07-4.07c.2-.03.4-.04.61-.04 1.93 0 3.5 1.57 3.5 3.5 0 .21-.01.41-.04.61z";
        fill: Colors.secondary-foreground;
    }

    action-touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { root.clicked(); }
    }
}

component SettingsToast inherits Rectangle {
    in property <string> message;
    in property <bool> error: false;
    callback dismissed();

    width: Metrics.toast-width;
    height: Metrics.toast-height;
    border-radius: Spacing.small;
    border-width: 1px;
    border-color: Colors.outline;
    background: Colors.surface;

    Path {
        x: Spacing.medium;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.error
            ? "M11 15h2v2h-2v-2zm0-8h2v6h-2V7zm1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
            : "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
        fill: root.error ? Colors.error : Colors.success;
    }

    Text {
        x: Spacing.medium + Metrics.icon-size + Spacing.small;
        width: parent.width - 2 * Spacing.medium - 2 * Metrics.icon-size - 2 * Spacing.small;
        height: parent.height;
        text: root.message;
        color: Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 700;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    close-button := Rectangle {
        x: parent.width - Spacing.small - Metrics.icon-button-size;
        y: (parent.height - Metrics.icon-button-size) / 2;
        width: Metrics.icon-button-size;
        height: Metrics.icon-button-size;
        border-radius: Metrics.icon-button-radius;
        background: close-touch.pressed ? Colors.icon-button-pressed
            : close-touch.has-hover ? Colors.icon-button-hover : transparent;

        Path {
            x: (parent.width - Metrics.icon-size) / 2;
            y: (parent.height - Metrics.icon-size) / 2;
            width: Metrics.icon-size;
            height: Metrics.icon-size;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M18.3 5.71 16.89 4.29 12 9.17 7.11 4.29 5.7 5.71 10.59 10.59 5.7 15.48 7.11 16.89 12 12 16.89 16.89 18.3 15.48 13.41 10.59z";
            fill: Colors.secondary-foreground;
        }

        close-touch := TouchArea {
            clicked => { root.dismissed(); }
        }
    }
}

component SettingsSelectMenu inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    in-out property <length> scroll-y: 0px;
    callback selected(int);

    border-radius: 4px;
    border-width: 1px;
    border-color: Colors.outline;
    background: Colors.surface;
    clip: true;

    menu-scroll := ScrollView {
        width: parent.width - 10px;
        height: parent.height;
        content-width: self.visible-width;
        content-height: root.options.length * 40px;
        content-y <=> root.scroll-y;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: true;
        scrolled => { root.scroll-y = round(root.scroll-y / 4px) * 4px; }

        for option[index] in root.options: option-row := Rectangle {
            y: index * 40px;
            width: menu-scroll.visible-width;
            height: 40px;
            background: index == root.selected-index
                ? Colors.primary-container
                : option-touch.pressed ? Colors.icon-button-pressed
                : option-touch.has-hover ? Colors.background : Colors.surface;

            Text {
                x: Spacing.medium;
                width: parent.width - 2 * Spacing.medium;
                text: option;
                color: Colors.foreground;
                font-size: Typography.menu-size;
                font-weight: Typography.menu-weight;
                vertical-alignment: center;
                overflow: elide;
            }

            option-touch := TouchArea {
                clicked => { root.selected(index); }
            }
        }
    }
    AppVerticalScrollBar {
        x: parent.width - 12px;
        y: 2px;
        height: parent.height - 4px;
        viewport-height: menu-scroll.visible-height;
        content-height: menu-scroll.content-height;
        content-y <=> menu-scroll.content-y;
    }
}

export struct SettingsToastData {
    id: int,
    message: string,
    error: bool,
}

component SettingsCard inherits Rectangle {
    in property <string> title;

    border-radius: Metrics.settings-card-radius;
    background: Colors.surface;
    height: card-layout.preferred-height;

    card-layout := VerticalLayout {
        x: 0px; y: 0px; width: parent.width;
        padding: Metrics.settings-card-padding;
        spacing: Spacing.medium;

        Text {
            height: 24px;
            text: root.title;
            color: Colors.foreground;
            font-size: Typography.body-size;
            font-weight: 700;
            vertical-alignment: center;
        }

        @children
    }
}

component SettingsFieldLabel inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> error-text;

    height: 44px;

    Text {
        y: 1px;
        width: parent.width;
        height: 22px;
        text: root.label;
        color: Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        y: 24px;
        width: parent.width;
        height: 18px;
        text: root.error-text != "" ? root.error-text : root.description;
        color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component AppearanceThemeChoice inherits Rectangle {
    in property <int> theme-kind;
    in property <bool> selected;
    callback chosen();

    height: 106px;
    background: transparent;

    preview := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 78px;
        border-radius: Spacing.small;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Colors.primary : Colors.outline;
        background: root.theme-kind == 1 ? #15345d : #dcecff;
        clip: true;

        if root.theme-kind == 2: Rectangle {
            x: parent.width / 2; width: parent.width / 2; height: parent.height;
            background: #15345d;
        }
        Rectangle {
            x: 9px; y: 13px; width: parent.width - 18px; height: parent.height - 13px;
            border-radius: 5px;
            background: root.theme-kind == 1 ? #25282d : #ffffff;
            clip: true;
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; width: parent.width / 2; height: parent.height;
                background: #25282d;
            }
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 14px;
                border-radius: 5px;
                background: root.theme-kind == 1 ? #383c43 : #f5f7fa;
            }
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; y: 0px; width: parent.width / 2; height: 14px;
                background: #383c43;
            }
            for dot in [0, 1, 2]: Rectangle {
                x: 6px + dot * 6px; y: 6px; width: 3px; height: 3px;
                border-radius: 2px;
                background: root.theme-kind == 1 ? #aeb5bf : #68707a;
            }
            Rectangle { x: 6px; y: 22px; width: 16px; height: 6px; border-radius: 2px; background: #1967d2; }
            Rectangle { x: 6px; y: 33px; width: 12px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 23px; width: parent.width - 43px; height: 4px; border-radius: 2px; background: root.theme-kind == 1 ? #aeb5bf : #68707a; }
            Rectangle { x: 28px; y: 33px; width: parent.width - 38px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 42px; width: parent.width - 48px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: parent.width - 27px; y: parent.height - 13px; width: 19px; height: 6px; border-radius: 3px; background: #1967d2; }
        }
    }
    Text {
        y: 82px; width: parent.width; height: 24px;
        text: root.theme-kind == 0 ? @tr("Light") : root.theme-kind == 1 ? @tr("Dark") : @tr("System");
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: Typography.compact-size;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.chosen(); } }
}

component AppearanceAccentChoice inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback chosen();

    width: 36px; height: 36px;
    border-radius: 18px;
    border-width: root.selected ? 2px : 0px;
    border-color: Colors.primary;
    background: transparent;
    Rectangle {
        x: 3px; y: 3px; width: 30px; height: 30px;
        border-radius: 15px;
        background: root.swatch;
        if root.selected: Path {
            x: 8px; y: 10px; width: 14px; height: 11px;
            viewbox-width: 14; viewbox-height: 11;
            stroke: Colors.on-primary; stroke-width: 2px;
            MoveTo { x: 1; y: 5; } LineTo { x: 5; y: 9; } LineTo { x: 13; y: 1; }
        }
    }
    TouchArea { clicked => { root.chosen(); } }
}

component AppearancePreviewField inherits Rectangle {
    in property <string> value;
    in property <bool> opened;
    callback clicked();

    height: 42px;
    border-radius: 6px;
    border-width: root.opened ? 2px : 1px;
    border-color: root.opened ? Colors.primary : Colors.outline;
    background: Colors.background;
    Text {
        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 18px; height: parent.height;
        text: root.value; color: Colors.foreground; font-size: Typography.body-size;
        vertical-alignment: center; overflow: elide;
    }
    Path {
        x: parent.width - Spacing.medium - 12px; y: (parent.height - 6px) / 2;
        width: 12px; height: 6px; viewbox-width: 12; viewbox-height: 6;
        stroke: Colors.secondary-foreground; stroke-width: 1.5px;
        MoveTo { x: 1; y: root.opened ? 5 : 1; }
        LineTo { x: 6; y: root.opened ? 1 : 5; }
        LineTo { x: 11; y: root.opened ? 5 : 1; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component UnavailableHotkeyRow inherits Rectangle {
    in property <string> label;
    in property <bool> compact;

    height: root.compact ? 88px : 64px;

    Text {
        x: 0px; y: 0px;
        width: root.compact ? parent.width : parent.width * 0.45 - Spacing.small;
        height: root.compact ? 32px : parent.height;
        text: root.label; color: Colors.secondary-foreground; wrap: word-wrap;
        font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.compact ? 0px : parent.width * 0.45;
        y: root.compact ? 38px : (parent.height - 40px) / 2;
        width: root.compact ? parent.width - 112px : parent.width * 0.55 - 112px;
        height: 40px; border-radius: 6px; border-width: 1px;
        border-color: Colors.outline; background: Colors.background;
        Text {
            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
            text: @tr("No shortcut"); color: Colors.secondary-foreground;
            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
        }
    }
    Rectangle {
        x: parent.width - 100px; y: root.compact ? 38px : (parent.height - 40px) / 2;
        width: 100px; height: 40px; border-radius: 6px; background: Colors.background;
        Text {
            width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Unavailable"); color: Colors.secondary-foreground;
            font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component OffsetPreviewField inherits Rectangle {
    in-out property <string> value: "12";
    in property <string> unit: "px";
    in property <int> fallback-value: 12;
    in property <int> min-value: -10000;

    function parsed-value() -> int {
        if root.value.is-float() { return max(root.min-value, round(root.value.to-float())); }
        return root.fallback-value;
    }

    height: 42px;
    border-radius: 6px; border-width: 1px; border-color: Colors.outline;
    background: Colors.background;

    TextInput {
        x: Spacing.medium; width: parent.width - (root.unit == "" ? 72px : 116px); height: parent.height;
        text <=> root.value;
        color: Colors.foreground; font-size: Typography.body-size;
        selection-background-color: Colors.primary-container;
        selection-foreground-color: Colors.foreground;
        vertical-alignment: center;
        accepted => { root.value = root.parsed-value(); }
        changed has-focus => { if !self.has-focus { root.value = root.parsed-value(); } }
    }
    if root.unit != "": Text {
        x: parent.width - 96px; width: 44px; height: parent.height;
        text: root.unit; color: Colors.secondary-foreground;
        font-size: Typography.body-size; vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 44px; y: 1px; width: 43px; height: parent.height - 2px;
        clip: true;

        Rectangle {
            x: 1px; y: 0px; width: parent.width - 1px; height: 20px;
            background: increase-touch.pressed ? Colors.icon-button-pressed
                : increase-touch.has-hover ? Colors.icon-button-hover : transparent;
            Image {
                x: (parent.width - 20px) / 2; y: 0px; width: 20px; height: 20px;
                source: AppAssets.icon-expand-less; image-fit: contain;
                colorize: Colors.secondary-foreground;
            }
            increase-touch := TouchArea {
                clicked => { root.value = root.parsed-value() + 1; }
            }
        }
        Rectangle {
            x: 1px; y: 21px; width: parent.width - 1px; height: parent.height - 21px;
            background: decrease-touch.pressed ? Colors.icon-button-pressed
                : decrease-touch.has-hover ? Colors.icon-button-hover : transparent;
            Image {
                x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2;
                width: 20px; height: 20px;
                source: AppAssets.icon-expand-more; image-fit: contain;
                colorize: Colors.secondary-foreground;
            }
            decrease-touch := TouchArea {
                clicked => { root.value = max(root.min-value, root.parsed-value() - 1); }
            }
        }
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Colors.outline; }
        Rectangle { x: 1px; y: 20px; width: parent.width - 1px; height: 1px; background: Colors.outline; }
    }
}

component SelectionActionRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // 0 is required, 1 is a preview switch, and 2 is unavailable.
    in property <int> status;
    in property <bool> checked: false;
    callback toggled(bool);

    height: Metrics.settings-row-height;

    for dot in [0, 1, 2, 3, 4, 5]: Rectangle {
        x: Math.mod(dot, 2) * 5px; y: 23px + floor(dot / 2) * 6px;
        width: 2px; height: 2px; border-radius: 1px;
        background: Colors.secondary-foreground;
    }
    Image {
        x: 24px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
        source: root.icon; image-fit: contain; colorize: Colors.secondary-foreground;
    }
    Text {
        x: 56px; width: parent.width - 56px - (root.status == 1 ? 64px : 112px);
        height: parent.height; text: root.label; wrap: word-wrap;
        color: root.status == 2 ? Colors.secondary-foreground : Colors.foreground;
        font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
    }
    if root.status == 0: Rectangle {
        x: parent.width - 94px; y: (parent.height - 32px) / 2;
        width: 94px; height: 32px; border-radius: 6px;
        background: Colors.primary-container;
        Text { width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Required"); color: Colors.primary; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.status == 1: SettingsSwitch {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        checked: root.checked; toggled(value) => { root.toggled(value); }
    }
    if root.status == 2: Rectangle {
        x: parent.width - 100px; y: (parent.height - 36px) / 2;
        width: 100px; height: 36px; border-radius: 6px; background: Colors.background;
        Text { width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Unavailable"); color: Colors.secondary-foreground; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}

component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind;
    in property <bool> selected;
    in property <bool> expanded;
    callback activated();

    height: Metrics.settings-nav-item-height;
    border-radius: 10px;
    background: root.selected ? Colors.primary-container
        : nav-touch.pressed ? Colors.icon-button-pressed
        : nav-touch.has-hover || nav-focus.has-focus ? Colors.icon-button-hover : transparent;

    Path {
        x: root.expanded ? Spacing.medium : (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-kind == 4
            ? "M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 0h2v6h-6v-2h4v-4zM10 10h4v4h-4v-4z"
            : root.icon-kind == 3
            ? "M11 2a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7V2zm0 4a5 5 0 1 0 5 5h-2a3 3 0 1 1-3-3V6zm1 5 9 4-4 1-1 4-4-9z"
            : root.icon-kind == 2
            ? "M20 5H4C2.9 5 2 5.9 2 7v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 12H4V7h16v10zM6 9h2v2H6V9zm3 0h2v2H9V9zm3 0h2v2h-2V9zm3 0h3v2h-3V9zM6 12h2v2H6v-2zm3 0h2v2H9v-2zm3 0h2v2h-2v-2zm3 0h3v2h-3v-2zM7 15h10v1H7v-1z"
            : root.icon-kind == 0
            ? "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
            : "M12.87 15.07 10.33 12.56l.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17A15.5 15.5 0 0 1 9 11.35 15.4 15.4 0 0 1 6.91 8H4.91A17.5 17.5 0 0 0 7.67 12.56L2.58 17.58 4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z";
        fill: root.selected ? Colors.primary : Colors.secondary-foreground;
    }

    if root.expanded: Text {
        x: Spacing.medium + Metrics.icon-size + Spacing.small;
        width: parent.width - self.x - Spacing.small;
        height: parent.height;
        text: root.label;
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: root.icon-kind == 3 || root.icon-kind == 4 ? 13px : Typography.body-size;
        font-weight: root.selected ? 700 : 600;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    if !root.expanded && nav-touch.has-hover: Rectangle {
        x: parent.width + Spacing.small;
        y: (parent.height - 36px) / 2;
        width: 112px;
        height: 36px;
        z: 100;
        border-radius: 6px;
        background: Colors.foreground;

        Text {
            text: root.label;
            color: Colors.surface;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    nav-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    nav-touch := TouchArea {
        clicked => {
            nav-focus.focus();
            root.activated();
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("Lexift Settings"); icon: AppAssets.app-icon;
    preferred-width: 820px; preferred-height: 680px; min-width: 520px; min-height: 520px;
    background: Colors.background;
    out property <color> resize-fallback-color: Colors.background;
    callback theme-background-changed();
    changed resize-fallback-color => { root.theme-background-changed(); }

    in-out property <int> draft-target-index: 0;
    in property <string> target-language-error-text: "";
    in property <string> hotkey-error-text: "";
    in property <string> annotation-hotkey-status: @tr("Unavailable");
    in property <string> provider-error-text: "";
    in-out property <bool> launch-at-login: false;
    in-out property <bool> selection-toolbar: true;
    in property <string> launch-at-login-error-text: "";
    in-out property <string> draft-hotkey-label: "Alt + X";
    in-out property <bool> hotkey-capturing: false;
    in-out property <string> draft-provider-id: "deepl";
    in property <bool> credential-configured: false;
    in property <bool> credential-busy: false;
    in property <string> credential-error-text: "";
    in-out property <string> credential-draft: "";
    in-out property <string> credential-transient-secret: "";
    in-out property <bool> credential-revealed: false;
    in-out property <bool> credential-editing: false;
    in-out property <bool> credential-secret-visible: false;
    in-out property <bool> credential-reveal-dismiss-armed: false;
    in-out property <bool> credential-request-pending: false;
    in-out property <bool> settings-menu-open: false;
    in-out property <bool> settings-menu-dismiss-armed: false;
    in-out property <bool> settings-menu-provider-mode: false;
    in-out property <length> settings-menu-scroll-y: 0px;
    in-out property <[SettingsToastData]> toast-items: [];
    in-out property <int> active-category: 0;
    in-out property <int> appearance-theme-index: 0;
    callback theme-selected(int);
    callback ui-language-selected(int);
    in-out property <int> appearance-accent-index: 0;
    in-out property <int> appearance-font-index: 0;
    in-out property <int> appearance-size-index: 1;
    in-out property <int> appearance-language-index: 2;
    in-out property <int> tray-click-index: 0;
    in-out property <bool> open-settings-on-launch: true;
    in-out property <bool> check-updates-on-launch: true;
    in-out property <bool> background-copy-notifications: true;
    in-out property <bool> anonymous-usage-statistics: false;
    in-out property <bool> disable-hotkeys-in-fullscreen: false;
    in-out property <bool> selection-double-click: true;
    in-out property <string> selection-horizontal-offset: "12";
    in-out property <string> selection-vertical-offset: "12";
    in-out property <int> selection-filter-mode-index: 0;
    in-out property <bool> selection-copy-action: true;
    in-out property <bool> screenshot-crosshair-guides: false;
    in-out property <bool> screenshot-magnifier: true;
    in-out property <bool> screenshot-selection-dimensions: true;
    in-out property <string> screenshot-line-width: "3";
    in-out property <string> screenshot-text-size: "22";
    in-out property <string> screenshot-save-location: "";
    in-out property <int> screenshot-format-index: 0;
    in-out property <bool> screenshot-copy-as-file: false;
    in-out property <bool> screenshot-close-after-output: false;
    private property <bool> preview-menu-open: false;
    private property <int> preview-menu-kind: 0;
    private property <length> preview-menu-scroll-y: 0px;

    // Measure localized navigation text instead of breaking long words mid-label.
    navigation-measure := Text {
        visible: false; font-size: Typography.body-size; font-weight: 600;
        text: @tr("General") + "\n" + @tr("Hotkeys") + "\n" + @tr("Selection Assistant") + "\n" + @tr("Screenshot settings") + "\n" + @tr("Translation");
    }
    private property <bool> expanded-navigation: root.width >= Metrics.settings-wide-nav-breakpoint;
    private property <length> sidebar-width: root.expanded-navigation ? max(Metrics.settings-sidebar-width, navigation-measure.preferred-width + 80px) : Metrics.settings-sidebar-compact-width;
    private property <bool> two-column-layout: root.width >= Metrics.settings-two-column-breakpoint;
    private property <bool> hotkeys-compact: root.page-width < 580px;
    private property <length> page-width: root.width - root.sidebar-width;
    private property <[string]> language-labels: [
        "简体中文", "繁體中文", "English (US)", "English (UK)", "日本語", "한국어",
        "Deutsch", "Français", "Español", "Italiano", "Português (Portugal)", "Português (Brasil)"
    ];
    private property <[color]> appearance-accents: [
        #1967d2, #9c4da0, #ec4899, #ff5a5f, #fa8324, #ffbe0b, #5baa43
    ];
    private property <[string]> appearance-fonts: [@tr("System default"), "Segoe UI", "Arial"];
    private property <[string]> appearance-sizes: [@tr("Compact"), @tr("Standard"), @tr("Large")];
    private property <[string]> appearance-languages: root.language-labels;
    private property <[string]> tray-click-actions: [@tr("Open settings"), @tr("Open main window"), @tr("Do nothing")];
    private property <[string]> selection-filter-modes: [@tr("Blacklist"), @tr("Whitelist")];
    private property <[string]> screenshot-formats: ["PNG", "JPEG", "WebP"];
    private property <[string]> preview-menu-options: root.preview-menu-kind == 0
        ? root.appearance-fonts : root.preview-menu-kind == 1 ? root.appearance-sizes
            : root.preview-menu-kind == 2 ? root.appearance-languages
                : root.preview-menu-kind == 3 ? root.tray-click-actions
                    : root.preview-menu-kind == 4 ? root.selection-filter-modes : root.screenshot-formats;
    private property <length> preview-menu-anchor-x: root.preview-menu-kind == 0
        ? font-preview.absolute-position.x : root.preview-menu-kind == 1
            ? size-preview.absolute-position.x : root.preview-menu-kind == 2
                ? app-language-preview.absolute-position.x : root.preview-menu-kind == 3
                    ? tray-click-preview.absolute-position.x : root.preview-menu-kind == 4
                        ? filter-mode-preview.absolute-position.x : screenshot-format-preview.absolute-position.x;
    private property <length> preview-menu-anchor-y: root.preview-menu-kind == 0
        ? font-preview.absolute-position.y : root.preview-menu-kind == 1
            ? size-preview.absolute-position.y : root.preview-menu-kind == 2
                ? app-language-preview.absolute-position.y : root.preview-menu-kind == 3
                    ? tray-click-preview.absolute-position.y : root.preview-menu-kind == 4
                        ? filter-mode-preview.absolute-position.y : screenshot-format-preview.absolute-position.y;
    private property <length> preview-menu-anchor-width: root.preview-menu-kind == 0
        ? font-preview.width : root.preview-menu-kind == 1 ? size-preview.width
            : root.preview-menu-kind == 2 ? app-language-preview.width
                : root.preview-menu-kind == 3 ? tray-click-preview.width
                    : root.preview-menu-kind == 4 ? filter-mode-preview.width : screenshot-format-preview.width;
    private property <length> preview-menu-anchor-height: root.preview-menu-kind == 0
        ? font-preview.height : root.preview-menu-kind == 1 ? size-preview.height
            : root.preview-menu-kind == 2 ? app-language-preview.height
                : root.preview-menu-kind == 3 ? tray-click-preview.height
                    : root.preview-menu-kind == 4 ? filter-mode-preview.height : screenshot-format-preview.height;
    private property <length> settings-menu-anchor-x: root.settings-menu-provider-mode ? provider-selector.absolute-position.x : language-selector.absolute-position.x;
    private property <length> settings-menu-anchor-y: root.settings-menu-provider-mode ? provider-selector.absolute-position.y : language-selector.absolute-position.y;
    private property <length> settings-menu-anchor-height: root.settings-menu-provider-mode ? provider-selector.height : language-selector.height;
    private property <length> settings-menu-anchor-width: root.settings-menu-provider-mode ? provider-selector.width : language-selector.width;

    callback hotkey-key-pressed(string, bool, bool, bool, bool) -> string;
    callback hotkey-change-requested(string);
    callback launch-at-login-change-requested(bool);
    callback selection-toolbar-change-requested(bool);
    callback credential-save-requested(string);
    callback credential-remove-requested();
    callback credential-reveal-requested();
    callback credential-edit-requested();
    callback credential-copy-requested();
    callback credential-hide-requested();
    callback credential-edit-cancel-requested();
    callback settings-menu-selected(int);
    callback toast-dismiss-requested(int);

    public function focus-credential-reveal() { credential-reveal-input.focus(); }
    public function focus-credential-edit() { credential-edit-input.focus(); }
    public function focus-hotkey-capture() { hotkey-capture.focus(); }
    public function focus-settings-menu() { settings-menu-focus.focus(); }
    public function close-settings-menu() { settings-menu-open = false; settings-menu-dismiss-armed = false; }
    public function close-preview-menu() { preview-menu-open = false; }
    public function reset-settings-view() {
        root.close-settings-menu(); root.close-preview-menu(); root.hotkey-capturing = false; root.active-category = 0;
        general-scroll.content-y = 0px; translation-scroll.content-y = 0px;
        hotkeys-scroll.content-y = 0px; selection-assistant-scroll.content-y = 0px;
        screenshot-scroll.content-y = 0px;
    }
    function select-category(category: int) {
        if root.active-category == category { return; }
        root.close-settings-menu(); root.close-preview-menu(); root.hotkey-capturing = false;
        if root.active-category == 1 { root.credential-edit-cancel-requested(); }
        root.active-category = category;
    }

    root-content := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;

    sidebar := Rectangle {
        x: 0px; y: 0px; width: root.sidebar-width; height: root-content.height; z: 10; background: Colors.surface;
        Image {
            x: root.expanded-navigation ? Spacing.medium : (parent.width - 28px) / 2;
            y: Spacing.large; width: 28px; height: 28px;
            source: AppAssets.app-icon; image-fit: contain;
        }
        if root.expanded-navigation: Text {
            x: Spacing.medium + 40px; y: Spacing.large - 6px;
            width: parent.width - self.x - Spacing.medium; height: 40px;
            text: "Lexift"; color: Colors.foreground; font-size: 20px; font-weight: 700; vertical-alignment: center;
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px; width: parent.width - 2 * self.x;
            label: @tr("General"); icon-kind: 0; selected: root.active-category == 0; expanded: root.expanded-navigation;
            activated => { root.select-category(0); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + Metrics.settings-nav-item-height + Spacing.small;
            width: parent.width - 2 * self.x;
            label: @tr("Hotkeys"); icon-kind: 2; selected: root.active-category == 2; expanded: root.expanded-navigation;
            activated => { root.select-category(2); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 2 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Selection Assistant"); icon-kind: 3; selected: root.active-category == 3; expanded: root.expanded-navigation;
            activated => { root.select-category(3); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 3 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Screenshot settings"); icon-kind: 4; selected: root.active-category == 4; expanded: root.expanded-navigation;
            activated => { root.select-category(4); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 4 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Translation"); icon-kind: 1; selected: root.active-category == 1; expanded: root.expanded-navigation;
            activated => { root.select-category(1); }
        }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.outline; }
    }

    main-pane := Rectangle {
        x: root.sidebar-width; y: 0px; width: root.width - root.sidebar-width; height: root.height;
        clip: true;

    header := Rectangle {
        x: 0px; y: 0px; width: main-pane.width; height: Metrics.settings-header-height; z: 5; background: Colors.surface;
        Text {
            x: Metrics.settings-page-padding; y: (parent.height - 32px) / 2; height: 32px;
            text: root.active-category == 0 ? @tr("General") : root.active-category == 2 ? @tr("Hotkeys")
                : root.active-category == 3 ? @tr("Selection Assistant")
                    : root.active-category == 4 ? @tr("Screenshot settings") : @tr("Translation");
            color: Colors.foreground; font-size: 24px; font-weight: 700; vertical-alignment: center;
        }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Colors.outline; }
    }

    general-scroll := ScrollView {
        visible: root.active-category == 0;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, privacy-card.y + privacy-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => {
            root.close-preview-menu();
            if root.settings-menu-open && (root.settings-menu-anchor-y < Metrics.settings-header-height || root.settings-menu-anchor-y + root.settings-menu-anchor-height > root.height) { root.close-settings-menu(); }
        }

        language-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: appearance-card.y + appearance-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Language & region");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.small;
                SettingsFieldLabel { label: @tr("Target language"); description: @tr("Language used for new translations"); error-text: root.target-language-error-text; }
                language-selector := Rectangle {
                    height: 40px; border-radius: 6px; border-width: 1px; border-color: Colors.outline; background: Colors.background;
                    Text { x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 24px; text: root.language-labels[root.draft-target-index]; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                    Path {
                        x: parent.width - Spacing.medium - 16px; y: (parent.height - 8px) / 2; width: 16px; height: 8px; viewbox-width: 16; viewbox-height: 8; stroke: Colors.secondary-foreground; stroke-width: 1.5px;
                        MoveTo { x: 1; y: root.settings-menu-open ? 7 : 1; } LineTo { x: 8; y: root.settings-menu-open ? 1 : 7; } LineTo { x: 15; y: root.settings-menu-open ? 7 : 1; }
                    }
                    TouchArea { clicked => { root.toggle-language-menu(); } }
                }
            }
        }

        appearance-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: Metrics.settings-page-padding;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Appearance");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.medium;
                Text { height: 22px; text: @tr("App theme"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                HorizontalLayout {
                    width: 100%; height: 106px; spacing: Spacing.small;
                    for theme in [0, 1, 2]: AppearanceThemeChoice {
                        width: (parent.width - 2 * Spacing.small) / 3;
                        theme-kind: theme; selected: root.appearance-theme-index == theme;
                        chosen => { root.theme-selected(theme); root.close-preview-menu(); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Text { height: 22px; text: @tr("Accent color"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                HorizontalLayout {
                    width: 100%; height: 36px; spacing: Spacing.small;
                    for accent[index] in root.appearance-accents: AppearanceAccentChoice {
                        swatch: accent; selected: root.appearance-accent-index == index;
                        chosen => { root.appearance-accent-index = index; root.close-preview-menu(); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("App font"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    font-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-fonts[root.appearance-font-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 0;
                        clicked => { root.toggle-preview-menu(0); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("Text size"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    size-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-sizes[root.appearance-size-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 1;
                        clicked => { root.toggle-preview-menu(1); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("App language"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    app-language-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-languages[root.appearance-language-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 2;
                        clicked => { root.toggle-preview-menu(2); }
                    }
                }
            }
        }

        startup-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: language-card.y + language-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Startup & updates");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Launch at startup"); description: ""; error-text: root.launch-at-login-error-text; }
                    SettingsSwitch { checked: root.launch-at-login; toggled(value) => { root.launch-at-login = value; root.launch-at-login-change-requested(value); } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("On tray icon click"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    tray-click-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.tray-click-actions[root.tray-click-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 3;
                        clicked => { root.toggle-preview-menu(3); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Open settings on launch");
                        description: @tr("Start in the background when this is off."); error-text: "";
                    }
                    SettingsSwitch { checked: root.open-settings-on-launch; toggled(value) => { root.open-settings-on-launch = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Check for updates on launch"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.check-updates-on-launch; toggled(value) => { root.check-updates-on-launch = value; } }
                }
            }
        }

        privacy-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: startup-card.y + startup-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Notifications & privacy");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Show background copy notifications");
                        description: @tr("Shows background copy results and errors."); error-text: "";
                    }
                    SettingsSwitch { checked: root.background-copy-notifications; toggled(value) => { root.background-copy-notifications = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Anonymous usage statistics");
                        description: @tr("No translation text or personal data."); error-text: "";
                    }
                    SettingsSwitch { checked: root.anonymous-usage-statistics; toggled(value) => { root.anonymous-usage-statistics = value; } }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 0;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: general-scroll.visible-height;
        content-height: general-scroll.content-height;
        content-y <=> general-scroll.content-y;
    }
    hotkeys-scroll := ScrollView {
        visible: root.active-category == 2;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, annotation-hotkeys-card.y + annotation-hotkeys-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;

        behavior-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: hotkeys-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Behavior");
            HorizontalLayout {
                width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                SettingsFieldLabel {
                    width: parent.width - 52px - Spacing.medium;
                    label: @tr("Disable hotkeys in fullscreen apps");
                    description: @tr("No global hotkeys in fullscreen apps.");
                    error-text: "";
                }
                SettingsSwitch {
                    checked: root.disable-hotkeys-in-fullscreen;
                    toggled(value) => { root.disable-hotkeys-in-fullscreen = value; }
                }
            }
        }

        input-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: behavior-hotkeys-card.y + behavior-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width;
            title: @tr("Input");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Input translation"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Inline input translation"); }
            }
        }

        selection-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: input-hotkeys-card.y + input-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width;
            title: @tr("Selection");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 112px : 76px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Translate selection");
                        description: root.hotkey-capturing ? @tr("Press a key combination") : @tr("Translate the current selection");
                        error-text: root.hotkey-error-text;
                    }
                    hotkey-field := Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? 58px : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.hotkey-capturing ? 2px : 1px;
                        border-color: root.hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.hotkey-capturing ? @tr("Press shortcut…") : root.draft-hotkey-label;
                            color: root.hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        hotkey-capture := FocusScope {
                            key-pressed(event) => {
                                if !root.hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.hotkey-change-requested(captured); root.draft-hotkey-label = captured; root.hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? 58px : (parent.height - 40px) / 2;
                        width: 84px; label: root.hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.hotkey-capturing = !root.hotkey-capturing;
                            if root.hotkey-capturing { root.focus-hotkey-capture(); }
                        }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Translate selection and copy"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Translate selection and replace"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Read selection aloud"); }
            }
        }
        annotation-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-hotkeys-card.y + selection-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width; title: @tr("Annotation");
            VerticalLayout {
                spacing: Spacing.small;
                Text { text: @tr("Annotation toolbar — Alt + A"); color: Colors.foreground; font-size: Typography.body-size; }
                Text { text: root.annotation-hotkey-status; color: Colors.secondary-foreground; font-size: 13px; wrap: word-wrap; }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 2;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: hotkeys-scroll.visible-height;
        content-height: hotkeys-scroll.content-height;
        content-y <=> hotkeys-scroll.content-y;
    }
    selection-assistant-scroll := ScrollView {
        visible: root.active-category == 3;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, selection-actions-card.y + selection-actions-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { root.close-preview-menu(); }

        selection-basic-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: selection-assistant-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Basic settings");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium;
                        label: @tr("Enable selection assistant"); description: @tr("Show Translate and Copy after selecting text"); error-text: ""; }
                    SettingsSwitch { checked: root.selection-toolbar;
                        toggled(value) => { root.selection-toolbar = value; root.selection-toolbar-change-requested(value); } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium;
                        label: @tr("Detect double-click selection"); description: @tr("Show the assistant after selecting a word by double-clicking"); error-text: ""; }
                    SettingsSwitch { checked: root.selection-double-click;
                        toggled(value) => { root.selection-double-click = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        label: @tr("Horizontal offset"); description: @tr("Positive values move the toolbar right"); error-text: "";
                    }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 52px : 11px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value <=> root.selection-horizontal-offset;
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        label: @tr("Vertical offset"); description: @tr("Positive values move the toolbar down"); error-text: "";
                    }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 52px : 11px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value <=> root.selection-vertical-offset;
                    }
                }
            }
        }

        selection-filter-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-basic-card.y + selection-basic-card.height + Metrics.settings-card-gap;
            width: selection-basic-card.width;
            title: @tr("App filtering");
            Rectangle {
                width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                SettingsFieldLabel {
                    x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                    width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                    label: @tr("Filter mode"); description: @tr("Choose where the assistant would appear"); error-text: "";
                }
                filter-mode-preview := AppearancePreviewField {
                    x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                    y: root.hotkeys-compact ? 52px : 11px;
                    width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                    value: root.selection-filter-modes[root.selection-filter-mode-index];
                    opened: root.preview-menu-open && root.preview-menu-kind == 4;
                    clicked => { root.toggle-preview-menu(4); }
                }
            }
        }
        selection-app-list-heading := Rectangle {
            x: Metrics.settings-page-padding;
            y: selection-filter-card.y + selection-filter-card.height + Metrics.settings-card-gap;
            width: selection-basic-card.width; height: 40px;
            Text { width: parent.width - 120px; height: parent.height; text: @tr("App list");
                color: Colors.secondary-foreground; font-size: Typography.body-size; vertical-alignment: center; }
            SettingsButton { x: parent.width - self.width; label: @tr("Add app"); enabled: false; }
        }
        selection-app-list-empty := Rectangle {
            x: Metrics.settings-page-padding;
            y: selection-app-list-heading.y + selection-app-list-heading.height + Spacing.small;
            width: selection-basic-card.width; height: 68px;
            border-radius: Metrics.settings-card-radius; background: Colors.surface;
            Text { text: @tr("No apps added"); color: Colors.secondary-foreground;
                font-size: Typography.body-size; horizontal-alignment: center; vertical-alignment: center; }
        }

        selection-actions-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-app-list-empty.y + selection-app-list-empty.height + Metrics.settings-card-gap;
            width: selection-basic-card.width;
            title: @tr("Selection actions");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                SelectionActionRow { width: 100%; label: @tr("Translate"); icon: AppAssets.icon-translate; status: 0; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Translate and copy"); icon: AppAssets.icon-copy; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Translate and replace"); icon: AppAssets.icon-refresh; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Read aloud"); icon: AppAssets.icon-volume; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Copy"); icon: AppAssets.icon-copy; status: 1;
                    checked: root.selection-copy-action; toggled(value) => { root.selection-copy-action = value; } }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Paste"); icon: AppAssets.icon-paste; status: 2; }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 3;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: selection-assistant-scroll.visible-height;
        content-height: selection-assistant-scroll.content-height;
        content-y <=> selection-assistant-scroll.content-y;
    }
    screenshot-scroll := ScrollView {
        visible: root.active-category == 4;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, screenshot-output-card.y + screenshot-output-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { root.close-preview-menu(); }

        screenshot-selection-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: screenshot-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Selection");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Crosshair guides"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-crosshair-guides; toggled(value) => { root.screenshot-crosshair-guides = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Magnifier"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-magnifier; toggled(value) => { root.screenshot-magnifier = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Show selection dimensions"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-selection-dimensions; toggled(value) => { root.screenshot-selection-dimensions = value; } }
                }
            }
        }

        screenshot-annotation-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: screenshot-selection-card.y + screenshot-selection-card.height + Metrics.settings-card-gap;
            width: screenshot-selection-card.width;
            title: @tr("Default annotation style");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: root.hotkeys-compact ? 0px : 0px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Annotation color"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    SettingsButton {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 8px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        label: @tr("Select color"); clicked => { }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Line width"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        unit: ""; fallback-value: 3; min-value: 1;
                        value <=> root.screenshot-line-width;
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Text size"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        unit: ""; fallback-value: 22; min-value: 1;
                        value <=> root.screenshot-text-size;
                    }
                }
            }
        }

        screenshot-output-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: screenshot-annotation-card.y + screenshot-annotation-card.height + Metrics.settings-card-gap;
            width: screenshot-selection-card.width;
            title: @tr("Image output");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Save location"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.42 - 96px;
                        height: 42px; border-radius: 6px; border-width: 1px;
                        border-color: Colors.outline; background: Colors.background;
                        TextInput {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text <=> root.screenshot-save-location;
                            color: Colors.foreground; font-size: Typography.body-size;
                            selection-background-color: Colors.primary-container;
                            selection-foreground-color: Colors.foreground; vertical-alignment: center;
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? 44px : 8px;
                        width: 84px; label: @tr("Browse"); clicked => { }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Image format"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    screenshot-format-preview := AppearancePreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value: root.screenshot-formats[root.screenshot-format-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 5;
                        clicked => { root.toggle-preview-menu(5); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Copy image as file"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-copy-as-file; toggled(value) => { root.screenshot-copy-as-file = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Close after copying or saving"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-close-after-output; toggled(value) => { root.screenshot-close-after-output = value; } }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 4;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: screenshot-scroll.visible-height;
        content-height: screenshot-scroll.content-height;
        content-y <=> screenshot-scroll.content-y;
    }
    translation-scroll := ScrollView {
        visible: root.active-category == 1;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, credential-card.y + credential-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { if root.settings-menu-open && (root.settings-menu-anchor-y < Metrics.settings-header-height || root.settings-menu-anchor-y + root.settings-menu-anchor-height > root.height) { root.close-settings-menu(); } }

        provider-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: root.two-column-layout
                ? (translation-scroll.visible-width - 2 * Metrics.settings-page-padding - Metrics.settings-card-gap) / 2
                : translation-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Provider");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.small;
                SettingsFieldLabel { label: @tr("Translation provider"); description: ""; error-text: root.provider-error-text; }
                provider-selector := Rectangle {
                    height: 40px; border-radius: 6px; border-width: 1px; border-color: Colors.outline; background: Colors.background;
                    Text { x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 24px; text: "DeepL"; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    Path {
                        x: parent.width - Spacing.medium - 16px; y: (parent.height - 8px) / 2; width: 16px; height: 8px; viewbox-width: 16; viewbox-height: 8; stroke: Colors.secondary-foreground; stroke-width: 1.5px;
                        MoveTo { x: 1; y: root.settings-menu-open && root.settings-menu-provider-mode ? 7 : 1; } LineTo { x: 8; y: root.settings-menu-open && root.settings-menu-provider-mode ? 1 : 7; } LineTo { x: 15; y: root.settings-menu-open && root.settings-menu-provider-mode ? 7 : 1; }
                    }
                    TouchArea { clicked => { root.toggle-provider-menu(); } }
                }
            }
        }

        credential-card := SettingsCard {
            x: root.two-column-layout ? provider-card.x + provider-card.width + Metrics.settings-card-gap : Metrics.settings-page-padding;
            y: root.two-column-layout ? Metrics.settings-page-padding : provider-card.y + provider-card.height + Metrics.settings-card-gap;
            width: provider-card.width; title: @tr("Credentials");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: 24px;
                    Text { text: @tr("DeepL API Key"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                    Text { text: root.credential-configured ? @tr("Configured") : @tr("Not configured"); color: root.credential-configured ? Colors.primary : Colors.secondary-foreground; font-size: 13px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                }

                credential-field := Rectangle {
                    height: 40px; border-radius: 6px;
                    border-width: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? 2px : 1px;
                    border-color: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? Colors.primary : Colors.outline;
                    background: Colors.background;
                    field-hover := TouchArea {
                        enabled: root.credential-configured && !root.credential-editing && !root.credential-revealed && !root.credential-request-pending;
                        clicked => {
                            if self.mouse-x >= self.width - 4 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - 3 * Metrics.icon-button-size - 4px { root.credential-reveal-requested(); }
                            else if self.mouse-x >= self.width - 3 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - 2 * Metrics.icon-button-size - 4px { root.credential-copy-requested(); }
                            else if self.mouse-x >= self.width - 2 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - Metrics.icon-button-size - 4px { root.credential-edit-requested(); }
                            else if self.mouse-x >= self.width - Metrics.icon-button-size - 4px && self.mouse-x < self.width - 4px { root.credential-remove-requested(); }
                        }
                    }
                    if !root.credential-configured: credential-new-input := TextInput {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height; text <=> root.credential-draft; input-type: InputType.password; enabled: !root.credential-busy;
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; text-cursor-width: 2px; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy { root.credential-save-requested(root.credential-draft); } }
                    }
                    if root.credential-configured && !root.credential-editing && !root.credential-revealed: Text {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 4 * Metrics.icon-button-size; height: parent.height; text: "••••••••••••••••"; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                    }
                    credential-reveal-input := TextInput {
                        visible: root.credential-configured && root.credential-revealed && !root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text: root.credential-transient-secret; read-only: true;
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        changed has-focus => { if !self.has-focus && root.credential-revealed && root.credential-reveal-dismiss-armed { root.credential-hide-requested(); } }
                    }
                    credential-edit-input := TextInput {
                        visible: root.credential-configured && root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text <=> root.credential-draft;
                        input-type: root.credential-secret-visible ? InputType.text : InputType.password; enabled: !root.credential-busy;
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy { root.credential-save-requested(root.credential-draft); } }
                    }
                    if root.credential-configured && !root.credential-editing && !root.credential-revealed: HorizontalLayout {
                        x: parent.width - 4 * Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2; width: 4 * Metrics.icon-button-size; spacing: 0px;
                        opacity: field-hover.has-hover && !root.credential-request-pending ? 1 : 0;
                        CredentialActionButton { icon-kind: 0; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 4 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 3 * Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 1; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 3 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 2 * Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 2; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 2 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 3; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 4px; pressed: field-hover.pressed && self.highlighted; }
                    }
                    if root.credential-configured && root.credential-request-pending && !root.credential-editing: Text {
                        x: parent.width - Spacing.medium - 88px; width: 88px; height: parent.height; text: @tr("Loading…"); color: Colors.secondary-foreground; font-size: 13px; horizontal-alignment: right; vertical-alignment: center;
                    }
                    if root.credential-configured && (root.credential-editing || root.credential-revealed): CredentialActionButton {
                        x: parent.width - Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2;
                        icon-kind: root.credential-revealed || root.credential-secret-visible ? 4 : 0;
                        clicked => { if root.credential-editing { root.credential-secret-visible = !root.credential-secret-visible; } else { root.credential-hide-requested(); } }
                    }
                }

                Text { height: 18px; text: root.credential-error-text; color: Colors.error; font-size: 13px; overflow: elide; }
                HorizontalLayout {
                    width: 100%; height: 40px; spacing: Spacing.small; alignment: end;
                    SettingsButton { width: 96px; visible: root.credential-editing; label: @tr("Cancel"); enabled: !root.credential-busy; clicked => { root.credential-edit-cancel-requested(); } }
                    SettingsButton {
                        width: 128px; visible: root.credential-editing || (!root.credential-configured && (root.credential-draft != "" || root.credential-busy));
                        primary: true; label: root.credential-busy ? @tr("Working…") : @tr("Save key"); enabled: root.credential-draft != "" && !root.credential-busy;
                        clicked => { root.credential-save-requested(root.credential-draft); }
                    }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 1;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: translation-scroll.visible-height;
        content-height: translation-scroll.content-height;
        content-y <=> translation-scroll.content-y;
    }
    }
    }
    function toggle-language-menu() {
        root.close-preview-menu();
        if root.settings-menu-open && !root.settings-menu-provider-mode { root.close-settings-menu(); }
        else {
            root.settings-menu-provider-mode = false;
            root.settings-menu-scroll-y = round(min(0px, max(settings-menu.height - root.language-labels.length * 40px, settings-menu.height / 2 - (root.draft-target-index + 0.5) * 40px)) / 4px) * 4px;
            root.settings-menu-open = true; root.settings-menu-dismiss-armed = true; root.focus-settings-menu();
        }
    }
    function toggle-provider-menu() {
        root.close-preview-menu();
        if root.settings-menu-open && root.settings-menu-provider-mode { root.close-settings-menu(); }
        else {
            root.settings-menu-provider-mode = true; root.settings-menu-scroll-y = 0px;
            root.settings-menu-open = true; root.settings-menu-dismiss-armed = true; root.focus-settings-menu();
        }
    }
    function toggle-preview-menu(kind: int) {
        if root.preview-menu-open && root.preview-menu-kind == kind { root.close-preview-menu(); }
        else {
            root.close-settings-menu();
            root.preview-menu-kind = kind;
            root.preview-menu-scroll-y = 0px;
            root.preview-menu-open = true;
            preview-menu-focus.focus();
        }
    }

    overlay := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; z: 80;

    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height; z: 10;
        enabled: (root.settings-menu-open && root.settings-menu-dismiss-armed) || root.preview-menu-open;
        clicked => { root.close-settings-menu(); root.close-preview-menu(); }
    }
    settings-menu := SettingsSelectMenu {
        visible: root.settings-menu-open; z: 15;
        x: round(root.settings-menu-anchor-x / 1px) * 1px;
        y: round((root.settings-menu-anchor-y + root.settings-menu-anchor-height + 2px) / 1px) * 1px;
        width: round(root.settings-menu-anchor-width / 1px) * 1px;
        height: round(min((root.settings-menu-provider-mode ? 1 : root.language-labels.length) * 40px, max(0px, root.height - self.y - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.settings-menu-provider-mode ? ["DeepL"] : root.language-labels;
        selected-index: root.settings-menu-provider-mode ? 0 : root.draft-target-index;
        scroll-y <=> root.settings-menu-scroll-y;
        selected(index) => { root.settings-menu-selected(index); root.close-settings-menu(); }
    }
    settings-menu-focus := FocusScope {
        visible: root.settings-menu-open; x: settings-menu.x; y: settings-menu.y; width: settings-menu.width; height: settings-menu.height; z: 16;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-settings-menu(); return accept; }
            return reject;
        }
    }
    preview-menu := SettingsSelectMenu {
        visible: root.preview-menu-open; z: 15;
        x: round(root.preview-menu-anchor-x / 1px) * 1px;
        y: round((root.preview-menu-anchor-y + root.preview-menu-anchor-height + self.height + Metrics.settings-page-padding + 2px <= root.height
            ? root.preview-menu-anchor-y + root.preview-menu-anchor-height + 2px
            : max(Metrics.settings-header-height + 4px, root.preview-menu-anchor-y - self.height - 2px)) / 1px) * 1px;
        width: round(root.preview-menu-anchor-width / 1px) * 1px;
        height: round(min(root.preview-menu-options.length * 40px, max(0px, root.height - Metrics.settings-header-height - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.preview-menu-options;
        selected-index: root.preview-menu-kind == 0 ? root.appearance-font-index
            : root.preview-menu-kind == 1 ? root.appearance-size-index
                : root.preview-menu-kind == 2 ? root.appearance-language-index
                    : root.preview-menu-kind == 3 ? root.tray-click-index
                        : root.preview-menu-kind == 4 ? root.selection-filter-mode-index : root.screenshot-format-index;
        scroll-y <=> root.preview-menu-scroll-y;
        selected(index) => {
            if root.preview-menu-kind == 0 { root.appearance-font-index = index; }
            else if root.preview-menu-kind == 1 { root.appearance-size-index = index; }
            else if root.preview-menu-kind == 2 { root.ui-language-selected(index); }
            else if root.preview-menu-kind == 3 { root.tray-click-index = index; }
            else if root.preview-menu-kind == 4 { root.selection-filter-mode-index = index; }
            else { root.screenshot-format-index = index; }
            root.close-preview-menu();
        }
    }
    preview-menu-focus := FocusScope {
        visible: root.preview-menu-open;
        x: preview-menu.x; y: preview-menu.y;
        width: preview-menu.width; height: preview-menu.height; z: 16;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-preview-menu(); return accept; }
            return reject;
        }
    }
    for toast[index] in root.toast-items: SettingsToast {
        x: root.sidebar-width + max(Spacing.medium, (root.page-width - self.width) / 2);
        y: Spacing.medium + index * (Metrics.toast-height + Spacing.small); z: 30;
        message: toast.message; error: toast.error;
        dismissed => { root.toast-dismiss-requested(toast.id); }
    }
    }
}
