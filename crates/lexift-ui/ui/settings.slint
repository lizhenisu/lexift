import { SettingsSwitch, SettingsButton, SettingsSelectMenu, SettingsCard, SettingsTextBlock, SettingsControlRow, SettingsSelectField, SettingsComboBox } from "settings-controls.slint";
import { OcrProviderPage, OcrResourceRow } from "ocr-provider.slint";
export { OcrResourceRow }
import { AppToast } from "design/toast.slint";
import { CopyFeedbackIcon } from "design/copy-feedback.slint";
import { AboutPage } from "about.slint";
import { SettingsHints, SettingsHintTarget, SettingsHintOverlay } from "settings-hint.slint";
import { SettingsScrollArea } from "settings-scroll-area.slint";
import { SettingsColors } from "settings-colors.slint";
import { SettingsInteraction, SettingsFocusScope } from "settings-interaction.slint";
import { ProviderModelRow, ProviderIconButton, ProviderInput, ProviderModelItem, ProviderDialog, ProviderFilterBar, ProviderProbeRow, TranslationChoice, ProviderLogo } from "provider-controls.slint";
export { ProviderModelRow, ProviderProbeRow, TranslationChoice }
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
import { Metrics } from "design/metrics.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";
import { Slider, SpinBox } from "annotation-fields.slint";
import { ScrollView } from "std-widgets.slint";

export struct ServiceProviderRow { provider-id: string, label: string, group-title: string, icon-index: int }



component CredentialActionButton inherits Rectangle {
    in property <bool> copied: false;
    in property <int> icon-kind;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    in property <bool> highlighted: false;
    in property <bool> pressed: false;
    callback clicked();
    public function focus-button() { keyboard.focus-target(); }
    private property <string> action-label: root.icon-kind == 0 ? @tr("View key") : root.icon-kind == 1 ? @tr("Copy") : root.icon-kind == 2 ? @tr("Edit key") : root.icon-kind == 3 ? @tr("Delete key") : @tr("Hide key");
    accessible-role: button; accessible-label: root.action-label; accessible-enabled: root.enabled;

    width: Metrics.icon-button-size;
    height: Metrics.icon-button-size;
    border-radius: Metrics.icon-button-radius;
    opacity: root.enabled ? 1 : Metrics.disabled-opacity;
    background: root.pressed || (root.interactive && action-touch.pressed)
        ? SettingsColors.pressed
        : root.highlighted || (root.interactive && action-touch.has-hover)
            ? SettingsColors.hover : transparent;

    if root.icon-kind != 1: Image {
        x: (parent.width - Metrics.icon-size) / 2; y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size; height: Metrics.icon-size; colorize: Colors.secondary-foreground;
        source: root.icon-kind == 0 ? @image-url("icons/credential-reveal.svg") : root.icon-kind == 1 ? @image-url("icons/credential-copy.svg") : root.icon-kind == 2 ? @image-url("icons/credential-edit.svg") : root.icon-kind == 3 ? @image-url("icons/credential-delete.svg") : @image-url("icons/credential-hide.svg");
    }

    if root.icon-kind == 1: CopyFeedbackIcon {x: (parent.width - Metrics.icon-size) / 2; y: (parent.height - Metrics.icon-size) / 2; width: Metrics.icon-size; height: Metrics.icon-size; copied: root.copied; normal-color: Colors.secondary-foreground;}
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: Metrics.icon-button-radius;
        border-width: keyboard.focus-visible ? 1px : 0px; border-color: Colors.primary; background: transparent; }
    keyboard := SettingsFocusScope { enabled: root.enabled && root.interactive;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    action-touch := TouchArea {
        enabled: root.enabled && root.interactive;
        mouse-cursor: pointer; clicked => { SettingsInteraction.pointer-input(); keyboard.focus-target(); root.clicked(); }
    }
    SettingsHintTarget { active: root.enabled && action-touch.has-hover; text: root.action-label; anchor-x: root.absolute-position.x; anchor-y: root.absolute-position.y; anchor-height: root.height; }

}


component ProviderCredentialField inherits Rectangle {
    in property <bool> credential-copy-active;
    in property <bool> credential-copied;
    in property <bool> credential-configured;
    in property <bool> credential-busy;
    in property <bool> operation-blocked: false;
    in property <bool> credential-editing;
    in property <bool> credential-revealed;
    in property <bool> credential-request-pending;
    in property <bool> credential-reveal-dismiss-armed;
    in-out property <bool> credential-secret-visible;
    in-out property <string> credential-draft;
    in property <string> credential-transient-secret;
    in property <string> credential-error-text;
    in property <bool> can-remove: true;
    callback credential-reveal-requested();
    callback credential-copy-requested();
    callback credential-edit-requested();
    callback credential-remove-requested();
    callback credential-hide-requested();
    callback credential-edit-cancel-requested();
    callback credential-edit-blurred();
    callback credential-save-requested(string);
    public function focus-remove() { delete-key-button.focus-button(); }
    public function focus-reveal() { credential-reveal-input.focus(); }
    public function focus-edit() { credential-edit-input.focus(); }
    public pure function edit-focused() -> bool { return credential-edit-input.has-focus; }
    height: contents.preferred-height;
    contents := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: Spacing.small;
                credential-field := Rectangle {
                    height: 40px; border-radius: 6px;
                    border-width: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? 2px : 1px;
                    border-color: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? Colors.primary : Colors.outline;
                    background: Colors.background;
                    if !root.credential-configured: credential-new-input := TextInput {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height; text <=> root.credential-draft; input-type: InputType.password; enabled: !root.credential-busy && !root.operation-blocked;
                        color: Colors.foreground; selection-background-color: SettingsColors.selected; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; text-cursor-width: 2px; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy && !root.operation-blocked { root.credential-save-requested(root.credential-draft); } }
                    }
                    if root.credential-configured && !root.credential-editing && !root.credential-revealed: Text {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 4 * Metrics.icon-button-size; height: parent.height; text: "••••••••••••••••"; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                    }
                    credential-reveal-input := TextInput {
                        visible: root.credential-configured && root.credential-revealed && !root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text: root.credential-transient-secret; read-only: true;
                        color: Colors.foreground; selection-background-color: SettingsColors.selected; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        changed has-focus => { if !self.has-focus && root.credential-revealed && root.credential-reveal-dismiss-armed { root.credential-hide-requested(); } }
                    }
                    credential-edit-input := TextInput {
                        visible: root.credential-configured && root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text <=> root.credential-draft;
                        input-type: root.credential-secret-visible ? InputType.text : InputType.password; enabled: !root.credential-busy && !root.operation-blocked;
                        changed has-focus => { if !self.has-focus && root.credential-editing {root.credential-edit-blurred();} }
                        color: Colors.foreground; selection-background-color: SettingsColors.selected; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy && !root.operation-blocked { root.credential-save-requested(root.credential-draft); } }
                    }
                    credential-actions := HorizontalLayout {
                        visible: root.credential-configured && !root.credential-editing && !root.credential-revealed && (!root.credential-request-pending || root.credential-copy-active);
                        x: parent.width - 4 * Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2; width: 4 * Metrics.icon-button-size; spacing: 0px;
                        CredentialActionButton { icon-kind: 0; enabled: !root.credential-busy && !root.operation-blocked && !root.credential-request-pending; clicked => { root.credential-reveal-requested(); } }
                        CredentialActionButton { icon-kind: 1; copied: root.credential-copied; enabled: !root.credential-busy && !root.operation-blocked && !root.credential-request-pending; clicked => { root.credential-copy-requested(); } }
                        CredentialActionButton { icon-kind: 2; enabled: !root.credential-busy && !root.operation-blocked && !root.credential-request-pending; clicked => { root.credential-edit-requested(); } }
                        delete-key-button := CredentialActionButton { icon-kind: 3; enabled: root.can-remove && !root.credential-busy && !root.operation-blocked && !root.credential-request-pending; clicked => { root.credential-remove-requested(); } }
                    }
                    if root.credential-configured && root.credential-request-pending && !root.credential-copy-active && !root.credential-editing: Text {
                        x: parent.width - Spacing.medium - 88px; width: 88px; height: parent.height; text: @tr("Loading…"); color: Colors.secondary-foreground; font-size: 13px; horizontal-alignment: right; vertical-alignment: center;
                    }
                    if root.credential-configured && (root.credential-editing || root.credential-revealed): CredentialActionButton {
                        x: parent.width - Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2;
                        icon-kind: root.credential-revealed || root.credential-secret-visible ? 4 : 0;
                        clicked => { if root.credential-editing { root.credential-secret-visible = !root.credential-secret-visible; } else { root.credential-hide-requested(); } }
                    }
                }

                if root.credential-error-text != "": Text { text: root.credential-error-text; color: Colors.error; font-size: 13px; wrap: word-wrap; }
                if root.credential-editing || (!root.credential-configured && (root.credential-draft != "" || root.credential-busy)): HorizontalLayout {
                    width: 100%; height: 40px; spacing: Spacing.small; alignment: end;
                    SettingsButton { width: 96px; visible: root.credential-editing; label: @tr("Cancel"); enabled: !root.credential-busy && !root.operation-blocked; clicked => { root.credential-edit-cancel-requested(); } }
                    SettingsButton {
                        width: 128px; visible: root.credential-editing || (!root.credential-configured && (root.credential-draft != "" || root.credential-busy));
                        primary: true; label: root.credential-busy ? @tr("Working…") : @tr("Save key"); enabled: root.credential-draft != "" && !root.credential-busy && !root.operation-blocked;
                        clicked => { root.credential-save-requested(root.credential-draft); }
                    }
                }
    }
}



export struct SettingsToastData {
    id: int,
    message: string,
    error: bool,
}



// Shared by settings rows so descriptions grow naturally with localized text.


// Fields share a responsive label/control row; text determines the row height.


// A single target row keeps localized descriptions and the switch on the same center.
component SettingsToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> error-text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: max(56px, text-block.preferred-height + 16px);
    border-radius: 6px;
    background: label-touch.has-hover ? SettingsColors.hover : transparent;
    text-block := SettingsTextBlock {
        x: 0px; y: (parent.height - self.height) / 2;
        width: parent.width - 52px - Spacing.medium; height: self.preferred-height;
        label: root.label; description: root.description; error-text: root.error-text;
    }
    label-touch := TouchArea {
        width: parent.width - 52px - Spacing.small; enabled: root.enabled; mouse-cursor: pointer;
        clicked => { toggle.focus-switch(); root.toggled(!root.checked); }
    }
    toggle := SettingsSwitch {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        label: root.label; checked: root.checked; enabled: root.enabled; opacity: root.enabled ? 1 : Metrics.disabled-opacity;
        toggled(value) => { root.toggled(value); }
    }
}

// A shared keyboard/pointer target for visually distinct choices.
component SettingsChoiceTarget inherits SettingsFocusScope {
    in property <string> label;
    in property <bool> selected;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback chosen();
    accessible-role: button; accessible-label: root.label;
    accessible-checkable: true; accessible-checked: root.selected;
    accessible-action-default => { root.chosen(); }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.chosen(); root.refresh-focus(); return accept; }
        return reject;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { SettingsInteraction.pointer-input(); root.focus-target(); root.chosen(); root.refresh-focus(); } }
}

component AppearanceThemeChoice inherits Rectangle {
    in property <int> theme-kind;
    in property <bool> selected;
    callback chosen();

    height: 106px;
    background: transparent;
    forward-focus: choice;

    preview := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 78px;
        border-radius: Spacing.small;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Colors.primary : Colors.outline;
        background: root.theme-kind == 1 ? #15345d : #dcecff;
        clip: true;

        if root.theme-kind == 2: Rectangle {
            x: parent.width / 2; width: parent.width / 2; height: parent.height;
            border-top-right-radius: Spacing.small;
            border-bottom-right-radius: Spacing.small;
            background: #15345d;
        }
        Rectangle {
            x: 9px; y: 13px; width: parent.width - 18px; height: parent.height - 13px;
            border-radius: 5px;
            background: root.theme-kind == 1 ? #25282d : #ffffff;
            clip: true;
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; width: parent.width / 2; height: parent.height;
                border-top-right-radius: 5px;
                border-bottom-right-radius: 5px;
                background: #25282d;
            }
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 14px;
                border-radius: 5px;
                background: root.theme-kind == 1 ? #383c43 : #f5f7fa;
            }
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; y: 0px; width: parent.width / 2; height: 14px;
                border-top-right-radius: 5px;
                background: #383c43;
            }
            for dot in [0, 1, 2]: Rectangle {
                x: 6px + dot * 6px; y: 6px; width: 3px; height: 3px;
                border-radius: 2px;
                background: root.theme-kind == 1 ? #aeb5bf : #68707a;
            }
            Rectangle { x: 6px; y: 22px; width: 16px; height: 6px; border-radius: 2px; background: #1967d2; }
            Rectangle { x: 6px; y: 33px; width: 12px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 23px; width: parent.width - 43px; height: 4px; border-radius: 2px; background: root.theme-kind == 1 ? #aeb5bf : #68707a; }
            Rectangle { x: 28px; y: 33px; width: parent.width - 38px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 42px; width: parent.width - 48px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: parent.width - 27px; y: parent.height - 13px; width: 19px; height: 6px; border-radius: 3px; background: #1967d2; }
        }
        // Keep the outline above both halves of the system-theme preview.
        Rectangle {
            width: parent.width; height: parent.height;
            background: transparent; border-radius: Spacing.small;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Colors.primary : Colors.outline;
        }
    }
    Text {
        y: 82px; width: parent.width; height: 24px;
        text: root.theme-kind == 0 ? @tr("Light") : root.theme-kind == 1 ? @tr("Dark") : @tr("System");
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: Typography.compact-size;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: 84px; border-radius: 11px;
        background: transparent; border-width: choice.focus-visible ? 1px : 0px; border-color: Colors.primary; }
    choice := SettingsChoiceTarget { label: root.theme-kind == 0 ? @tr("Light") : root.theme-kind == 1 ? @tr("Dark") : @tr("System");
        selected: root.selected; chosen => { root.chosen(); } }
}



// Unlike the standard ComboBox, refreshing choices must never select the first model.



// Unimplemented actions are status rows, not disabled copies of editable fields.
component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind;
    in property <bool> selected;
    in property <bool> expanded;
    callback activated();
    callback move-focus(int);
    public function focus-item() { nav-focus.focus-target(); }
    forward-focus: nav-focus;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    height: Metrics.settings-nav-item-height;
    border-radius: 10px;
    border-width: nav-focus.focus-visible ? 1px : 0px; border-color: Colors.primary;
    background: SettingsColors.interactive(transparent, nav-touch.has-hover, nav-touch.pressed, root.selected);

    if root.icon-kind != 6: Path {
        x: root.expanded ? Spacing.medium : (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-kind == 5
            ? "M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2ZM2 12H22M4 7H20M4 17H20M12 2C7 7 7 17 12 22C17 17 17 7 12 2Z"
            : root.icon-kind == 4
            ? "M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 0h2v6h-6v-2h4v-4zM10 10h4v4h-4v-4z"
            : root.icon-kind == 3
            ? "M11 2a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7V2zm0 4a5 5 0 1 0 5 5h-2a3 3 0 1 1-3-3V6zm1 5 9 4-4 1-1 4-4-9z"
            : root.icon-kind == 2
            ? "M20 5H4C2.9 5 2 5.9 2 7v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 12H4V7h16v10zM6 9h2v2H6V9zm3 0h2v2H9V9zm3 0h2v2h-2V9zm3 0h3v2h-3V9zM6 12h2v2H6v-2zm3 0h2v2H9v-2zm3 0h2v2h-2v-2zm3 0h3v2h-3v-2zM7 15h10v1H7v-1z"
            : root.icon-kind == 0
            ? "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
            : "M12.87 15.07 10.33 12.56l.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17A15.5 15.5 0 0 1 9 11.35 15.4 15.4 0 0 1 6.91 8H4.91A17.5 17.5 0 0 0 7.67 12.56L2.58 17.58 4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z";
        fill: root.icon-kind == 5 ? transparent : root.selected ? Colors.primary : Colors.secondary-foreground;
        stroke: root.icon-kind == 5 ? (root.selected ? Colors.primary : Colors.secondary-foreground) : transparent;
        stroke-width: root.icon-kind == 5 ? 1.6px : 0px;
    }

    if root.icon-kind == 6: Image {
        x: root.expanded ? Spacing.medium : (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2; width: Metrics.icon-size; height: Metrics.icon-size;
        source: @image-url("icons/about.svg"); colorize: root.selected ? Colors.primary : Colors.secondary-foreground;
    }

    if root.expanded: Text {
        x: Spacing.medium + Metrics.icon-size + Spacing.small;
        width: parent.width - self.x - Spacing.small;
        height: parent.height;
        text: root.label;
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    SettingsHintTarget { active: !root.expanded && nav-touch.has-hover; text: root.label; anchor-x: root.absolute-position.x; anchor-y: root.absolute-position.y; anchor-height: root.height; }

    nav-focus := SettingsFocusScope {
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.move-focus(1); return accept; }
            if event.text == Key.UpArrow { root.move-focus(-1); return accept; }
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    nav-touch := TouchArea {
        clicked => {
            SettingsInteraction.pointer-input(); nav-focus.focus-target();
            root.activated();
        }
    }
}

export component SettingsWindow inherits Window {
    in property <string> about-version;
    in-out property <bool> about-link-failed;
    callback about-link-requested(int);
    in-out property <[TranslationChoice]> translation-choices;
    in-out property <string> translation-search;
    in-out property <int> translation-list-height;
    in-out property <bool> translation-selecting;
    in-out property <bool> translation-selector-open;
    in-out property <bool> translation-settings-open;
    in-out property <int> translation-highlight: -1;
    callback translation-filter();
    callback translation-selected(int);
    callback translation-open-settings();
    callback translation-move(int);
    public function open-translation-settings() {
        if root.llm-translation-provider-index == 0 || root.translation-selecting { return; }
        root.translation-open-settings(); root.translation-settings-open = true;
        root.llm-parameters-expanded = true; root.llm-prompt-expanded = true;
        translation-modal-focus.focus();
    }
    public function finish-translation-choice() {
        root.translation-selector-open = false; selector-focus.focus-target();
    }
    public function finish-translation-settings() {
        root.translation-settings-open = false;
        root.prompt-can-undo-reset = false;
        translation-config.focus-button();
    }
    function cancel-translation-settings() {
        if root.llm-translation-saving { return; }
        root.llm-cancel-translation(); root.finish-translation-settings();
    }
    function manage-translation-models() {
        root.translation-selector-open = false;
        root.provider-detail-index = root.llm-translation-provider-index;
        root.llm-service-index = max(0, root.provider-detail-index - 1);
        root.credential-hide-requested(); root.llm-service-selected(root.provider-detail-index); root.active-category = 5;
    }
    in-out property <bool> llm-parameters-expanded: false;
    in-out property <bool> llm-prompt-expanded: false;
    in-out property <bool> credential-delete-dialog: false;
    in-out property <bool> settings-close-dialog: false;
    in property <[ServiceProviderRow]> provider-navigation: [
        { provider-id: "deepl", label: "DeepL", group-title: @tr("Translation services"), icon-index: 0 },
        { provider-id: "ollama", label: "Ollama", group-title: @tr("Large language models"), icon-index: 1 },
