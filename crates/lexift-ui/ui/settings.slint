    public function request-history-clear() {
        if !root.history-supported || root.active-category != 0 || root.history-clear-dialog || root.settings-close-dialog { return; }
        root.close-settings-menu(); root.close-app-language-menu(); SettingsHints.clear();
        root.history-clear-dialog = true; cancel-clear-history.focus-button();
    }
    public function finish-history-clear(confirmed: bool) {
        if !root.history-clear-dialog { return; }
        let valid = root.history-supported && root.active-category == 0;
        root.history-clear-dialog = false;
        if confirmed && valid { root.history-clear-requested(); }
        if root.active-category == 0 { clear-history-button.focus-button(); }
    }

    public function request-credential-delete() {
        if root.credential-delete-dialog { return; }
        if root.credential-busy || root.credential-request-pending || root.credential-editing { return; }
        if root.provider-detail-id == "deepl" ? !root.credential-configured : !root.llm-key-configured { return; }
        root.close-app-language-menu(); root.close-settings-menu(); root.credential-hide-requested();
        root.credential-delete-provider = root.provider-detail-index;
        root.credential-delete-dialog = true; cancel-delete-key.focus-button();
    }
    public function finish-credential-delete(confirmed: bool) {
        if !root.credential-delete-dialog { return; }
        let valid = root.credential-delete-dialog && root.credential-delete-provider == root.provider-detail-index && !root.credential-busy && !root.credential-request-pending;
        root.credential-delete-dialog = false; root.credential-delete-provider = -1;
        if confirmed && valid { root.credential-remove-requested(); }
        else if root.active-category == 5 { provider-credential.focus-remove(); }
    }
    public function reset-prompt-with-undo() {
        root.prompt-before-reset = root.llm-prompt;
        root.llm-reset-prompt(); root.prompt-reset-value = root.llm-prompt;
        root.prompt-reset-undo = root.prompt-before-reset != root.prompt-reset-value;
    }
    public function undo-prompt-reset() {
        if root.prompt-can-undo-reset { root.llm-prompt = root.prompt-before-reset; }
        root.prompt-reset-undo = false; root.prompt-before-reset = "";
    }
    public function focus-credential-reveal() { provider-credential.focus-reveal(); }
    public function confirm-settings-close() {
        if root.settings-close-dialog { return; }
        root.close-return-focus = root.credential-editing ? 1 : provider-address.input-focused() ? 2
            : root.active-editor == 4 && root.active-category == 1 && root.llm-prompt-expanded ? 4
            : root.llm-advanced && (root.active-editor == 5 || (root.llm-header-editing && root.active-editor >= 6)) ? root.active-editor
            : root.llm-advanced || root.llm-model-dialog || root.llm-probe-dialog ? 3 : 0;
        root.close-settings-menu(); root.close-app-language-menu();
        root.settings-close-dialog = true;
        keep-editing-button.focus-button();
    }
    public function finish-settings-close(discard: bool) {
        if !root.settings-close-dialog { return; }
        root.settings-close-dialog = false;
        if discard { root.discard-settings-requested(); }
        else if root.close-return-focus == 1 && root.credential-editing { provider-credential.focus-edit(); }
        else if root.close-return-focus == 2 { provider-address.focus-input(); }
        else if root.close-return-focus >= 4 { root.focus-settings-editor(root.close-return-focus); }
        else if root.llm-advanced || root.llm-model-dialog || root.llm-probe-dialog { provider-modal-focus.focus(); }
        else if root.history-clear-dialog { cancel-clear-history.focus-button(); }
        else { root-content.focus(); }
    }
    // Focus requests preserve the existing TextInput and therefore its insertion point and selection.
    public function focus-settings-editor(target: int) {
        root.editor-return-target = target;
        root.editor-return-anchor = root.editor-selection-target == target ? root.editor-anchor : 0;
        root.editor-return-cursor = root.editor-selection-target == target ? root.editor-cursor : 0;
        root.editor-focus-request += 1;
    }
    // Slint collapses a selection when an in-window modal takes focus; remember it before that happens.
    function remember-editor-selection(target: int, anchor: int, cursor: int) {
        root.active-editor = target;
        root.editor-selection-target = target; root.editor-anchor = anchor; root.editor-cursor = cursor;
    }
    function editor-focus-changed(target: int, focused: bool) {
        if focused { root.active-editor = target; }
        else if root.active-editor == target { root.active-editor = 0; }
    }
    public function focus-credential-edit() { provider-credential.focus-edit(); }
    public pure function credential-edit-focused() -> bool {return provider-credential.edit-focused();}
    public function focus-hotkey-capture() { hotkey-capture.focus(); }
    public function focus-annotation-hotkey-capture() { annotation-hotkey-capture.focus(); }
    public function focus-settings-menu() { settings-menu.focus-menu(); }
    public function scroll-model-settings(bottom: bool) {
        translation-scroll.content-y = min(0px, max(translation-scroll.visible-height - translation-scroll.content-height, bottom ? translation-scroll.visible-height - translation-scroll.content-height : -llm-translation-card.y));
    }
    public function open-provider-request() {
        root.credential-edit-cancel-requested(); root.close-app-language-menu(); root.close-settings-menu();
        SettingsHints.clear(); root.llm-request-open(); root.llm-advanced = true; provider-modal-focus.focus();
    }
    public function open-provider-models() {
        if root.llm-connection-dirty || root.llm-persisting { return; }
        root.credential-edit-cancel-requested(); SettingsHints.clear(); root.llm-model-dialog = true; model-viewport.content-y = 0px;
        root.llm-model-search = ""; root.llm-model-filter = 0; root.llm-filter-models();
        root.llm-refresh(false); provider-modal-focus.focus();
    }
    public function close-provider-dialog(confirm: bool) {
        if root.llm-probe-dialog { root.llm-probe-close(); check-models-button.focus-button(); }
        else if root.llm-advanced { root.llm-request-close(confirm); if !root.llm-advanced { request-config-button.focus-button(); } }
        else { root.llm-model-dialog = false; root.llm-models-close(); sync-models-button.focus-button(); }
    }
    public function open-provider-probe() {
        SettingsHints.clear();
        root.llm-probe-open();
        if root.llm-probe-dialog { root.credential-hide-requested(); provider-modal-focus.focus(); }
    }
    function dismiss-settings-menu() { root.close-settings-menu(); language-selector.focus-field(); }
    function dismiss-app-language-menu() {
        root.close-app-language-menu();
        app-language-field.focus-field();
    }
    public function close-settings-menu() { settings-menu-open = false; settings-menu-dismiss-armed = false; }
    public function focus-app-language() { app-language-field.focus-field(); }
    public function close-app-language-menu() { app-language-menu-open = false; }
    public function reset-settings-view() {
        root.history-clear-dialog = false;
        root.settings-close-dialog = false;
        root.credential-delete-dialog = false; root.prompt-reset-undo = false; root.prompt-before-reset = ""; root.prompt-reset-value = "";
        root.close-settings-menu(); root.close-app-language-menu(); root.hotkey-capturing = false; root.annotation-hotkey-capturing = false; root.active-category = 0; root.llm-page-left();
        general-scroll.content-y = 0px; translation-scroll.content-y = 0px; providers-scroll.content-y = 0px;
        hotkeys-scroll.content-y = 0px; about-page.content-y = 0px; root.about-link-failed = false;
    }
    function focus-navigation(index: int) {
        if index <= 0 { nav-0.focus-item(); }
        else if index == 1 { nav-1.focus-item(); }
        else if index == 2 { nav-2.focus-item(); }
        else if index == 3 { nav-3.focus-item(); }
        else { nav-4.focus-item(); }
    }
    public function settings-keyboard-input() { SettingsInteraction.keyboard-mode = true; }
    public function settings-pointer-input() { SettingsInteraction.pointer-input(); }
    public function invalidate-button-focus() { SettingsInteraction.invalidate(); }
    public function clear-settings-hint() { SettingsHints.clear(); }
    changed provider-detail-index => { SettingsHints.clear(); }
    changed llm-advanced => { SettingsHints.clear(); }
    changed llm-model-dialog => { SettingsHints.clear(); }
    changed llm-probe-dialog => { SettingsHints.clear(); }
    changed translation-settings-open => { SettingsHints.clear(); }
    changed translation-selector-open => { SettingsHints.clear(); }
    changed credential-delete-dialog => { SettingsHints.clear(); }
    changed settings-close-dialog => { SettingsHints.clear(); }
    changed history-clear-dialog => { SettingsHints.clear(); }
    public function reset-button-visuals() { SettingsHints.clear(); SettingsInteraction.reset(); }
    public function reset-provider-filters() {
        root.llm-search-open = false; root.llm-filter-open = false;
        root.llm-model-search = ""; root.llm-model-filter = 0;
    }
    public function select-category(category: int) {
        if root.ocr-remove-dialog || root.ocr-download-dialog || root.settings-close-dialog || root.credential-delete-dialog || root.history-clear-dialog || root.active-category == category { return; }
        root.close-settings-menu(); root.close-app-language-menu(); root.hotkey-capturing = false; root.annotation-hotkey-capturing = false;
        if root.active-category == 5 { root.credential-edit-cancel-requested(); root.llm-page-left(); }
        SettingsInteraction.invalidate();
        root.active-category = category;
        root.about-link-failed = false;
        root.focus-navigation(category == 0 ? 0 : category == 2 ? 1 : category == 1 ? 2 : category == 5 ? 3 : 4);
    }

    root-content := SettingsFocusScope {
        enabled: !root.ocr-remove-dialog && !root.ocr-download-dialog && !root.settings-close-dialog && !root.llm-advanced && !root.llm-model-dialog && !root.llm-probe-dialog && !root.credential-delete-dialog && !root.history-clear-dialog;
        x: 0px; y: 0px; width: root.width; height: root.height;

    sidebar := Rectangle {
        x: 0px; y: 0px; width: root.sidebar-width; height: root-content.height; z: 10; background: Colors.surface;
        Image {
            x: root.expanded-navigation ? Spacing.medium : (parent.width - 28px) / 2;
            y: Spacing.large; width: 28px; height: 28px;
            source: AppAssets.app-icon; image-fit: contain;
        }
        if root.expanded-navigation: Text {
            x: Spacing.medium + 40px; y: Spacing.large - 6px;
            width: parent.width - self.x - Spacing.medium; height: 40px;
            text: "Lexift"; color: Colors.foreground; font-size: 20px; font-weight: 700; vertical-alignment: center;
        }
        nav-0 := SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px; width: parent.width - 2 * self.x;
            label: @tr("General"); icon-kind: 0; selected: root.active-category == 0; expanded: root.expanded-navigation;
            activated => { root.select-category(0); }
            move-focus(delta) => { root.focus-navigation(0 + delta); }
        }
        nav-1 := SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + Metrics.settings-nav-item-height + Spacing.small;
            width: parent.width - 2 * self.x;
            label: @tr("Hotkeys"); icon-kind: 2; selected: root.active-category == 2; expanded: root.expanded-navigation;
            activated => { root.select-category(2); }
            move-focus(delta) => { root.focus-navigation(1 + delta); }
        }
        nav-2 := SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 2 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Translation settings"); icon-kind: 1; selected: root.active-category == 1; expanded: root.expanded-navigation;
            activated => { root.select-category(1); }
            move-focus(delta) => { root.focus-navigation(2 + delta); }
        }
        nav-3 := SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 3 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Service providers"); icon-kind: 5; selected: root.active-category == 5; expanded: root.expanded-navigation;
            activated => { root.select-category(5); }
            move-focus(delta) => { root.focus-navigation(3 + delta); }
        }
        nav-4 := SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 4 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("About"); icon-kind: 6; selected: root.active-category == 6; expanded: root.expanded-navigation;
            activated => { root.select-category(6); }
            move-focus(delta) => { root.focus-navigation(4 + delta); }
        }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.outline; }
    }

    main-pane := Rectangle {
        x: root.sidebar-width; y: 0px; width: root.width - root.sidebar-width; height: root.height;
        clip: true;

    header := Rectangle {
        x: 0px; y: 0px; width: main-pane.width; height: Metrics.settings-header-height; z: 5; background: Colors.surface;
        Text {
            x: Metrics.settings-page-padding; y: (parent.height - 32px) / 2; height: 32px;
            text: root.active-category == 0 ? @tr("General") : root.active-category == 2 ? @tr("Hotkeys")
                : root.active-category == 5 ? @tr("Service providers") : root.active-category == 6 ? @tr("About") : @tr("Translation settings");
            color: Colors.foreground; font-size: 24px; font-weight: 700; vertical-alignment: center;
        }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Colors.outline; }
    }

    about-page := AboutPage {
        visible: root.active-category == 6;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - self.y;
        version: root.about-version; link-failed: root.about-link-failed;
        open-link(index) => { root.about-link-requested(index); }
    }

    general-scroll := ScrollView {
        changed content-y => { SettingsHints.clear(); }
        visible: root.active-category == 0;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, history-card.y + history-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { SettingsHints.clear();
            root.close-app-language-menu();
            if root.settings-menu-open && (root.settings-menu-anchor-y < Metrics.settings-header-height || root.settings-menu-anchor-y + root.settings-menu-anchor-height > root.height) { root.close-settings-menu(); }
        }



        appearance-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: Metrics.settings-page-padding;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Appearance");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.medium;
                Text { height: 22px; text: @tr("App theme"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                HorizontalLayout {
                    width: 100%; height: 106px; spacing: Spacing.small;
                    for theme in [0, 1, 2]: AppearanceThemeChoice {
                        width: (parent.width - 2 * Spacing.small) / 3;
                        theme-kind: theme; selected: root.appearance-theme-index == theme;
                        chosen => { root.theme-selected(theme); root.close-app-language-menu(); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SettingsControlRow {
                    width: 100%; label: @tr("App language"); controls-fraction: 0.64;
                    app-language-field := SettingsSelectField {
                        value: root.language-labels[root.appearance-language-index];
                        opened: root.app-language-menu-open;
                        clicked => { root.toggle-app-language-menu(); }
                    }
                }
            }
        }

        startup-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: appearance-card.y + appearance-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Behavior");
            SettingsToggleRow {
                label: @tr("Launch at startup"); error-text: root.launch-at-login-error-text;
                checked: root.launch-at-login;
                toggled(value) => { root.launch-at-login = value; root.launch-at-login-change-requested(value); }
            }
        }

        selection-assistant-card := SettingsCard {
            x: Metrics.settings-page-padding; y: startup-card.y + startup-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Selection Assistant");
            SettingsToggleRow {
                label: @tr("Enable selection assistant");
                checked: root.selection-toolbar;
                toggled(value) => { root.selection-toolbar = value; root.selection-toolbar-change-requested(value); }
            }
        }
        history-card := SettingsCard {
            x: Metrics.settings-page-padding; y: selection-assistant-card.y + selection-assistant-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Clipboard history");
            VerticalLayout {
                spacing: Spacing.medium;
                SettingsToggleRow {
                    label: @tr("Record clipboard history"); enabled: root.history-supported; description: root.history-supported ? "" : @tr("Clipboard history monitoring is unavailable"); checked: root.history-enabled;
                    toggled(value) => { root.history-enabled-changed(value); }
                }
                SettingsControlRow {
                    label: @tr("History limit");
                    controls-height: 40px; controls-fraction: 0.72;
                    Rectangle {
                        width: 110px; height: 40px; horizontal-stretch: 0;
                        SpinBox { width: parent.width; y: (parent.height - self.height) / 2; enabled: root.history-supported; value <=> root.history-limit; live-update: false; minimum: 10; maximum: 200; input-finished => { root.history-limit-changed(self.value); } input-confirmed => { root.history-limit-changed(self.value); } }
                    }
                    Rectangle { min-width: Spacing.medium; horizontal-stretch: 1; }
                    clear-history-button := SettingsButton { available-width: max(0px, parent.width - 110px - Spacing.medium); enabled: root.history-supported; label: @tr("Clear clipboard history"); clicked => { root.request-history-clear(); } }
                }
                if root.history-error != "": Text { text: root.history-error; wrap: word-wrap; color: Colors.error; font-size: 13px; }
            }
        }

    }
    AppVerticalScrollBar {
        visible: root.active-category == 0 && general-scroll.content-height > general-scroll.visible-height + 1px;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: general-scroll.visible-height;
        content-height: general-scroll.content-height;
        content-y <=> general-scroll.content-y;
    }
    hotkeys-scroll := ScrollView {
        changed content-y => { SettingsHints.clear(); }
        visible: root.active-category == 2;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, ocr-hotkeys-card.y + ocr-hotkeys-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;

        selection-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: Metrics.settings-page-padding;
            width: hotkeys-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Selection");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? capture-label-0.height + 56px : max(76px, capture-label-0.height + 16px);
                    capture-label-0 := SettingsTextBlock {
                        height: self.preferred-height;
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Translate selection");
                        description: root.hotkey-capturing ? @tr("Press a key combination") : @tr("Translate the current selection");
                        error-text: root.hotkey-error-text;
                    }
                    hotkey-field := Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? capture-label-0.height + Spacing.small : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.hotkey-capturing ? 2px : 1px;
                        border-color: root.hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.hotkey-capturing ? @tr("Press shortcut…") : root.draft-hotkey-label;
                            color: root.hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        hotkey-capture := SettingsFocusScope {
                            key-pressed(event) => {
                                if !root.hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.hotkey-change-requested(captured); root.draft-hotkey-label = captured; root.hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? capture-label-0.height + Spacing.small : (parent.height - 40px) / 2;
                        width: 84px; label: root.hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.annotation-hotkey-capturing = false;
                            root.hotkey-capturing = !root.hotkey-capturing;
                            if root.hotkey-capturing { root.focus-hotkey-capture(); }
                        }
                    }
                }
            }
        }
        annotation-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-hotkeys-card.y + selection-hotkeys-card.height + Metrics.settings-card-gap;
            width: hotkeys-scroll.visible-width - 2 * Metrics.settings-page-padding; title: @tr("Annotation");
            VerticalLayout {
                spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? capture-label-1.height + 56px : max(92px, capture-label-1.height + 16px);
                    capture-label-1 := SettingsTextBlock {
                        height: self.preferred-height;
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Annotation toolbar");
                        description: root.annotation-hotkey-capturing ? @tr("Press a key combination") : root.annotation-hotkey-status;
                        error-text: root.annotation-hotkey-error-text;
                    }
                    Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? capture-label-1.height + Spacing.small : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.annotation-hotkey-capturing ? 2px : 1px;
                        border-color: root.annotation-hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.annotation-hotkey-capturing ? @tr("Press shortcut…") : root.draft-annotation-hotkey-label;
                            color: root.annotation-hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        annotation-hotkey-capture := SettingsFocusScope {
                            key-pressed(event) => {
                                if !root.annotation-hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.annotation-hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.annotation-hotkey-change-requested(captured); root.draft-annotation-hotkey-label = captured; root.annotation-hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? capture-label-1.height + Spacing.small : (parent.height - 40px) / 2;
                        width: 84px; label: root.annotation-hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.hotkey-capturing = false;
                            root.annotation-hotkey-capturing = !root.annotation-hotkey-capturing;
                            if root.annotation-hotkey-capturing { root.focus-annotation-hotkey-capture(); }
                        }
                    }
                }
            }
        }
        ocr-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: annotation-hotkeys-card.y + annotation-hotkeys-card.height + Metrics.settings-card-gap;
            width: hotkeys-scroll.visible-width - 2 * Metrics.settings-page-padding; title: @tr("OCR translation");
            VerticalLayout {
                spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? capture-label-2.height + 56px : max(92px, capture-label-2.height + 16px);
                    capture-label-2 := SettingsTextBlock {
                        height: self.preferred-height;
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Screen region translation");
                        description: root.ocr-hotkey-capturing ? @tr("Press a key combination") : @tr("Drag a screen region to recognize and translate text");

                    }
                    Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? capture-label-2.height + Spacing.small : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.ocr-hotkey-capturing ? 2px : 1px;
                        border-color: root.ocr-hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.ocr-hotkey-capturing ? @tr("Press shortcut…") : root.draft-ocr-hotkey-label;
                            color: root.ocr-hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        ocr-hotkey-capture := SettingsFocusScope {
                            key-pressed(event) => {
                                if !root.ocr-hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.ocr-hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.ocr-hotkey-change-requested(captured); root.draft-ocr-hotkey-label = captured; root.ocr-hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? capture-label-2.height + Spacing.small : (parent.height - 40px) / 2;
                        width: 84px; label: root.ocr-hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.hotkey-capturing = false;
                            root.ocr-hotkey-capturing = !root.ocr-hotkey-capturing;
                            if root.ocr-hotkey-capturing { root.focus-ocr-hotkey-capture(); }
                        }
                    }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 2 && hotkeys-scroll.content-height > hotkeys-scroll.visible-height + 1px;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: hotkeys-scroll.visible-height;
        content-height: hotkeys-scroll.content-height;
        content-y <=> hotkeys-scroll.content-y;
    }
    translation-scroll := ScrollView {
        changed content-y => { SettingsHints.clear(); }
        visible: root.active-category == 1;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, llm-translation-card.y + llm-translation-card.height + 48px + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { SettingsHints.clear(); root.close-settings-menu(); root.close-app-language-menu(); }
        translation-language-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: translation-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Languages");
            VerticalLayout {
                width: 100%; spacing: Spacing.small;
                Rectangle {
                    height: root.hotkeys-compact ? default-language-label.preferred-height + 52px : max(Metrics.settings-row-height, default-language-label.preferred-height + 16px);
                    default-language-label := SettingsTextBlock {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.medium; height: self.preferred-height;
                        label: @tr("Default target language"); error-text: root.target-language-error-text;
                    }
                    language-selector := SettingsSelectField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? default-language-label.height + Spacing.small : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        value: root.language-labels[root.draft-target-index]; opened: root.settings-menu-open;
                        clicked => { root.toggle-language-menu(); }
                    }
                }
            }
        }
        llm-translation-card := Rectangle {
            x: Metrics.settings-page-padding; y: translation-language-card.y + translation-language-card.height + Metrics.settings-card-gap;
            width: translation-language-card.width; height: root.hotkeys-compact ? 138px : 104px;
            border-radius: Metrics.settings-card-radius; background: Colors.surface;
            Image { x: 24px; y: 24px; width: 20px; height: 20px; source: @image-url("assets/icons/translate.svg"); colorize: Colors.foreground; }
            Text { x: 52px; y: 21px; width: root.hotkeys-compact ? parent.width - 76px : parent.width * 0.38 - 52px; height: 26px; text: @tr("Translation model"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; }
            Text { x: 24px; y: 52px; width: root.hotkeys-compact ? parent.width - 48px : parent.width * 0.38 - 24px; height: 22px; text: @tr("Model used for translation"); color: Colors.secondary-foreground; font-size: 13px; overflow: elide; }
            translation-selector := Rectangle {
                x: root.hotkeys-compact ? 24px : parent.width * 0.40; y: root.hotkeys-compact ? 84px : 24px;
                width: parent.width - self.x - 68px; height: 40px;
                border-radius: 8px; border-width: 1px; border-color: selector-focus.focus-visible ? Colors.primary : Colors.outline;
                background: SettingsColors.interactive(Colors.surface, selector-touch.has-hover, selector-touch.pressed, root.translation-selector-open);
                accessible-role: button; accessible-label: @tr("Translation model") + ": " + root.llm-selected-model;
                ProviderLogo { x: 12px; y: 10px; width: 20px; height: 20px; provider: root.llm-translation-provider-index; }
                selected-model-caption := Text { x: 42px; width: max(0px, parent.width - 160px); height: parent.height; text: root.llm-translation-provider-index == 0 ? "DeepL" : root.llm-selected-model == "" ? @tr("Select a model") : root.llm-selected-model; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                Text { x: parent.width - 112px; width: 80px; height: parent.height; text: ["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.llm-translation-provider-index]; color: Colors.secondary-foreground; font-size: 12px; vertical-alignment: center; overflow: elide; }
                Image { x: parent.width - 24px; y: 14px; width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Colors.foreground; }
                selector-focus := SettingsFocusScope { enabled: !root.translation-selecting;
                    key-pressed(event) => { if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow { root.open-translation-selector(); return accept; } return reject; }
                }
                selector-touch := TouchArea { enabled: !root.translation-selecting; mouse-cursor: pointer; clicked => { SettingsInteraction.pointer-input(); selector-focus.focus-target(); root.open-translation-selector(); } }
            }
            translation-config := ProviderIconButton {
                x: parent.width - 56px; y: translation-selector.y + 4px;
                icon: @image-url("icons/translation-settings.svg"); tooltip: root.llm-translation-provider-index == 0 ? @tr("DeepL does not use model parameters") : @tr("Translation settings");
                enabled: root.llm-translation-provider-index > 0 && root.llm-selected-model != "" && !root.translation-selecting;
                clicked => { root.open-translation-settings(); }
            }
        }
        Text { x: llm-translation-card.x; y: llm-translation-card.y + llm-translation-card.height; width: llm-translation-card.width; height: self.preferred-height; text: root.provider-error-text != "" ? root.provider-error-text : root.llm-selection-note; color: Colors.secondary-foreground; font-size: 13px; wrap: word-wrap; }
    }

    AppVerticalScrollBar {
        visible: root.active-category == 1 && translation-scroll.content-height > translation-scroll.visible-height + 1px;
        x: main-pane.width - 14px; y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: translation-scroll.visible-height; content-height: translation-scroll.content-height;
        content-y <=> translation-scroll.content-y;
    }
    provider-list := Rectangle {
        visible: root.active-category == 5;
        x: 0px; y: Metrics.settings-header-height;
        width: main-pane.width < 600px ? 148px : 184px; height: main-pane.height - self.y;
        background: Colors.surface;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.outline; }
        SettingsScrollArea {
            x: 8px; y: 16px; width: parent.width - 16px; height: parent.height - 32px;
            content-width: self.visible-width; content-height: max(self.visible-height, provider-rows.preferred-height);
            provider-rows := VerticalLayout { x: 0px; y: 0px; alignment: start; width: parent.width; height: self.preferred-height; spacing: 8px;
                for row[index] in root.provider-navigation: Rectangle {
                    height: row.group-title == "" ? 40px : 72px;
                    if row.group-title != "": Text { x: 8px; y: 0px; width: parent.width - 16px; height: 24px; text: row.group-title; overflow: elide; color: Colors.secondary-foreground; font-size: 12px; vertical-alignment: center; }
                    Rectangle { y: parent.height - 40px; width: parent.width; height: 40px; border-radius: 6px;
                        background: SettingsColors.interactive(transparent, choice.hovered, choice.pressed, root.provider-detail-id == row.provider-id);
                        border-width: choice.focus-visible ? 1px : 0px; border-color: Colors.primary;
                        Rectangle { x: 8px; y: 6px; width: 28px; height: 28px; border-radius: 7px; background: SettingsColors.brand-surface; border-width: 1px; border-color: Colors.outline.with-alpha(0.5);
                            Image { x: 4px; y: 4px; width: 20px; height: 20px; image-fit: contain; source: [@image-url("icons/provider-deepl.svg"), @image-url("icons/provider-ollama.svg"), @image-url("icons/provider-lmstudio.svg"), @image-url("icons/provider-deepseek.svg"), @image-url("icons/ocr-provider.svg")][row.icon-index]; }
                        }
                        Rectangle { x: parent.width - 15px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px; background: Colors.success; visible: row.provider-id == "paddleocr" ? root.ocr-provider-enabled : index < root.provider-enabled-states.length && root.provider-enabled-states[index]; }
                        Text { x: 44px; width: parent.width - 64px; height: parent.height; text: row.label; color: root.provider-detail-id == row.provider-id ? Colors.primary : Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                        choice := SettingsChoiceTarget { label: row.label; selected: root.provider-detail-id == row.provider-id; chosen => { root.provider-detail-index = index; root.credential-hide-requested(); root.llm-service-selected(index); if row.provider-id == "paddleocr" { root.ocr-refresh-requested(); } providers-scroll.content-y = 0px; } }
                    }
                }
            }
        }
    }
    Rectangle { visible: root.active-category == 5; x: provider-list.width; y: Metrics.settings-header-height; width: main-pane.width - self.x; height: main-pane.height - self.y; background: Colors.surface; }
    providers-scroll := ScrollView {
        changed content-y => { SettingsHints.clear(); }
        visible: root.active-category == 5;
        x: provider-list.width; y: Metrics.settings-header-height;
        width: main-pane.width - self.x;
        height: main-pane.height - self.y - (root.provider-detail-id != "paddleocr" && root.llm-connection-dirty ? 64px : 0px);
        content-width: self.visible-width;
        content-height: max(self.visible-height, (root.provider-detail-id == "paddleocr" ? ocr-provider-content.y + ocr-provider-content.height : provider-content.y + provider-content.height) + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        scrolled => { SettingsHints.clear(); }
        provider-content := VerticalLayout {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: providers-scroll.visible-width - 2 * Metrics.settings-page-padding;
            height: self.preferred-height; spacing: 24px;
            HorizontalLayout { height: 32px; spacing: 8px;
                Text { text: root.provider-navigation[root.provider-detail-index].label; color: Colors.foreground; font-size: Typography.body-size; font-weight: 700; vertical-alignment: center; }
                Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                SettingsSwitch { label: root.provider-navigation[root.provider-detail-index].label; enabled: !root.llm-enable-saving; checked: root.llm-enabled; toggled(value) => { root.llm-enable-requested(value); } }
            }
            VerticalLayout { visible: root.provider-detail-id != "paddleocr"; height: self.visible ? self.preferred-height : 0px; spacing: 8px;
                Text { height: 24px; text: @tr("API key"); font-size: Typography.body-size; color: Colors.foreground; vertical-alignment: center; }
                credential-row := Rectangle {
                    private property <length> action-width: root.provider-detail-id == "deepl" ? 0px : max(72px, check-measure.preferred-width + 32px);
                    private property <bool> wrapped: self.width < self.action-width + 188px;
                    height: provider-credential.height + (self.wrapped && self.action-width > 0px ? 48px : 0px);
                    check-measure := Text { visible: false; text: @tr("Test connection"); font-size: 14px; }
                provider-credential := ProviderCredentialField {
                    x: 0px; y: 0px;
                    width: credential-row.width - (credential-row.wrapped || credential-row.action-width == 0px ? 0px : credential-row.action-width + 8px);
                    credential-configured: root.provider-detail-id == "deepl" ? root.credential-configured : root.llm-key-configured || (root.provider-detail-id == "deepseek" && root.deepseek-environment-key);
                    can-remove: root.provider-detail-id == "deepl" || root.llm-key-configured;
                    credential-busy: root.credential-busy && !root.llm-connection-pending;
                    operation-blocked: root.llm-connection-pending;
                    credential-editing: root.credential-editing;
                    credential-revealed: root.credential-revealed;
                    credential-request-pending: root.credential-request-pending && !root.llm-connection-pending;
                    credential-reveal-dismiss-armed: root.credential-reveal-dismiss-armed;
                    credential-secret-visible <=> root.credential-secret-visible;
                    credential-draft <=> root.credential-draft;
                    credential-transient-secret: root.credential-transient-secret;
                    credential-error-text: root.credential-error-text;
                    credential-reveal-requested => { root.credential-reveal-requested(); }
                    credential-copy-active: root.credential-copy-active; credential-copied: root.credential-copied;
                    credential-copy-requested => { root.credential-copy-requested(); }
                    credential-edit-requested => { root.credential-edit-requested(); }
                    credential-remove-requested => { root.request-credential-delete(); }
                    credential-hide-requested => { root.credential-hide-requested(); }
                    credential-edit-cancel-requested => { root.credential-edit-cancel-requested(); }
                    credential-edit-blurred => {root.credential-edit-blurred();}
                    credential-save-requested(value) => { root.credential-save-requested(value); }
                }

                    check-models-button := SettingsButton { visible: root.provider-detail-id != "deepl" && root.provider-detail-id != "paddleocr"; compact: true; x: credential-row.width - self.width; y: credential-row.wrapped ? provider-credential.height + 8px : 0px; width: credential-row.action-width; label: @tr("Test connection"); enabled: !root.credential-busy; clicked => { root.open-provider-probe(); } }
                }
                if root.provider-detail-id == "deepseek" && !root.llm-key-configured: Text { text: root.deepseek-environment-key ? @tr("Credential source: environment; manage it outside Lexift") : @tr("API key not configured"); color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; }
            }
            VerticalLayout { visible: root.provider-detail-id != "deepl" && root.provider-detail-id != "paddleocr"; height: self.visible ? self.preferred-height : 0px; spacing: 8px;
                Text { height: 24px; text: @tr("API address"); font-size: Typography.body-size; color: Colors.foreground; vertical-alignment: center; }
                Rectangle { height: 40px;
                    provider-address := ProviderInput { x: 0px; y: 0px; width: parent.width - 40px; height: 40px; text <=> root.llm-base-url; edited => { root.llm-base-edited(); } }
                    request-config-button := ProviderIconButton { x: parent.width - 32px; y: (parent.height - self.height) / 2; icon: @image-url("icons/provider-settings.svg"); tooltip: @tr("Request configuration"); selected: root.llm-advanced; clicked => { root.open-provider-request(); } }
                }
            }
            VerticalLayout { visible: root.provider-detail-id != "deepl" && root.provider-detail-id != "paddleocr"; height: self.visible ? self.preferred-height : 0px; spacing: 12px;
                Rectangle {
                    z: 5;
                    height: toolbar-left.preferred-width + sync-models-button.width + 8px > self.width ? 88px : 40px;
                    toolbar-left := HorizontalLayout { x: 0px; y: 4px; width: self.preferred-width; height: 32px; spacing: 4px;
                        Text { text: @tr("Models") + "  " + root.llm-enabled-count; color: Colors.foreground; font-size: Typography.body-size; font-weight: 700; vertical-alignment: center; }
                        ProviderIconButton { icon: @image-url("icons/provider-search.svg"); tooltip: @tr("Search models"); selected: root.llm-search-open; clicked => { root.llm-search-open = !root.llm-search-open; if !root.llm-search-open { root.llm-model-search = ""; root.llm-filter-models(); } } }
                        ProviderIconButton { icon: @image-url("icons/provider-filter.svg"); tooltip: @tr("Filter models"); selected: root.llm-filter-open; clicked => { root.llm-filter-open = !root.llm-filter-open; if !root.llm-filter-open { root.llm-model-filter = 0; root.llm-filter-models(); } } }
                    }
                    sync-models-button := SettingsButton { compact: true;
                        x: parent.width - self.width; y: parent.height - 40px;
                        label: @tr("Sync models"); enabled: !root.llm-connection-dirty && !root.llm-persisting; clicked => { root.open-provider-models(); }
                    }
                }
                if root.llm-connection-dirty: Text { text: @tr("Apply connection settings before syncing models"); color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; }
                if root.llm-search-open: ProviderInput { text <=> root.llm-model-search; placeholder: @tr("Search models"); edited => { root.llm-filter-models(); } }
                if root.llm-filter-open: ProviderFilterBar {
                    labels: [@tr("All models"), @tr("Text generation"), @tr("Embedding models"), @tr("Unknown capability"), @tr("Unavailable")]; current-index: root.llm-model-filter;
                    chosen(index) => { root.llm-model-filter = index; root.llm-filter-models(); }
                }
                Rectangle {
                    height: root.llm-enabled-catalog.length == 0 ? 168px : enabled-rows.preferred-height + 2px;
                    border-radius: 8px; border-width: root.llm-enabled-catalog.length == 0 ? 0px : 1px; border-color: Colors.outline;
                    enabled-rows := VerticalLayout { x: 1px; y: 1px; width: parent.width - 2px; height: self.preferred-height; spacing: 0px;
                        for model in root.llm-enabled-catalog: ProviderModelItem { enabled: !root.llm-persisting; model: model; toggle => { root.llm-model-toggle(model.id, false); } }
                    }
                    if root.llm-enabled-catalog.length == 0: Rectangle {
                        width: parent.width; height: parent.height;
                        Image { x: (parent.width - 40px) / 2; y: 24px; height: 40px; width: 40px; source: @image-url("icons/provider-empty.svg"); colorize: Colors.outline; }
                        Text { x: 16px; y: 72px; width: parent.width - 32px; height: 24px; text: root.llm-enabled-count == 0 ? @tr("No enabled models") : @tr("No matching models"); color: Colors.secondary-foreground; font-size: Typography.body-size; horizontal-alignment: center; }
                        Text { x: 16px; y: 104px; width: parent.width - 32px; text: @tr("Use Sync models to choose models for translation."); color: Colors.secondary-foreground; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }
            }
        }
            ocr-provider-content := OcrProviderPage {
                x: provider-content.x; y: provider-content.y + 56px; width: provider-content.width;
                visible: root.provider-detail-id == "paddleocr"; height: self.visible ? self.preferred-height : 0px;
                selected-resource: root.ocr-resource-target;
                korean-auto: root.ocr-korean-auto; korean-auto-enabled: root.ocr-korean-auto-enabled;
                korean-auto-toggled(value) => { root.ocr-korean-auto-toggled(value); }
                korean-status: root.ocr-korean-status; korean-status-kind: root.ocr-korean-status-kind;
                korean-version: root.ocr-korean-version; korean-download-size: root.ocr-korean-download-size;
                korean-installed-size: root.ocr-korean-installed-size; korean-ready: root.ocr-korean-ready;
                korean-downloading: root.ocr-korean-downloading; korean-progress: root.ocr-korean-progress;
                korean-can-download: root.ocr-korean-can-download; korean-can-remove: root.ocr-korean-can-remove;
                korean-damaged: root.ocr-korean-damaged; korean-note: root.ocr-korean-note; korean-note-error: root.ocr-korean-note-error;
                korean-download-clicked => { root.ocr-resource-target = 1; if root.ocr-korean-downloading { root.ocr-download-cancelled(); } else { root.ocr-download-dialog = true; } }
                korean-remove-clicked => { root.ocr-resource-target = 1; root.ocr-remove-dialog = true; }
                language-index <=> root.ocr-language-index;
                status: root.ocr-status; status-kind: root.ocr-resource-status-kind;
                version: root.ocr-resource-version; download-size: root.ocr-download-size-compact;
                installed-size: root.ocr-installed-size; model-rows: root.ocr-model-rows;
                ready: root.ocr-resource-ready; downloading: root.ocr-downloading; progress: root.ocr-download-progress;
                can-download: root.ocr-can-download; can-remove: root.ocr-can-remove; damaged: root.ocr-resource-damaged;
                note: root.ocr-resource-note; note-error: root.ocr-resource-note-error;
                language-selected(index) => { root.ocr-language-selected(index); }
                download-clicked => { root.ocr-resource-target = 0; if root.ocr-downloading { root.ocr-download-cancelled(); } else { root.ocr-download-dialog = true; } }
                remove-clicked => { root.ocr-resource-target = 0; root.ocr-remove-dialog = true; }
            }

    }
    AppVerticalScrollBar {
        visible: root.active-category == 5 && providers-scroll.content-height > providers-scroll.visible-height; x: main-pane.width - 14px; y: Metrics.settings-header-height + 4px;
        height: providers-scroll.height - 8px; viewport-height: providers-scroll.visible-height; content-height: providers-scroll.content-height; content-y <=> providers-scroll.content-y;
    }
    if root.active-category == 5 && root.provider-detail-id != "paddleocr" && root.llm-connection-dirty: Rectangle {
        x: provider-list.width; y: main-pane.height - 64px; width: main-pane.width - self.x; height: 64px; background: Colors.surface;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Colors.outline; }
        HorizontalLayout { padding: 12px; spacing: 8px; alignment: end;
            SettingsButton { compact: true; label: @tr("Cancel"); enabled: !root.llm-connection-saving; clicked => { root.llm-cancel-connection(); } }
            SettingsButton { compact: true; label: root.llm-connection-saving ? @tr("Working…") : @tr("Apply"); primary: true; enabled: !root.credential-busy && !root.llm-persisting && !root.credential-editing && root.credential-draft == ""; clicked => { root.llm-save-connection(); } }
        }
    }
    }
    }
    function toggle-language-menu() {
        root.close-app-language-menu();
        if root.settings-menu-open { root.close-settings-menu(); }
        else {
            root.settings-menu-scroll-y = round(min(0px, max(settings-menu.height - root.language-labels.length * 40px, settings-menu.height / 2 - (root.draft-target-index + 0.5) * 40px)) / 4px) * 4px;
            root.settings-menu-open = true; root.settings-menu-dismiss-armed = true; root.focus-settings-menu();
        }
    }
    function toggle-app-language-menu() {
        if root.app-language-menu-open { root.close-app-language-menu(); }
        else {
            root.close-settings-menu();
            root.app-language-menu-scroll-y = 0px;
            root.app-language-menu-open = true;
            app-language-menu.focus-menu();
        }
    }

    overlay := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; z: 80;

    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height; z: 10;
        enabled: (root.settings-menu-open && root.settings-menu-dismiss-armed) || root.app-language-menu-open;
        clicked => { if root.settings-menu-open { root.dismiss-settings-menu(); } else { root.dismiss-app-language-menu(); } }
    }
    settings-menu := SettingsSelectMenu {
        visible: root.settings-menu-open; z: 15;
        x: round(root.settings-menu-anchor-x / 1px) * 1px;
        y: round((root.settings-menu-anchor-y + root.settings-menu-anchor-height + 2px) / 1px) * 1px;
        width: round(root.settings-menu-anchor-width / 1px) * 1px;
        height: round(min(root.language-labels.length * 40px, max(0px, root.height - self.y - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.language-labels;
        selected-index: root.draft-target-index;
        scroll-y <=> root.settings-menu-scroll-y;
        selected(index) => { root.settings-menu-selected(index); root.dismiss-settings-menu(); }
        dismissed => { root.dismiss-settings-menu(); }
    }
    app-language-menu := SettingsSelectMenu {
        visible: root.app-language-menu-open; z: 15;
        x: round(root.app-language-menu-anchor-x / 1px) * 1px;
        y: round((root.app-language-menu-anchor-y + root.app-language-menu-anchor-height + self.height + Metrics.settings-page-padding + 2px <= root.height
            ? root.app-language-menu-anchor-y + root.app-language-menu-anchor-height + 2px
            : max(Metrics.settings-header-height + 4px, root.app-language-menu-anchor-y - self.height - 2px)) / 1px) * 1px;
        width: round(root.app-language-menu-anchor-width / 1px) * 1px;
        height: round(min(root.language-labels.length * 40px, max(0px, root.height - Metrics.settings-header-height - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.language-labels;
        selected-index: root.appearance-language-index;
        scroll-y <=> root.app-language-menu-scroll-y;
        dismissed => { root.dismiss-app-language-menu(); }
        selected(index) => {
            root.ui-language-selected(index);
            root.dismiss-app-language-menu();
        }
    }
    for toast[index] in root.toast-items: AppToast {
        x: root.sidebar-width + max(Spacing.medium, (root.page-width - self.width) / 2);
        y: Spacing.medium + index * (Metrics.toast-height + Spacing.small); z: 30;
        message: toast.message; error: toast.error;
        dismissed => { root.toast-dismiss-requested(toast.id); }
    }
    }
    close-settings-modal := SettingsFocusScope {
        visible: root.settings-close-dialog;
        x: 0px; y: 0px; width: root.width; height: root.height; z: 130;
        key-pressed(event) => { if event.text == Key.Escape { root.finish-settings-close(false); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea { } }
        ProviderDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 48px); height: min(parent.height - 48px, close-settings-copy.preferred-height + 140px);
            title: @tr("Unsaved changes"); dismissed => { root.finish-settings-close(false); }
            SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 140px;
                content-width: self.visible-width; content-height: close-settings-copy.preferred-height;
                close-settings-copy := Text {
                    width: parent.width; height: self.preferred-height; wrap: word-wrap; font-size: Typography.body-size; color: Colors.secondary-foreground;
                    text: @tr("Closing discards unapplied edits. Changes already submitted may still finish saving.");
                }
            }
            HorizontalLayout {
                x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: Spacing.small; alignment: end;
                keep-editing-button := SettingsButton { compact: true; label: @tr("Keep editing"); clicked => { root.finish-settings-close(false); } }
                SettingsButton { compact: true; destructive: true; label: @tr("Discard and close"); clicked => { root.finish-settings-close(true); } }
            }
        }
    }
    ocr-remove-modal := SettingsFocusScope {
        visible: root.ocr-remove-dialog; x: 0px; y: 0px; width: root.width; height: root.height; z: 122;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.ocr-remove-dialog = false; return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea {} }
        ProviderDialog { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(480px, parent.width - 48px); height: 260px;
            title: @tr("Delete local resources"); dismissed => { root.ocr-remove-dialog = false; }
            Text { x: 24px; y: 64px; width: parent.width - 48px; height: 120px; wrap: word-wrap; color: Colors.secondary-foreground; font-size: Typography.body-size; text: root.ocr-resource-target == 1 ? @tr("Delete the Korean extension? Basic OCR remains available.") : @tr("Delete the basic OCR resources and Korean extension? Loaded runtime files will be removed after restarting Lexift."); }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: Spacing.small; alignment: end;
                cancel-ocr-remove := SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.ocr-remove-dialog = false; } }
                SettingsButton { compact: true; destructive: true; label: @tr("Delete"); enabled: root.ocr-resource-target == 1 ? root.ocr-korean-can-remove : root.ocr-can-remove; clicked => { root.ocr-remove-dialog = false; if root.ocr-resource-target == 1 { root.ocr-korean-remove-requested(); } else { root.ocr-remove-requested(); } } }
            }
        }
    }
    changed ocr-remove-dialog => { SettingsHints.clear(); if root.ocr-remove-dialog { cancel-ocr-remove.focus-button(); } else if root.active-category == 5 && root.provider-detail-id == "paddleocr" { ocr-provider-content.focus-remove(); } }
    ocr-download-modal := SettingsFocusScope {
        visible: root.ocr-download-dialog; x: 0px; y: 0px; width: root.width; height: root.height; z: 121;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.ocr-download-dialog = false; return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea {} }
        ProviderDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(480px, parent.width - 48px); height: 240px;
            title: @tr("Download OCR resources"); dismissed => { root.ocr-download-dialog = false; }
            Text { x: 24px; y: 64px; width: parent.width - 48px; height: 100px; wrap: word-wrap; color: Colors.secondary-foreground; font-size: Typography.body-size;
                text: root.ocr-resource-target == 1 ? @tr("Download Korean recognition resources. The basic runtime is shared.") + "\n" + root.ocr-korean-download-exact : @tr("Download basic recognition models and runtime. Korean is an optional extension.") + "\n" + root.ocr-download-size;
            }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: Spacing.small; alignment: end;
                cancel-ocr-download := SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.ocr-download-dialog = false; } }
                SettingsButton { compact: true; label: @tr("Download"); clicked => { root.ocr-download-dialog = false; if root.ocr-resource-target == 1 { root.ocr-korean-download-requested(); } else { root.ocr-download-requested(); } } }
            }
        }
    }
    changed ocr-download-dialog => { SettingsHints.clear(); if root.ocr-download-dialog { cancel-ocr-download.focus-button(); } else if root.active-category == 5 && root.provider-detail-id == "paddleocr" { ocr-provider-content.focus-download(); } }
    clear-history-modal := SettingsFocusScope {
        visible: root.history-clear-dialog; enabled: !root.settings-close-dialog;
        x: 0px; y: 0px; width: root.width; height: root.height; z: 120;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.finish-history-clear(false); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea { } }
        ProviderDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 48px); height: min(parent.height - 48px, clear-history-copy.preferred-height + 140px);
            title: @tr("Clear clipboard history"); dismissed => { root.finish-history-clear(false); }
            SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 140px;
                content-width: self.visible-width; content-height: clear-history-copy.preferred-height;
                clear-history-copy := Text {
                    width: parent.width; height: self.preferred-height; wrap: word-wrap; font-size: Typography.body-size; color: Colors.secondary-foreground;
                    text: @tr("Delete all saved clipboard history? This cannot be undone.");
                }
            }
            HorizontalLayout {
                x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: Spacing.small; alignment: end;
                cancel-clear-history := SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.finish-history-clear(false); } }
                SettingsButton { compact: true; destructive: true; label: @tr("Clear clipboard history"); clicked => { root.finish-history-clear(true); } }
            }
        }
    }
    delete-key-modal := SettingsFocusScope {
        visible: root.credential-delete-dialog;
        enabled: !root.settings-close-dialog;
        x: 0px; y: 0px; width: root.width; height: root.height; z: 120;
        key-pressed(event) => { if event.text == Key.Escape { root.finish-credential-delete(false); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea { } }
        ProviderDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 48px); height: min(parent.height - 48px, delete-key-content.preferred-height + 140px);
            title: @tr("Delete key"); dismissed => { root.finish-credential-delete(false); }
            SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 140px;
                content-width: self.visible-width; content-height: delete-key-content.preferred-height;
                delete-key-content := VerticalLayout {
                    x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: Spacing.small;
                    Text { text: ["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.credential-delete-provider < 0 ? 0 : root.credential-delete-provider]; font-weight: 600; font-size: Typography.body-size; color: Colors.foreground; }
                    Text { text: @tr("Remove this API key from system storage?"); wrap: word-wrap; font-size: Typography.body-size; color: Colors.secondary-foreground; }
                    Text { text: root.credential-delete-provider == 3 && root.deepseek-environment-key ? @tr("The environment key will be used again. Your environment and .env file are unchanged.") : @tr("You will need to enter the key again to reconnect."); wrap: word-wrap; font-size: 13px; color: Colors.secondary-foreground; }
                }
            }
            HorizontalLayout {
                x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: Spacing.small; alignment: end;
                cancel-delete-key := SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.finish-credential-delete(false); } }
                SettingsButton { compact: true; destructive: true; label: @tr("Delete key"); enabled: !root.credential-busy && !root.credential-request-pending; clicked => { root.finish-credential-delete(true); } }
            }
        }
    }
    public function open-translation-selector() {
        root.close-settings-menu(); root.close-app-language-menu();
        root.translation-search = ""; root.translation-highlight = -1; root.translation-filter();
        root.translation-selector-open = !root.translation-selector-open;
        if root.translation-selector-open { translation-search-input.focus-input(); }
    }
    changed active-category => { SettingsHints.clear(); root.history-clear-dialog = false;
        if root.active-category != 1 {
            root.translation-selector-open = false;
            if root.translation-settings-open { root.llm-cancel-translation(); root.translation-settings-open = false; }
        }
    }
    translation-choice-focus := SettingsFocusScope {
        visible: root.translation-selector-open && root.active-category == 1; z: 100;
        width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.translation-selector-open = false; selector-focus.focus-target(); return accept; }
            if event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.translation-move(event.text == Key.DownArrow ? 1 : -1);
                if root.translation-highlight >= 0 { choices-viewport.content-y = min(0px, max(choices-viewport.visible-height - choices-viewport.content-height, -root.translation-choices[root.translation-highlight].top * 1px)); }
                return accept;
            }
            if event.text == Key.Return && root.translation-highlight >= 0 { root.translation-selected(root.translation-highlight); return accept; }
            return reject;
        }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.translation-selector-open = false; selector-focus.focus-target(); } }
        Rectangle {
            x: max(12px, min(translation-selector.absolute-position.x, root.width - self.width - 12px));
            y: max(12px, min(translation-selector.absolute-position.y + translation-selector.height + 6px, root.height - self.height - 12px));
            width: min(500px, root.width - 24px); height: min(460px, root.height - 32px, max(180px, root.translation-list-height * 1px + 116px));
            border-radius: 12px; border-width: 1px; border-color: Colors.outline; background: Colors.surface;
            TouchArea { }
            translation-search-input := ProviderInput { x: 12px; y: 12px; width: parent.width - 24px; text <=> root.translation-search; placeholder: @tr("Search models"); edited => { root.translation-filter(); } }
            choices-viewport := SettingsScrollArea {
                x: 8px; y: 64px; width: parent.width - 16px; height: parent.height - 116px;
                content-width: self.visible-width; content-height: max(self.visible-height, root.translation-list-height * 1px);
                if root.translation-choices.length == 0: Text { x: 12px; y: 16px; width: parent.width - 24px; text: @tr("No matching models"); color: Colors.secondary-foreground; font-size: Typography.body-size; }
                for choice[index] in root.translation-choices: Rectangle {
                    y: choice.top * 1px; width: parent.width; height: choice.group == "" ? 48px : 76px;
                    if choice.group != "": Text { x: 12px; y: 0px; height: 28px; text: choice.group; color: Colors.secondary-foreground; font-size: 13px; vertical-alignment: center; }
                    Rectangle {
                        y: choice.group == "" ? 0px : 28px; width: parent.width; height: 46px; border-radius: 8px;
                        background: SettingsColors.interactive(transparent, choice.usable && choice-touch.has-hover, choice.usable && choice-touch.pressed, root.translation-highlight == index || (root.llm-translation-provider-index == choice.provider && (choice.provider == 0 || root.llm-selected-model == choice.id)));
                        opacity: choice.usable ? 1 : Metrics.disabled-opacity;
                        if root.llm-translation-provider-index == choice.provider && (choice.provider == 0 || root.llm-selected-model == choice.id): Rectangle { x: 0px; width: 3px; height: 26px; y: 10px; border-radius: 2px; background: Colors.success; }
                        ProviderLogo { x: 12px; y: 12px; width: 22px; height: 22px; provider: choice.provider; }
                        Text { x: 44px; y: choice.note == "" ? 0px : 1px; width: parent.width - 100px; height: choice.note == "" ? 46px : 25px; text: choice.id; color: root.translation-highlight == index || (root.llm-translation-provider-index == choice.provider && (choice.provider == 0 || root.llm-selected-model == choice.id)) ? SettingsColors.accent : Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                        if choice.note != "": Text { x: 44px; y: 25px; width: parent.width - 56px; height: 18px; text: choice.note; color: Colors.secondary-foreground; font-size: 11px; overflow: elide; }
                        if choice.thinking: Image { x: parent.width - 32px; y: 14px; width: 18px; height: 18px; source: @image-url("icons/provider-thinking.svg"); colorize: Colors.primary; }
                        choice-touch := TouchArea { mouse-cursor: choice.usable ? pointer : default;

                            clicked => { if choice.usable && !root.translation-selecting { SettingsInteraction.pointer-input(); root.translation-selected(index); } }
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 48px; width: parent.width; height: 1px; background: Colors.outline; }
            SettingsButton { x: 12px; y: parent.height - 42px; width: parent.width - 24px; compact: true; label: @tr("Manage models"); clicked => { root.manage-translation-models(); } }
        }
    }
    SettingsHintTarget { active: selector-touch.has-hover && !root.translation-selector-open && !root.translation-settings-open && selected-model-caption.preferred-width > selected-model-caption.width; text: root.llm-selected-model; anchor-x: translation-selector.absolute-position.x; anchor-y: translation-selector.absolute-position.y; anchor-height: translation-selector.height; }
    translation-modal-focus := SettingsFocusScope {
        visible: root.translation-settings-open; z: 110; width: root.width; height: root.height;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.cancel-translation-settings(); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea { } }
        ProviderDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(620px, parent.width - 32px); height: min(760px, parent.height - 32px);
            title: @tr("Translation settings"); dismissed => { root.cancel-translation-settings(); }
            translation-settings-viewport := SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 144px;
                content-width: self.visible-width; content-height: translation-fields.preferred-height;
                translation-fields := VerticalLayout { x: 0px; y: 0px; width: max(0px, translation-settings-viewport.visible-width - 12px); height: self.preferred-height; spacing: 12px; alignment: start;
                    Text { text: "\{["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.llm-translation-provider-index]} · \{root.llm-selected-model}"; color: Colors.secondary-foreground; font-size: 13px; wrap: word-wrap; }
                    Text { text: @tr("Model parameters"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; }
                    SettingsToggleRow { label: @tr("Streaming"); description: @tr("Show translation progressively as it is generated"); checked: root.llm-streaming; enabled: !root.llm-translation-saving; toggled(value) => { root.llm-streaming = value; } }
                    SettingsControlRow { label: @tr("Thinking effort");
                        SettingsComboBox { model: root.llm-reasoning-options; placeholder: @tr("Unavailable"); current-index <=> root.llm-reasoning-index; enabled: root.llm-reasoning-options.length > 1; selected(index) => { root.llm-reasoning-selected(self.current-index); } }
                    }
                    Text { visible: root.llm-reasoning-note != ""; height: self.visible ? self.preferred-height : 0px; font-size: Typography.body-size; text: root.llm-reasoning-note; color: Colors.secondary-foreground; wrap: word-wrap; }
                    SettingsToggleRow {
                        label: @tr("Model temperature"); description: root.llm-temperature-custom ? @tr("Custom") : @tr("Model default");
                        enabled: root.llm-temperature-available; checked: root.llm-temperature-custom;
                        toggled(value) => { root.llm-temperature-custom = value; }
                    }
                    if root.llm-temperature-custom && root.llm-temperature-available: HorizontalLayout { spacing: Spacing.medium;
                        Rectangle { height: 32px; min-width: 120px; horizontal-stretch: 1;
                            Slider { y: (parent.height - self.height) / 2; width: parent.width; value: root.llm-temperature; maximum: root.llm-temperature-max; wheel-step: 1; changed value => { root.llm-temperature = round(self.value); } }
                        }
                        SpinBox { width: 110px; height: 32px; value <=> root.llm-temperature; minimum: 0; maximum: root.llm-temperature-max; display-divisor: 100; }
                    }
                    SettingsToggleRow {
                        label: "Top-P"; description: root.llm-top-p-custom ? @tr("Custom") : @tr("Model default");
                        enabled: root.llm-top-p-available; checked: root.llm-top-p-custom;
                        toggled(value) => { root.llm-top-p-custom = value; }
                    }
                    if root.llm-top-p-custom && root.llm-top-p-available: HorizontalLayout { spacing: Spacing.medium;
                        Rectangle { height: 32px; min-width: 120px; horizontal-stretch: 1;
                            Slider { y: (parent.height - self.height) / 2; width: parent.width; value: root.llm-top-p; minimum: root.llm-top-p-min; maximum: 100; wheel-step: 1; changed value => { root.llm-top-p = round(self.value); } }
                        }
                        SpinBox { width: 110px; height: 32px; value <=> root.llm-top-p; minimum: root.llm-top-p-min; maximum: 100; display-divisor: 100; }
                    }

                    Rectangle { height: 1px; background: Colors.outline; }
                    Text { text: @tr("Translation prompt"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; }
                    Rectangle { height: 240px; border-radius: 6px; border-width: 1px; border-color: prompt-input.has-focus ? SettingsColors.focus : Colors.outline; background: SettingsColors.field;
                        SettingsScrollArea { x: Spacing.small; y: Spacing.small; width: parent.width - 2 * Spacing.small; height: parent.height - 2 * Spacing.small;
                            content-width: self.visible-width;
                            prompt-input := TextInput {
                                in property <int> focus-request: root.editor-focus-request;
                                changed focus-request => { if root.editor-return-target == 4 && root.active-category == 1 && root.llm-prompt-expanded { self.focus(); self.set-selection-offsets(root.editor-return-anchor, root.editor-return-cursor); } }
                                cursor-position-changed(position) => { if self.has-focus { root.remember-editor-selection(4, self.anchor-position-byte-offset, self.cursor-position-byte-offset); } }
                                changed has-focus => { root.editor-focus-changed(4, self.has-focus); }
                                width: parent.width; min-height: 220px; text <=> root.llm-prompt; wrap: word-wrap; color: Colors.foreground; font-size: Typography.body-size; selection-background-color: SettingsColors.selected; selection-foreground-color: Colors.foreground; }
                        }
                    }
                    Text { font-size: Typography.body-size; text: @tr("Use {{target_language}} for the target language."); color: Colors.secondary-foreground; wrap: word-wrap; }
                    FlexboxLayout { flex-wrap: wrap; spacing: Spacing.small;
                        SettingsButton { label: @tr("Restore default prompt"); clicked => { root.reset-prompt-with-undo(); } }
                    }
                    if root.prompt-can-undo-reset: HorizontalLayout {
                        spacing: Spacing.small;
                        Text { text: @tr("Prompt restored to default."); color: Colors.secondary-foreground; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        SettingsButton { compact: true; label: @tr("Undo"); clicked => { root.undo-prompt-reset(); } }
                    }

                    if !root.llm-prompt-valid: Text { text: @tr("Use {{target_language}} for the target language."); color: Colors.error; font-size: 13px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: 12px; alignment: end;
                SettingsButton { compact: true; label: @tr("Cancel"); enabled: !root.llm-translation-saving; clicked => { root.cancel-translation-settings(); } }
                SettingsButton { compact: true; primary: true; label: root.llm-translation-saving ? @tr("Working…") : @tr("Apply"); enabled: root.llm-translation-can-apply && !root.llm-persisting && !root.credential-busy && !root.llm-translation-saving; clicked => { root.llm-save-translation(); } }
            }
        }
    }
    provider-modal-focus := SettingsFocusScope {
        enabled: !root.settings-close-dialog;
        visible: root.active-category == 5 && (root.llm-advanced || root.llm-model-dialog || root.llm-probe-dialog);
        x: 0px; y: 0px; width: root.width; height: root.height; z: 110;
        key-pressed(event) => { if event.text == Key.Escape { root.close-provider-dialog(false); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: SettingsColors.scrim; TouchArea { } }
        request-dialog := ProviderDialog {
            visible: root.llm-advanced;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px); height: min(680px, parent.height - 48px, request-fields.preferred-height + 140px);
            title: @tr("Request configuration"); dismissed => { root.close-provider-dialog(false); }
            SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 140px;
                content-width: self.visible-width; content-height: request-fields.preferred-height;
                request-fields := VerticalLayout {
                    x: 0px; y: 0px; alignment: start; width: parent.width; height: self.preferred-height; spacing: 12px;
                    Text { height: 24px; text: @tr("Protocol"); color: Colors.foreground; font-size: Typography.body-size; }
                    SettingsComboBox { model: [@tr("Native"), "OpenAI Chat Completions", "OpenAI Responses"]; current-index <=> root.llm-protocol-index; selected(index) => { root.llm-protocol-selected(index); } }
                    Text { height: 24px; text: "API Base URL"; color: Colors.foreground; font-size: Typography.body-size; }
                    ProviderInput { text <=> root.llm-base-url; edited => { root.llm-base-edited(); }
                        focus-request: root.editor-focus-request; restore-focus: root.editor-return-target == 5 && root.llm-advanced;
                        focus-state-changed(focused) => { root.editor-focus-changed(5, focused); }
                        restore-anchor: root.editor-return-anchor; restore-cursor: root.editor-return-cursor;
                        selection-changed(anchor, cursor) => { root.remember-editor-selection(5, anchor, cursor); }
                    }
                    Text { text: root.llm-endpoints; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                    Text { height: 24px; text: @tr("Authentication"); color: Colors.foreground; font-size: Typography.body-size; }
                    SettingsComboBox { model: [@tr("Automatic API key"), @tr("Custom request headers"), @tr("None")]; current-index <=> root.llm-auth-index; selected(index) => { root.llm-draft-changed(); } }
                    HorizontalLayout { height: 32px;
                        Text { text: @tr("Custom request headers"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; horizontal-stretch: 1; }
                        ProviderIconButton { icon: @image-url("icons/provider-plus.svg"); tooltip: @tr("Add header"); clicked => { root.llm-header-name = ""; root.llm-header-value = ""; root.llm-header-editing = true; } }
                    }
                    for name in root.llm-headers: HorizontalLayout { height: 36px; spacing: 4px;
                        Text { text: name + ": ••••••••"; color: Colors.foreground; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        CredentialActionButton { icon-kind: 2; clicked => { root.llm-header-name = name; root.llm-header-value = ""; root.llm-header-editing = true; } }
                        CredentialActionButton { icon-kind: 3; enabled: !root.credential-busy; clicked => { root.llm-header-remove(name); } }
                    }
                    if root.llm-header-editing: VerticalLayout { spacing: 8px;
                        ProviderInput { text <=> root.llm-header-name; placeholder: @tr("Header name");
                            focus-request: root.editor-focus-request; restore-focus: root.editor-return-target == 6 && root.llm-advanced && root.llm-header-editing;
                            focus-state-changed(focused) => { root.editor-focus-changed(6, focused); }
                        restore-anchor: root.editor-return-anchor; restore-cursor: root.editor-return-cursor;
                        selection-changed(anchor, cursor) => { root.remember-editor-selection(6, anchor, cursor); }
                        }
                        ProviderInput { text <=> root.llm-header-value; placeholder: @tr("Header value"); secret: true;
                            focus-request: root.editor-focus-request; restore-focus: root.editor-return-target == 7 && root.llm-advanced && root.llm-header-editing;
                            focus-state-changed(focused) => { root.editor-focus-changed(7, focused); }
                        restore-anchor: root.editor-return-anchor; restore-cursor: root.editor-return-cursor;
                        selection-changed(anchor, cursor) => { root.remember-editor-selection(7, anchor, cursor); }
                        }
                        HorizontalLayout { alignment: end; spacing: 8px;
                            SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.llm-header-value = ""; root.llm-header-name = ""; root.llm-header-editing = false; } }
                            SettingsButton { compact: true; label: @tr("Save header"); enabled: root.llm-header-name != "" && root.llm-header-value != ""; clicked => { root.llm-header-save(); } }
                        }
                    }
                    if root.llm-status != "": Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                }
            }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: 8px; alignment: end;
                SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.close-provider-dialog(false); } }
                SettingsButton { compact: true; label: @tr("OK"); primary: true; enabled: !root.credential-busy; clicked => { root.close-provider-dialog(true); } }
            }
        }
        probe-dialog := ProviderDialog {
            visible: root.llm-probe-dialog;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px);
            height: min(parent.height - 48px, root.llm-probe-results.length > 0 ? 600px : 380px);
            title: root.llm-probe-all ? @tr("Test all enabled models") : @tr("Select a model to test");
            dismissed => { root.close-provider-dialog(false); }
            SettingsScrollArea {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 144px;
                content-width: self.visible-width; content-height: probe-fields.preferred-height;
                probe-fields := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; alignment: start; spacing: 12px;
                    if !root.llm-probe-all: Text { text: @tr("Select a model"); font-size: Typography.body-size; color: Colors.foreground; }
                    if !root.llm-probe-all: SettingsComboBox { model: root.llm-probe-models; current-index <=> root.llm-probe-index; placeholder: @tr("No enabled models"); enabled: !root.llm-probe-running; selected(index) => { root.llm-probe-selected(); } }
                    Text { text: @tr("API key"); font-size: 13px; color: Colors.secondary-foreground; }
                    Rectangle { height: 40px; border-radius: 6px; border-width: 1px; border-color: Colors.outline; background: Colors.background;
                        Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.llm-key-configured || (root.provider-detail-id == "deepseek" && root.deepseek-environment-key) ? "••••••••••••" : @tr("No authentication configured"); font-size: 13px; color: Colors.secondary-foreground; vertical-alignment: center; }
                    }
                    if (root.llm-key-configured && root.provider-detail-id != "deepseek") || (root.provider-detail-id == "deepseek" && !root.llm-key-configured && root.deepseek-environment-key): Text { text: root.llm-key-configured ? @tr("Credential source: system storage") : @tr("Credential source: environment; manage it outside Lexift"); font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    Text { text: @tr("Testing sends a short fixed message. It may load local models or incur API charges."); font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    if root.llm-probe-all: Text { text: @tr("Enabled models") + ": " + root.llm-probe-models.length; font-size: Typography.body-size; color: Colors.foreground; }
                    if root.llm-probe-note != "": Text { text: root.llm-probe-note; font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    if root.llm-probe-progress != "": Text { text: root.llm-probe-progress; font-size: 13px; color: Colors.foreground; wrap: word-wrap; }
                    for result in root.llm-probe-results: Rectangle { height: max(64px, probe-result.preferred-height + 16px); border-width: 1px; border-color: Colors.outline; border-radius: 6px;
                        probe-result := VerticalLayout { x: 12px; y: 8px; width: parent.width - 24px; height: self.preferred-height; spacing: 4px;
                            Text { text: result.id; font-size: 14px; color: Colors.foreground; overflow: elide; }
                            Text { text: result.state + (result.elapsed == "" ? "" : " · " + result.elapsed); font-size: 12px; color: result.failed ? Colors.error : Colors.secondary-foreground; }
                            if result.detail != "": Text { text: result.detail; font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                        }
                    }
                }
            }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: 8px;
                SettingsButton { compact: true; visible: !root.llm-probe-all; label: @tr("Test all models"); enabled: !root.llm-probe-running && root.llm-probe-models.length > 0; clicked => { root.llm-probe-all = true; root.llm-probe-selected(); } }
                Rectangle { horizontal-stretch: 1; }
                SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.close-provider-dialog(false); } }
                SettingsButton { compact: true; label: root.llm-probe-running ? @tr("Testing…") : @tr("Start"); primary: true; enabled: root.llm-probe-can-start && !root.llm-probe-running; clicked => { root.llm-probe-start(); } }
            }
        }
        model-dialog := ProviderDialog {
            visible: root.llm-model-dialog;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(720px, parent.width - 48px); height: min(680px, parent.height - 48px);
            title: ["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.provider-detail-index] + " · " + @tr("Models") + "  " + root.llm-catalog-count;
            dismissed => { root.close-provider-dialog(false); }
            model-tools := VerticalLayout { x: 24px; y: 64px; width: parent.width - 48px; height: self.preferred-height; spacing: 8px;
                ProviderInput { text <=> root.llm-model-search; placeholder: @tr("Search models"); edited => { root.llm-filter-models(); } }
                ProviderFilterBar {
                    labels: [@tr("All models"), @tr("Text generation"), @tr("Embedding models"), @tr("Unknown capability"), @tr("Unavailable")]; current-index: root.llm-model-filter;
                    chosen(index) => { root.llm-model-filter = index; root.llm-filter-models(); }
                }
                Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: root.llm-status == "" ? 0px : self.preferred-height; }
            }
            model-viewport := SettingsScrollArea {
                    x: 24px; y: model-tools.y + model-tools.height + 8px; width: parent.width - 48px;
                    height: max(0px, model-dialog.height - self.y - 80px);
                    content-width: self.visible-width; content-height: max(self.visible-height, discovered-rows.preferred-height);
                    scrolled => { SettingsHints.clear(); }
                    discovered-rows := VerticalLayout { x: 0px; y: 0px; alignment: start; width: model-viewport.visible-width; height: self.preferred-height; spacing: 0px;
                        for model in root.llm-catalog: ProviderModelItem { enabled: !root.llm-persisting; model: model; toggle => { root.llm-model-toggle(model.id, !model.enabled); } }
                    }
                    if root.llm-catalog.length == 0: Text { width: parent.width; height: 100px; text: root.llm-syncing ? @tr("Loading…") : @tr("No matching models"); color: Colors.secondary-foreground; font-size: Typography.body-size; horizontal-alignment: center; vertical-alignment: center; }
                }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; alignment: end; spacing: 8px;
                SettingsButton { compact: true; label: @tr("Sync models"); enabled: !root.llm-syncing && !root.llm-persisting; clicked => { root.llm-refresh(false); } }
                SettingsButton { compact: true; label: @tr("Close"); clicked => { root.close-provider-dialog(false); } }
            }
        }
    }
    SettingsHintOverlay { window-width: root.width; window-height: root.height; }

}
