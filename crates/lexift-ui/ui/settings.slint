    in property <bool> credential-busy: false;
    in property <string> credential-error-text: "";
    in-out property <string> credential-draft: "";
    in-out property <string> credential-transient-secret: "";
    in-out property <bool> credential-revealed: false;
    in-out property <bool> credential-editing: false;
    in-out property <bool> credential-secret-visible: false;
    in-out property <bool> credential-reveal-dismiss-armed: false;
    in-out property <bool> credential-request-pending: false;
    in-out property <bool> settings-menu-open: false;
    in-out property <bool> settings-menu-dismiss-armed: false;
    in-out property <length> settings-menu-scroll-y: 0px;
    in-out property <[SettingsToastData]> toast-items: [];
    in-out property <int> active-category: 0;
    in-out property <int> appearance-theme-index: 0;
    callback theme-selected(int);
    callback ui-language-selected(int);
    in-out property <int> appearance-accent-index: 0;
    in-out property <int> appearance-font-index: 0;
    in-out property <int> appearance-size-index: 1;
    in-out property <int> appearance-language-index: 2;
    in-out property <int> tray-click-index: 0;
    in-out property <bool> open-settings-on-launch: true;
    in-out property <bool> check-updates-on-launch: true;
    in-out property <bool> background-copy-notifications: true;
    in-out property <bool> anonymous-usage-statistics: false;
    in-out property <bool> disable-hotkeys-in-fullscreen: false;
    in-out property <bool> selection-double-click: true;
    in-out property <string> selection-horizontal-offset: "12";
    in-out property <string> selection-vertical-offset: "12";
    in-out property <int> selection-filter-mode-index: 0;
    in-out property <bool> selection-copy-action: true;
    in-out property <bool> screenshot-crosshair-guides: false;
    in-out property <bool> screenshot-magnifier: true;
    in-out property <bool> screenshot-selection-dimensions: true;
    in-out property <string> screenshot-line-width: "3";
    in-out property <string> screenshot-text-size: "22";
    in-out property <string> screenshot-save-location: "";
    in-out property <int> screenshot-format-index: 0;
    in-out property <bool> screenshot-copy-as-file: false;
    in-out property <bool> screenshot-close-after-output: false;
    in-out property <int> fallback-target-index: 2;
    in-out property <bool> preprocess-join-lines: false;
    in-out property <bool> preprocess-snake-case: false;
    in-out property <bool> preprocess-camel-case: false;
    in-out property <bool> preprocess-pascal-case: false;
    in-out property <bool> preprocess-kebab-case: false;
    in-out property <bool> translation-auto-copy: false;
    in-out property <bool> translation-hide-input: false;
    in-out property <bool> translation-hide-language-bar: false;
    in-out property <bool> translation-auto-resize: true;
    in-out property <bool> translation-pin-window: false;
    private property <bool> preview-menu-open: false;
    private property <int> preview-menu-kind: 0;
    private property <length> preview-menu-scroll-y: 0px;

    // Match the navigation text's font and leave room for the icon and both margins.
    navigation-measure := Text {
        visible: false; font-size: Typography.body-size; font-weight: 600;
        text: @tr("General") + "\n" + @tr("Hotkeys") + "\n" + @tr("Selection Assistant") + "\n" + @tr("Screenshot settings") + "\n" + @tr("Translation settings") + "\n" + @tr("Service providers");
    }
    private property <bool> expanded-navigation: root.width >= Metrics.settings-wide-nav-breakpoint;
    private property <length> sidebar-width: root.expanded-navigation ? max(Metrics.settings-sidebar-width, navigation-measure.preferred-width + 100px) : Metrics.settings-sidebar-compact-width;
    private property <bool> hotkeys-compact: root.page-width < 580px;
    private property <length> page-width: root.width - root.sidebar-width;
    private property <[string]> language-labels: [
        "简体中文", "繁體中文", "English (US)", "English (UK)", "日本語", "한국어",
        "Deutsch", "Français", "Español", "Italiano", "Português (Portugal)", "Português (Brasil)"
    ];
    private property <[color]> appearance-accents: [
        #1967d2, #9c4da0, #ec4899, #ff5a5f, #fa8324, #ffbe0b, #5baa43
    ];
    private property <[string]> appearance-fonts: [@tr("System default"), "Segoe UI", "Arial"];
    private property <[string]> appearance-sizes: [@tr("Compact"), @tr("Standard"), @tr("Large")];
    private property <[string]> appearance-languages: root.language-labels;
    private property <[string]> tray-click-actions: [@tr("Open settings"), @tr("Open main window"), @tr("Do nothing")];
    private property <[string]> selection-filter-modes: [@tr("Blacklist"), @tr("Whitelist")];
    private property <[string]> screenshot-formats: ["PNG", "JPEG", "WebP"];
    private property <[string]> preview-menu-options: root.preview-menu-kind == 0
        ? root.appearance-fonts : root.preview-menu-kind == 1 ? root.appearance-sizes
            : root.preview-menu-kind == 2 ? root.appearance-languages
                : root.preview-menu-kind == 3 ? root.tray-click-actions
                    : root.preview-menu-kind == 4 ? root.selection-filter-modes : root.preview-menu-kind == 5 ? root.screenshot-formats : root.language-labels;
    private property <length> preview-menu-anchor-x: root.preview-menu-kind == 0
        ? font-preview.absolute-position.x : root.preview-menu-kind == 1
            ? size-preview.absolute-position.x : root.preview-menu-kind == 2
                ? app-language-preview.absolute-position.x : root.preview-menu-kind == 3
                    ? tray-click-preview.absolute-position.x : root.preview-menu-kind == 4
                        ? filter-mode-preview.absolute-position.x : root.preview-menu-kind == 5 ? screenshot-format-preview.absolute-position.x : fallback-language-preview.absolute-position.x;
    private property <length> preview-menu-anchor-y: root.preview-menu-kind == 0
        ? font-preview.absolute-position.y : root.preview-menu-kind == 1
            ? size-preview.absolute-position.y : root.preview-menu-kind == 2
                ? app-language-preview.absolute-position.y : root.preview-menu-kind == 3
                    ? tray-click-preview.absolute-position.y : root.preview-menu-kind == 4
                        ? filter-mode-preview.absolute-position.y : root.preview-menu-kind == 5 ? screenshot-format-preview.absolute-position.y : fallback-language-preview.absolute-position.y;
    private property <length> preview-menu-anchor-width: root.preview-menu-kind == 0
        ? font-preview.width : root.preview-menu-kind == 1 ? size-preview.width
            : root.preview-menu-kind == 2 ? app-language-preview.width
                : root.preview-menu-kind == 3 ? tray-click-preview.width
                    : root.preview-menu-kind == 4 ? filter-mode-preview.width : root.preview-menu-kind == 5 ? screenshot-format-preview.width : fallback-language-preview.width;
    private property <length> preview-menu-anchor-height: root.preview-menu-kind == 0
        ? font-preview.height : root.preview-menu-kind == 1 ? size-preview.height
            : root.preview-menu-kind == 2 ? app-language-preview.height
                : root.preview-menu-kind == 3 ? tray-click-preview.height
                    : root.preview-menu-kind == 4 ? filter-mode-preview.height : root.preview-menu-kind == 5 ? screenshot-format-preview.height : fallback-language-preview.height;
    private property <length> settings-menu-anchor-x: language-selector.absolute-position.x;
    private property <length> settings-menu-anchor-y: language-selector.absolute-position.y;
    private property <length> settings-menu-anchor-height: language-selector.height;
    private property <length> settings-menu-anchor-width: language-selector.width;

    callback hotkey-key-pressed(string, bool, bool, bool, bool) -> string;
    callback hotkey-change-requested(string);
    callback annotation-hotkey-change-requested(string);
    callback launch-at-login-change-requested(bool);
    callback selection-toolbar-change-requested(bool);
    callback credential-save-requested(string);
    callback credential-remove-requested();
    callback credential-reveal-requested();
    callback credential-edit-requested();
    callback credential-copy-requested();
    callback credential-hide-requested();
    callback credential-edit-cancel-requested();
    callback credential-edit-blurred();
    callback settings-menu-selected(int);
    callback toast-dismiss-requested(int);

    public function focus-credential-reveal() { provider-credential.focus-reveal(); }
    public function focus-credential-edit() { provider-credential.focus-edit(); }
    public pure function credential-edit-focused() -> bool {return provider-credential.edit-focused();}
    public function focus-hotkey-capture() { hotkey-capture.focus(); }
    public function focus-annotation-hotkey-capture() { annotation-hotkey-capture.focus(); }
    public function focus-settings-menu() { settings-menu-focus.focus(); }
    public function scroll-model-settings(bottom: bool) {
        translation-scroll.content-y = min(0px, max(translation-scroll.visible-height - translation-scroll.content-height, bottom ? translation-scroll.visible-height - translation-scroll.content-height : -llm-translation-card.y));
    }
    out property <length> translation-model-section-height: llm-translation-card.height + Metrics.settings-card-gap;
    public function open-provider-request() {
        root.credential-edit-cancel-requested(); root.close-preview-menu(); root.close-settings-menu();
        root.llm-model-hint = ""; root.llm-request-open(); root.llm-advanced = true; provider-modal-focus.focus();
    }
    public function open-provider-models() {
        if root.llm-connection-dirty { return; }
        root.credential-edit-cancel-requested(); root.llm-model-hint = ""; root.llm-model-dialog = true; model-viewport.content-y = 0px;
        root.llm-model-search = ""; root.llm-model-filter = 0; root.llm-filter-models();
        root.llm-refresh(false); provider-modal-focus.focus();
    }
    public function close-provider-dialog(confirm: bool) {
        if root.llm-probe-dialog { root.llm-probe-close(); check-models-button.focus-button(); }
        else if root.llm-advanced { root.llm-request-close(confirm); if !root.llm-advanced { request-config-button.focus-button(); } }
        else { root.llm-model-dialog = false; root.llm-models-close(); sync-models-button.focus-button(); }
    }
    public function open-provider-probe() {
        root.llm-model-hint = "";
        root.llm-probe-open();
        if root.llm-probe-dialog { root.credential-hide-requested(); provider-modal-focus.focus(); }
    }
    public function close-settings-menu() { settings-menu-open = false; settings-menu-dismiss-armed = false; }
    public function close-preview-menu() { preview-menu-open = false; }
    public function reset-settings-view() {
        root.close-settings-menu(); root.close-preview-menu(); root.hotkey-capturing = false; root.annotation-hotkey-capturing = false; root.active-category = 0; root.llm-page-left();
        general-scroll.content-y = 0px; translation-scroll.content-y = 0px; providers-scroll.content-y = 0px;
        hotkeys-scroll.content-y = 0px; selection-assistant-scroll.content-y = 0px;
        screenshot-scroll.content-y = 0px;
    }
    public function select-category(category: int) {
        if root.active-category == category { return; }
        root.close-settings-menu(); root.close-preview-menu(); root.hotkey-capturing = false; root.annotation-hotkey-capturing = false;
        if root.active-category == 5 { root.credential-edit-cancel-requested(); root.llm-page-left(); }
        root.active-category = category;
    }

    root-content := FocusScope {
        enabled: !root.llm-advanced && !root.llm-model-dialog && !root.llm-probe-dialog;
        x: 0px; y: 0px; width: root.width; height: root.height;

    sidebar := Rectangle {
        x: 0px; y: 0px; width: root.sidebar-width; height: root-content.height; z: 10; background: Colors.surface;
        Image {
            x: root.expanded-navigation ? Spacing.medium : (parent.width - 28px) / 2;
            y: Spacing.large; width: 28px; height: 28px;
            source: AppAssets.app-icon; image-fit: contain;
        }
        if root.expanded-navigation: Text {
            x: Spacing.medium + 40px; y: Spacing.large - 6px;
            width: parent.width - self.x - Spacing.medium; height: 40px;
            text: "Lexift"; color: Colors.foreground; font-size: 20px; font-weight: 700; vertical-alignment: center;
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px; width: parent.width - 2 * self.x;
            label: @tr("General"); icon-kind: 0; selected: root.active-category == 0; expanded: root.expanded-navigation;
            activated => { root.select-category(0); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + Metrics.settings-nav-item-height + Spacing.small;
            width: parent.width - 2 * self.x;
            label: @tr("Hotkeys"); icon-kind: 2; selected: root.active-category == 2; expanded: root.expanded-navigation;
            activated => { root.select-category(2); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 2 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Selection Assistant"); icon-kind: 3; selected: root.active-category == 3; expanded: root.expanded-navigation;
            activated => { root.select-category(3); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 3 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Screenshot settings"); icon-kind: 4; selected: root.active-category == 4; expanded: root.expanded-navigation;
            activated => { root.select-category(4); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 4 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Translation settings"); icon-kind: 1; selected: root.active-category == 1; expanded: root.expanded-navigation;
            activated => { root.select-category(1); }
        }
        SettingsNavItem {
            x: root.expanded-navigation ? Spacing.medium : Spacing.small;
            y: Spacing.large + 64px + 5 * (Metrics.settings-nav-item-height + Spacing.small);
            width: parent.width - 2 * self.x;
            label: @tr("Service providers"); icon-kind: 5; selected: root.active-category == 5; expanded: root.expanded-navigation;
            activated => { root.select-category(5); }
        }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.outline; }
    }

    main-pane := Rectangle {
        x: root.sidebar-width; y: 0px; width: root.width - root.sidebar-width; height: root.height;
        clip: true;

    header := Rectangle {
        x: 0px; y: 0px; width: main-pane.width; height: Metrics.settings-header-height; z: 5; background: Colors.surface;
        Text {
            x: Metrics.settings-page-padding; y: (parent.height - 32px) / 2; height: 32px;
            text: root.active-category == 0 ? @tr("General") : root.active-category == 2 ? @tr("Hotkeys")
                : root.active-category == 3 ? @tr("Selection Assistant")
                    : root.active-category == 4 ? @tr("Screenshot settings")
                        : root.active-category == 5 ? @tr("Service providers") : @tr("Translation settings");
            color: Colors.foreground; font-size: 24px; font-weight: 700; vertical-alignment: center;
        }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Colors.outline; }
    }

    general-scroll := ScrollView {
        visible: root.active-category == 0;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, privacy-card.y + privacy-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => {
            root.close-preview-menu();
            if root.settings-menu-open && (root.settings-menu-anchor-y < Metrics.settings-header-height || root.settings-menu-anchor-y + root.settings-menu-anchor-height > root.height) { root.close-settings-menu(); }
        }



        appearance-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: Metrics.settings-page-padding;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Appearance");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1;
                spacing: Spacing.medium;
                Text { height: 22px; text: @tr("App theme"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                HorizontalLayout {
                    width: 100%; height: 106px; spacing: Spacing.small;
                    for theme in [0, 1, 2]: AppearanceThemeChoice {
                        width: (parent.width - 2 * Spacing.small) / 3;
                        theme-kind: theme; selected: root.appearance-theme-index == theme;
                        chosen => { root.theme-selected(theme); root.close-preview-menu(); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Text { height: 22px; text: @tr("Accent color"); color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; vertical-alignment: center; }
                HorizontalLayout {
                    width: 100%; height: 36px; spacing: Spacing.small;
                    for accent[index] in root.appearance-accents: AppearanceAccentChoice {
                        swatch: accent; selected: root.appearance-accent-index == index;
                        chosen => { root.appearance-accent-index = index; root.close-preview-menu(); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("App font"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    font-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-fonts[root.appearance-font-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 0;
                        clicked => { root.toggle-preview-menu(0); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("Text size"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    size-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-sizes[root.appearance-size-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 1;
                        clicked => { root.toggle-preview-menu(1); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("App language"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    app-language-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.appearance-languages[root.appearance-language-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 2;
                        clicked => { root.toggle-preview-menu(2); }
                    }
                }
            }
        }

        startup-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: appearance-card.y + appearance-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Startup & updates");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Launch at startup"); description: ""; error-text: root.launch-at-login-error-text; }
                    SettingsSwitch { checked: root.launch-at-login; toggled(value) => { root.launch-at-login = value; root.launch-at-login-change-requested(value); } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: 56px; spacing: Spacing.small; alignment: center;
                    Text { width: parent.width * 0.36 - Spacing.small; wrap: word-wrap; text: @tr("On tray icon click"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; }
                    tray-click-preview := AppearancePreviewField {
                        width: parent.width * 0.64; value: root.tray-click-actions[root.tray-click-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 3;
                        clicked => { root.toggle-preview-menu(3); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Open settings on launch");
                        description: @tr("Start in the background when this is off."); error-text: "";
                    }
                    SettingsSwitch { checked: root.open-settings-on-launch; toggled(value) => { root.open-settings-on-launch = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Check for updates on launch"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.check-updates-on-launch; toggled(value) => { root.check-updates-on-launch = value; } }
                }
            }
        }

        privacy-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: startup-card.y + startup-card.height + Metrics.settings-card-gap;
            width: general-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Notifications & privacy");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Show background copy notifications");
                        description: @tr("Shows background copy results and errors."); error-text: "";
                    }
                    SettingsSwitch { checked: root.background-copy-notifications; toggled(value) => { root.background-copy-notifications = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel {
                        width: parent.width - 52px - Spacing.medium;
                        label: @tr("Anonymous usage statistics");
                        description: @tr("No translation text or personal data."); error-text: "";
                    }
                    SettingsSwitch { checked: root.anonymous-usage-statistics; toggled(value) => { root.anonymous-usage-statistics = value; } }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 0;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: general-scroll.visible-height;
        content-height: general-scroll.content-height;
        content-y <=> general-scroll.content-y;
    }
    hotkeys-scroll := ScrollView {
        visible: root.active-category == 2;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, annotation-hotkeys-card.y + annotation-hotkeys-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;

        behavior-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: hotkeys-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Behavior");
            HorizontalLayout {
                width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                SettingsFieldLabel {
                    width: parent.width - 52px - Spacing.medium;
                    label: @tr("Disable hotkeys in fullscreen apps");
                    description: @tr("No global hotkeys in fullscreen apps.");
                    error-text: "";
                }
                SettingsSwitch {
                    checked: root.disable-hotkeys-in-fullscreen;
                    toggled(value) => { root.disable-hotkeys-in-fullscreen = value; }
                }
            }
        }

        input-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: behavior-hotkeys-card.y + behavior-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width;
            title: @tr("Input");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Input translation"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Inline input translation"); }
            }
        }

        selection-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: input-hotkeys-card.y + input-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width;
            title: @tr("Selection");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 112px : 76px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Translate selection");
                        description: root.hotkey-capturing ? @tr("Press a key combination") : @tr("Translate the current selection");
                        error-text: root.hotkey-error-text;
                    }
                    hotkey-field := Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? 58px : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.hotkey-capturing ? 2px : 1px;
                        border-color: root.hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.hotkey-capturing ? @tr("Press shortcut…") : root.draft-hotkey-label;
                            color: root.hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        hotkey-capture := FocusScope {
                            key-pressed(event) => {
                                if !root.hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.hotkey-change-requested(captured); root.draft-hotkey-label = captured; root.hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? 58px : (parent.height - 40px) / 2;
                        width: 84px; label: root.hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.annotation-hotkey-capturing = false;
                            root.hotkey-capturing = !root.hotkey-capturing;
                            if root.hotkey-capturing { root.focus-hotkey-capture(); }
                        }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Translate selection and copy"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Translate selection and replace"); }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                UnavailableHotkeyRow { width: 100%; compact: root.hotkeys-compact; label: @tr("Read selection aloud"); }
            }
        }
        annotation-hotkeys-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-hotkeys-card.y + selection-hotkeys-card.height + Metrics.settings-card-gap;
            width: behavior-hotkeys-card.width; title: @tr("Annotation");
            VerticalLayout {
                spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 126px : 92px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.small;
                        label: @tr("Annotation toolbar");
                        description: root.annotation-hotkey-capturing ? @tr("Press a key combination") : root.annotation-hotkey-status;
                        error-text: root.annotation-hotkey-error-text;
                    }
                    Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? 70px : (parent.height - 40px) / 2;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.55 - 96px;
                        height: 40px; border-radius: 6px;
                        border-width: root.annotation-hotkey-capturing ? 2px : 1px;
                        border-color: root.annotation-hotkey-capturing ? Colors.primary : Colors.outline;
                        background: Colors.background;
                        Text {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text: root.annotation-hotkey-capturing ? @tr("Press shortcut…") : root.draft-annotation-hotkey-label;
                            color: root.annotation-hotkey-capturing ? Colors.primary : Colors.foreground;
                            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
                        }
                        annotation-hotkey-capture := FocusScope {
                            key-pressed(event) => {
                                if !root.annotation-hotkey-capturing || root.active-category != 2 { return reject; }
                                if event.text == Key.Escape { root.annotation-hotkey-capturing = false; return accept; }
                                let captured = root.hotkey-key-pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if captured != "" { root.annotation-hotkey-change-requested(captured); root.draft-annotation-hotkey-label = captured; root.annotation-hotkey-capturing = false; }
                                return accept;
                            }
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? 70px : (parent.height - 40px) / 2;
                        width: 84px; label: root.annotation-hotkey-capturing ? @tr("Cancel") : @tr("Change");
                        clicked => {
                            root.hotkey-capturing = false;
                            root.annotation-hotkey-capturing = !root.annotation-hotkey-capturing;
                            if root.annotation-hotkey-capturing { root.focus-annotation-hotkey-capture(); }
                        }
                    }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 2;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: hotkeys-scroll.visible-height;
        content-height: hotkeys-scroll.content-height;
        content-y <=> hotkeys-scroll.content-y;
    }
    selection-assistant-scroll := ScrollView {
        visible: root.active-category == 3;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, selection-actions-card.y + selection-actions-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { root.close-preview-menu(); }

        selection-basic-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: selection-assistant-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Basic settings");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium;
                        label: @tr("Enable selection assistant"); description: @tr("Show Translate and Copy after selecting text"); error-text: ""; }
                    SettingsSwitch { checked: root.selection-toolbar;
                        toggled(value) => { root.selection-toolbar = value; root.selection-toolbar-change-requested(value); } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium;
                        label: @tr("Detect double-click selection"); description: @tr("Show the assistant after selecting a word by double-clicking"); error-text: ""; }
                    SettingsSwitch { checked: root.selection-double-click;
                        toggled(value) => { root.selection-double-click = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        label: @tr("Horizontal offset"); description: @tr("Positive values move the toolbar right"); error-text: "";
                    }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 52px : 11px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value <=> root.selection-horizontal-offset;
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                    SettingsFieldLabel {
                        x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        label: @tr("Vertical offset"); description: @tr("Positive values move the toolbar down"); error-text: "";
                    }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 52px : 11px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value <=> root.selection-vertical-offset;
                    }
                }
            }
        }

        selection-filter-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-basic-card.y + selection-basic-card.height + Metrics.settings-card-gap;
            width: selection-basic-card.width;
            title: @tr("App filtering");
            Rectangle {
                width: 100%; height: root.hotkeys-compact ? 102px : 64px;
                SettingsFieldLabel {
                    x: 0px; y: root.hotkeys-compact ? 0px : 10px;
                    width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                    label: @tr("Filter mode"); description: @tr("Choose where the assistant would appear"); error-text: "";
                }
                filter-mode-preview := AppearancePreviewField {
                    x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                    y: root.hotkeys-compact ? 52px : 11px;
                    width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                    value: root.selection-filter-modes[root.selection-filter-mode-index];
                    opened: root.preview-menu-open && root.preview-menu-kind == 4;
                    clicked => { root.toggle-preview-menu(4); }
                }
            }
        }
        selection-app-list-heading := Rectangle {
            x: Metrics.settings-page-padding;
            y: selection-filter-card.y + selection-filter-card.height + Metrics.settings-card-gap;
            width: selection-basic-card.width; height: 40px;
            Text { width: parent.width - 120px; height: parent.height; text: @tr("App list");
                color: Colors.secondary-foreground; font-size: Typography.body-size; vertical-alignment: center; }
            SettingsButton { x: parent.width - self.width; label: @tr("Add app"); enabled: false; }
        }
        selection-app-list-empty := Rectangle {
            x: Metrics.settings-page-padding;
            y: selection-app-list-heading.y + selection-app-list-heading.height + Spacing.small;
            width: selection-basic-card.width; height: 68px;
            border-radius: Metrics.settings-card-radius; background: Colors.surface;
            Text { text: @tr("No apps added"); color: Colors.secondary-foreground;
                font-size: Typography.body-size; horizontal-alignment: center; vertical-alignment: center; }
        }

        selection-actions-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: selection-app-list-empty.y + selection-app-list-empty.height + Metrics.settings-card-gap;
            width: selection-basic-card.width;
            title: @tr("Selection actions");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                SelectionActionRow { width: 100%; label: @tr("Translate"); icon: AppAssets.icon-translate; status: 0; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Translate and copy"); icon: AppAssets.icon-copy; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Translate and replace"); icon: AppAssets.icon-refresh; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Read aloud"); icon: AppAssets.icon-volume; status: 2; }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Copy"); icon: AppAssets.icon-copy; status: 1;
                    checked: root.selection-copy-action; toggled(value) => { root.selection-copy-action = value; } }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                SelectionActionRow { width: 100%; label: @tr("Paste"); icon: AppAssets.icon-paste; status: 2; }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 3;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: selection-assistant-scroll.visible-height;
        content-height: selection-assistant-scroll.content-height;
        content-y <=> selection-assistant-scroll.content-y;
    }
    screenshot-scroll := ScrollView {
        visible: root.active-category == 4;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, screenshot-output-card.y + screenshot-output-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { root.close-preview-menu(); }

        screenshot-selection-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: screenshot-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Selection");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Crosshair guides"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-crosshair-guides; toggled(value) => { root.screenshot-crosshair-guides = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Magnifier"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-magnifier; toggled(value) => { root.screenshot-magnifier = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Show selection dimensions"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-selection-dimensions; toggled(value) => { root.screenshot-selection-dimensions = value; } }
                }
            }
        }

        screenshot-annotation-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: screenshot-selection-card.y + screenshot-selection-card.height + Metrics.settings-card-gap;
            width: screenshot-selection-card.width;
            title: @tr("Default annotation style");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: root.hotkeys-compact ? 0px : 0px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Annotation color"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    SettingsButton {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 8px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        label: @tr("Select color"); clicked => { }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Line width"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        unit: ""; fallback-value: 3; min-value: 1;
                        value <=> root.screenshot-line-width;
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Text size"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    OffsetPreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        unit: ""; fallback-value: 22; min-value: 1;
                        value <=> root.screenshot-text-size;
                    }
                }
            }
        }

        screenshot-output-card := SettingsCard {
            x: Metrics.settings-page-padding;
            y: screenshot-annotation-card.y + screenshot-annotation-card.height + Metrics.settings-card-gap;
            width: screenshot-selection-card.width;
            title: @tr("Image output");
            VerticalLayout {
                width: 100%; horizontal-stretch: 1; spacing: Spacing.small;
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Save location"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    Rectangle {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width - 96px : parent.width * 0.42 - 96px;
                        height: 42px; border-radius: 6px; border-width: 1px;
                        border-color: Colors.outline; background: Colors.background;
                        TextInput {
                            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
                            text <=> root.screenshot-save-location;
                            color: Colors.foreground; font-size: Typography.body-size;
                            selection-background-color: Colors.primary-container;
                            selection-foreground-color: Colors.foreground; vertical-alignment: center;
                        }
                    }
                    SettingsButton {
                        x: parent.width - 84px; y: root.hotkeys-compact ? 44px : 8px;
                        width: 84px; label: @tr("Browse"); clicked => { }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                Rectangle {
                    width: 100%; height: root.hotkeys-compact ? 92px : 56px;
                    Text { x: 0px; y: 0px; width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        height: root.hotkeys-compact ? 36px : parent.height;
                        text: @tr("Image format"); color: Colors.foreground;
                        font-size: Typography.body-size; vertical-alignment: center; }
                    screenshot-format-preview := AppearancePreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.58;
                        y: root.hotkeys-compact ? 44px : 7px;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.42;
                        value: root.screenshot-formats[root.screenshot-format-index];
                        opened: root.preview-menu-open && root.preview-menu-kind == 5;
                        clicked => { root.toggle-preview-menu(5); }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Copy image as file"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-copy-as-file; toggled(value) => { root.screenshot-copy-as-file = value; } }
                }
                Rectangle { width: 100%; height: 1px; background: Colors.outline; }
                HorizontalLayout {
                    width: 100%; height: Metrics.settings-row-height; spacing: Spacing.medium; alignment: center;
                    SettingsFieldLabel { width: parent.width - 52px - Spacing.medium; label: @tr("Close after copying or saving"); description: ""; error-text: ""; }
                    SettingsSwitch { checked: root.screenshot-close-after-output; toggled(value) => { root.screenshot-close-after-output = value; } }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 4;
        x: main-pane.width - 14px;
        y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: screenshot-scroll.visible-height;
        content-height: screenshot-scroll.content-height;
        content-y <=> screenshot-scroll.content-y;
    }
    translation-scroll := ScrollView {
        visible: root.active-category == 1;
        x: 0px; y: Metrics.settings-header-height; width: main-pane.width; height: main-pane.height - Metrics.settings-header-height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, translation-behavior-card.y + translation-behavior-card.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off; mouse-drag-pan-enabled: true;
        scrolled => { root.close-settings-menu(); root.close-preview-menu(); }
        translation-language-card := SettingsCard {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: translation-scroll.visible-width - 2 * Metrics.settings-page-padding;
            title: @tr("Languages");
            VerticalLayout {
                width: 100%; spacing: Spacing.small;
                Rectangle {
                    height: root.hotkeys-compact ? default-language-label.preferred-height + 52px : max(Metrics.settings-row-height, default-language-label.preferred-height + 16px);
                    default-language-label := SettingsTextBlock {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.medium; height: self.preferred-height;
                        label: @tr("Default target language"); description: @tr("Language used for new translations"); error-text: root.target-language-error-text;
                    }
                    language-selector := AppearancePreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? default-language-label.height + Spacing.small : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        value: root.language-labels[root.draft-target-index]; opened: root.settings-menu-open;
                        clicked => { root.toggle-language-menu(); }
                    }
                }
                Rectangle { height: 1px; background: Colors.outline; }
                Rectangle {
                    height: root.hotkeys-compact ? fallback-language-label.preferred-height + 52px : max(Metrics.settings-row-height, fallback-language-label.preferred-height + 16px);
                    fallback-language-label := SettingsTextBlock {
                        x: 0px; y: root.hotkeys-compact ? 0px : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.45 - Spacing.medium; height: self.preferred-height;
                        label: @tr("Fallback target language"); description: @tr("Used when the detected source language matches the default target language."); error-text: "";
                    }
                    fallback-language-preview := AppearancePreviewField {
                        x: root.hotkeys-compact ? 0px : parent.width * 0.45;
                        y: root.hotkeys-compact ? fallback-language-label.height + Spacing.small : (parent.height - self.height) / 2;
                        width: root.hotkeys-compact ? parent.width : parent.width * 0.55;
                        value: root.language-labels[root.fallback-target-index]; opened: root.preview-menu-open && root.preview-menu-kind == 6;
                        clicked => { root.toggle-preview-menu(6); }
                    }
                }
            }
        }
        preprocess-card := SettingsCard {
            x: Metrics.settings-page-padding; y: llm-translation-card.y + llm-translation-card.height + Metrics.settings-card-gap;
            width: translation-language-card.width; title: @tr("Source text preprocessing");
            VerticalLayout {
                width: 100%; spacing: Spacing.small;
                SettingsPreviewToggleRow { label: @tr("Smart line break removal"); description: @tr("Join wrapped lines while preserving paragraph breaks."); checked <=> root.preprocess-join-lines; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Split snake_case"); description: @tr("Convert foo_bar to foo bar before translation."); checked <=> root.preprocess-snake-case; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Split camelCase"); description: @tr("Convert fooBar to foo bar before translation."); checked <=> root.preprocess-camel-case; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Split PascalCase"); description: @tr("Convert FooBar to foo bar before translation."); checked <=> root.preprocess-pascal-case; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Split kebab-case"); description: @tr("Convert foo-bar to foo bar before translation."); checked <=> root.preprocess-kebab-case; }
            }
        }
        translation-behavior-card := SettingsCard {
            x: Metrics.settings-page-padding; y: preprocess-card.y + preprocess-card.height + Metrics.settings-card-gap;
            width: translation-language-card.width; title: @tr("Behavior");
            VerticalLayout {
                width: 100%; spacing: Spacing.small;
                SettingsPreviewToggleRow { label: @tr("Copy the first translation result automatically"); checked <=> root.translation-auto-copy; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Hide input area"); description: @tr("Hide source text for selection and screenshot translations. Keep it visible for typed translations."); checked <=> root.translation-hide-input; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Hide language bar"); description: @tr("Hide language controls for selection and screenshot translations. Keep them visible for typed translations."); checked <=> root.translation-hide-language-bar; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Resize the translation window automatically"); description: @tr("Adjust window height to the content. Window width is resized manually."); checked <=> root.translation-auto-resize; }
                Rectangle { height: 1px; background: Colors.outline; }
                SettingsPreviewToggleRow { label: @tr("Pin the translation window by default"); checked <=> root.translation-pin-window; }
            }
        }
        llm-translation-card := SettingsCard {
            x: Metrics.settings-page-padding; y: translation-language-card.y + translation-language-card.height + Metrics.settings-card-gap;
            width: translation-language-card.width; title: @tr("Translation provider and model");
            VerticalLayout { spacing: Spacing.small;
                SettingsComboBox { model: ["DeepL", "Ollama", "LM Studio", "DeepSeek"]; current-index <=> root.llm-translation-provider-index; selected(index) => { root.llm-provider-selected(self.current-index); } }
                Text { font-size: Typography.body-size; text: root.provider-error-text; color: Colors.error; wrap: word-wrap; }
                if root.llm-translation-provider-index == 0 && !root.deepl-provider-enabled: Text { text: @tr("Provider is disabled"); color: Colors.secondary-foreground; font-size: Typography.body-size; wrap: word-wrap; }
                if root.llm-translation-provider-index > 0: VerticalLayout { spacing: Spacing.small;
                    SettingsComboBox { model: root.llm-models; placeholder: root.llm-selected-model == "" ? @tr("Select a model") : root.llm-selected-model; current-index <=> root.llm-model-index; enabled: root.llm-models.length > 0; selected(index) => { root.llm-model-selected(self.current-index); } }
                    Text { visible: root.llm-selection-note != ""; height: self.visible ? self.preferred-height : 0px; text: root.llm-selection-note; font-size: Typography.body-size; color: Colors.secondary-foreground; wrap: word-wrap; }
                    SettingsButton { label: @tr("Manage models"); clicked => { root.provider-detail-index = root.llm-translation-provider-index; root.llm-service-index = max(0, root.provider-detail-index - 1); root.credential-hide-requested(); root.llm-service-selected(root.provider-detail-index); root.active-category = 5; } }
                    Text { font-size: Typography.body-size; text: @tr("Model parameters"); color: Colors.foreground; font-weight: 600; }
                    HorizontalLayout { spacing: Spacing.small;
                        Text { font-size: Typography.body-size; text: @tr("Thinking effort"); color: Colors.foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        SettingsComboBox { model: root.llm-reasoning-options; placeholder: @tr("Unavailable"); current-index <=> root.llm-reasoning-index; enabled: root.llm-reasoning-options.length > 1; selected(index) => { root.llm-reasoning-selected(self.current-index); } }
                    }
                    Text { font-size: Typography.body-size; text: root.llm-reasoning-note; color: Colors.secondary-foreground; wrap: word-wrap; }
                    HorizontalLayout { spacing: Spacing.small;
                        Text { font-size: Typography.body-size; text: @tr("Model temperature"); color: Colors.foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { font-size: Typography.body-size; text: root.llm-temperature-custom ? @tr("Custom") : @tr("Model default"); color: Colors.secondary-foreground; vertical-alignment: center; }
                        Rectangle { width: 52px; height: 32px; opacity: root.llm-temperature-available ? 1 : 0.45;
                            SettingsSwitch { checked: root.llm-temperature-custom; toggled(v) => { if root.llm-temperature-available { root.llm-temperature-custom = v; } } }
                        }
                    }
                    if root.llm-temperature-custom && root.llm-temperature-available: HorizontalLayout { spacing: Spacing.medium;
                        Rectangle { height: 32px; min-width: 120px; horizontal-stretch: 1;
                            Slider { y: (parent.height - self.height) / 2; width: parent.width; value: root.llm-temperature; maximum: root.llm-temperature-max; wheel-step: 1; changed value => { root.llm-temperature = round(self.value); } }
                        }
                        SpinBox { width: 110px; height: 32px; value <=> root.llm-temperature; minimum: 0; maximum: root.llm-temperature-max; display-divisor: 100; }
                    }
                    HorizontalLayout { spacing: Spacing.small;
                        Text { font-size: Typography.body-size; text: "Top-P"; color: Colors.foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { font-size: Typography.body-size; text: root.llm-top-p-custom ? @tr("Custom") : @tr("Model default"); color: Colors.secondary-foreground; vertical-alignment: center; }
                        Rectangle { width: 52px; height: 32px; opacity: root.llm-top-p-available ? 1 : 0.45;
                            SettingsSwitch { checked: root.llm-top-p-custom; toggled(v) => { if root.llm-top-p-available { root.llm-top-p-custom = v; } } }
                        }
                    }
                    if root.llm-top-p-custom && root.llm-top-p-available: HorizontalLayout { spacing: Spacing.medium;
                        Rectangle { height: 32px; min-width: 120px; horizontal-stretch: 1;
                            Slider { y: (parent.height - self.height) / 2; width: parent.width; value: root.llm-top-p; minimum: root.llm-top-p-min; maximum: 100; wheel-step: 1; changed value => { root.llm-top-p = round(self.value); } }
                        }
                        SpinBox { width: 110px; height: 32px; value <=> root.llm-top-p; minimum: root.llm-top-p-min; maximum: 100; display-divisor: 100; }
                    }
                    Text { font-size: Typography.body-size; text: @tr("Translation prompt"); color: Colors.foreground; font-weight: 600; }
                    Rectangle { height: 240px; border-radius: 6px; border-width: 1px; border-color: Colors.outline; background: Colors.surface;
                        ScrollView { x: Spacing.small; y: Spacing.small; width: parent.width - 2 * Spacing.small; height: parent.height - 2 * Spacing.small;
                            content-width: self.visible-width;
                            TextInput { width: parent.width; min-height: 220px; text <=> root.llm-prompt; wrap: word-wrap; color: Colors.foreground; font-size: Typography.body-size; selection-background-color: Colors.primary-container; }
                        }
                    }
                    Text { font-size: Typography.body-size; text: @tr("Use {{target_language}} for the target language."); color: Colors.secondary-foreground; wrap: word-wrap; }
                    FlexboxLayout { flex-wrap: wrap; spacing: Spacing.small;
                        SettingsButton { label: @tr("Restore default prompt"); clicked => { root.llm-reset-prompt(); } }
                        SettingsButton { label: @tr("Apply"); primary: true; clicked => { root.llm-save-translation(); } }
                    }
                    Text { font-size: Typography.body-size; text: root.llm-status; color: Colors.secondary-foreground; wrap: word-wrap; }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 1;
        x: main-pane.width - 14px; y: Metrics.settings-header-height + 4px;
        height: main-pane.height - Metrics.settings-header-height - 8px;
        viewport-height: translation-scroll.visible-height; content-height: translation-scroll.content-height;
        content-y <=> translation-scroll.content-y;
    }
    provider-list := Rectangle {
        visible: root.active-category == 5;
        x: 0px; y: Metrics.settings-header-height;
        width: main-pane.width < 600px ? 148px : 184px; height: main-pane.height - self.y;
        background: Colors.surface;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.outline; }
        ScrollView {
            x: 8px; y: 16px; width: parent.width - 16px; height: parent.height - 32px;
            content-width: self.visible-width; content-height: max(self.visible-height, 4 * 48px);
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            for name[index] in ["DeepL", "Ollama", "LM Studio", "DeepSeek"]: Rectangle {
                y: index * 48px; width: parent.width; height: 40px; border-radius: 6px;
                background: root.provider-detail-index == index ? Colors.primary-container : touch.has-hover ? Colors.icon-button-hover : transparent;
                Rectangle { x: 8px; y: 6px; width: 28px; height: 28px; border-radius: 7px; background: #ffffff; border-width: 1px; border-color: Colors.outline.with-alpha(0.5);
                    Image { x: 4px; y: 4px; width: 20px; height: 20px; image-fit: contain;
                        source: [@image-url("icons/provider-deepl.svg"), @image-url("icons/provider-ollama.svg"), @image-url("icons/provider-lmstudio.svg"), @image-url("icons/provider-deepseek.svg")][index]; }
                }
                Rectangle { x: parent.width - 15px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px; background: Colors.success; visible: index < root.provider-enabled-states.length && root.provider-enabled-states[index]; }
                Text { x: 44px; width: parent.width - 64px; height: parent.height; text: name; color: root.provider-detail-index == index ? Colors.primary : Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide; }
                touch := TouchArea { clicked => { root.provider-detail-index = index; if index > 0 { root.llm-service-index = index - 1; } root.credential-hide-requested(); root.llm-service-selected(index); providers-scroll.content-y = 0px; } }
            }
        }
    }
    Rectangle { visible: root.active-category == 5; x: provider-list.width; y: Metrics.settings-header-height; width: main-pane.width - self.x; height: main-pane.height - self.y; background: Colors.surface; }
    providers-scroll := ScrollView {
        visible: root.active-category == 5;
        x: provider-list.width; y: Metrics.settings-header-height;
        width: main-pane.width - self.x;
        height: main-pane.height - self.y - (root.llm-connection-dirty ? 64px : 0px);
        content-width: self.visible-width;
        content-height: max(self.visible-height, provider-content.y + provider-content.height + Metrics.settings-page-padding);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        scrolled => { root.llm-model-hint = ""; }
        provider-content := VerticalLayout {
            x: Metrics.settings-page-padding; y: Metrics.settings-page-padding;
            width: providers-scroll.visible-width - 2 * Metrics.settings-page-padding;
            height: self.preferred-height; spacing: 24px;
            HorizontalLayout { height: 32px; spacing: 8px;
                Text { text: ["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.provider-detail-index]; color: Colors.foreground; font-size: Typography.body-size; font-weight: 700; vertical-alignment: center; }
                Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                SettingsSwitch { checked: root.llm-enabled; toggled(value) => { root.llm-enabled = value; root.llm-draft-changed(); } }
            }
            VerticalLayout { spacing: 8px;
                Text { height: 24px; text: @tr("API key"); font-size: Typography.body-size; color: Colors.foreground; vertical-alignment: center; }
                credential-row := Rectangle {
                    private property <length> action-width: root.provider-detail-index == 0 ? 0px : max(72px, check-measure.preferred-width + 32px);
                    private property <bool> wrapped: self.width < self.action-width + 188px;
                    height: provider-credential.height + (self.wrapped && self.action-width > 0px ? 48px : 0px);
                    check-measure := Text { visible: false; text: @tr("Test connection"); font-size: 14px; }
                provider-credential := ProviderCredentialField {
                    x: 0px; y: 0px;
                    width: credential-row.width - (credential-row.wrapped || credential-row.action-width == 0px ? 0px : credential-row.action-width + 8px);
                    credential-configured: root.provider-detail-index == 0 ? root.credential-configured : root.llm-key-configured || (root.llm-service-index == 2 && root.deepseek-environment-key);
                    can-remove: root.provider-detail-index == 0 || root.llm-key-configured;
                    credential-busy: root.credential-busy;
                    credential-editing: root.credential-editing;
                    credential-revealed: root.credential-revealed;
                    credential-request-pending: root.credential-request-pending;
                    credential-reveal-dismiss-armed: root.credential-reveal-dismiss-armed;
                    credential-secret-visible <=> root.credential-secret-visible;
                    credential-draft <=> root.credential-draft;
                    credential-transient-secret: root.credential-transient-secret;
                    credential-error-text: root.credential-error-text;
                    credential-reveal-requested => { root.credential-reveal-requested(); }
                    credential-copy-requested => { root.credential-copy-requested(); }
                    credential-edit-requested => { root.credential-edit-requested(); }
                    credential-remove-requested => { root.credential-remove-requested(); }
                    credential-hide-requested => { root.credential-hide-requested(); }
                    credential-edit-cancel-requested => { root.credential-edit-cancel-requested(); }
                    credential-edit-blurred => {root.credential-edit-blurred();}
                    credential-save-requested(value) => { root.credential-save-requested(value); }
                }

                    check-models-button := SettingsButton { visible: root.provider-detail-index > 0; compact: true; x: credential-row.width - self.width; y: credential-row.wrapped ? provider-credential.height + 8px : 0px; width: credential-row.action-width; label: @tr("Test connection"); enabled: !root.credential-busy; clicked => { root.open-provider-probe(); } }
                }
                if root.provider-detail-index == 3: Text { text: root.llm-key-configured ? @tr("Credential source: system storage") : root.deepseek-environment-key ? @tr("Credential source: environment; manage it outside Lexift") : @tr("API key not configured"); color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; }
            }
            VerticalLayout { visible: root.provider-detail-index > 0; height: self.visible ? self.preferred-height : 0px; spacing: 8px;
                Text { height: 24px; text: @tr("API address"); font-size: Typography.body-size; color: Colors.foreground; vertical-alignment: center; }
                HorizontalLayout { height: 40px; spacing: 8px;
                    ProviderInput { text <=> root.llm-base-url; horizontal-stretch: 1; edited => { root.llm-base-edited(); } }
                    request-config-button := ProviderIconButton { icon: @image-url("icons/provider-settings.svg"); tooltip: @tr("Request configuration"); selected: root.llm-advanced; clicked => { root.open-provider-request(); } }
                }
            }
            VerticalLayout { visible: root.provider-detail-index > 0; height: self.visible ? self.preferred-height : 0px; spacing: 12px;
                Rectangle {
                    z: 5;
                    height: toolbar-left.preferred-width + sync-models-button.width + 8px > self.width ? 88px : 40px;
                    toolbar-left := HorizontalLayout { x: 0px; y: 4px; width: self.preferred-width; height: 32px; spacing: 4px;
                        Text { text: @tr("Models") + "  " + root.llm-enabled-count; color: Colors.foreground; font-size: Typography.body-size; font-weight: 700; vertical-alignment: center; }
                        ProviderIconButton { icon: @image-url("icons/provider-search.svg"); tooltip: @tr("Search models"); selected: root.llm-search-open; clicked => { root.llm-search-open = !root.llm-search-open; if !root.llm-search-open { root.llm-model-search = ""; root.llm-filter-models(); } } }
                        ProviderIconButton { icon: @image-url("icons/provider-filter.svg"); tooltip: @tr("Filter models"); selected: root.llm-filter-open; clicked => { root.llm-filter-open = !root.llm-filter-open; if !root.llm-filter-open { root.llm-model-filter = 0; root.llm-filter-models(); } } }
                    }
                    sync-models-button := SettingsButton { compact: true;
                        x: parent.width - self.width; y: parent.height - 40px;
                        label: @tr("Sync models"); enabled: !root.llm-connection-dirty; clicked => { root.open-provider-models(); }
                    }
                }
                if root.llm-connection-dirty: Text { text: @tr("Apply connection settings before syncing models"); color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; }
                if root.llm-search-open: ProviderInput { text <=> root.llm-model-search; placeholder: @tr("Search models"); edited => { root.llm-filter-models(); } }
                if root.llm-filter-open: ProviderFilterBar {
                    labels: [@tr("All models"), @tr("Text generation"), @tr("Embedding models"), @tr("Unknown capability"), @tr("Unavailable")]; current-index: root.llm-model-filter;
                    chosen(index) => { root.llm-model-filter = index; root.llm-filter-models(); }
                }
                Rectangle {
                    height: root.llm-enabled-catalog.length == 0 ? 168px : enabled-rows.preferred-height + 2px;
                    border-radius: 8px; border-width: root.llm-enabled-catalog.length == 0 ? 0px : 1px; border-color: Colors.outline;
                    enabled-rows := VerticalLayout { x: 1px; y: 1px; width: parent.width - 2px; height: self.preferred-height; spacing: 0px;
                        for model in root.llm-enabled-catalog: ProviderModelItem { model: model; toggle => { root.llm-model-toggle(model.id, false); } hint(text,x,y) => { root.llm-model-hint = text; root.llm-hint-x = x; root.llm-hint-y = y; } }
                    }
                    if root.llm-enabled-catalog.length == 0: Rectangle {
                        width: parent.width; height: parent.height;
                        Image { x: (parent.width - 40px) / 2; y: 24px; height: 40px; width: 40px; source: @image-url("icons/provider-empty.svg"); colorize: Colors.outline; }
                        Text { x: 16px; y: 72px; width: parent.width - 32px; height: 24px; text: root.llm-enabled-count == 0 ? @tr("No enabled models") : @tr("No matching models"); color: Colors.secondary-foreground; font-size: Typography.body-size; horizontal-alignment: center; }
                        Text { x: 16px; y: 104px; width: parent.width - 32px; text: @tr("Use Sync models to choose models for translation."); color: Colors.secondary-foreground; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }
            }
        }
    }
    AppVerticalScrollBar {
        visible: root.active-category == 5 && providers-scroll.content-height > providers-scroll.visible-height; x: main-pane.width - 14px; y: Metrics.settings-header-height + 4px;
        height: providers-scroll.height - 8px; viewport-height: providers-scroll.visible-height; content-height: providers-scroll.content-height; content-y <=> providers-scroll.content-y;
    }
    if root.active-category == 5 && root.llm-connection-dirty: Rectangle {
        x: provider-list.width; y: main-pane.height - 64px; width: main-pane.width - self.x; height: 64px; background: Colors.surface;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Colors.outline; }
        HorizontalLayout { padding: 12px; spacing: 8px; alignment: end;
            SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.llm-cancel-connection(); } }
            SettingsButton { compact: true; label: @tr("Apply"); primary: true; enabled: !root.credential-busy; clicked => { root.llm-save-connection(); } }
        }
    }
    }
    }
    function toggle-language-menu() {
        root.close-preview-menu();
        if root.settings-menu-open { root.close-settings-menu(); }
        else {
            root.settings-menu-scroll-y = round(min(0px, max(settings-menu.height - root.language-labels.length * 40px, settings-menu.height / 2 - (root.draft-target-index + 0.5) * 40px)) / 4px) * 4px;
            root.settings-menu-open = true; root.settings-menu-dismiss-armed = true; root.focus-settings-menu();
        }
    }
    function toggle-preview-menu(kind: int) {
        if root.preview-menu-open && root.preview-menu-kind == kind { root.close-preview-menu(); }
        else {
            root.close-settings-menu();
            root.preview-menu-kind = kind;
            root.preview-menu-scroll-y = 0px;
            root.preview-menu-open = true;
            preview-menu-focus.focus();
        }
    }

    overlay := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; z: 80;

    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height; z: 10;
        enabled: (root.settings-menu-open && root.settings-menu-dismiss-armed) || root.preview-menu-open;
        clicked => { root.close-settings-menu(); root.close-preview-menu(); }
    }
    settings-menu := SettingsSelectMenu {
        visible: root.settings-menu-open; z: 15;
        x: round(root.settings-menu-anchor-x / 1px) * 1px;
        y: round((root.settings-menu-anchor-y + root.settings-menu-anchor-height + 2px) / 1px) * 1px;
        width: round(root.settings-menu-anchor-width / 1px) * 1px;
        height: round(min(root.language-labels.length * 40px, max(0px, root.height - self.y - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.language-labels;
        selected-index: root.draft-target-index;
        scroll-y <=> root.settings-menu-scroll-y;
        selected(index) => { root.settings-menu-selected(index); root.close-settings-menu(); }
    }
    settings-menu-focus := FocusScope {
        visible: root.settings-menu-open; x: settings-menu.x; y: settings-menu.y; width: settings-menu.width; height: settings-menu.height; z: 16;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-settings-menu(); return accept; }
            return reject;
        }
    }
    preview-menu := SettingsSelectMenu {
        visible: root.preview-menu-open; z: 15;
        x: round(root.preview-menu-anchor-x / 1px) * 1px;
        y: round((root.preview-menu-anchor-y + root.preview-menu-anchor-height + self.height + Metrics.settings-page-padding + 2px <= root.height
            ? root.preview-menu-anchor-y + root.preview-menu-anchor-height + 2px
            : max(Metrics.settings-header-height + 4px, root.preview-menu-anchor-y - self.height - 2px)) / 1px) * 1px;
        width: round(root.preview-menu-anchor-width / 1px) * 1px;
        height: round(min(root.preview-menu-options.length * 40px, max(0px, root.height - Metrics.settings-header-height - Metrics.settings-page-padding)) / 1px) * 1px;
        options: root.preview-menu-options;
        selected-index: root.preview-menu-kind == 0 ? root.appearance-font-index
            : root.preview-menu-kind == 1 ? root.appearance-size-index
                : root.preview-menu-kind == 2 ? root.appearance-language-index
                    : root.preview-menu-kind == 3 ? root.tray-click-index
                        : root.preview-menu-kind == 4 ? root.selection-filter-mode-index : root.preview-menu-kind == 5 ? root.screenshot-format-index : root.fallback-target-index;
        scroll-y <=> root.preview-menu-scroll-y;
        selected(index) => {
            if root.preview-menu-kind == 0 { root.appearance-font-index = index; }
            else if root.preview-menu-kind == 1 { root.appearance-size-index = index; }
            else if root.preview-menu-kind == 2 { root.ui-language-selected(index); }
            else if root.preview-menu-kind == 3 { root.tray-click-index = index; }
            else if root.preview-menu-kind == 4 { root.selection-filter-mode-index = index; }
            else if root.preview-menu-kind == 5 { root.screenshot-format-index = index; }
            else { root.fallback-target-index = index; }
            root.close-preview-menu();
        }
    }
    preview-menu-focus := FocusScope {
        visible: root.preview-menu-open;
        x: preview-menu.x; y: preview-menu.y;
        width: preview-menu.width; height: preview-menu.height; z: 16;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-preview-menu(); return accept; }
            return reject;
        }
    }
    for toast[index] in root.toast-items: SettingsToast {
        x: root.sidebar-width + max(Spacing.medium, (root.page-width - self.width) / 2);
        y: Spacing.medium + index * (Metrics.toast-height + Spacing.small); z: 30;
        message: toast.message; error: toast.error;
        dismissed => { root.toast-dismiss-requested(toast.id); }
    }
    }
    provider-modal-focus := FocusScope {
        visible: root.active-category == 5 && (root.llm-advanced || root.llm-model-dialog || root.llm-probe-dialog);
        x: 0px; y: 0px; width: root.width; height: root.height; z: 110;
        key-pressed(event) => { if event.text == Key.Escape { root.close-provider-dialog(false); return accept; } return reject; }
        Rectangle { width: parent.width; height: parent.height; background: Colors.foreground.with-alpha(0.30); TouchArea { } }
        request-dialog := ProviderDialog {
            visible: root.llm-advanced;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px); height: min(680px, parent.height - 48px, request-fields.preferred-height + 140px);
            title: @tr("Request configuration"); dismissed => { root.close-provider-dialog(false); }
            ScrollView {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 140px;
                content-width: self.visible-width; content-height: request-fields.preferred-height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                request-fields := VerticalLayout {
                    x: 0px; y: 0px; alignment: start; width: parent.width; height: self.preferred-height; spacing: 12px;
                    Text { height: 24px; text: @tr("Protocol"); color: Colors.foreground; font-size: Typography.body-size; }
                    SettingsComboBox { model: [@tr("Native"), "OpenAI Chat Completions", "OpenAI Responses"]; current-index <=> root.llm-protocol-index; selected(index) => { root.llm-protocol-selected(index); } }
                    Text { height: 24px; text: "API Base URL"; color: Colors.foreground; font-size: Typography.body-size; }
                    ProviderInput { text <=> root.llm-base-url; edited => { root.llm-base-edited(); } }
                    Text { text: root.llm-endpoints; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                    Text { height: 24px; text: @tr("Authentication"); color: Colors.foreground; font-size: Typography.body-size; }
                    SettingsComboBox { model: [@tr("Automatic API key"), @tr("Custom request headers"), @tr("None")]; current-index <=> root.llm-auth-index; selected(index) => { root.llm-draft-changed(); } }
                    HorizontalLayout { height: 32px;
                        Text { text: @tr("Custom request headers"); color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center; horizontal-stretch: 1; }
                        ProviderIconButton { icon: @image-url("icons/provider-plus.svg"); tooltip: @tr("Add header"); clicked => { root.llm-header-name = ""; root.llm-header-value = ""; root.llm-header-editing = true; } }
                    }
                    for name in root.llm-headers: HorizontalLayout { height: 36px; spacing: 4px;
                        Text { text: name + ": ••••••••"; color: Colors.foreground; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        CredentialActionButton { icon-kind: 2; clicked => { root.llm-header-name = name; root.llm-header-value = ""; root.llm-header-editing = true; } }
                        CredentialActionButton { icon-kind: 3; enabled: !root.credential-busy; clicked => { root.llm-header-remove(name); } }
                    }
                    if root.llm-header-editing: VerticalLayout { spacing: 8px;
                        ProviderInput { text <=> root.llm-header-name; placeholder: @tr("Header name"); }
                        ProviderInput { text <=> root.llm-header-value; placeholder: @tr("Header value"); secret: true; }
                        HorizontalLayout { alignment: end; spacing: 8px;
                            SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.llm-header-value = ""; root.llm-header-name = ""; root.llm-header-editing = false; } }
                            SettingsButton { compact: true; label: @tr("Save header"); enabled: root.llm-header-name != "" && root.llm-header-value != ""; clicked => { root.llm-header-save(); } }
                        }
                    }
                    Text { text: @tr("Header values are stored securely when you apply. Cancel discards changes."); color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                    if root.llm-status != "": Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                }
            }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: 8px; alignment: end;
                SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.close-provider-dialog(false); } }
                SettingsButton { compact: true; label: @tr("OK"); primary: true; enabled: !root.credential-busy; clicked => { root.close-provider-dialog(true); } }
            }
        }
        probe-dialog := ProviderDialog {
            visible: root.llm-probe-dialog;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px);
            height: min(parent.height - 48px, root.llm-probe-results.length > 0 ? 600px : 380px);
            title: root.llm-probe-all ? @tr("Test all enabled models") : @tr("Select a model to test");
            dismissed => { root.close-provider-dialog(false); }
            ScrollView {
                x: 24px; y: 64px; width: parent.width - 48px; height: parent.height - 144px;
                content-width: self.visible-width; content-height: probe-fields.preferred-height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                probe-fields := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; alignment: start; spacing: 12px;
                    if !root.llm-probe-all: Text { text: @tr("Select a model"); font-size: Typography.body-size; color: Colors.foreground; }
                    if !root.llm-probe-all: SettingsComboBox { model: root.llm-probe-models; current-index <=> root.llm-probe-index; placeholder: @tr("No enabled models"); enabled: !root.llm-probe-running; selected(index) => { root.llm-probe-selected(); } }
                    Text { text: @tr("API key"); font-size: 13px; color: Colors.secondary-foreground; }
                    Rectangle { height: 40px; border-radius: 6px; border-width: 1px; border-color: Colors.outline; background: Colors.background;
                        Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.llm-key-configured || (root.provider-detail-index == 3 && root.deepseek-environment-key) ? "••••••••••••" : @tr("No authentication configured"); font-size: 13px; color: Colors.secondary-foreground; vertical-alignment: center; }
                    }
                    if root.llm-key-configured || (root.provider-detail-index == 3 && root.deepseek-environment-key): Text { text: root.llm-key-configured ? @tr("Credential source: system storage") : @tr("Credential source: environment; manage it outside Lexift"); font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    Text { text: @tr("Testing sends a short fixed message. It may load local models or incur API charges."); font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    if root.llm-probe-all: Text { text: @tr("Enabled models") + ": " + root.llm-probe-models.length; font-size: Typography.body-size; color: Colors.foreground; }
                    if root.llm-probe-note != "": Text { text: root.llm-probe-note; font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                    if root.llm-probe-progress != "": Text { text: root.llm-probe-progress; font-size: 13px; color: Colors.foreground; wrap: word-wrap; }
                    for result in root.llm-probe-results: Rectangle { height: max(64px, probe-result.preferred-height + 16px); border-width: 1px; border-color: Colors.outline; border-radius: 6px;
                        probe-result := VerticalLayout { x: 12px; y: 8px; width: parent.width - 24px; height: self.preferred-height; spacing: 4px;
                            Text { text: result.id; font-size: 14px; color: Colors.foreground; overflow: elide; }
                            Text { text: result.state + (result.elapsed == "" ? "" : " · " + result.elapsed); font-size: 12px; color: result.failed ? Colors.error : Colors.secondary-foreground; }
                            if result.detail != "": Text { text: result.detail; font-size: 12px; color: Colors.secondary-foreground; wrap: word-wrap; }
                        }
                    }
                }
            }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; spacing: 8px;
                SettingsButton { compact: true; visible: !root.llm-probe-all; label: @tr("Test all models"); enabled: !root.llm-probe-running && root.llm-probe-models.length > 0; clicked => { root.llm-probe-all = true; root.llm-probe-selected(); } }
                Rectangle { horizontal-stretch: 1; }
                SettingsButton { compact: true; label: @tr("Cancel"); clicked => { root.close-provider-dialog(false); } }
                SettingsButton { compact: true; label: root.llm-probe-running ? @tr("Testing…") : @tr("Start"); primary: true; enabled: root.llm-probe-can-start && !root.llm-probe-running; clicked => { root.llm-probe-start(); } }
            }
        }
        model-dialog := ProviderDialog {
            visible: root.llm-model-dialog;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(720px, parent.width - 48px); height: min(680px, parent.height - 48px);
            title: ["DeepL", "Ollama", "LM Studio", "DeepSeek"][root.provider-detail-index] + " · " + @tr("Models") + "  " + root.llm-catalog-count;
            dismissed => { root.close-provider-dialog(false); }
            model-tools := VerticalLayout { x: 24px; y: 64px; width: parent.width - 48px; height: self.preferred-height; spacing: 8px;
                ProviderInput { text <=> root.llm-model-search; placeholder: @tr("Search models"); edited => { root.llm-filter-models(); } }
                ProviderFilterBar {
                    labels: [@tr("All models"), @tr("Text generation"), @tr("Embedding models"), @tr("Unknown capability"), @tr("Unavailable")]; current-index: root.llm-model-filter;
                    chosen(index) => { root.llm-model-filter = index; root.llm-filter-models(); }
                }
                Text { text: root.llm-status; color: Colors.secondary-foreground; font-size: 12px; wrap: word-wrap; height: root.llm-status == "" ? 0px : self.preferred-height; }
            }
            model-viewport := ScrollView {
                    x: 24px; y: model-tools.y + model-tools.height + 8px; width: parent.width - 48px;
                    height: max(0px, model-dialog.height - self.y - 80px);
                    content-width: self.visible-width; content-height: max(self.visible-height, discovered-rows.preferred-height);
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off; vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    scrolled => { root.llm-model-hint = ""; }
                    discovered-rows := VerticalLayout { x: 0px; y: 0px; alignment: start; width: model-viewport.visible-width; height: self.preferred-height; spacing: 0px;
                        for model in root.llm-catalog: ProviderModelItem { model: model; toggle => { root.llm-model-toggle(model.id, !model.enabled); } hint(text,x,y) => { root.llm-model-hint = text; root.llm-hint-x = x; root.llm-hint-y = y; } }
                    }
                    if root.llm-catalog.length == 0: Text { width: parent.width; height: 100px; text: root.llm-syncing ? @tr("Loading…") : @tr("No matching models"); color: Colors.secondary-foreground; font-size: Typography.body-size; horizontal-alignment: center; vertical-alignment: center; }
                }
            HorizontalLayout { x: 24px; y: parent.height - 64px; width: parent.width - 48px; height: 40px; alignment: end; spacing: 8px;
                SettingsButton { compact: true; label: @tr("Sync models"); enabled: !root.llm-syncing; clicked => { root.llm-refresh(false); } }
                SettingsButton { compact: true; label: @tr("Close"); clicked => { root.close-provider-dialog(false); } }
            }
        }
    }
    if root.active-category == 5 && root.llm-model-hint != "": Rectangle {
        z: 150; x: max(8px, min(root.width - self.width - 8px, root.llm-hint-x)); y: max(8px, min(root.height - self.height - 8px, root.llm-hint-y));
        width: min(480px, root.width - 32px); height: model-hint.preferred-height + 16px; border-radius: 6px; background: Colors.foreground;
        model-hint := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.llm-model-hint; color: Colors.surface; font-size: 12px; wrap: word-wrap; }
    }

}
