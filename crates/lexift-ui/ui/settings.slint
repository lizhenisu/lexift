import { ProviderModelRow, ProviderIconButton, ProviderInput, ProviderModelItem, ProviderDialog, ProviderFilterBar, ProviderProbeRow } from "provider-controls.slint";
export { ProviderModelRow, ProviderProbeRow }
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
import { Metrics } from "design/metrics.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";
import { Slider, SpinBox } from "annotation-fields.slint";
import { ScrollView } from "std-widgets.slint";

component SettingsButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked();
    public function focus-button() { keyboard.focus(); }

    width: max(root.compact ? 72px : 104px, button-label.preferred-width + 2 * Spacing.medium);
    height: 40px;
    border-radius: root.compact ? 6px : 20px;
    border-width: primary ? 0px : 1px;
    border-color: Colors.outline;
    background: !root.enabled ? Colors.outline : button-touch.pressed ? Colors.icon-button-pressed : button-touch.has-hover ? Colors.icon-button-hover : root.primary ? Colors.primary : Colors.surface;
    accessible-role: button; accessible-label: root.label;

    button-label := Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        wrap: word-wrap;
        text: root.label;
        color: !root.enabled ? Colors.secondary-foreground : root.primary ? Colors.on-primary : Colors.primary;
        font-size: root.compact ? 14px : Typography.body-size;
        font-weight: root.compact ? 500 : 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    keyboard := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    button-touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
}

component SettingsSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: root.checked ? Colors.primary : Colors.outline;

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Colors.surface;
    }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }
}

component CredentialActionButton inherits Rectangle {
    in property <int> icon-kind;
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    in property <bool> highlighted: false;
    in property <bool> pressed: false;
    callback clicked();

    width: Metrics.icon-button-size;
    height: Metrics.icon-button-size;
    border-radius: Metrics.icon-button-radius;
    opacity: root.enabled ? 1 : Metrics.disabled-opacity;
    background: root.pressed || (root.interactive && action-touch.pressed)
        ? Colors.icon-button-pressed
        : root.highlighted || (root.interactive && action-touch.has-hover)
            ? Colors.icon-button-hover : transparent;

    Image {
        x: (parent.width - Metrics.icon-size) / 2; y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size; height: Metrics.icon-size; colorize: Colors.secondary-foreground;
        source: root.icon-kind == 0 ? @image-url("icons/credential-reveal.svg") : root.icon-kind == 1 ? @image-url("icons/credential-copy.svg") : root.icon-kind == 2 ? @image-url("icons/credential-edit.svg") : root.icon-kind == 3 ? @image-url("icons/credential-delete.svg") : @image-url("icons/credential-hide.svg");
    }

    action-touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { root.clicked(); }
    }
    if root.enabled && (root.highlighted || action-touch.has-hover): Rectangle {
        z: 100; x: min(0px, root.width - self.width); y: root.height + 4px;
        width: tip.preferred-width + 16px; height: 28px; border-radius: 4px; background: Colors.foreground;
        tip := Text { x: 8px; height: parent.height; text: root.icon-kind == 0 ? @tr("View key") : root.icon-kind == 1 ? @tr("Copy") : root.icon-kind == 2 ? @tr("Edit key") : root.icon-kind == 3 ? @tr("Delete key") : @tr("Hide key"); color: Colors.surface; font-size: 12px; vertical-alignment: center; }
    }

}


component ProviderCredentialField inherits Rectangle {
    in property <bool> credential-configured;
    in property <bool> credential-busy;
    in property <bool> credential-editing;
    in property <bool> credential-revealed;
    in property <bool> credential-request-pending;
    in property <bool> credential-reveal-dismiss-armed;
    in-out property <bool> credential-secret-visible;
    in-out property <string> credential-draft;
    in property <string> credential-transient-secret;
    in property <string> credential-error-text;
    in property <bool> can-remove: true;
    callback credential-reveal-requested();
    callback credential-copy-requested();
    callback credential-edit-requested();
    callback credential-remove-requested();
    callback credential-hide-requested();
    callback credential-edit-cancel-requested();
    callback credential-edit-blurred();
    callback credential-save-requested(string);
    public function focus-reveal() { credential-reveal-input.focus(); }
    public function focus-edit() { credential-edit-input.focus(); }
    public pure function edit-focused() -> bool { return credential-edit-input.has-focus; }
    height: contents.preferred-height;
    contents := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: Spacing.small;
                credential-field := Rectangle {
                    height: 40px; border-radius: 6px;
                    border-width: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? 2px : 1px;
                    border-color: (credential-reveal-input.has-focus || credential-edit-input.has-focus) ? Colors.primary : Colors.outline;
                    background: Colors.background;
                    field-hover := TouchArea {
                        enabled: root.credential-configured && !root.credential-editing && !root.credential-revealed && !root.credential-request-pending;
                        clicked => {
                            if self.mouse-x >= self.width - 4 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - 3 * Metrics.icon-button-size - 4px { root.credential-reveal-requested(); }
                            else if self.mouse-x >= self.width - 3 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - 2 * Metrics.icon-button-size - 4px { root.credential-copy-requested(); }
                            else if self.mouse-x >= self.width - 2 * Metrics.icon-button-size - 4px && self.mouse-x < self.width - Metrics.icon-button-size - 4px { root.credential-edit-requested(); }
                            else if self.mouse-x >= self.width - Metrics.icon-button-size - 4px && self.mouse-x < self.width - 4px { if root.can-remove { root.credential-remove-requested(); } }
                        }
                    }
                    if !root.credential-configured: credential-new-input := TextInput {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height; text <=> root.credential-draft; input-type: InputType.password; enabled: !root.credential-busy;
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; text-cursor-width: 2px; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy { root.credential-save-requested(root.credential-draft); } }
                    }
                    if root.credential-configured && !root.credential-editing && !root.credential-revealed: Text {
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 4 * Metrics.icon-button-size; height: parent.height; text: "••••••••••••••••"; color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                    }
                    credential-reveal-input := TextInput {
                        visible: root.credential-configured && root.credential-revealed && !root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text: root.credential-transient-secret; read-only: true;
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        changed has-focus => { if !self.has-focus && root.credential-revealed && root.credential-reveal-dismiss-armed { root.credential-hide-requested(); } }
                    }
                    credential-edit-input := TextInput {
                        visible: root.credential-configured && root.credential-editing;
                        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 34px; height: parent.height; text <=> root.credential-draft;
                        input-type: root.credential-secret-visible ? InputType.text : InputType.password; enabled: !root.credential-busy;
                        changed has-focus => { if !self.has-focus && root.credential-editing {root.credential-edit-blurred();} }
                        color: Colors.foreground; selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
                        accepted => { if root.credential-draft != "" && !root.credential-busy { root.credential-save-requested(root.credential-draft); } }
                    }
                    if root.credential-configured && !root.credential-editing && !root.credential-revealed: HorizontalLayout {
                        x: parent.width - 4 * Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2; width: 4 * Metrics.icon-button-size; spacing: 0px;
                        opacity: field-hover.has-hover && !root.credential-request-pending ? 1 : 0;
                        CredentialActionButton { icon-kind: 0; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 4 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 3 * Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 1; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 3 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 2 * Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 2; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - 2 * Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - Metrics.icon-button-size - 4px; pressed: field-hover.pressed && self.highlighted; }
                        CredentialActionButton { icon-kind: 3; enabled: root.can-remove; interactive: false; highlighted: field-hover.mouse-x >= credential-field.width - Metrics.icon-button-size - 4px && field-hover.mouse-x < credential-field.width - 4px; pressed: field-hover.pressed && self.highlighted; }
                    }
                    if root.credential-configured && root.credential-request-pending && !root.credential-editing: Text {
                        x: parent.width - Spacing.medium - 88px; width: 88px; height: parent.height; text: @tr("Loading…"); color: Colors.secondary-foreground; font-size: 13px; horizontal-alignment: right; vertical-alignment: center;
                    }
                    if root.credential-configured && (root.credential-editing || root.credential-revealed): CredentialActionButton {
                        x: parent.width - Metrics.icon-button-size - 4px; y: (parent.height - Metrics.icon-button-size) / 2;
                        icon-kind: root.credential-revealed || root.credential-secret-visible ? 4 : 0;
                        clicked => { if root.credential-editing { root.credential-secret-visible = !root.credential-secret-visible; } else { root.credential-hide-requested(); } }
                    }
                }

                if root.credential-error-text != "": Text { text: root.credential-error-text; color: Colors.error; font-size: 13px; wrap: word-wrap; }
                if root.credential-editing || (!root.credential-configured && (root.credential-draft != "" || root.credential-busy)): HorizontalLayout {
                    width: 100%; height: 40px; spacing: Spacing.small; alignment: end;
                    SettingsButton { width: 96px; visible: root.credential-editing; label: @tr("Cancel"); enabled: !root.credential-busy; clicked => { root.credential-edit-cancel-requested(); } }
                    SettingsButton {
                        width: 128px; visible: root.credential-editing || (!root.credential-configured && (root.credential-draft != "" || root.credential-busy));
                        primary: true; label: root.credential-busy ? @tr("Working…") : @tr("Save key"); enabled: root.credential-draft != "" && !root.credential-busy;
                        clicked => { root.credential-save-requested(root.credential-draft); }
                    }
                }
    }
}

component SettingsToast inherits Rectangle {
    in property <string> message;
    in property <bool> error: false;
    callback dismissed();

    width: Metrics.toast-width;
    height: Metrics.toast-height;
    border-radius: Spacing.small;
    border-width: 1px;
    border-color: Colors.outline;
    background: Colors.surface;

    Path {
        x: Spacing.medium;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.error
            ? "M11 15h2v2h-2v-2zm0-8h2v6h-2V7zm1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
            : "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
        fill: root.error ? Colors.error : Colors.success;
    }

    Text {
        x: Spacing.medium + Metrics.icon-size + Spacing.small;
        width: parent.width - 2 * Spacing.medium - 2 * Metrics.icon-size - 2 * Spacing.small;
        height: parent.height;
        text: root.message;
        color: Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 700;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    close-button := Rectangle {
        x: parent.width - Spacing.small - Metrics.icon-button-size;
        y: (parent.height - Metrics.icon-button-size) / 2;
        width: Metrics.icon-button-size;
        height: Metrics.icon-button-size;
        border-radius: Metrics.icon-button-radius;
        background: close-touch.pressed ? Colors.icon-button-pressed
            : close-touch.has-hover ? Colors.icon-button-hover : transparent;

        Path {
            x: (parent.width - Metrics.icon-size) / 2;
            y: (parent.height - Metrics.icon-size) / 2;
            width: Metrics.icon-size;
            height: Metrics.icon-size;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M18.3 5.71 16.89 4.29 12 9.17 7.11 4.29 5.7 5.71 10.59 10.59 5.7 15.48 7.11 16.89 12 12 16.89 16.89 18.3 15.48 13.41 10.59z";
            fill: Colors.secondary-foreground;
        }

        close-touch := TouchArea {
            clicked => { root.dismissed(); }
        }
    }
}

component SettingsSelectMenu inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    in-out property <length> scroll-y: 0px;
    callback selected(int);

    border-radius: 4px;
    border-width: 1px;
    border-color: Colors.outline;
    background: Colors.surface;
    clip: true;

    menu-scroll := ScrollView {
        width: parent.width - 10px;
        height: parent.height;
        content-width: self.visible-width;
        content-height: root.options.length * 40px;
        content-y <=> root.scroll-y;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: true;
        scrolled => { root.scroll-y = round(root.scroll-y / 4px) * 4px; }

        for option[index] in root.options: option-row := Rectangle {
            y: index * 40px;
            width: menu-scroll.visible-width;
            height: 40px;
            background: index == root.selected-index
                ? Colors.primary-container
                : option-touch.pressed ? Colors.icon-button-pressed
                : option-touch.has-hover ? Colors.background : Colors.surface;

            Text {
                x: Spacing.medium;
                width: parent.width - 2 * Spacing.medium;
                text: option;
                color: Colors.foreground;
                font-size: Typography.menu-size;
                font-weight: Typography.menu-weight;
                vertical-alignment: center;
                overflow: elide;
            }

            option-touch := TouchArea {
                clicked => { root.selected(index); }
            }
        }
    }
    AppVerticalScrollBar {
        x: parent.width - 12px;
        y: 2px;
        height: parent.height - 4px;
        viewport-height: menu-scroll.visible-height;
        content-height: menu-scroll.content-height;
        content-y <=> menu-scroll.content-y;
    }
}

export struct SettingsToastData {
    id: int,
    message: string,
    error: bool,
}

component SettingsCard inherits Rectangle {
    in property <string> title;

    border-radius: Metrics.settings-card-radius;
    background: Colors.surface;
    height: card-layout.preferred-height;

    card-layout := VerticalLayout {
        x: 0px; y: 0px; width: parent.width;
        padding: Metrics.settings-card-padding;
        spacing: Spacing.medium;

        Text {
            height: 24px;
            text: root.title;
            color: Colors.foreground;
            font-size: Typography.body-size;
            font-weight: 700;
            vertical-alignment: center;
        }

        @children
    }
}

component SettingsFieldLabel inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> error-text;

    height: 44px;

    Text {
        y: 1px;
        width: parent.width;
        height: 22px;
        text: root.label;
        color: Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        y: 24px;
        width: parent.width;
        height: 18px;
        text: root.error-text != "" ? root.error-text : root.description;
        color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Shared by preview rows so descriptions grow naturally with localized text.
component SettingsTextBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <string> error-text;
    spacing: 4px;
    Text { text: root.label; color: Colors.foreground; font-size: Typography.body-size; font-weight: 600; wrap: word-wrap; }
    if root.description != "" || root.error-text != "": Text {
        text: root.error-text != "" ? root.error-text : root.description;
        color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
        font-size: 13px; wrap: word-wrap;
    }
}

component SettingsPreviewToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    height: max(Metrics.settings-row-height, text-block.preferred-height + 16px);
    text-block := SettingsTextBlock {
        x: 0px; y: (parent.height - self.height) / 2;
        width: parent.width - 52px - Spacing.medium; height: self.preferred-height;
        label: root.label; description: root.description;
    }
    SettingsSwitch {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        checked: root.checked; toggled(value) => { root.checked = value; }
    }
}

component AppearanceThemeChoice inherits Rectangle {
    in property <int> theme-kind;
    in property <bool> selected;
    callback chosen();

    height: 106px;
    background: transparent;

    preview := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 78px;
        border-radius: Spacing.small;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Colors.primary : Colors.outline;
        background: root.theme-kind == 1 ? #15345d : #dcecff;
        clip: true;

        if root.theme-kind == 2: Rectangle {
            x: parent.width / 2; width: parent.width / 2; height: parent.height;
            background: #15345d;
        }
        Rectangle {
            x: 9px; y: 13px; width: parent.width - 18px; height: parent.height - 13px;
            border-radius: 5px;
            background: root.theme-kind == 1 ? #25282d : #ffffff;
            clip: true;
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; width: parent.width / 2; height: parent.height;
                background: #25282d;
            }
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 14px;
                border-radius: 5px;
                background: root.theme-kind == 1 ? #383c43 : #f5f7fa;
            }
            if root.theme-kind == 2: Rectangle {
                x: parent.width / 2; y: 0px; width: parent.width / 2; height: 14px;
                background: #383c43;
            }
            for dot in [0, 1, 2]: Rectangle {
                x: 6px + dot * 6px; y: 6px; width: 3px; height: 3px;
                border-radius: 2px;
                background: root.theme-kind == 1 ? #aeb5bf : #68707a;
            }
            Rectangle { x: 6px; y: 22px; width: 16px; height: 6px; border-radius: 2px; background: #1967d2; }
            Rectangle { x: 6px; y: 33px; width: 12px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 23px; width: parent.width - 43px; height: 4px; border-radius: 2px; background: root.theme-kind == 1 ? #aeb5bf : #68707a; }
            Rectangle { x: 28px; y: 33px; width: parent.width - 38px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: 28px; y: 42px; width: parent.width - 48px; height: 3px; border-radius: 2px; background: root.theme-kind == 1 ? #565b63 : #d4d9df; }
            Rectangle { x: parent.width - 27px; y: parent.height - 13px; width: 19px; height: 6px; border-radius: 3px; background: #1967d2; }
        }
    }
    Text {
        y: 82px; width: parent.width; height: 24px;
        text: root.theme-kind == 0 ? @tr("Light") : root.theme-kind == 1 ? @tr("Dark") : @tr("System");
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: Typography.compact-size;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.chosen(); } }
}

component AppearanceAccentChoice inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback chosen();

    width: 36px; height: 36px;
    border-radius: 18px;
    border-width: root.selected ? 2px : 0px;
    border-color: Colors.primary;
    background: transparent;
    Rectangle {
        x: 3px; y: 3px; width: 30px; height: 30px;
        border-radius: 15px;
        background: root.swatch;
        if root.selected: Path {
            x: 8px; y: 10px; width: 14px; height: 11px;
            viewbox-width: 14; viewbox-height: 11;
            stroke: Colors.on-primary; stroke-width: 2px;
            MoveTo { x: 1; y: 5; } LineTo { x: 5; y: 9; } LineTo { x: 13; y: 1; }
        }
    }
    TouchArea { clicked => { root.chosen(); } }
}

component AppearancePreviewField inherits Rectangle {
    in property <string> value;
    in property <bool> opened;
    callback clicked();

    height: 42px;
    border-radius: 6px;
    border-width: root.opened ? 2px : 1px;
    border-color: root.opened ? Colors.primary : Colors.outline;
    background: Colors.background;
    Text {
        x: Spacing.medium; width: parent.width - 2 * Spacing.medium - 18px; height: parent.height;
        text: root.value; color: Colors.foreground; font-size: Typography.body-size;
        vertical-alignment: center; overflow: elide;
    }
    Path {
        x: parent.width - Spacing.medium - 12px; y: (parent.height - 6px) / 2;
        width: 12px; height: 6px; viewbox-width: 12; viewbox-height: 6;
        stroke: Colors.secondary-foreground; stroke-width: 1.5px;
        MoveTo { x: 1; y: root.opened ? 5 : 1; }
        LineTo { x: 6; y: root.opened ? 1 : 5; }
        LineTo { x: 11; y: root.opened ? 5 : 1; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Unlike the standard ComboBox, refreshing choices must never select the first model.
component SettingsComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in property <string> placeholder: @tr("Select a model");
    in-out property <int> current-index: -1;
    callback selected(int);
    private property <bool> popup-focused;
    private property <length> menu-scroll-y;
    height: 42px; min-width: 140px; horizontal-stretch: 1; vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: field-focus;
    accessible-role: combobox; accessible-enabled: root.enabled;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder;
    accessible-expandable: true; accessible-expanded: root.popup-focused;
    accessible-action-expand => { root.open(); }
    function open() {
        if root.enabled && root.model.length > 0 {
            root.menu-scroll-y = -max(0, root.current-index - 4) * 40px;
            menu.show();
        }
    }
    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.current-index = index; root.selected(index);
        }
    }
    field-focus := FocusScope { enabled: root.enabled;
        AppearancePreviewField {
            width: parent.width; height: parent.height;
            value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder;
            opened: root.popup-focused;
            clicked => { if root.enabled { field-focus.focus(); root.open(); } }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow { root.open(); return accept; }
            return reject;
        }
    }
    menu := PopupWindow {
        x: 0px; y: root.height + 2px; width: root.width; height: min(240px, root.model.length * 40px);
        close-policy: close-on-click-outside; forward-focus: menu-focus;
        menu-focus := FocusScope {
            focus-changed-event => { root.popup-focused = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.choose(max(0,root.current-index - 1)); return accept; }
                if event.text == Key.DownArrow { root.choose(min(root.model.length - 1,root.current-index + 1)); return accept; }
                if event.text == Key.Return || event.text == Key.Escape { menu.close(); return accept; }
                return reject;
            }
            SettingsSelectMenu {
                width: parent.width; height: parent.height; options: root.model;
                selected-index: root.current-index; scroll-y <=> root.menu-scroll-y;
                selected(index) => { root.choose(index); menu.close(); }
            }
        }
    }
}


component UnavailableHotkeyRow inherits Rectangle {
    in property <string> label;
    in property <bool> compact;

    height: root.compact ? 88px : 64px;

    Text {
        x: 0px; y: 0px;
        width: root.compact ? parent.width : parent.width * 0.45 - Spacing.small;
        height: root.compact ? 32px : parent.height;
        text: root.label; color: Colors.secondary-foreground; wrap: word-wrap;
        font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.compact ? 0px : parent.width * 0.45;
        y: root.compact ? 38px : (parent.height - 40px) / 2;
        width: root.compact ? parent.width - 112px : parent.width * 0.55 - 112px;
        height: 40px; border-radius: 6px; border-width: 1px;
        border-color: Colors.outline; background: Colors.background;
        Text {
            x: Spacing.medium; width: parent.width - 2 * Spacing.medium; height: parent.height;
            text: @tr("No shortcut"); color: Colors.secondary-foreground;
            font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
        }
    }
    Rectangle {
        x: parent.width - 100px; y: root.compact ? 38px : (parent.height - 40px) / 2;
        width: 100px; height: 40px; border-radius: 6px; background: Colors.background;
        Text {
            width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Unavailable"); color: Colors.secondary-foreground;
            font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component OffsetPreviewField inherits Rectangle {
    in-out property <string> value: "12";
    in property <string> unit: "px";
    in property <int> fallback-value: 12;
    in property <int> min-value: -10000;

    function parsed-value() -> int {
        if root.value.is-float() { return max(root.min-value, round(root.value.to-float())); }
        return root.fallback-value;
    }

    height: 42px;
    border-radius: 6px; border-width: 1px; border-color: Colors.outline;
    background: Colors.background;

    TextInput {
        x: Spacing.medium; width: parent.width - (root.unit == "" ? 72px : 116px); height: parent.height;
        text <=> root.value;
        color: Colors.foreground; font-size: Typography.body-size;
        selection-background-color: Colors.primary-container;
        selection-foreground-color: Colors.foreground;
        vertical-alignment: center;
        accepted => { root.value = root.parsed-value(); }
        changed has-focus => { if !self.has-focus { root.value = root.parsed-value(); } }
    }
    if root.unit != "": Text {
        x: parent.width - 96px; width: 44px; height: parent.height;
        text: root.unit; color: Colors.secondary-foreground;
        font-size: Typography.body-size; vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 44px; y: 1px; width: 43px; height: parent.height - 2px;
        clip: true;

        Rectangle {
            x: 1px; y: 0px; width: parent.width - 1px; height: 20px;
            background: increase-touch.pressed ? Colors.icon-button-pressed
                : increase-touch.has-hover ? Colors.icon-button-hover : transparent;
            Image {
                x: (parent.width - 20px) / 2; y: 0px; width: 20px; height: 20px;
                source: AppAssets.icon-expand-less; image-fit: contain;
                colorize: Colors.secondary-foreground;
            }
            increase-touch := TouchArea {
                clicked => { root.value = root.parsed-value() + 1; }
            }
        }
        Rectangle {
            x: 1px; y: 21px; width: parent.width - 1px; height: parent.height - 21px;
            background: decrease-touch.pressed ? Colors.icon-button-pressed
                : decrease-touch.has-hover ? Colors.icon-button-hover : transparent;
            Image {
                x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2;
                width: 20px; height: 20px;
                source: AppAssets.icon-expand-more; image-fit: contain;
                colorize: Colors.secondary-foreground;
            }
            decrease-touch := TouchArea {
                clicked => { root.value = max(root.min-value, root.parsed-value() - 1); }
            }
        }
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Colors.outline; }
        Rectangle { x: 1px; y: 20px; width: parent.width - 1px; height: 1px; background: Colors.outline; }
    }
}

component SelectionActionRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // 0 is required, 1 is a preview switch, and 2 is unavailable.
    in property <int> status;
    in property <bool> checked: false;
    callback toggled(bool);

    height: Metrics.settings-row-height;

    for dot in [0, 1, 2, 3, 4, 5]: Rectangle {
        x: Math.mod(dot, 2) * 5px; y: 23px + floor(dot / 2) * 6px;
        width: 2px; height: 2px; border-radius: 1px;
        background: Colors.secondary-foreground;
    }
    Image {
        x: 24px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
        source: root.icon; image-fit: contain; colorize: Colors.secondary-foreground;
    }
    Text {
        x: 56px; width: parent.width - 56px - (root.status == 1 ? 64px : 112px);
        height: parent.height; text: root.label; wrap: word-wrap;
        color: root.status == 2 ? Colors.secondary-foreground : Colors.foreground;
        font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
    }
    if root.status == 0: Rectangle {
        x: parent.width - 94px; y: (parent.height - 32px) / 2;
        width: 94px; height: 32px; border-radius: 6px;
        background: Colors.primary-container;
        Text { width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Required"); color: Colors.primary; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.status == 1: SettingsSwitch {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        checked: root.checked; toggled(value) => { root.toggled(value); }
    }
    if root.status == 2: Rectangle {
        x: parent.width - 100px; y: (parent.height - 36px) / 2;
        width: 100px; height: 36px; border-radius: 6px; background: Colors.background;
        Text { width: parent.width - 8px; x: 4px; height: parent.height; wrap: word-wrap; text: @tr("Unavailable"); color: Colors.secondary-foreground; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}

component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon-kind;
    in property <bool> selected;
    in property <bool> expanded;
    callback activated();

    height: Metrics.settings-nav-item-height;
    border-radius: 10px;
    background: root.selected ? Colors.primary-container
        : nav-touch.pressed ? Colors.icon-button-pressed
        : nav-touch.has-hover || nav-focus.has-focus ? Colors.icon-button-hover : transparent;

    Path {
        x: root.expanded ? Spacing.medium : (parent.width - Metrics.icon-size) / 2;
        y: (parent.height - Metrics.icon-size) / 2;
        width: Metrics.icon-size;
        height: Metrics.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-kind == 5
            ? "M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2ZM2 12H22M4 7H20M4 17H20M12 2C7 7 7 17 12 22C17 17 17 7 12 2Z"
            : root.icon-kind == 4
            ? "M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 0h2v6h-6v-2h4v-4zM10 10h4v4h-4v-4z"
            : root.icon-kind == 3
            ? "M11 2a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7V2zm0 4a5 5 0 1 0 5 5h-2a3 3 0 1 1-3-3V6zm1 5 9 4-4 1-1 4-4-9z"
            : root.icon-kind == 2
            ? "M20 5H4C2.9 5 2 5.9 2 7v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 12H4V7h16v10zM6 9h2v2H6V9zm3 0h2v2H9V9zm3 0h2v2h-2V9zm3 0h3v2h-3V9zM6 12h2v2H6v-2zm3 0h2v2H9v-2zm3 0h2v2h-2v-2zm3 0h3v2h-3v-2zM7 15h10v1H7v-1z"
            : root.icon-kind == 0
            ? "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
            : "M12.87 15.07 10.33 12.56l.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17A15.5 15.5 0 0 1 9 11.35 15.4 15.4 0 0 1 6.91 8H4.91A17.5 17.5 0 0 0 7.67 12.56L2.58 17.58 4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z";
        fill: root.icon-kind == 5 ? transparent : root.selected ? Colors.primary : Colors.secondary-foreground;
        stroke: root.icon-kind == 5 ? (root.selected ? Colors.primary : Colors.secondary-foreground) : transparent;
        stroke-width: root.icon-kind == 5 ? 1.6px : 0px;
    }

    if root.expanded: Text {
        x: Spacing.medium + Metrics.icon-size + Spacing.small;
        width: parent.width - self.x - Spacing.small;
        height: parent.height;
        text: root.label;
        color: root.selected ? Colors.primary : Colors.foreground;
        font-size: Typography.body-size;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    if !root.expanded && nav-touch.has-hover: Rectangle {
        x: parent.width + Spacing.small;
        y: (parent.height - 36px) / 2;
        width: 112px;
        height: 36px;
        z: 100;
        border-radius: 6px;
        background: Colors.foreground;

        Text {
            text: root.label;
            color: Colors.surface;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    nav-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    nav-touch := TouchArea {
        clicked => {
            nav-focus.focus();
            root.activated();
        }
    }
}

