import { Colors } from "design/colors.slint";
// Pointer-transparent feedback shared by image and pin crop hosts.
export component ImageCropFeedback inherits Rectangle {
    in property <float> source-width: 1;
    in property <float> source-height: 1;
    in property <float> selection-left;
    in property <float> selection-top;
    in property <float> selection-right;
    in property <float> selection-bottom;
    private property <length> l: root.selection-left / max(1,root.source-width) * root.width;
    private property <length> t: root.selection-top / max(1,root.source-height) * root.height;
    private property <length> r: root.selection-right / max(1,root.source-width) * root.width;
    private property <length> b: root.selection-bottom / max(1,root.source-height) * root.height;
            Rectangle { x:0px; y:0px; width:parent.width; height:parent.t; background:Colors.capture-mask; }
            Rectangle { x:0px; y:parent.b; width:parent.width; height:max(0px,parent.height - parent.b); background:Colors.capture-mask; }
            Rectangle { x:0px; y:parent.t; width:parent.l; height:parent.b - parent.t; background:Colors.capture-mask; }
            Rectangle { x:parent.r; y:parent.t; width:max(0px,parent.width - parent.r); height:parent.b - parent.t; background:Colors.capture-mask; }
            Rectangle { x:parent.l; y:parent.t; width:parent.r - parent.l; height:parent.b - parent.t; border-width:1px; border-color:Colors.primary; }
            for handle in [0,1,2,3,4,5,6,7]: Rectangle {
                x: (handle == 0 || handle == 6 || handle == 7 ? parent.l : handle == 2 || handle == 3 || handle == 4 ? parent.r : (parent.l+parent.r)/2) - 3px;
                y: (handle <= 2 ? parent.t : handle >= 4 && handle <= 6 ? parent.b : (parent.t+parent.b)/2) - 3px;
                width:6px; height:6px; background:Colors.surface; border-width:1px; border-color:Colors.primary;
            }
}
