import { NumericButton } from "annotation-numeric.slint";
import { AnnotationPalette, CustomColorButton } from "annotation-palette.slint";
import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { Metrics } from "design/metrics.slint";
import { ComboBox, SpinBox, CheckBox, LineEdit, AnnotationChoiceRequest } from "annotation-fields.slint";
import { ScrollView } from "std-widgets.slint";

export struct AnnotationValues {
    size: int, rounding: int, text-size: int, start: int, strength: float,
    shape: int, style: int, mode: int, font: int, format: int, zoom: int,
    fill: bool, erase: bool, include-annotations: bool, antialias: bool, shadow: bool,
    text: string, color-index: int, custom-color: string,
    line-start: int, line-end: int, connector-style: int, head: bool,
    text-bold: bool, text-italic: bool, text-outline: bool, text-background: bool,
    text-outline-width: int, text-outline-color-index: int, text-outline-custom-color: string,
    text-bg-color-index: int, text-bg-custom-color: string, text-bg-opacity: int, text-bg-rounding: int,
    text-bg-padding: int,
    sequence-ratio: int, sequence-guide: bool, sequence-expanded: bool, sequence-text-color: string,
    sequence-label: string,
}

component ToolIcon inherits Rectangle {
    in property <int> kind;
    in property <color> ink: Colors.foreground;
    width: 24px; height: 24px;
    if root.kind == 12: Image { width:24px;height:24px;source:@image-url("icons/sticker-sheet.svg");colorize:root.ink;image-fit:contain; }
    if root.kind != 12: Path {
    width:24px; height:24px; viewbox-width:24; viewbox-height:24;
    fill: kind == 11 || kind == 12 ? root.ink : transparent; stroke: root.ink; stroke-width: 1.8px;
    commands: kind == 0 ? "M4 4H20V20H4Z"
        : kind == 1 ? "M12 3A9 9 0 1 0 12 21A9 9 0 1 0 12 3Z"
        : kind == 2 ? "M8 17H16M9 20H15M8 14C2 8 7 3 12 3S22 8 16 14V17H8Z"
        : kind == 3 ? "M4 16L15 5L19 9L8 20H4ZM13 7L17 11M15 5L17 3L21 7L19 9"
        : kind == 4 ? "M7 5H17L19 14L14 19H8L4 15ZM8 10H16M9 19V22H13V19"
        : kind == 5 ? "M4 20L20 4M8 4H20V16"
        : kind == 6 ? "M3 18L9 8L15 15L21 4"
        : kind == 7 ? "M10 3A7 7 0 1 0 10 17A7 7 0 1 0 10 3M15 15L22 22"
        : kind == 8 ? "M3 4H21M12 4V21M8 21H16"
        : kind == 9 ? "M12 2C10 6 5 10 5 15A7 7 0 0 0 19 15C19 10 14 6 12 2Z"
        : kind == 10 ? "M12 3A9 9 0 1 0 12 21A9 9 0 1 0 12 3M10 9L12 7V17"
        : kind == 11 || kind == 12 ? "M3 3H9V9H3ZM15 3H21V9H15ZM9 9H15V15H9ZM3 15H9V21H3ZM15 15H21V21H15Z"
        : kind == 13 ? "M3 14L13 4L21 12L11 22H9ZM7 10L15 18M11 22H22"
        : kind == 14 ? "M8 4L3 9L8 14M3 9H14C23 9 23 21 14 21H9"
        : kind == 15 ? "M12 2V16M7 11L12 16L17 11M3 16V21H21V16"
        : kind == 18 ? "M4 20L20 4"
        : kind == 17 ? "M4 2L4 21L9 16L13 22L16 20L12 14L20 13Z"
        : "M3 12L9 18L21 5";
    }
}

component ToolButton inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    in property <bool> selected;
    in property <int> text-style: 0;
    in property <bool> enabled: true;
    in property <int> mosaic-style: 0;
    callback clicked();
    width: 38px; height: 38px; border-radius: 6px;
    accessible-role: button; accessible-label: root.label;
    background: area.pressed ? Colors.icon-button-pressed : root.selected ? Colors.primary-container
        : area.has-hover && root.enabled ? Colors.icon-button-hover : transparent;
    if root.kind < 19 && root.text-style == 0 && root.mosaic-style == 0: ToolIcon { x: 7px; y: 7px; kind: root.kind;
        ink: !root.enabled ? Colors.outline : root.selected ? Colors.primary : Colors.foreground; }
    if (root.kind >= 19 || root.text-style != 0 || root.mosaic-style != 0): Image {
        x: 7px; y: 7px; width: 24px; height: 24px;
        source: root.kind == 20 ? @image-url("assets/icons/toolbar-collapse.svg")
            : root.kind == 21 ? @image-url("assets/icons/toolbar-expand.svg")
            : root.mosaic-style == 1 ? @image-url("icons/mosaic-area.svg")
            : root.mosaic-style == 2 ? @image-url("icons/mosaic-brush.svg")
            : root.text-style == 1 ? @image-url("icons/text-italic.svg")
            : root.text-style == 2 ? @image-url("icons/text-outline.svg")
            : root.text-style == 3 ? @image-url("icons/text-background.svg") : @image-url("icons/curve.svg"); image-fit: contain;
        colorize: !root.enabled ? Colors.outline : root.selected ? Colors.primary : Colors.foreground;
    }
    area := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component AnnotationToolbar inherits Window {
    title: @tr("Lexift Annotation Preview"); no-frame: true; always-on-top: true;
    background: transparent; preferred-width: root.toolbar-width; preferred-height: 54px;
    min-width: 0px; max-width: root.toolbar-width; min-height: 54px; max-height: 54px;
    in property <bool> collapsed: false;
    out property <length> toolbar-width: root.collapsed ? 80px : 695px;
    callback collapse-requested();
    in property <[int]> tools: [0, 4, 7, 9, 10, 11, 13];
    in property <int> active-group: -1;
    in property <bool> operate: false;
    in property <bool> can-undo: false;
    in property <bool> can-download: false;
    out property <length> notice-width: Metrics.toast-width;
    out property <length> notice-height: Metrics.toast-height;
    out property <length> notice-margin: Spacing.medium;
    out property <length> notice-radius: Spacing.small;
    out property <length> notice-font-size: Typography.body-size;
    callback tool-clicked(int, bool);
    callback operate-requested();
    callback undo-requested();
    callback download-requested();
    callback delete-requested();
    callback finish-path-requested();
    callback backspace-requested();
    callback drag-requested();
    callback finish-requested();
    callback escape-requested();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.escape-requested(); return accept; }
            if event.text == Key.Delete { root.delete-requested(); return accept; }
            if event.text == Key.Return { root.finish-path-requested(); return accept; }
            if event.text == Key.Backspace { root.backspace-requested(); return accept; }
            if event.text == "z" && event.modifiers.control { root.undo-requested(); return accept; }
            return reject;
        }
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 10px; border-width: 1px; border-color: Colors.outline; background: Colors.surface;
            Rectangle {
                x: 7px; y: 7px; width: 20px; height: 38px;
                for dot in [0,1,2,3,4,5]: Rectangle {
                    x: 4px + Math.mod(dot,2) * 7px; y: 10px + floor(dot/2) * 7px;
                    width: 4px; height: 4px; border-radius: 2px; background: Colors.outline;
                }
                TouchArea { mouse-cursor: move; pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-requested(); }
                } }
            }
            if !root.collapsed: HorizontalLayout {
            x: 34px; y: 7px; width: parent.width - 85px; height: 38px; spacing: 7px;
            alignment: space-between;
            ToolButton { kind: 17; selected: root.operate; clicked => { root.operate-requested(); } }
            for tool[group] in root.tools: HorizontalLayout {
                spacing: 0px;
                ToolButton { kind: tool; selected: root.active-group == group;
                    clicked => { root.tool-clicked(group, false); } }
                if group != 4 && group != 6: Rectangle {
                    width: 18px; height: 38px; border-radius: 5px;
                    background: arrow.has-hover ? Colors.icon-button-hover : transparent;
                    Path { x: 4px; y: 16px; width: 10px; height: 6px;
                        viewbox-width: 10; viewbox-height: 6; commands: "M1 1L5 5L9 1";
                        fill: transparent; stroke: Colors.secondary-foreground; stroke-width: 1.6px; }
                    arrow := TouchArea { clicked => { root.tool-clicked(group, true); } }
                }
            }
            Rectangle { width: 1px; background: Colors.outline; }
            ToolButton { kind: 14; enabled: root.can-undo; clicked => { root.undo-requested(); } }
                ToolButton { kind: 15; enabled: root.can-download; clicked => { root.download-requested(); } }
            ToolButton { kind: 16; clicked => { root.finish-requested(); } }
            }
            ToolButton {
                x: parent.width - 44px; y: (parent.height - self.height) / 2;
                kind: root.collapsed ? 21 : 20;
                label: root.collapsed ? @tr("Expand toolbar") : @tr("Collapse toolbar");
                clicked => { root.collapse-requested(); }
            }
    }
    }
}

export component AnnotationPanel inherits Window {
    clear-label-metrics := Text { text: @tr("Clear all"); font-size: 13px; visible: false; }
    out property <float> numeric-content-height: (root.tool <= 4 ? numeric-basic.preferred-height : root.tool >= 5 && root.tool <= 7 ? numeric-lines.preferred-height : root.tool == 8 ? numeric-text.preferred-height : root.tool == 9 ? numeric-watermark.preferred-height : root.tool == 10 ? numeric-sequence.preferred-height : (root.tool == 11 || root.tool == 12) ? numeric-mosaic.preferred-height : root.tool == 13 ? numeric-eraser.preferred-height : 38px) / 1px + 22;
    out property <float> numeric-content-width: (root.tool <= 4 ? numeric-basic.preferred-width : root.tool >= 5 && root.tool <= 7 ? numeric-lines.preferred-width : root.tool == 8 ? numeric-text.preferred-width : root.tool == 9 ? numeric-watermark.preferred-width : root.tool == 10 ? numeric-sequence.preferred-width : (root.tool == 11 || root.tool == 12) ? numeric-mosaic.preferred-width : numeric-eraser.preferred-width) / 1px + 26;
    in property <bool> numeric-measuring: false;
    in property <int> language-revision;
    title: @tr("Lexift Annotation Options"); no-frame: true; always-on-top: true;
    background: transparent; preferred-width: 720px; preferred-height: 220px;
    in property <bool> menu: false;
    in property <[int]> menu-tools;
    in property <[string]> menu-labels;
    in property <[int]> fields;
    in property <[string]> font-families;
    in property <int> tool: 0;
    in property <string> heading: @tr("Rectangle");
    in-out property <AnnotationValues> values;
    callback parameter-dragging(bool);
    callback release-parameter-input();
    release-parameter-input => { keys.focus(); root.parameter-input-active = false; }
    callback parameter-input-finished(bool);
    // Releasing the confirmed field also emits a deferred blur; it is the same interaction.
    private property <bool> confirmed-input-exit: false;
    function confirm-parameter-input() {
        root.confirmed-input-exit = true;
        root.release-parameter-input();
        root.parameter-input-finished(true);
    }
    function finish-parameter-input() {
        if !root.confirmed-input-exit { root.parameter-input-finished(false); }
    }
    in-out property <bool> parameter-input-active: false;
    out property <float> parameter-input-x;
    out property <float> parameter-input-y;
    out property <float> parameter-input-width;
    out property <float> parameter-input-height;
    function report-parameter-input(active: bool, x: float, y: float, w: float, h: float) {
        if active { root.confirmed-input-exit = false; }
        root.parameter-input-active = active;
        if active {
            root.parameter-input-x = x; root.parameter-input-y = y;
            root.parameter-input-width = w; root.parameter-input-height = h;
        }
    }
    callback values-changed(AnnotationValues);
    changed values => { root.values-changed(root.values); }
    in property <int> columns: 4;
    in property <int> active-choice: -1;
    in property <bool> mosaic-available: true;
    in property <bool> can-clear: false;
    callback clear-all-requested();
    callback numeric-scrolled(int,float);
    callback numeric-layout-changed();
    changed numeric-content-height => { root.numeric-layout-changed(); }
    callback watermark-edit-requested();
    in property <color> custom-preview: #d9472b;
    callback choice-requested(AnnotationChoiceRequest);
    callback text-style-requested(AnnotationChoiceRequest);
    callback selected(int);
    callback undo-requested();
    callback escape-requested();
    private property <[string]> labels: [@tr("Width"), @tr("Shape"), @tr("Line style"), @tr("Corner radius"), @tr("Fill"), @tr("Intensity"), @tr("Blend mode"), @tr("Magnification"), @tr("Include annotations"), @tr("Anti-aliasing"), @tr("Shadow"), @tr("Text"), @tr("Font"), @tr("Text size"), @tr("Arrangement"), @tr("Start at"), @tr("Sequence"), @tr("Method"), @tr("Effect")];
    private property <[color]> palette: root.tool == 4 ? [#fff400, #ffa500, #46ebeb, #a59bff, #ffa0f5, #ffffff, #32ec66, #212121] : [#d9472b, #e5bf55, #69ad61, #598fdf, #212121, #ffffff, #32ec66, #fff400];
    private property <[string]> endpoint-options: [@tr("None"), @tr("Open arrow"), @tr("Arrow"), @tr("Filled arrow"), @tr("Circle"), @tr("Open circle"), @tr("Diamond"), @tr("Open diamond"), @tr("Bar")];
    private property <[string]> connector-options: [@tr("Plain line"), @tr("Source dot"), @tr("Source frame"), @tr("No connection")];
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.escape-requested(); return accept; }
            if (root.tool == 11 || root.tool == 12 || root.tool == 13) && !root.parameter-input-active
                && event.text == "z" && event.modifiers.control {
                root.undo-requested(); return accept;
            }
            return reject;
        }
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 10px; border-width: 1px; border-color: Colors.outline; background: Colors.surface;
        if root.menu: ScrollView {
            width: 100%; height: 100%; content-width: self.visible-width;
            content-height: 46px + root.menu-tools.length * 42px;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
            width: 100%; height: 46px + root.menu-tools.length * 42px;
            padding: 8px; spacing: 2px;
            for kind[i] in root.menu-tools: Rectangle {
                height: 40px; border-radius: 5px;
                background: option.has-hover ? Colors.icon-button-hover : transparent;
                ToolIcon { x: 8px; y: 8px; kind: kind; ink: kind == root.tool ? Colors.primary : Colors.foreground; }
                Text { x: 44px; height: parent.height; text: root.menu-labels[i]; color: Colors.foreground; vertical-alignment: center; font-size: 14px; }
                option := TouchArea { clicked => { root.selected(kind); } }
            }
            Text { height: 28px; text: @tr("Adjust — unavailable"); color: Colors.secondary-foreground; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
        numeric-basic := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool <= 4;
 x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            if root.tool <= 2: ToolButton { kind: 0; selected: root.values.shape == 0;
                clicked => { root.values.shape = 0; } }
            if root.tool <= 2: ToolButton { kind: 1; selected: root.values.shape == 1;
                clicked => { root.values.shape = 1; } }
            if root.tool < 2: CheckBox {
                  width:self.content-width;
                text: @tr("Fill"); checked <=> root.values.fill;
            }
            if root.tool == 2: CheckBox {
                  width:self.content-width;
                text: @tr("Outline"); checked <=> root.values.erase;
            }
            if root.tool < 2 || root.tool == 3: ComboBox { field: 2; lines: true; active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                  width: 105px; height: 30px;
                language-revision: root.language-revision;
                model: ["────", "— —", "····", "— ·", "— · ·"];
                current-index <=> root.values.style;
            }
            if root.tool == 4: ToolButton { kind: 18; selected: root.values.shape == 0; clicked => {root.values.shape = 0;} }
            if root.tool == 4: ToolButton { kind: 0; selected: root.values.shape == 1; clicked => {root.values.shape = 1;} }
            if root.tool == 4: ComboBox {
                  width: 194px; height: 30px; field: 6;
                active-field: root.active-choice; menu-requested(request) => {root.choice-requested(request);}
                model: [@tr("Translucent"), @tr("Multiply — unavailable")]; current-index: 0;
            }
            if root.tool == 2: NumericButton { tool:root.tool;   field:-101; value:root.values.strength; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            NumericButton { tool:root.tool; height:38px; enabled: root.tool == 3 ? true : root.tool == 4 ? root.values.shape == 0 : root.tool == 2 ? root.values.erase : !root.values.fill; field:-9; value:root.values.size; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            if root.tool <= 2: NumericButton { tool:root.tool; height:38px; enabled: root.values.shape == 0; field:-100; value:root.values.rounding; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            for ink[i] in root.palette: Rectangle {


                width: 28px; height: 28px; border-radius: 8px;
                border-width: root.values.color-index == i ? 2px : 1px;
                border-color: root.values.color-index == i ? Colors.primary : Colors.outline;
                Rectangle { x: 4px; y: 4px; width: 20px; height: 20px; border-radius: 5px; background: ink; }
                TouchArea { clicked => { root.values.color-index = i; } }
            }
            custom-color := Rectangle {

                 width: 28px; height: 28px;
                border-radius: 8px; border-width: root.values.color-index == 8 ? 2px : 1px;
                border-color: root.values.color-index == 8 || root.active-choice == -2 ? Colors.primary : Colors.outline;
                background: custom-hit.has-hover ? Colors.icon-button-hover : Colors.surface;
                accessible-role: button; accessible-label: @tr("Custom color");
                Image { x: 4px; y: 4px; width: 20px; height: 20px; source: @image-url("icons/custom-color.svg"); }
                custom-hit := TouchArea { clicked => {
                    root.choice-requested({field: -2, options: [], selected: 0, lines: false, connectors: false,
                        x: custom-color.absolute-position.x / 1px, y: custom-color.absolute-position.y / 1px,
                        width: custom-color.width / 1px, height: custom-color.height / 1px});
                } }
            }
}
        numeric-lines := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool >= 5 && root.tool <= 7;
 x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            if root.tool != 5: ToolButton { kind: root.tool == 7 ? 0 : 6;
                selected: root.values.shape == 0; clicked => { root.values.shape = 0; } }
            if root.tool != 5: ToolButton { kind: root.tool == 7 ? 1 : 19;
                selected: root.values.shape == 1; clicked => { root.values.shape = 1; } }
            if root.tool != 7: ComboBox {
                  width: 104px; height: 30px; field: 2;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision;
                model: [@tr("Solid"), @tr("Dashed"), @tr("Dotted"), @tr("Dash dot"), @tr("Dash dot dot")];
                current-index <=> root.values.style;
            }
            NumericButton { tool:root.tool; height:38px; field:-9; value:root.values.size; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            if root.tool == 6: CheckBox {   width:self.content-width;
                text: @tr("Fill"); checked <=> root.values.fill; }
            if root.tool != 7: CheckBox {   width:self.content-width;
                text: @tr("Arrowhead"); checked <=> root.values.head; }
            if root.tool != 7: ComboBox {
                  width: 108px; height: 30px; field: 19;
                enabled: root.values.head;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision; model: root.endpoint-options;
                current-index <=> root.values.line-start;
            }
            if root.tool != 7: ComboBox {

                 width: 108px; height: 30px; field: 20;
                enabled: root.values.head;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision; model: root.endpoint-options;
                current-index <=> root.values.line-end;
            }
            if root.tool == 7: ComboBox {
                  width: 108px; height: 30px; field: 21;
                connectors: true;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision; model: root.connector-options;
                current-index <=> root.values.connector-style;
            }
            if root.tool == 7: NumericButton { tool:root.tool;   field:-103; value:root.values.zoom; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            if root.tool == 7: CheckBox {   width: self.content-width;
                text: @tr("Include annotations"); checked <=> root.values.include-annotations; }
            if root.tool == 7: CheckBox {
                 width:self.content-width;
                text: @tr("Anti-aliasing"); checked <=> root.values.antialias; }
            if root.tool == 7: CheckBox {
                 width:self.content-width;
                text: @tr("Shadow"); checked <=> root.values.shadow; }
            for ink[i] in root.palette: Rectangle {


                width: 28px; height: 28px; border-radius: 8px;
                border-width: root.values.color-index == i ? 2px : 1px;
                border-color: root.values.color-index == i ? Colors.primary : Colors.outline;
                Rectangle { x: 4px; y: 4px; width: 20px; height: 20px; border-radius: 5px; background: ink; }
                TouchArea { clicked => { root.values.color-index = i; } }
            }
            custom-third := Rectangle {


                width: 28px; height: 28px; border-radius: 8px;
                border-width: root.values.color-index == 8 ? 2px : 1px;
                border-color: root.values.color-index == 8 || root.active-choice == -2 ? Colors.primary : Colors.outline;
                background: Colors.surface; accessible-role: button; accessible-label: @tr("Custom color");
                Image { x: 4px; y: 4px; width: 20px; height: 20px; source: @image-url("icons/custom-color.svg"); }
                TouchArea { clicked => { root.choice-requested({field: -2, options: [], selected: 0, lines: false, connectors: false,
                    x: custom-third.absolute-position.x / 1px, y: custom-third.absolute-position.y / 1px,
                    width: custom-third.width / 1px, height: custom-third.height / 1px}); } }
            }
}
        numeric-text := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool == 8;
 x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            Rectangle {  width: 38px; height: 38px; border-radius: 6px;
                background: root.values.text-bold ? Colors.primary-container : bold-area.has-hover ? Colors.icon-button-hover : transparent;
                Text { width: 100%; height: 100%; text: "B"; font-size: 20px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                    color: root.values.text-bold ? Colors.primary : Colors.foreground; }
                bold-area := TouchArea { clicked => { root.values.text-bold = !root.values.text-bold; } }
            }
            ToolButton {  kind: 8; text-style: 1; selected: root.values.text-italic;
                clicked => { root.values.text-italic = !root.values.text-italic; } }
            outline-button := ToolButton {  kind: 8; text-style: 2; selected: root.values.text-outline;
                clicked => { root.text-style-requested({field: -3, options: [], selected: 0, lines: false, connectors: false,
                        x: self.absolute-position.x / 1px, y: self.absolute-position.y / 1px, width: self.width / 1px, height: self.height / 1px}); } }
            background-button := ToolButton {  kind: 0; text-style: 3; selected: root.values.text-background;
                clicked => { root.text-style-requested({field: -4, options: [], selected: 0, lines: false, connectors: false,
                        x: self.absolute-position.x / 1px, y: self.absolute-position.y / 1px, width: self.width / 1px, height: self.height / 1px}); } }
            ComboBox {   width:210px; height: 30px; field: 12; active-field: root.active-choice;
                menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision; model: root.font-families;
                current-index <=> root.values.font; }
            NumericButton { tool:root.tool; height:38px; field:-102; value:root.values.text-size; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            AnnotationPalette {


                selected <=> root.values.color-index; palette: root.palette; custom-active: root.active-choice == -2;
                custom-requested(x,y,w,h) => { root.choice-requested({field: -2, options: [], selected: 0, lines: false, connectors: false,
                    x: x, y: y, width: w, height: h}); }
            }
}
        numeric-watermark := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool == 9;
 x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            Rectangle {   width: 180px; height: 30px; border-radius: 8px;
                background: Colors.icon-button-hover;
                Text { x: 8px; width: 160px; height: 30px; text: root.values.text == "" ? @tr("Enter watermark") : root.values.text;
                    overflow: elide; vertical-alignment: center; color: Colors.foreground; }
                TouchArea { clicked => { root.watermark-edit-requested(); } }
            }
            ComboBox {   width: 125px; height: 30px; field: 14;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision;
                model: [@tr("Tile"), @tr("Bottom right"), @tr("Bottom left"), @tr("Top right"), @tr("Top left"), @tr("Top center"), @tr("Bottom center"), @tr("Center")];
                current-index <=> root.values.mode; }
            NumericButton { tool:root.tool;   field:-101; value:root.values.strength; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            NumericButton { tool:root.tool; height:38px; field:-102; value:root.values.text-size; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            ComboBox {   width: 130px; height: 30px; field: 12;
                active-field: root.active-choice; menu-requested(request) => { root.choice-requested(request); }
                language-revision: root.language-revision; model: root.font-families; current-index <=> root.values.font; }
            AnnotationPalette {


                selected <=> root.values.color-index; palette: root.palette; custom-active: root.active-choice == -2;
                custom-requested(x,y,w,h) => { root.choice-requested({field: -2, options: [], selected: 0, lines: false, connectors: false,
                    x: x, y: y, width: w, height: h}); }
            }
}
        numeric-sequence := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool == 10;
 x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            Rectangle { width:30px;height:30px;background:Colors.icon-button-hover;border-radius:5px;
                Image { width:100%;height:100%;image-fit:contain;
                    source: root.values.shape==0 ? @image-url("icons/sequence-circle.svg") : root.values.shape==1 ? @image-url("icons/sequence-circle-border.svg") : root.values.shape==2 ? @image-url("icons/sequence-outline.svg") : root.values.shape==3 ? @image-url("icons/sequence-plain.svg") : @image-url("icons/sequence-square.svg"); }
                Text { width:100%;height:100%;text:root.values.sequence-label;font-size:13px;horizontal-alignment:center;vertical-alignment:center;color:root.values.shape==2 ? #444444 : root.values.shape==3 ? Colors.foreground : #ffffff;overflow:elide; }
                TouchArea { clicked => { root.choice-requested({ field:23,options:[@tr("Filled circle"),@tr("Circle with white border"),@tr("Outline circle"),@tr("Number only"),@tr("Filled square")],selected:root.values.shape,lines:false,connectors:false,x:parent.absolute-position.x/1px,y:parent.absolute-position.y/1px,width:parent.width/1px,height:parent.height/1px }); } }
            }
            SpinBox {
                input-editing(active) => { root.report-parameter-input(active, self.absolute-position.x / 1px, self.absolute-position.y / 1px, (self.width - 28px) / 1px, self.height / 1px); }
                input-confirmed => { root.confirm-parameter-input(); }
                input-finished => { root.finish-parameter-input(); }
 width:78px;height:30px;minimum:1;maximum:2147483646;value <=> root.values.start; }
            ComboBox { width:106px;height:30px;field:16;active-field:root.active-choice;model:["1,2,3","I,II,III","a,b,c","A,B,C","一,二,三"];current-index <=> root.values.format;menu-requested(q)=>{root.choice-requested(q);} }
            NumericButton { tool:root.tool; height:38px; field:-102; value:root.values.text-size; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            AnnotationPalette { selected <=> root.values.color-index; custom-active:root.active-choice == -2;
                custom-requested(x,y,w,h)=>{root.choice-requested({field:-2,options:[],selected:0,lines:false,connectors:false,x:x,y:y,width:w,height:h});} }
            Rectangle { width:30px;height:30px;border-radius:5px;background:expand.has-hover ? Colors.icon-button-hover : transparent;
                Image { x:6px;y:6px;width:18px;height:18px;source:root.values.sequence-expanded ? @image-url("icons/chevron-left.svg") : @image-url("icons/chevron-right.svg");colorize:Colors.foreground; }
                expand := TouchArea { clicked=>{root.values.sequence-expanded=!root.values.sequence-expanded;} }
            }
            if root.values.sequence-expanded: CustomColorButton { width:38px;height:38px;active:root.active-choice == -8;clicked=>{root.choice-requested({field:-8,options:[],selected:0,lines:false,connectors:false,x:self.absolute-position.x/1px,y:self.absolute-position.y/1px,width:38,height:38});} }
            if root.values.sequence-expanded: ComboBox { width:180px;height:38px;field:12;active-field:root.active-choice;model:root.font-families;current-index <=> root.values.font;menu-requested(q)=>{root.choice-requested(q);} }
            if root.values.sequence-expanded: ToolButton { kind:8;text-style:2;selected:root.values.text-outline;clicked=>{root.text-style-requested({field:-3,options:[],selected:0,lines:false,connectors:false,x:self.absolute-position.x/1px,y:self.absolute-position.y/1px,width:38,height:38}); } }
            if root.values.sequence-expanded: CheckBox { width:self.content-width;text:@tr("Guide");checked <=> root.values.sequence-guide; }
            if root.values.sequence-expanded: NumericButton { tool:root.tool; height:38px; field:-108; value:root.values.sequence-ratio; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            if root.values.sequence-expanded: ComboBox { width:106px;height:38px;field:20;active-field:root.active-choice;model:root.endpoint-options;current-index <=> root.values.line-end;menu-requested(q)=>{root.choice-requested(q);} }
}
        numeric-mosaic := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && (root.tool == 12 || (root.tool == 11 && root.mosaic-available));
            x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
            ToolButton { mosaic-style:1;selected:root.values.shape == 0;clicked=>{root.values.shape=0;} }
            ToolButton { mosaic-style:2;selected:root.values.shape == 1;clicked=>{root.values.shape=1;} }
            NumericButton { tool:root.tool;field:-9;value:root.values.size;enabled:root.values.shape == 1;active-field:root.active-choice;requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            ComboBox { width:110px;height:30px;field:18;active-field:root.active-choice;model:root.tool == 12 ? [@tr("Glass tiles"),@tr("Frosted grain")] : [@tr("Mosaic"),@tr("Blur")];current-index <=> root.values.mode;menu-requested(q)=>{root.choice-requested(q);} }
            NumericButton { tool:root.tool;field:-101;value:root.values.strength;active-field:root.active-choice;requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
            if root.tool == 12: NumericButton { tool:root.tool; field:-109; value:root.values.zoom; active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }
        }
        if !root.menu && root.tool == 11 && !root.mosaic-available: Text {
            x: 12px; width: parent.width - 24px; height: parent.height;
            text: @tr("Mosaic is unavailable on this platform."); font-size: 13px;
            color: Colors.secondary-foreground; vertical-alignment: center;
        }
        numeric-eraser := FlexboxLayout { flex-wrap:root.numeric-measuring ? no-wrap : wrap; visible: !root.menu && root.tool == 13;
            x:12px;y:10px;width:parent.width - 24px;height:self.preferred-height;spacing:8px;cross-axis-alignment:center;
                ToolButton { mosaic-style: 1; selected: root.values.shape == 0; clicked => { root.values.shape = 0; } }
                ToolButton { mosaic-style: 2; selected: root.values.shape == 1; clicked => { root.values.shape = 1; } }
                NumericButton { tool:root.tool; field:-9; value:root.values.size; enabled:root.values.shape == 1;
                    active-field:root.active-choice; requested(q)=>{root.choice-requested(q);} scrolled(f,d)=>{root.numeric-scrolled(f,d);} }

                Rectangle { width: 1px; height: 38px;
                    Rectangle { y: 7px; width: 1px; height: 24px; background: Colors.outline; }
                }
                Rectangle { width: max(110px, clear-label-metrics.preferred-width + 44px); height: 38px; border-radius: 6px;
                    accessible-role: button; accessible-label: @tr("Clear all");
                    background: clear-area.pressed ? Colors.icon-button-pressed
                        : clear-area.has-hover && root.can-clear ? Colors.icon-button-hover : transparent;
                    Image { x: 8px; y: 7px; width: 24px; height: 24px;
                        source: @image-url("icons/clear-annotations.svg"); image-fit: contain;
                        colorize: root.can-clear ? Colors.error : Colors.secondary-foreground;
                        opacity: root.can-clear ? 1 : 0.45;
                    }
                    Text { x: 36px; width: parent.width - 44px; height: 100%; text: @tr("Clear all"); font-size: 13px;
                        color: root.can-clear ? Colors.error : Colors.secondary-foreground; opacity: root.can-clear ? 1 : 0.45;
                        vertical-alignment: center; }
                    clear-area := TouchArea { enabled: root.can-clear; clicked => { root.clear-all-requested(); } }
                }
            }


    }
    }
}
