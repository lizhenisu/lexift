import { Colors } from "design/colors.slint";
import { ScrollView } from "std-widgets.slint";
import { AppVerticalScrollBar } from "design/scrollbar.slint";
export { Colors }
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { AppAssets } from "design/assets.slint";
export { PopupLanguageMenuWindow, TranslationPopup } from "popup.slint";
export { SettingsToastData, SettingsWindow } from "settings.slint";
export { ClipboardHistoryRow, ClipboardHistoryWindow } from "clipboard-history.slint";
export { SelectionToolbarWindow } from "selection-toolbar.slint";
export { AnnotationToolbar, AnnotationPanel, AnnotationValues } from "annotation.slint";
export { AnnotationCanvas, AnnotationCursor } from "annotation-canvas.slint";
export { AnnotationTextInput, AnnotationWatermarkInput } from "annotation-text.slint";

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    height: 40px;
    border-radius: 20px;
    border-width: primary ? 0px : 1px;
    border-color: Colors.outline;
    background: primary ? Colors.primary : Colors.surface;

    Text {
        text: root.label;
        color: root.primary ? Colors.on-primary : Colors.primary;
        font-size: Typography.body-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Lexift";
    icon: AppAssets.app-icon;
    width: 560px;
    height: 520px;
    background: Colors.background;

    in-out property <string> input-text: "";
    in property <string> status-text: @tr("Idle");
    in property <bool> translation-busy: false;
    in property <string> target-language: "";
    in property <string> translated-text: "";
    out property <length> translation-content-height: translation-scroll.content-height;
    out property <length> translation-viewport-height: translation-scroll.visible-height;
    in-out property <length> translation-scroll-y: 0px;
    changed translated-text => { root.translation-scroll-y = 0px; }
    changed error-text => { root.translation-scroll-y = 0px; }
    in property <string> error-text: "";
    in property <bool> show-selection-demo: false;
    callback selection-translation-requested();
    callback input-translation-requested(string);
    callback settings-window-requested();

    VerticalLayout {
        padding: Spacing.large;
        spacing: Spacing.medium;

        HorizontalLayout {
            Text {
                text: "Lexift";
                color: Colors.foreground;
                font-size: Typography.title-size;
                font-weight: 700;
                horizontal-alignment: left;
            }

            ActionButton {
                width: 96px;
                label: @tr("Settings");
                clicked => { root.settings-window-requested(); }
            }
        }

        HorizontalLayout {
            Text {
                text: @tr("Target");
                color: Colors.secondary-foreground;
                font-size: Typography.body-size;
            }

            Text {
                text: root.target-language;
                color: Colors.foreground;
                font-size: Typography.body-size;
                font-weight: 700;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            height: 148px;
            border-radius: Spacing.small;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Colors.primary : Colors.outline;
            background: Colors.surface;

            input := TextInput {
                x: Spacing.medium;
                y: Spacing.medium;
                width: parent.width - 2 * Spacing.medium;
                height: parent.height - 2 * Spacing.medium;
                text <=> root.input-text;
                color: Colors.foreground;
                selection-background-color: Colors.primary-container;
                selection-foreground-color: Colors.foreground;
                font-size: Typography.body-size;
                text-cursor-width: 2px;
                single-line: false;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        HorizontalLayout {
            spacing: Spacing.small;
            alignment: end;

            ActionButton {
                width: 220px;
                visible: root.show-selection-demo;
                label: @tr("Translate selection (demo)");
                clicked => { root.selection-translation-requested(); }
            }

            ActionButton {
                width: 120px;
                primary: true;
                label: root.translation-busy ? @tr("Translating…") : @tr("Translate");
                clicked => { root.input-translation-requested(root.input-text); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.outline;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Spacing.small;
            background: Colors.surface;

            VerticalLayout {
                padding: Spacing.medium;
                spacing: Spacing.small;

                Text {
                    text: @tr("Translation");
                    color: Colors.secondary-foreground;
                    font-size: Typography.body-size;
                    font-weight: 700;
                }

                Rectangle {
                    vertical-stretch: 1;
                    translation-scroll := ScrollView {
                        width: parent.width - 10px;
                        height: parent.height;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, translation-text.preferred-height);
                        content-y <=> root.translation-scroll-y;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        translation-text := Text {
                            x: 0px; y: 0px;
                            width: translation-scroll.visible-width;
                            height: max(translation-scroll.visible-height, self.preferred-height);
                            vertical-alignment: TextVerticalAlignment.top;
                            text: root.error-text != ""
                                ? root.error-text
                                : root.translation-busy
                                    ? @tr("Translating…")
                                    : root.translated-text == ""
                                        ? @tr("Translation will appear here")
                                        : root.translated-text;
                            color: root.error-text != "" ? Colors.error : Colors.foreground;
                            font-size: Typography.body-size;
                            wrap: word-wrap;
                        }
                    }
                    AppVerticalScrollBar {
                        x: parent.width - 10px;
                        height: parent.height;
                        viewport-height: translation-scroll.visible-height;
                        content-height: translation-scroll.content-height;
                        content-y <=> translation-scroll.content-y;
                    }
                }

                Text {
                    text: root.status-text;
                    color: root.error-text != "" ? Colors.error : Colors.secondary-foreground;
                    font-size: Typography.body-size;
                }
            }
        }
    }
}

export { TrayMenuWindow } from "tray-menu.slint";

export { AnnotationChoiceWindow } from "annotation-choice.slint";
export { AnnotationChoiceRequest } from "annotation-fields.slint";
