import { Colors } from "design/colors.slint";

export component LineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    height: 30px; background: Colors.background; border-radius: 5px;
    border-width: 1px; border-color: input.has-focus ? Colors.primary : Colors.outline;
    forward-focus: input;
    if root.text == "": Text { x: 9px; width: parent.width - 18px; height: parent.height;
        text: root.placeholder-text; font-size: 13px; color: Colors.secondary-foreground; vertical-alignment: center; }
    input := TextInput { x: 9px; width: parent.width - 18px; height: parent.height;
        text <=> root.text; font-size: 13px; color: Colors.foreground; vertical-alignment: center;
        selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground; }
}

export component SpinBox inherits Rectangle {
    in-out property <int> value;
    in property <bool> enabled: true;
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    height: 30px; background: Colors.background; border-radius: 5px; opacity: root.enabled ? 1 : 0.45;
    border-width: 1px; border-color: input.has-focus ? Colors.primary : Colors.outline;
    forward-focus: input;
    TouchArea { enabled: root.enabled;
        scroll-event(event) => { root.value = clamp(root.value + (event.delta-y > 0px ? 1 : -1),root.minimum,root.maximum); return accept; }
    }
    function commit() { root.value = input.text.is-float() ? clamp(round(input.text.to-float()), root.minimum, root.maximum) : root.value; input.text = root.value; }
    changed value => { input.text = root.value; }
    input := TextInput { x: 9px; width: parent.width - 44px; height: parent.height;
        enabled: root.enabled;
        text: root.value; font-size: 13px; color: Colors.foreground; vertical-alignment: center;
        selection-background-color: Colors.primary-container; selection-foreground-color: Colors.foreground;
        edited => { if self.text.is-float() { root.value = clamp(round(self.text.to-float()),root.minimum,root.maximum); } }
        accepted => { root.commit(); }
        changed has-focus => { if !self.has-focus { root.commit(); } }
    }
    Rectangle { x: parent.width - 28px; y: 0px; width: 1px; height: parent.height; background: Colors.outline; }
    for direction[i] in [1,-1]: Rectangle {
        x: parent.width - 27px; y: i * 15px; width: 26px; height: 15px;
        background: hit.pressed ? Colors.icon-button-pressed : hit.has-hover ? Colors.icon-button-hover : transparent;
        Path { x: 8px; y: 5px; width: 10px; height: 5px; viewbox-width: 10; viewbox-height: 5;
            commands: i == 0 ? "M1 4L5 1L9 4" : "M1 1L5 4L9 1";
            fill: transparent; stroke: Colors.secondary-foreground; stroke-width: 1.5px; }
        hit := TouchArea { enabled: root.enabled; clicked => { root.commit(); root.value = clamp(root.value + direction,root.minimum,root.maximum); } }
    }
    Rectangle { x: parent.width - 27px; y: 15px; width: 27px; height: 1px; background: Colors.outline; }
}

export struct AnnotationChoiceRequest {
    field: int, options: [string], selected: int,
    x: float, y: float, width: float, height: float, lines: bool,
}

export component LineStylePreview inherits Path {
    in property <int> style;
    in property <color> ink: Colors.foreground;
    viewbox-width: 84; viewbox-height: 4;
    fill: transparent; stroke: root.ink; stroke-width: 1.5px;
    commands: root.style == 0 ? "M0 2H84"
        : root.style == 1 ? "M0 2H12M18 2H30M36 2H48M54 2H66M72 2H84"
        : root.style == 2 ? "M0 2H2M6 2H8M12 2H14M18 2H20M24 2H26M30 2H32M36 2H38M42 2H44M48 2H50M54 2H56M60 2H62M66 2H68M72 2H74M78 2H80"
        : root.style == 3 ? "M0 2H14M20 2H22M28 2H42M48 2H50M56 2H70M76 2H78"
        : "M0 2H14M20 2H22M28 2H30M36 2H50M56 2H58M64 2H66M72 2H84";
}

export component ComboBox inherits Rectangle {
    in property <int> language-revision;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <int> field;
    in property <bool> lines;
    in property <int> active-field: -1;
    callback menu-requested(AnnotationChoiceRequest);
    height: 30px; border-radius: 5px; border-width: 1px;
    border-color: root.active-field == root.field ? Colors.primary : Colors.outline;
    background: area.has-hover ? Colors.icon-button-hover : Colors.background;
    if !root.lines: Text { x: 9px; width: parent.width - 32px; height: parent.height;
        text: root.model[root.current-index]; font-size: 13px; color: Colors.foreground;
        vertical-alignment: center; overflow: elide; }
    if root.lines: LineStylePreview { x: 9px; y: (parent.height - 4px) / 2; width: parent.width - 36px; height: 4px; style: root.current-index; }
    Path { x: parent.width - 19px; y: 13px; width: 10px; height: 5px;
        viewbox-width: 10; viewbox-height: 5; commands: "M1 1L5 4L9 1";
        fill: transparent; stroke: Colors.secondary-foreground; stroke-width: 1.5px; }
    area := TouchArea { clicked => { root.menu-requested({
        field: root.field, options: root.model, selected: root.current-index,
        x: root.absolute-position.x / 1px, y: root.absolute-position.y / 1px,
        width: root.width / 1px, height: root.height / 1px, lines: root.lines,
    }); } }
}

export component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    height: 24px;
    Rectangle { x: 0px; y: 3px; width: 18px; height: 18px; border-radius: 4px;
        background: root.checked ? Colors.primary : Colors.surface;
        border-width: 1px; border-color: root.checked ? Colors.primary : Colors.outline;
        if root.checked: Path { x: 3px; y: 5px; width: 12px; height: 8px;
            viewbox-width: 12; viewbox-height: 8; commands: "M1 4L5 7L11 1";
            fill: transparent; stroke: Colors.on-primary; stroke-width: 1.5px; }
    }
    Text { x: 26px; height: parent.height; text: root.text; font-size: 13px; color: Colors.foreground; vertical-alignment: center; }
    TouchArea { clicked => { root.checked = !root.checked; } }
}

export component Slider inherits Rectangle {
    callback dragging(bool);
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum: 100;
    height: 24px;
    Rectangle { x: 8px; y: 10px; width: parent.width - 16px; height: 4px; border-radius: 2px; background: Colors.outline;
        Rectangle { x: 0px; y: 0px; width: parent.width * (root.value - root.minimum) / max(1,root.maximum - root.minimum); height: 4px; background: Colors.primary; }
    }
    Rectangle { x: (parent.width - 16px) * (root.value - root.minimum) / max(1,root.maximum - root.minimum); y: 4px;
        width: 16px; height: 16px; border-radius: 8px; background: Colors.primary;
        border-width: 2px; border-color: Colors.surface; }
    TouchArea {
        pointer-event(event) => { if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {root.dragging(false);} if event.kind == PointerEventKind.down { root.dragging(true); root.value = root.minimum + clamp((self.mouse-x - 8px)/(self.width - 16px),0,1) * (root.maximum - root.minimum); } }
        moved => { if self.pressed { root.value = root.minimum + clamp((self.mouse-x - 8px)/(self.width - 16px),0,1) * (root.maximum - root.minimum); } }
    }
}
