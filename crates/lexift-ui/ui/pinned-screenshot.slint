import { ImageCropFeedback } from "image-crop-feedback.slint";
import { AnnotationHistory } from "annotation-hint.slint";
import { Colors } from "design/colors.slint";
import { Metrics } from "design/metrics.slint";
import { Spacing } from "design/spacing.slint";
import { AppToast } from "design/toast.slint";
import { MenuMetrics } from "design/menu.slint";
import { AnnotationCursor } from "annotation-canvas.slint";
// A shared Gaussian alpha mask works in software renderers without drop-shadow.
// Fixed corners preserve the 8px exterior falloff when the image is resized.
component PinGlow inherits Image {
    // Hollow the mask before nine-slice scaling; its center must not obscure
    // the desktop when the independent content texture becomes translucent.
    source:@image-url("assets/pin-glow-mask.png", nine-slice(16));
    colorize:Colors.primary;
    image-rendering:smooth;
}
export component PinnedScreenshotWindow inherits Window {
    in property <bool> viewport-active:false;
    in property <bool> navigating:false;
    in property <bool> zoom-enabled:false;
    in property <float> zoom-percent:100;
    in property <[bool]> zoom-presets:[true,true,true,true,true,true];
    callback zoom-preset-requested(int);
    callback navigation-key(bool) -> bool;
    in property <bool> window-suppressed: false;
    in property <bool> transform-enabled: false;
    in property <bool> transform-busy: false;
    callback transform-requested(int);
    in property <bool> color-enabled:false;
    in property <bool> grayscale:false;
    in property <bool> inverted:false;
    in property <int> brightness:0;
    callback color-requested(int);
    callback brightness-requested(int);
    in property <int> contrast:0;
    callback contrast-requested(int);
    in property <bool> locked: false;
    in property <int> content-opacity-percent: 100;
    callback opacity-requested(int);
    in property <bool> mouse-passthrough: false;
    in property <bool> policy-busy: false;
    in property <bool> policy-idle: true;
    callback policy-requested(bool, bool);
    in property <bool> context-input: true;
    out property <bool> context-available: !root.transform-busy && !root.window-suppressed && root.context-input && !root.mouse-passthrough && !root.policy-busy && (root.interactive || root.editing) && !root.cropping;
    title:@tr("Pinned screenshot"); no-frame:true; always-on-top:root.topmost; background:transparent;
    in property <image> picture;
    in property <image> decoration;
    in property <bool> interactive:true;
    in property <bool> output-busy:false;
    in property <bool> recognizing:false;
    in property <bool> recognition-enabled:true;
    in property <bool> browsing:false;
    callback recognize-requested();
    in property <bool> editing:false;
    in property <bool> cropping:false;
    in property <float> crop-left;
    in property <float> crop-top;
    in property <float> crop-right;
    in property <float> crop-bottom;
    in property <float> crop-source-width:1;
    in property <float> crop-source-height:1;
    in property <bool> annotations-hidden:false;
    in property <AnnotationCursor> cursor:AnnotationCursor.idle;
    callback annotate-requested(); callback visibility-requested(bool); callback edit-pointer(int,float,float); callback escape-requested(); callback edit-key(int); callback edit-scroll(float);
    in-out property <bool> shadow-enabled:true;
    in-out property <bool> topmost:true;
    out property <float> frame-inset: MenuMetrics.shadow-inset / 1px;
    callback press-changed(bool); callback drag-requested(); callback close-requested(); callback zoom-requested(float,float,float);
    callback output-requested(int); callback option-requested(int,bool);
    public function close-menu() { context.close(); }
    public function open-menu(x:length,y:length) {
        if root.context-available { context.show({x:x - MenuMetrics.shadow-inset,y:y - MenuMetrics.shadow-inset}); }
    }
    forward-focus:keys;
    if root.shadow-enabled: PinGlow {width:parent.width; height:parent.height;}
    Rectangle {
        x:MenuMetrics.shadow-inset; y:MenuMetrics.shadow-inset;
        width:parent.width - 2 * MenuMetrics.shadow-inset; height:parent.height - 2 * MenuMetrics.shadow-inset;
        clip:true;
        if root.viewport-active: Rectangle {
            width:parent.width;height:parent.height;background:Colors.image-workspace;
            for row in ceil(self.height / Metrics.image-grid-spacing): Rectangle {
                y:row * Metrics.image-grid-spacing;width:parent.width;height:1px;
                for col in ceil(parent.width / Metrics.image-grid-spacing): Rectangle {
                    x:col * Metrics.image-grid-spacing;width:1px;height:1px;background:Colors.image-workspace-dot;
                }
            }
        }
        Rectangle {
            width:parent.width; height:parent.height;
            opacity: root.content-opacity-percent / 100;
            Image { source:root.picture; width:parent.width; height:parent.height; image-fit:fill; }
        }
        if root.editing && !root.cropping: Image {source:root.decoration;width:parent.width;height:parent.height;image-fit:fill;}
        if root.cropping: ImageCropFeedback {x:0px;y:0px;width:parent.width;height:parent.height;
            source-width:root.crop-source-width;source-height:root.crop-source-height;
            selection-left:root.crop-left;selection-top:root.crop-top;selection-right:root.crop-right;selection-bottom:root.crop-bottom;
        }
        area := TouchArea {
            width:parent.width; height:parent.height; enabled:!root.transform-busy && !root.window-suppressed && root.interactive && !root.mouse-passthrough && !root.policy-busy;
            pointer-event(event)=>{
                if !root.locked && (!root.viewport-active || root.recognizing) && (!root.editing || root.browsing) && event.kind==PointerEventKind.down && event.button==PointerEventButton.left {root.press-changed(true);root.drag-requested();}
                if event.kind==PointerEventKind.up || event.kind==PointerEventKind.cancel {root.press-changed(false);}
                if root.editing && (!root.browsing || root.viewport-active) {
                    if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {root.edit-pointer(0,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.move {root.edit-pointer(1,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.up && event.button==PointerEventButton.left {root.edit-pointer(2,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.cancel {root.edit-pointer(3,self.mouse-x/1px,self.mouse-y/1px);}
                }
            }
            changed has-hover=>{if root.editing && !root.browsing && !self.has-hover {root.edit-pointer(4,self.mouse-x/1px,self.mouse-y/1px);}}
            mouse-cursor: root.editing && !root.browsing ? (root.cursor==AnnotationCursor.moving ? move : root.cursor==AnnotationCursor.text ? text : root.cursor==AnnotationCursor.horizontal ? ew-resize : root.cursor==AnnotationCursor.vertical ? ns-resize : root.cursor==AnnotationCursor.diagonal-down ? nwse-resize : root.cursor==AnnotationCursor.diagonal-up ? nesw-resize : root.cursor==AnnotationCursor.drawing ? crosshair : default) : default;
            scroll-event(event)=>{if event.delta-x != 0px || event.modifiers.control || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta {return reject;}if root.locked && (!root.editing || root.navigating) {return accept;}if root.editing && !root.navigating && !root.browsing {root.edit-scroll(event.delta-y/1px);return accept;}root.zoom-requested(event.delta-y/1px,self.mouse-x/1px+root.frame-inset,self.mouse-y/1px+root.frame-inset);return accept;}
        }
            // Context input remains available while browsing an edited pin; drawing is separate.
            context := ContextMenuArea {
                width:parent.width; height:parent.height; enabled:root.context-available;
            Menu {
                MenuItem { title:@tr("Copy image"); enabled:!root.output-busy && !root.cropping; activated=>{root.output-requested(0);} }
                MenuItem { title:@tr("Save image"); enabled:!root.output-busy && !root.cropping; activated=>{root.output-requested(1);} }
                MenuItem { title:root.recognizing ? @tr("Recognizing text…") : @tr("Recognize text"); enabled:root.recognition-enabled && !root.output-busy && !root.cropping; activated=>{root.recognize-requested();} }
                MenuSeparator {}
                MenuItem { title:@tr("Annotate"); enabled:!root.output-busy && !root.editing; activated=>{root.annotate-requested();} }
                MenuItem { title:@tr("Hide annotations"); enabled:!root.output-busy && !root.cropping; checkable:true; checked:root.annotations-hidden; activated=>{root.visibility-requested(!root.annotations-hidden);} }
                MenuSeparator {}
                MenuItem { title:@tr("Window shadow"); checkable:true; checked <=> root.shadow-enabled; activated=>{root.option-requested(0,self.checked);} }
                MenuItem { title:@tr("Always on top"); checkable:true; checked <=> root.topmost; activated=>{root.option-requested(1,self.checked);} }
                MenuItem { title:@tr("Lock position and size"); enabled:root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping; checkable:true; checked:root.locked; activated=>{root.policy-requested(!root.locked,root.mouse-passthrough);} }
                MenuItem { title:@tr("Mouse passthrough"); enabled:root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping && !root.editing; checkable:true; checked:root.mouse-passthrough; activated=>{root.policy-requested(root.locked,!root.mouse-passthrough);} }
                Menu {
                    title:@tr("Opacity");
                    enabled:root.policy-idle && !root.policy-busy && !root.output-busy && !root.recognizing && !root.cropping;
                    for value in [100,80,60,40,20]: MenuItem {
                        title: @tr("{}%", value); checkable:true; checked:root.content-opacity-percent == value;
                        activated=>{root.opacity-requested(value);}
                    }
                }
                Menu {
                    title:@tr("Zoom: {}%", round(root.zoom-percent * 10) / 10);
                    enabled:root.zoom-enabled && root.policy-idle && !root.locked && !root.output-busy && !root.recognizing && !root.cropping;
                    for value[index] in [25,50,75,100,150,200]: MenuItem {
                        title:root.zoom-presets[index] ? @tr("{}%",value) : @tr("{}% (window limit)",value);checkable:true;checked:abs(root.zoom-percent - value)<0.01;
                        enabled:root.zoom-presets[index];activated=>{root.zoom-preset-requested(value);}
                    }
                    MenuSeparator {}
                    MenuItem {title:@tr("Fit to work area");activated=>{root.zoom-preset-requested(0);}}
                }
                Menu {
                    title:@tr("Rotate / flip");
                    enabled:root.transform-enabled && root.policy-idle && !root.locked && !root.output-busy && !root.recognizing && !root.cropping;
                    MenuItem { title:@tr("Rotate left 90°"); activated=>{root.transform-requested(0);} }
                    MenuItem { title:@tr("Rotate right 90°"); activated=>{root.transform-requested(1);} }
                    MenuItem { title:@tr("Flip horizontally"); activated=>{root.transform-requested(2);} }
                    MenuItem { title:@tr("Flip vertically"); activated=>{root.transform-requested(3);} }
                }
                MenuItem { title:@tr("Grayscale"); checkable:true; checked:root.grayscale; enabled:root.color-enabled && root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping; activated=>{root.color-requested(0);} }
                MenuItem { title:@tr("Invert colors"); checkable:true; checked:root.inverted; enabled:root.color-enabled && root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping; activated=>{root.color-requested(1);} }
                Menu {
                    title:@tr("Brightness");
                    enabled:root.color-enabled && root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping;
                    for value in [-100,-75,-50,-25,0,25,50,75,100]: MenuItem {
                        title:value == 0 ? @tr("0 (No adjustment)") : value > 0 ? @tr("+{}",value) : @tr("{}",value);
                        checkable:true;checked:root.brightness == value;
                        activated=>{root.brightness-requested(value);}
                    }
                }
                Menu {
                    title:@tr("Contrast");
                    enabled:root.color-enabled && root.policy-idle && !root.output-busy && !root.recognizing && !root.cropping;
                    for value in [-100,-75,-50,-25,0,25,50,75,100]: MenuItem {
                        title:value == 0 ? @tr("0 (No adjustment)") : value > 0 ? @tr("+{}",value) : @tr("{}",value);
                        checkable:true;checked:root.contrast == value;
                        activated=>{root.contrast-requested(value);}
                    }
                }
                MenuSeparator {}
                MenuItem { title:@tr("Close"); activated=>{root.close-requested();} }
            }
                keys := FocusScope {
                    key-released(event)=>{if event.text==" " && root.viewport-active {root.navigation-key(false);return accept;}return reject;}
                    key-pressed(event)=>{if root.window-suppressed || root.mouse-passthrough || root.policy-busy {return reject;}if event.text==" " && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift && root.viewport-active {if root.navigation-key(true) {return accept;}}if root.interactive && event.text==Key.Escape {root.escape-requested();return accept;}
                    if root.editing && !root.browsing {
                        if event.text==Key.Delete {root.edit-key(1);return accept;}
                        if event.text==Key.Return {root.edit-key(2);return accept;}
                        if event.text==Key.Backspace {root.edit-key(3);return accept;}
                        if AnnotationHistory.action(event.text,event.modifiers.control,event.modifiers.shift,event.modifiers.alt,event.modifiers.meta)==2 {root.edit-key(4);return accept;}
                        if AnnotationHistory.action(event.text,event.modifiers.control,event.modifiers.shift,event.modifiers.alt,event.modifiers.meta)==1 {root.edit-key(0);return accept;}
                    }return reject;} }
            }
    }
}
export component ScreenshotToastWindow inherits Window {
    title:""; no-frame:true; always-on-top:true; background:transparent;
    in property <bool> error:true;
    in property <bool> passive:false;
    out property <length> screen-margin:Spacing.medium;
    in property <string> message; callback dismissed();
    out property <length> content-width:Metrics.toast-width;
    out property <length> content-height:toast.height;
    preferred-width:root.content-width; preferred-height:root.content-height;
    min-width:root.content-width; max-width:root.content-width;
    min-height:root.content-height; max-height:root.content-height;
    toast := AppToast { width:parent.width; adaptive-height:true; height-limit:200px; error:root.error; dismissible:!root.passive; message:root.message; dismissed=>{root.dismissed();} }
}
