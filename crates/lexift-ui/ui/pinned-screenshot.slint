import { ImageCropFeedback } from "image-crop-feedback.slint";
import { AnnotationHistory } from "annotation-hint.slint";
import { Colors } from "design/colors.slint";
import { Metrics } from "design/metrics.slint";
import { Spacing } from "design/spacing.slint";
import { AppToast } from "design/toast.slint";
import { MenuMetrics } from "design/menu.slint";
import { AnnotationCursor } from "annotation-canvas.slint";
// A shared Gaussian alpha mask works in software renderers without drop-shadow.
// Fixed corners preserve the 8px exterior falloff when the image is resized.
component PinGlow inherits Image {
    source:@image-url("assets/pin-glow-mask.png", nine-slice(16));
    colorize:Colors.primary;
    image-rendering:smooth;
}
export component PinnedScreenshotWindow inherits Window {
    title:@tr("Pinned screenshot"); no-frame:true; always-on-top:root.topmost; background:transparent;
    in property <image> picture;
    in property <image> decoration;
    in property <bool> interactive:true;
    in property <bool> output-busy:false;
    in property <bool> recognizing:false;
    in property <bool> recognition-enabled:true;
    in property <bool> browsing:false;
    callback recognize-requested();
    in property <bool> editing:false;
    in property <bool> cropping:false;
    in property <float> crop-left;
    in property <float> crop-top;
    in property <float> crop-right;
    in property <float> crop-bottom;
    in property <float> crop-source-width:1;
    in property <float> crop-source-height:1;
    in property <bool> annotations-hidden:false;
    in property <AnnotationCursor> cursor:AnnotationCursor.idle;
    callback annotate-requested(); callback visibility-requested(bool); callback edit-pointer(int,float,float); callback escape-requested(); callback edit-key(int); callback edit-scroll(float);
    in-out property <bool> shadow-enabled:true;
    in-out property <bool> topmost:true;
    out property <float> frame-inset: MenuMetrics.shadow-inset / 1px;
    callback press-changed(bool); callback drag-requested(); callback close-requested(); callback zoom-requested(float,float,float);
    callback output-requested(int); callback option-requested(int,bool);
    public function close-menu() { context.close(); }
    forward-focus:keys;
    if root.shadow-enabled: PinGlow {width:parent.width; height:parent.height;}
    Rectangle {
        x:MenuMetrics.shadow-inset; y:MenuMetrics.shadow-inset;
        width:parent.width - 2 * MenuMetrics.shadow-inset; height:parent.height - 2 * MenuMetrics.shadow-inset;
        background:Colors.surface;
        Image { source:root.picture; width:parent.width; height:parent.height; image-fit:fill; }
        if root.editing && !root.cropping: Image {source:root.decoration;width:parent.width;height:parent.height;image-fit:fill;}
        if root.cropping: ImageCropFeedback {x:0px;y:0px;width:parent.width;height:parent.height;
            source-width:root.crop-source-width;source-height:root.crop-source-height;
            selection-left:root.crop-left;selection-top:root.crop-top;selection-right:root.crop-right;selection-bottom:root.crop-bottom;
        }
        area := TouchArea {
            width:parent.width; height:parent.height; enabled:root.interactive;
            pointer-event(event)=>{
                if (!root.editing || root.browsing) && event.kind==PointerEventKind.down && event.button==PointerEventButton.left {root.press-changed(true);root.drag-requested();}
                if event.kind==PointerEventKind.up || event.kind==PointerEventKind.cancel {root.press-changed(false);}
                if root.editing && !root.browsing {
                    if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {root.edit-pointer(0,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.move {root.edit-pointer(1,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.up && event.button==PointerEventButton.left {root.edit-pointer(2,self.mouse-x/1px,self.mouse-y/1px);}
                    if event.kind==PointerEventKind.cancel {root.edit-pointer(3,self.mouse-x/1px,self.mouse-y/1px);}
                }
            }
            changed has-hover=>{if root.editing && !root.browsing && !self.has-hover {root.edit-pointer(4,self.mouse-x/1px,self.mouse-y/1px);}}
            mouse-cursor: root.editing && !root.browsing ? (root.cursor==AnnotationCursor.moving ? move : root.cursor==AnnotationCursor.text ? text : root.cursor==AnnotationCursor.horizontal ? ew-resize : root.cursor==AnnotationCursor.vertical ? ns-resize : root.cursor==AnnotationCursor.diagonal-down ? nwse-resize : root.cursor==AnnotationCursor.diagonal-up ? nesw-resize : root.cursor==AnnotationCursor.drawing ? crosshair : default) : default;
            scroll-event(event)=>{if root.editing && !root.browsing {root.edit-scroll(event.delta-y/1px);return accept;}root.zoom-requested(event.delta-y/1px,self.mouse-x/1px+root.frame-inset,self.mouse-y/1px+root.frame-inset);return accept;}
            // The context area gets right clicks before the draggable parent's grab.
            context := ContextMenuArea {
                width:parent.width; height:parent.height; enabled:root.interactive;
            Menu {
                MenuItem { title:@tr("Copy image"); enabled:!root.output-busy && !root.cropping; activated=>{root.output-requested(0);} }
                MenuItem { title:@tr("Save image"); enabled:!root.output-busy && !root.cropping; activated=>{root.output-requested(1);} }
                MenuItem { title:root.recognizing ? @tr("Recognizing text…") : @tr("Recognize text"); enabled:root.recognition-enabled && !root.output-busy && !root.cropping; activated=>{root.recognize-requested();} }
                MenuSeparator {}
                MenuItem { title:@tr("Annotate"); enabled:!root.output-busy && !root.editing; activated=>{root.annotate-requested();} }
                MenuItem { title:@tr("Hide annotations"); enabled:!root.output-busy && !root.cropping; checkable:true; checked:root.annotations-hidden; activated=>{root.visibility-requested(!root.annotations-hidden);} }
                MenuSeparator {}
                MenuItem { title:@tr("Window shadow"); checkable:true; checked <=> root.shadow-enabled; activated=>{root.option-requested(0,self.checked);} }
                MenuItem { title:@tr("Always on top"); checkable:true; checked <=> root.topmost; activated=>{root.option-requested(1,self.checked);} }
                MenuSeparator {}
                MenuItem { title:@tr("Close"); activated=>{root.close-requested();} }
            }
                keys := FocusScope { key-pressed(event)=>{if root.interactive && event.text==Key.Escape {root.escape-requested();return accept;}
                    if root.editing && !root.browsing {
                        if event.text==Key.Delete {root.edit-key(1);return accept;}
                        if event.text==Key.Return {root.edit-key(2);return accept;}
                        if event.text==Key.Backspace {root.edit-key(3);return accept;}
                        if AnnotationHistory.action(event.text,event.modifiers.control,event.modifiers.shift,event.modifiers.alt,event.modifiers.meta)==2 {root.edit-key(4);return accept;}
                        if AnnotationHistory.action(event.text,event.modifiers.control,event.modifiers.shift,event.modifiers.alt,event.modifiers.meta)==1 {root.edit-key(0);return accept;}
                    }return reject;} }
            }
        }
    }
}
export component ScreenshotToastWindow inherits Window {
    title:""; no-frame:true; always-on-top:true; background:transparent;
    in property <bool> error:true;
    in property <bool> passive:false;
    out property <length> screen-margin:Spacing.medium;
    in property <string> message; callback dismissed();
    out property <length> content-width:Metrics.toast-width;
    out property <length> content-height:toast.height;
    preferred-width:root.content-width; preferred-height:root.content-height;
    min-width:root.content-width; max-width:root.content-width;
    min-height:root.content-height; max-height:root.content-height;
    toast := AppToast { width:parent.width; adaptive-height:true; height-limit:200px; error:root.error; dismissible:!root.passive; message:root.message; dismissed=>{root.dismissed();} }
}
