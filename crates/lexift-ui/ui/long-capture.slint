import { Colors } from "design/colors.slint";
import { Metrics } from "design/metrics.slint";
import { AnnotationHintTarget } from "annotation-hint.slint";

component CaptureButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> busy: false;
    private property <angle> busy-turn;
    Timer { interval: 80ms; running: root.busy; triggered => { root.busy-turn += 45deg; } }
    callback clicked();
    width: Metrics.long-capture-button-size; height: Metrics.long-capture-button-size; border-radius: 6px;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    background: area.pressed && root.enabled ? Colors.icon-button-pressed : root.selected ? Colors.primary-container : area.has-hover && root.enabled ? Colors.icon-button-hover : transparent;
    Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: Metrics.long-capture-icon-size; height: Metrics.long-capture-icon-size;
        source: root.busy ? @image-url("assets/icons/refresh.svg") : root.icon;
        transform-rotation: root.busy ? root.busy-turn : 0deg;
        colorize: root.selected ? Colors.primary : root.enabled || root.busy ? Colors.foreground : Colors.outline; image-fit: contain; }
    area := TouchArea { clicked => { if root.enabled { root.clicked(); } } }
    AnnotationHintTarget { width: parent.width; height: parent.height; text: root.label; hovered: area.has-hover; pressed: area.pressed; }
}
component CaptureSeparator inherits Rectangle {
    width: 9px; height: Metrics.long-capture-button-size;
    Rectangle { x: 4px; y: 7px; width: 1px; height: parent.height - 14px; background: Colors.outline; }
}
export component LongCaptureControl inherits Window {
    title: @tr("Long screenshot"); no-frame: true; always-on-top: true;
    background: transparent;
    preferred-width: root.content-width; preferred-height: root.content-height;
    min-width: root.content-width; max-width: root.content-width;
    min-height: root.content-height; max-height: root.content-height;
    // Reserve the widest legal dimensions once, so accepted rows never move the controls.
    measure-square := Text { visible: false; text: "32768 × 32768 px"; font-size: 12px; }
    measure-wide := Text { visible: false; text: "32000000 × 1 px"; font-size: 12px; }
    out property <length> content-width: max(measure-square.preferred-width, measure-wide.preferred-width) + 8px + 60px + 6 * Metrics.long-capture-button-size;
    out property <length> content-height: Metrics.long-capture-control-height;
    in property <bool> ready;
    in property <bool> paused;
    in property <bool> finishing;
    in property <bool> frozen;
    in property <string> dimensions;
    callback pause(); callback finish(); callback cancel(); callback output(int);
    callback drag-requested(float, float);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } return reject; }
        Rectangle {
            width: 100%; height: 100%; background: Colors.surface; border-radius: 8px; border-width: 1px; border-color: Colors.outline;
            HorizontalLayout {
                padding: 4px; spacing: 2px;
                Rectangle { width: 16px; height: Metrics.long-capture-button-size;
                    Image { x: 3px; y: 8px; width: 10px; height: 16px; source: @image-url("assets/icons/capture-grip.svg"); colorize: Colors.outline; }
                    grip := TouchArea { mouse-cursor: move; pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.drag-requested((self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px); } } }
                    AnnotationHintTarget { width: parent.width; height: parent.height; text: @tr("Move toolbar"); hovered: grip.has-hover; pressed: grip.pressed; }
                }
                Rectangle { width: max(measure-square.preferred-width, measure-wide.preferred-width) + 8px; height: Metrics.long-capture-button-size;
                    Text { x: 4px; width: parent.width - 8px; height: 100%; text: root.dimensions; color: Colors.foreground; vertical-alignment: center; font-size: 12px; }
                    dimensions-area := TouchArea {}
                    AnnotationHintTarget { width: parent.width; height: parent.height; text: @tr("Scroll down to extend the image"); hovered: dimensions-area.has-hover; pressed: dimensions-area.pressed; }
                }
                CaptureSeparator {}
                CaptureButton { icon: root.paused ? @image-url("assets/icons/capture-play.svg") : @image-url("assets/icons/capture-pause.svg"); label: root.paused ? @tr("Continue") : @tr("Pause"); enabled: root.ready && !root.finishing && !root.frozen; selected: root.paused; busy: !root.ready || root.finishing; clicked => { root.pause(); } }
                CaptureButton { icon: @image-url("icons/credential-edit.svg"); label: @tr("Edit"); enabled: root.ready && !root.finishing; clicked => { root.finish(); } }
                CaptureSeparator {}
                CaptureButton { icon: @image-url("assets/icons/copy.svg"); label: @tr("Copy image"); enabled: root.ready && !root.finishing; clicked => { root.output(0); } }
                CaptureButton { icon: @image-url("assets/icons/capture-save.svg"); label: @tr("Save image"); enabled: root.ready && !root.finishing; clicked => { root.output(1); } }
                CaptureButton { icon: @image-url("assets/icons/pin-screenshot.svg"); label: @tr("Pin screenshot"); enabled: root.ready && !root.finishing; clicked => { root.output(2); } }
                CaptureButton { icon: @image-url("assets/icons/screenshot-close.svg"); label: @tr("Cancel"); clicked => { root.cancel(); } }
            }
        }
    }
}
export component LongCapturePreview inherits Window {
    title: "Lexift Long Capture Preview"; no-frame: true; always-on-top: true; background: transparent;
    in property <image> preview;
    in property <float> current-top;
    in property <float> current-height;
    in property <bool> clipped;
    Rectangle { width: 100%; height: 100%; background: Colors.surface; border-width: 2px; border-color: Colors.primary;
        Image { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; source: root.preview; image-fit: fill; }
        Rectangle { x: 1px; y: 2px + root.current-top * (parent.height - 4px); width: parent.width - 2px;
            height: max(2px, root.current-height * (parent.height - 4px)); background: transparent;
            border-width: 2px; border-color: Colors.success; }
        if root.clipped: Rectangle { x: parent.width / 2 - 13px; y: 2px; width: 26px; height: 20px; background: Colors.surface; border-radius: 4px;
            Image { x: 5px; y: 2px; width: 16px; height: 16px; source: @image-url("icons/chevron-down.svg"); transform-rotation: 180deg; colorize: Colors.foreground; }
        }
    }
}
export component LongCaptureRange inherits Window {
    title: "Lexift Long Capture Range"; no-frame: true; always-on-top: true; background: transparent;
    in property <length> selection-x; in property <length> selection-y;
    in property <length> selection-width; in property <length> selection-height;
    Rectangle { x: 0px; y: 0px; width: 100%; height: root.selection-y; background: Colors.capture-mask; }
    Rectangle { x: 0px; y: root.selection-y + root.selection-height; width: 100%; height: root.height - self.y; background: Colors.capture-mask; }
    Rectangle { x: 0px; y: root.selection-y; width: root.selection-x; height: root.selection-height; background: Colors.capture-mask; }
    Rectangle { x: root.selection-x + root.selection-width; y: root.selection-y; width: root.width - self.x; height: root.selection-height; background: Colors.capture-mask; }
    Rectangle { x: root.selection-x; y: root.selection-y; width: root.selection-width; height: root.selection-height; background: transparent; border-width: Metrics.screen-selection-border; border-color: Colors.primary; }
}
