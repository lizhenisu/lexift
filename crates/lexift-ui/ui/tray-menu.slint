import { Colors } from "design/colors.slint";
import { Typography } from "design/typography.slint";
import { MenuMetrics } from "design/menu.slint";

component TrayMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled:true;
    out property <length> label-width: text.preferred-width;
    callback hovered();
    callback activated();
    height: MenuMetrics.row-height;
    border-radius: MenuMetrics.row-radius;
    background: touch.pressed ? Colors.menu-pressed : root.selected ? Colors.menu-hover : transparent;
    accessible-role: list-item;
    accessible-item-selected: root.selected;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled {root.activated();} }
    text := Text {
        x: MenuMetrics.text-inset;
        width: parent.width - 2 * MenuMetrics.text-inset;
        height: parent.height;
        text: root.label;
        font-size: Typography.menu-size;
        font-weight: 400;
        color: root.enabled ? Colors.foreground : Colors.outline;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled:root.enabled;
        changed has-hover => { if self.has-hover { root.hovered(); } }
        clicked => { root.activated(); }
    }
}

export component TrayMenuWindow inherits Window {
    title: "Lexift";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    out property <length> menu-width: max(max(MenuMetrics.minimum-width, max(open.label-width, max(max(import-file.label-width,import-clipboard.label-width),max(history.label-width, max(settings.label-width, quit.label-width)))) + 2 * (MenuMetrics.text-inset + MenuMetrics.padding)) + 2 * MenuMetrics.shadow-inset, max(recover.label-width,max(hide-pins.label-width,restore-pins.label-width)) + 2 * (MenuMetrics.text-inset + MenuMetrics.padding + MenuMetrics.shadow-inset));
    out property <length> menu-height: 9 * MenuMetrics.row-height + 2 * (MenuMetrics.padding + MenuMetrics.shadow-inset) + MenuMetrics.separator-height;
    preferred-width: root.menu-width;
    preferred-height: root.menu-height;
    in property <string> open-label: "Open Lexift";
    in property <string> settings-label: "Settings";
    in property <string> history-label: @tr("Image history");
    in property <string> quit-label: "Quit";
    in property <bool> import-available:true;
    in property <bool> pin-recovery-available:false;
    in property <bool> pin-hide-available:false;
    in property <bool> pin-restore-available:false;
    in-out property <int> selected: -1;
    callback action(int);
    callback cancel();
    callback character(string);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); }
            else if event.text == Key.DownArrow { root.selected = mod(root.selected + 1, 9); }
            else if event.text == Key.UpArrow { root.selected = root.selected <= 0 ? 8 : root.selected - 1; }
            else if event.text == Key.Home { root.selected = 0; }
            else if event.text == Key.End { root.selected = 8; }
            else if event.text == Key.Return || event.text == " " { if root.selected >= 0 { root.action(root.selected); } }
            else { root.character(event.text); }
            accept
        }
    }
    Rectangle {
        accessible-role: list;
        accessible-label: "Lexift";
        x: MenuMetrics.shadow-inset; y: MenuMetrics.shadow-inset;
        width: parent.width - 2 * MenuMetrics.shadow-inset;
        height: parent.height - 2 * MenuMetrics.shadow-inset;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.outline;
        border-radius: MenuMetrics.radius;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Colors.menu-shadow;
        open := TrayMenuRow {
            x: MenuMetrics.padding; y: MenuMetrics.padding;
            width: parent.width - 2 * MenuMetrics.padding;
            label: root.open-label; selected: root.selected == 0;
            hovered => { root.selected = 0; }
            activated => { root.action(0); }
        }
        settings := TrayMenuRow {
            x: open.x; y: open.y + open.height; width: open.width;
            label: root.settings-label; selected: root.selected == 1;
            hovered => { root.selected = 1; }
            activated => { root.action(1); }
        }
        history := TrayMenuRow {
            x: open.x; y: settings.y + settings.height; width: open.width;
            label: root.history-label; selected: root.selected == 2;
            hovered => { root.selected = 2; }
            activated => { root.action(2); }
        }
        import-file := TrayMenuRow {x:open.x;y:history.y+history.height;width:open.width;label:@tr("Open image");selected:root.selected==3;enabled:root.import-available;hovered=>{root.selected=3;}activated=>{root.action(3);} }
        import-clipboard := TrayMenuRow {x:open.x;y:import-file.y+import-file.height;width:open.width;label:@tr("Pin image from clipboard");selected:root.selected==4;enabled:root.import-available;hovered=>{root.selected=4;}activated=>{root.action(4);} }
        recover := TrayMenuRow {x:open.x;y:import-clipboard.y+import-clipboard.height;width:open.width;label:@tr("Turn off mouse passthrough for all pins");selected:root.selected==5;enabled:root.pin-recovery-available;hovered=>{root.selected=5;}activated=>{root.action(5);} }
        hide-pins := TrayMenuRow {x:open.x;y:recover.y+recover.height;width:open.width;label:@tr("Hide all pins");selected:root.selected==6;enabled:root.pin-hide-available;hovered=>{root.selected=6;}activated=>{root.action(6);} }
        restore-pins := TrayMenuRow {x:open.x;y:hide-pins.y+hide-pins.height;width:open.width;label:@tr("Restore hidden pins");selected:root.selected==7;enabled:root.pin-restore-available;hovered=>{root.selected=7;}activated=>{root.action(7);} }
        Rectangle {
            x: open.x; y: restore-pins.y + restore-pins.height + 4px;
            width: open.width; height: 1px; background: Colors.outline;
        }
        quit := TrayMenuRow {
            x: open.x; y: restore-pins.y + restore-pins.height + MenuMetrics.separator-height; width: open.width;
            label: root.quit-label; selected: root.selected == 8;
            hovered => { root.selected = 8; }
            activated => { root.action(8); }
        }
    }
}
