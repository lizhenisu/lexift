import { Colors } from "design/colors.slint";
import { Spacing } from "design/spacing.slint";
import { Typography } from "design/typography.slint";
import { Metrics } from "design/metrics.slint";

export struct ProviderProbeRow { id: string, state: string, detail: string, elapsed: string, failed: bool }

export struct ProviderModelRow { id: string, note: string, enabled: bool, usable: bool, text: bool, thinking: bool }

export component ProviderIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <string> accessible-name: root.tooltip;
    callback clicked();
    public function focus-button() { keyboard.focus(); }
    width: 32px; height: 32px; border-radius: 6px;
    opacity: enabled ? 1 : Metrics.disabled-opacity;
    background: selected ? Colors.primary-container : touch.pressed ? Colors.icon-button-pressed : touch.has-hover ? Colors.icon-button-hover : transparent;
    accessible-role: button; accessible-label: root.accessible-name;
    border-width: keyboard.has-focus && root.enabled ? 1px : 0px; border-color: Colors.primary;
    Image { x: 7px; y: 7px; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? Colors.primary : Colors.secondary-foreground; }
    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keyboard.focus(); root.clicked(); } }
    if touch.has-hover && root.tooltip != "": Rectangle {
        z: 100; x: min(0px, root.width - self.width); y: root.height + 4px;
        width: hint.preferred-width + 16px; height: 28px; border-radius: 4px; background: Colors.foreground;
        hint := Text { x: 8px; height: parent.height; text: root.tooltip; color: Colors.surface; font-size: 12px; vertical-alignment: center; }
    }
}

export component ProviderInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> secret: false;
    callback edited();
    public function focus-input() { input.focus(); }
    height: 40px; border-radius: 6px; border-width: 1px;
    border-color: input.has-focus ? Colors.primary : Colors.outline;
    background: Colors.background;
    input := TextInput {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text <=> root.text; input-type: root.secret ? InputType.password : InputType.text;
        color: Colors.foreground; font-size: Typography.body-size; vertical-alignment: center;
        edited => { root.edited(); }
    }
    if root.text == "" && !input.has-focus: Text {
        x: 12px; width: parent.width - 24px; height: parent.height; text: root.placeholder;
        color: Colors.secondary-foreground; font-size: Typography.body-size; vertical-alignment: center; overflow: elide;
    }
}

export component ProviderModelItem inherits Rectangle {
    in property <ProviderModelRow> model;
    callback toggle();
    callback hint(string, length, length);
    height: root.model.usable ? 52px : 72px;
    background: hover.has-hover ? Colors.background : transparent;
    hover := TouchArea { changed has-hover => { root.hint(self.has-hover && model-name.preferred-width > model-name.width ? root.model.id : "", root.absolute-position.x, root.absolute-position.y + root.height); } }
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Colors.outline.with-alpha(0.5); }
    model-name := Text {
        x: 16px; y: 8px; width: max(0px, parent.width - 112px); height: 36px;
        text: root.model.id; font-size: Typography.body-size; color: Colors.foreground; vertical-alignment: center; overflow: elide;
    }
    if !root.model.usable: Text {
        x: 16px; y: 40px; width: parent.width - 32px; height: 24px;
        text: root.model.note; color: Colors.secondary-foreground; font-size: 12px; vertical-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        x: parent.width - 92px; y: 10px; width: 84px; height: 32px; spacing: 4px;
        Rectangle { width: 40px;
            if root.model.text: Image { x: 0px; y: 8px; width: 16px; height: 16px; source: @image-url("icons/provider-text.svg"); colorize: Colors.secondary-foreground; }
            if root.model.thinking: Image { x: 20px; y: 8px; width: 16px; height: 16px; source: @image-url("icons/provider-thinking.svg"); colorize: Colors.primary; }
        }
        ProviderIconButton {
            icon: root.model.enabled ? @image-url("icons/provider-minus.svg") : @image-url("icons/provider-plus.svg");
            tooltip: root.model.enabled ? @tr("Disable model") : @tr("Enable model"); enabled: root.model.enabled || root.model.usable;
            clicked => { root.toggle(); }
        }
    }
}

// Owns only the shell; each caller supplies its bounded scrolling content.
export component ProviderDialog inherits Rectangle {
    in property <string> title;
    callback dismissed();
    border-radius: Metrics.popup-shell-radius; border-width: 1px; border-color: Colors.outline; background: Colors.surface;
    Text { x: 24px; y: 16px; width: parent.width - 88px; height: 32px; text: root.title; color: Colors.foreground; font-size: Typography.body-size; font-weight: 700; vertical-alignment: center; overflow: elide; }
    ProviderIconButton { x: parent.width - 56px; y: 16px; icon: @image-url("assets/icons/close.svg"); accessible-name: @tr("Close"); clicked => { root.dismissed(); } }
    @children
}

export component ProviderFilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: caption.preferred-width + 20px; height: 32px; border-radius: 6px;
    background: selected ? Colors.primary-container : touch.has-hover ? Colors.icon-button-hover : Colors.background;
    caption := Text { x: 10px; height: parent.height; text: root.label; color: root.selected ? Colors.primary : Colors.secondary-foreground; font-size: 13px; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Measure the single-row width before choosing a wrapping height. Flexbox's
// unconstrained preferred height can otherwise reserve a phantom second row.
export component ProviderFilterBar inherits Rectangle {
    in property <[string]> labels;
    in property <int> current-index;
    callback chosen(int);
    height: flow.height;
    measure := HorizontalLayout {
        visible: false; width: self.preferred-width; height: 32px; spacing: 4px;
        for label in root.labels: ProviderFilterChip { label: label; }
    }
    flow := FlexboxLayout {
        width: root.width; height: measure.preferred-width <= root.width ? 32px : self.preferred-height;
        spacing: 4px;
        for label[index] in root.labels: ProviderFilterChip {
            label: label; selected: root.current-index == index; clicked => { root.chosen(index); }
        }
    }
}
